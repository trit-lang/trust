; Globals, address arithmetic and loads.
;
; `offset` is the entire address-arithmetic instruction — there is no GEP —
; and a pointer may only address the allocation it came from (TIR §5).

tir 0.1 target "tritium"

global @data : tryte[9] = [1, 2, 3, 4, 5, 6, 7, 8, 9]

fn @sum_data() -> t9 {
^entry:
    br ^loop(const t27 0, const t9 0)

^loop(%i: t27, %acc: t9):
    %p = offset @data, %i
    %v = load t9 %p
    %acc2 = add.trap t9 %acc, %v
    %i2 = add.wrap t27 %i, const t27 1
    %c = cmp t27 %i2, const t27 9
    br3 %c, ^loop(%i2, %acc2), ^done(%acc2), ^done(%acc2)

^done(%r: t9):
    ret %r
}
