// mockHPL.tr — HPL's shape, on a machine that cannot yet keep time.
//
// HPL does four things: build a dense system, factor it with LU and partial
// pivoting, solve it, and check the answer by its scaled residual. All four
// are here and all four run. The fifth thing is the one that makes it a
// benchmark — dividing 2/3·N³ + 2·N² operations by the elapsed time — and it
// is the one thing this machine cannot do. TRISC-27 §2.2's device region is
// IO_IN, IO_OUT and MEM_SIZE; nothing counts steps, and `tritium run` does
// not report them either. `elapsed()` below is the seam: today it returns 0
// and the score prints `n/a`; when a counter device arrives it becomes an
// external declaration like `putchar`, served by the runtime, and this file
// starts reporting a number without another line changing. Hence `mock`.
//
// Three things it is honest about being:
//
//   * Fixed point, scale 3^9. There is no floating point (AM §7 defers the
//     format to a later draft), and TIR's `mulh` has no language surface, so
//     a product must fit `t27` — which caps the scale near 3^9 and the
//     working precision near four and a half decimal digits. The arithmetic
//     itself needs no apology: `x >> 9` *is* division by 3^9 under
//     round-to-nearest, with no tie case ever arising and no fixup (Ch. 1
//     §4). Every rescale below is one instruction and exactly rounded, which
//     is the one place this machine is better at numerics than the one you
//     are reading this on.
//
//   * N = 27, written as a literal everywhere it appears. A `const` cannot
//     be an array length in draft 0.1 and const generics are not
//     implemented, so changing the size means changing every `27` marked
//     `// N` — and `t27` is not one of them. 27 is also the honest size: at
//     ~160 instructions per inner multiply-accumulate (there is no register
//     allocator), N = 48 already costs 17 million steps.
//
//   * A system built to be solvable at this precision, and built to make the
//     pivoting work for its living. See `generate`.

fn putchar(c: t9);

// The score's missing half. A cycle counter turns this into
// `fn elapsed() -> t27;` — a declaration with an external body, the same
// arrangement `putchar` has. Until then it returns 0, which `main` reads as
// "no clock" rather than as "no time passed".
fn elapsed() -> t27 {
    0
}

// ------------------------------------------------------------ printing

fn print_str(s: &[t9]) {
    let mut i: taddr = 0;
    while i < s.len() {
        putchar(s[i]);
        i += 1;
    }
}

fn print_decimal(value: t27) {
    let mut n = value;
    if n < 0 {
        putchar(45);
        n = -n;
    }
    if n == 0 {
        putchar(48);
        return;
    }
    let mut digits: [t9; 16] = [0; 16];
    let mut i: taddr = 0;
    while n > 0 {
        digits[i] = (n % 10) as t9;
        n = n / 10;
        if digits[i] < 0 {              // the balanced remainder's one price
            digits[i] += 10;
            n -= 1;
        }
        i += 1;
    }
    while i > 0 {
        i -= 1;
        putchar(digits[i] + 48);
    }
}

// Division rounding toward zero, for the digits of a printed number. `/`
// rounds to nearest (Ch. 1 §4), which is what arithmetic wants and what a
// digit loop must not have: it would carry into the digit above.
fn div_floor(a: t27, b: t27) -> t27 {
    let q = a / b;
    if q * b > a { q - 1 } else { q }
}

// A non-negative fixed-point value, four places after the point.
fn print_fixed(v: t27) {
    let whole = div_floor(v, 19683);
    print_decimal(whole);
    putchar(46);                        // '.'
    let mut frac = v - whole * 19683;
    let mut k: taddr = 0;
    while k < 4 {
        frac = frac * 10;
        let digit = div_floor(frac, 19683);
        putchar((digit as t9) + 48);
        frac -= digit * 19683;
        k += 1;
    }
}

// ------------------------------------------------------- fixed point

// One is 19683 = 3^9, and every value below is a real number times it.
// Multiplying rescales by `>> 9`, dividing by `<< 9`, and both are exact.
fn fmul(a: t27, b: t27) -> t27 {
    (a * b) >> 9
}

fn fdiv(a: t27, b: t27) -> t27 {
    (a << 9) / b
}

fn fabs(x: t27) -> t27 {
    if x < 0 { -x } else { x }
}

// A remainder folded into 0…n−1. The balanced remainder lands in ±n/2
// (Ch. 1 §4), which is the right answer for arithmetic and the wrong one for
// an index — the same one-line apology `print_decimal` owes above.
fn wrap_index(v: taddr, n: taddr) -> taddr {
    let r = v % n;
    if r < 0 { r + n } else { r }
}

// ------------------------------------------------------- the system

// HPL's matrix is pseudo-random and so is this one: a linear congruential
// generator over the whole word — `wrapping_mul` is the release-profile
// flavor of `*`, asked for by name (Ch. 1 §4) — reduced into ±1 by a
// balanced remainder, whose range is |r| ≤ |b|/2 and so is exactly ±3^9 for
// this divisor. No fold, no bias correction, no absolute value.
struct Rng { s: t27 }

impl Rng {
    fn next_unit(&mut self) -> t27 {
        self.s = self.s.wrapping_mul(1103515).wrapping_add(12345);
        self.s % 39367                  // 2·3^9 + 1, so |r| ≤ 3^9
    }
}

// Where each row's weight goes: row i is heavy in column `sigma(i)`.
// 5 and 27 are coprime, so this is a permutation of the columns.
fn sigma(i: taddr, n: taddr) -> taddr {
    wrap_index(5 * i + 3, n)
}

// A dense system with entries in ±1, weighted so that it is both solvable at
// this precision and unsolvable without pivoting.
//
// Two departures from "draw everything uniformly", each bought with a
// reason. First, the weight: a random matrix at four and a half digits is a
// coin toss rather than a benchmark, since a condition number in the
// hundreds leaves nothing of the answer, so one entry per row carries N.
// Second, where the weight goes: on the diagonal it would make every pivot
// search find the element already in place, and the pivoting this file
// claims to do would never once swap a row. Putting it on a *permuted*
// diagonal instead costs nothing in conditioning — it is a row permutation
// of the same matrix — and forces the factorization to hunt down all N of
// them. `main` then checks that it found exactly the permutation planted
// here, which is a sharper question than the residual asks.
//
// The right-hand side is drawn the same way and weighted to match, so the
// solution comes out near ±1 rather than near ±1/N. That is not cosmetic: a
// solution of 0.03 has under three significant digits left at scale 3^9, and
// the residual would end up measuring the printer rather than the solver.
fn generate(a: &mut [[t27; 27]], b: &mut [t27], rng: &mut Rng) {     // N
    let n = a.len();
    let mut i: taddr = 0;
    while i < n {
        let mut j: taddr = 0;
        while j < n {
            a[i][j] = rng.next_unit();
            j += 1;
        }
        a[i][sigma(i, n)] += (n as t27) * 19683;
        b[i] = rng.next_unit() * (n as t27);
        i += 1;
    }
}

// ------------------------------------------------- factor, solve, check

// LU with partial pivoting, in place; `perm[i]` is the original row now
// sitting at row i. Returns the number of row exchanges, or `None` if a
// pivot column was entirely zero.
fn factor(a: &mut [[t27; 27]], perm: &mut [taddr]) -> Option<t27> {  // N
    let n = a.len();
    let mut swaps: t27 = 0;
    let mut k: taddr = 0;
    while k < n {
        // The pivot: the largest magnitude at or below the diagonal. This is
        // what holds every multiplier below to |m| ≤ 1, which is in turn
        // what keeps the products below inside `t27`.
        let mut best = k;
        let mut i = k + 1;
        while i < n {
            if fabs(a[i][k]) > fabs(a[best][k]) {
                best = i;
            }
            i += 1;
        }
        if a[best][k] == 0 {
            return Option::None;
        }
        if best != k {
            let mut j: taddr = 0;
            while j < n {
                let t = a[k][j];
                a[k][j] = a[best][j];
                a[best][j] = t;
                j += 1;
            }
            let t = perm[k];
            perm[k] = perm[best];
            perm[best] = t;
            swaps += 1;
        }
        // The elimination — the 2/3·N³ the score would be counting.
        let mut r = k + 1;
        while r < n {
            let m = fdiv(a[r][k], a[k][k]);
            a[r][k] = m;
            let mut c = k + 1;
            while c < n {
                a[r][c] -= fmul(m, a[k][c]);
                c += 1;
            }
            r += 1;
        }
        k += 1;
    }
    Option::Some(swaps)
}

// Forward then back substitution, into `x`. L has an implicit unit diagonal,
// and `perm` puts the right-hand side in the order the rows ended up in.
fn solve(a: &[[t27; 27]], perm: &[taddr], b: &[t27], x: &mut [t27]) { // N
    let n = a.len();
    let mut i: taddr = 0;
    while i < n {
        let mut sum = b[perm[i]];
        let mut j: taddr = 0;
        while j < i {
            sum -= fmul(a[i][j], x[j]);
            j += 1;
        }
        x[i] = sum;
        i += 1;
    }
    let mut r = n;
    while r > 0 {
        r -= 1;
        let mut sum = x[r];
        let mut j = r + 1;
        while j < n {
            sum -= fmul(a[r][j], x[j]);
            j += 1;
        }
        x[r] = fdiv(sum, a[r][r]);
    }
}

// ‖Ax − b‖∞, against the system as it stood before the factorization ate it.
fn residual_inf(a0: &[[t27; 27]], x: &[t27], b0: &[t27]) -> t27 {    // N
    let n = a0.len();
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut sum: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            sum += fmul(a0[i][j], x[j]);
            j += 1;
        }
        let r = fabs(sum - b0[i]);
        if r > worst {
            worst = r;
        }
        i += 1;
    }
    worst
}

fn norm_inf_matrix(a: &[[t27; 27]]) -> t27 {                         // N
    let n = a.len();
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut row: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            row += fabs(a[i][j]);
            j += 1;
        }
        if row > worst {
            worst = row;
        }
        i += 1;
    }
    worst
}

fn norm_inf_vector(v: &[t27]) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < v.len() {
        let m = fabs(v[i]);
        if m > worst {
            worst = m;
        }
        i += 1;
    }
    worst
}

// HPL's number: ‖Ax−b‖∞ ⁄ (ε·‖A‖∞·‖x‖∞·N), which passes under 16. ε is the
// fixed-point resolution 3^-9, so ε is the value 1 and dividing by it is a
// shift, and the whole check stays in the integers it was written in.
//
// The order of the arithmetic is the entire difficulty, and it is not the
// same order at both ends of the range. A residual that is doing its job is a
// handful of ULPs against a six-figure denominator, so dividing even once too
// early rounds it to nothing — and a residual printed as `0.0000` says
// nothing whatever about the solver that produced it. A residual reporting a
// disaster is large enough that scaling it first overflows. Both orders are
// the same quantity; each is wrong where the other is right.
//
// So: take the precise one where it fits, with all the scale `t27` will hold
// on the numerator — 3^18, not 3^27, because ‖Ax−b‖ already carries 3^9 —
// and one division after it. Where it does not fit, split the scale either
// side of the division instead. That costs the low digits of a number about
// to be printed as a failure, which is a price worth paying and not one
// worth hiding.
//
// The two cases divide at 9841, which is not a magic number: 3^18 · 9841 is
// the largest multiple of 3^18 a `t27` holds, and 9841 is `t9`'s maximum.
// The precise path is available exactly when the residual fits in a tryte.
// (`checked_mul` would say this directly, but its `Option<t27>` return is
// rejected by the compiler with a diagnostic that Ch. 4 is unwritten — which
// it no longer is; `factor` above returns an `Option<t27>` and compiles.)
fn scaled_residual(r: t27, anorm: t27, xnorm: t27, n: t27) -> t27 {
    let denom = fmul(anorm, xnorm);
    if r <= 9841 {
        ((r * 387420489) / denom) / n                   // 387420489 = 3^18
    } else {
        (fdiv(r, denom) << 9) / n
    }
}

// The verdict, which is deliberately not read off the number above.
//
// `resid < 16` is the same question as `‖Ax−b‖·3^9 < 16·‖A‖·‖x‖·N`, and the
// comparison survives magnitudes the quotient cannot represent. This matters
// more than it sounds: an earlier draft of this file saturated the quotient's
// numerator, and a solution perturbed by 200000 ULP — wrong in its first
// digit — came back saying `resid=0.7493 PASSED`, because clamping a
// numerator moves the answer toward passing. The multiply here saturates in
// the direction that fails.
fn residual_passes(r: t27, anorm: t27, xnorm: t27, n: t27) -> bool {
    r.saturating_mul(19683) < fmul(anorm, xnorm) * 16 * n
}

// ----------------------------------------------------------------- main

fn main() -> t27 {
    // "mockHPL 0.1 - LU solve, fixed point 3^9\n"
    let banner: [t9; 40] = [109, 111, 99, 107, 72, 80, 76, 32, 48, 46, 49, 32, 45, 32, 76, 85,
                            32, 115, 111, 108, 118, 101, 44, 32, 102, 105, 120, 101, 100, 32,
                            112, 111, 105, 110, 116, 32, 51, 94, 57, 10];
    print_str(&banner);

    let mut a: [[t27; 27]; 27] = [[0; 27]; 27];                      // N
    let mut a0: [[t27; 27]; 27] = [[0; 27]; 27];                     // N
    let mut b: [t27; 27] = [0; 27];                                  // N
    let mut x: [t27; 27] = [0; 27];                                  // N
    let mut perm: [taddr; 27] = [0; 27];                             // N
    let n: taddr = 27;                                               // N

    let mut rng = Rng { s: 20250814 };
    generate(&mut a, &mut b, &mut rng);

    // Keep the system: the factorization overwrites it, and a residual is
    // worth nothing measured against the matrix that produced the answer.
    let mut i: taddr = 0;
    while i < n {
        perm[i] = i;
        let mut j: taddr = 0;
        while j < n {
            a0[i][j] = a[i][j];
            j += 1;
        }
        i += 1;
    }

    let start = elapsed();
    let outcome = factor(&mut a, &mut perm);
    let swaps = match outcome {
        Option::Some(s) => s,
        Option::None => -1,             // a zero pivot column: singular
    };
    if swaps >= 0 {
        solve(&a, &perm, &b, &mut x);
    }
    let finish = elapsed();

    // The operation count HPL reports, computed rather than quoted: 2/3·N³
    // for the factorization and 2·N² for the two substitutions.
    let nn = n as t27;
    let ops = (2 * nn * nn * nn) / 3 + 2 * nn * nn;

    // "N="
    let l_n: [t9; 2] = [78, 61];
    print_str(&l_n);
    print_decimal(nn);
    // " ops="
    let l_ops: [t9; 5] = [32, 111, 112, 115, 61];
    print_str(&l_ops);
    print_decimal(ops);
    // " time="
    let l_t: [t9; 6] = [32, 116, 105, 109, 101, 61];
    print_str(&l_t);
    // " score="
    let l_sc: [t9; 7] = [32, 115, 99, 111, 114, 101, 61];
    // "n/a"
    let l_na: [t9; 3] = [110, 47, 97];
    let took = finish - start;
    if took == 0 {
        print_str(&l_na);
        print_str(&l_sc);
        print_str(&l_na);
    } else {
        print_decimal(took);
        print_str(&l_sc);
        // Operations per thousand units of whatever the counter counts:
        // this machine's honest analogue of a flop rate.
        print_fixed((ops * 1000 << 9) / took);
    }
    putchar(10);

    let r = residual_inf(&a0, &x, &b);
    let anorm = norm_inf_matrix(&a0);
    let xnorm = norm_inf_vector(&x);
    let scaled = scaled_residual(r, anorm, xnorm, nn);

    // "resid="
    let l_res: [t9; 6] = [114, 101, 115, 105, 100, 61];
    print_str(&l_res);
    print_fixed(scaled);
    // " swaps="
    let l_sw: [t9; 7] = [32, 115, 119, 97, 112, 115, 61];
    print_str(&l_sw);
    print_decimal(swaps);

    // Did the pivoting find the permutation `generate` planted? Row i is
    // heavy in column sigma(i), so the row that must end up at position k is
    // the one whose sigma is k — and `perm[k]` is the row that did.
    let mut pivots_ok = swaps >= 0;
    let mut k: taddr = 0;
    while k < n {
        if sigma(perm[k], n) != k {
            pivots_ok = false;
        }
        k += 1;
    }

    if pivots_ok {
        if residual_passes(r, anorm, xnorm, nn) {
            // " PASSED\n"
            let l_pass: [t9; 8] = [32, 80, 65, 83, 83, 69, 68, 10];
            print_str(&l_pass);
            return 0;
        }
    }
    // " FAILED\n"
    let l_fail: [t9; 8] = [32, 70, 65, 73, 76, 69, 68, 10];
    print_str(&l_fail);
    1
}
