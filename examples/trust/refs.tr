// refs.tr — Chapter 3, exercised.
//
// A shared reference reads and promises not to write; an exclusive one is the
// only reference to its place while it lives. An array reference coerces to a
// slice reference, which is a pointer and a length — and every index is
// bounds-checked, because a negative index is out of bounds and not
// end-relative.

struct Point { x: t27, y: t27 }

fn magnitude_squared(p: &Point) -> t27 {
    p.x * p.x + p.y * p.y        // auto-dereferenced
}

fn translate(p: &mut Point, dx: t27, dy: t27) {
    p.x += dx;
    p.y += dy;
}

fn sum(xs: &[t27]) -> t27 {
    let mut i: taddr = 0;
    let mut total: t27 = 0;
    while i < 4 {
        total += xs[i];
        i += 1;
    }
    total
}

fn scale(xs: &mut [t27], k: t27) {
    let mut i: taddr = 0;
    while i < 4 {
        xs[i] *= k;
        i += 1;
    }
}

fn main() -> t27 {
    let mut p = Point { x: 3, y: 4 };
    let m = magnitude_squared(&p);      // shared borrow, ends here
    translate(&mut p, 1, 1);            // exclusive borrow, ends here

    let mut xs: [t27; 4] = [1, 2, 3, 4];
    scale(&mut xs, 10);

    let r = &p;                         // a reference in a local
    m + r.x + sum(&xs)
}
