// -------------------------------------------------------- the system

// A linear congruential generator over the whole word — `wrapping_mul` is
// the release-profile flavor of `*`, asked for by name (Ch. 1 §4) — reduced
// into ±1 by a balanced remainder, whose range is |r| ≤ |b|/2 and so is
// exactly ±3^11 for this divisor. No fold and no bias correction.
struct Rng { s: t27 }

impl Rng {
    fn next_unit(&mut self) -> t27 {
        self.s = self.s.wrapping_mul(1103515).wrapping_add(12345);
        self.s % 354295                 // 2·3^11 + 1, so |r| ≤ 3^11
    }
}

// Where row i carries its weight. This is a permutation of the columns only
// when the multiplier is coprime with N, and it has to be one for every size
// tested: 11 is, against 29, 30 (2·3·5), 34 (2·17) and 35 (5·7). 5 is not —
// it shares a factor with two of the four, which collapses the map onto a
// fifth of the columns, leaves the rest unweighted, and produces exactly the
// small pivots the weighting exists to avoid.
fn sigma(i: taddr, n: taddr) -> taddr {
    wrap_index(11 * i + 3, n)
}

// HPL generates A at random and so does this, with one departure that is not
// cosmetic and one that is.
//
// Not cosmetic: one entry per row carries N. A uniformly random matrix has a
// condition number in the hundreds at these sizes, and fixed point has an
// *absolute* resolution rather than a relative one — so the small pivots such
// a matrix produces are exactly where 3^-11 runs out, and what comes back is
// a coin toss rather than a measurement. Weighting one entry per row buys a
// system whose residual reports the arithmetic instead of the draw.
//
// Cosmetic, but worth the two lines: the weight goes on a *permuted*
// diagonal, not the diagonal. On the diagonal, every pivot search would find
// the element already in place and the partial pivoting this benchmark is
// supposed to be doing would never once exchange a row. Permuted, it costs
// nothing in conditioning — the matrix is a row permutation of the same one —
// and the factorization has to hunt down all N of them. `main` checks that it
// found exactly the permutation planted here, which is a sharper question
// than the residual asks.
fn generate(a: &mut [[t27; NMAX]], b: &mut [t27], n: taddr, rng: &mut Rng) {
    let mut i: taddr = 0;
    while i < n {
        let mut j: taddr = 0;
        while j < n {
            a[i][j] = rng.next_unit();
            j += 1;
        }
        a[i][sigma(i, n)] += (n as t27) * ONE;
        b[i] = rng.next_unit() * (n as t27);
        i += 1;
    }
}

// ------------------------------------------- factor, solve, check

// LU with partial pivoting, in place. `perm[i]` is the original row now
// sitting at row i. Returns the number of row exchanges, or `None` if a pivot
// column was entirely zero.
fn factor(a: &mut [[t27; NMAX]], perm: &mut [taddr], n: taddr) -> Option<t27> {
    let mut swaps: t27 = 0;
    let mut k: taddr = 0;
    while k < n {
        // The largest magnitude at or below the diagonal, which is what holds
        // every multiplier below to |m| ≤ 1 — and with it the growth of the
        // entries that `fdiv`'s ceiling cares about.
        let mut best = k;
        let mut i = k + 1;
        while i < n {
            if fabs(a[i][k]) > fabs(a[best][k]) {
                best = i;
            }
            i += 1;
        }
        if a[best][k] == 0 {
            return Option::None;
        }
        if best != k {
            let mut j: taddr = 0;
            while j < n {
                let t = a[k][j];
                a[k][j] = a[best][j];
                a[best][j] = t;
                j += 1;
            }
            let t = perm[k];
            perm[k] = perm[best];
            perm[best] = t;
            swaps += 1;
        }
        // The elimination: the 2/3·N³ of the reported operation count.
        let mut r = k + 1;
        while r < n {
            let m = fdiv(a[r][k], a[k][k]);
            a[r][k] = m;
            let mut c = k + 1;
            while c < n {
                a[r][c] -= fmul(m, a[k][c]);
                c += 1;
            }
            r += 1;
        }
        k += 1;
    }
    Option::Some(swaps)
}

// Forward then back substitution — the 2·N² — with L's unit diagonal implied
// and `perm` putting the right-hand side in the order the rows ended up in.
fn solve(a: &[[t27; NMAX]], perm: &[taddr], b: &[t27], x: &mut [t27], n: taddr) {
    let mut i: taddr = 0;
    while i < n {
        let mut sum = b[perm[i]];
        let mut j: taddr = 0;
        while j < i {
            sum -= fmul(a[i][j], x[j]);
            j += 1;
        }
        x[i] = sum;
        i += 1;
    }
    let mut r = n;
    while r > 0 {
        r -= 1;
        let mut sum = x[r];
        let mut j = r + 1;
        while j < n {
            sum -= fmul(a[r][j], x[j]);
            j += 1;
        }
        x[r] = fdiv(sum, a[r][r]);
    }
}

// ‖Ax − b‖∞, against the system as it stood before the factorization ate it.
fn residual_inf(a0: &[[t27; NMAX]], x: &[t27], b0: &[t27], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut sum: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            sum += fmul(a0[i][j], x[j]);
            j += 1;
        }
        let r = fabs(sum - b0[i]);
        if r > worst {
            worst = r;
        }
        i += 1;
    }
    worst
}

fn norm_inf_matrix(a: &[[t27; NMAX]], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut row: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            row += fabs(a[i][j]);
            j += 1;
        }
        if row > worst {
            worst = row;
        }
        i += 1;
    }
    worst
}

fn norm_inf_vector(v: &[t27], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let m = fabs(v[i]);
        if m > worst {
            worst = m;
        }
        i += 1;
    }
    worst
}

// HPL's check is
//
//     ‖Ax−b‖∞ ⁄ ( eps · ( ‖x‖∞·‖A‖∞ + ‖b‖∞ ) · N )
//
// and on this machine it collapses to a single division. eps is the
// fixed-point resolution 3^-11, so eps is the value 1; writing the norm
// expression as the fixed-point value D, the whole quotient is
//
//     (R/3^11) ⁄ ( 3^-11 · (D/3^11) · N )  =  R ⁄ ((D·N) >> 11)
//
// — the residual, in ULPs, over one integer. That integer is worth computing
// once and keeping: printing the quotient and deciding the verdict then ask
// the same question two ways, and only the division can be made to lie.
fn residual_scale(anorm: t27, xnorm: t27, bnorm: t27, n: t27) -> t27 {
    let d = fmul(xnorm, anorm) + bnorm;
    (d * n) >> 11
}

// The number HPL prints, to seven places, as an integer scaled by 10^7. The
// numerator is what overflows; `checked_mul` says so rather than wrapping,
// and the fallback divides first — which loses digits of a residual that is
// already reporting a disaster, and cannot underflow there, because reaching
// it at all means R is larger than the scale by four orders of magnitude.
fn residual_e7(r: t27, scale: t27) -> t27 {
    match r.checked_mul(10000000) {
        Option::Some(v) => v / scale,
        Option::None => (r / scale).saturating_mul(10000000),
    }
}

// The verdict, deliberately not read back off the printed number: `resid < 16`
// is `R < 16·scale`, which is exact, and a comparison cannot be pushed toward
// passing by a numerator that would not fit.
fn residual_passes(r: t27, scale: t27) -> bool {
    r < scale.saturating_mul(16)
}
// ---------------------------------------------------------------- main

fn main() -> t27 {
    // HPL.dat's own four default sizes, which is why they are these.
    let sizes: [taddr; 4] = [29, 30, 34, 35];

    let mut a: [[t27; NMAX]; NMAX] = [[0; NMAX]; NMAX];
    let mut a0: [[t27; NMAX]; NMAX] = [[0; NMAX]; NMAX];
    let mut b: [t27; NMAX] = [0; NMAX];
    let mut x: [t27; NMAX] = [0; NMAX];
    let mut perm: [taddr; NMAX] = [0; NMAX];

    print_banner();

    // The N line carries every size, which is why it is not in the
    // static block with the rest of the parameters.
    // "N      :"
    let l_nrow: [t9; 8] = [78, 32, 32, 32, 32, 32, 32, 58];
    print_str(&l_nrow);
    let mut t: taddr = 0;
    while t < 4 {
        print_field(sizes[t] as t27, 8);
        putchar(32);
        t += 1;
    }
    putchar(10);
    print_params();

    // eps is 3^-11 exactly. Printing it needs no float: 10^12 divided by
    // 3^11 is its first thirteen digits, and `print_sci` puts the point
    // and the exponent where HPL's `%e` would.
    // "- The relative machine precision (eps) is taken to be"
    let l_eps: [t9; 53] = [45, 32, 84, 104, 101, 32, 114, 101, 108, 97, 116, 105, 118, 101,
                             32, 109, 97, 99, 104, 105, 110, 101, 32, 112, 114, 101, 99, 105,
                             115, 105, 111, 110, 32, 40, 101, 112, 115, 41, 32, 105, 115, 32,
                             116, 97, 107, 101, 110, 32, 116, 111, 32, 98, 101];
    print_str(&l_eps);
    print_sci(1000000000000 / ONE, -12, 7, 27);
    putchar(10);
    print_thresholds();

    let mut passed: t27 = 0;
    let mut failed: t27 = 0;
    let mut skipped: t27 = 0;

    let mut test: taddr = 0;
    while test < 4 {
        let n = sizes[test];
        let nn = n as t27;

        // Each test draws its own system, from a seed of its own, so no
        // test inherits the state the one before it left.
        let mut rng = Rng { s: 20250814 + nn * 7919 };
        generate(&mut a, &mut b, n, &mut rng);

        // Keep the system: the factorization overwrites it, and a residual
        // is worth nothing measured against the matrix that produced it.
        let mut i: taddr = 0;
        while i < n {
            perm[i] = i;
            let mut j: taddr = 0;
            while j < n {
                a0[i][j] = a[i][j];
                j += 1;
            }
            i += 1;
        }

        // The measured region: everything HPL times, and nothing else.
        let start = elapsed();
        let outcome = factor(&mut a, &mut perm, n);
        let swaps = match outcome {
            Option::Some(s) => s,
            Option::None => -1,
        };
        if swaps >= 0 {
            solve(&a, &perm, &b, &mut x, n);
        }
        let finish = elapsed();
        let cycles = finish - start;

        // 2/3·N³ for the factorization, 2·N² for the two substitutions.
        let ops = (2 * nn * nn * nn) / 3 + 2 * nn * nn;

        print_table_head();

        // The variant code. Every character of HPL's is a parameter this
        // machine has exactly one setting for: wall time, row-major, no
        // broadcast, depth zero, right-looking, one block.
        // "WR00R1R1"
        let l_tv: [t9; 8] = [87, 82, 48, 48, 82, 49, 82, 49];
        print_str(&l_tv);
        print_field(nn, 12);
        print_field(1, 6);
        print_field(1, 6);
        print_field(1, 6);
        print_ratio(cycles, CLOCK_HZ, 2, 19);
        // Gflops: operations per second, then the 10^-9. Both stay in
        // integers — `ops · CLOCK_HZ` fits a word at every size here.
        print_sci((ops * CLOCK_HZ) / cycles, -9, 4, 23);
        putchar(10);

        // HPL prints a start and end wall-clock time here. This machine
        // has no calendar and no clock; it has a count of instructions
        // retired, which is the measurement those two lines exist to
        // bracket, so it is what is printed.
        // "HPL_trsolve() start cycle"
        let l_c0: [t9; 25] = [72, 80, 76, 95, 116, 114, 115, 111, 108, 118, 101, 40, 41, 32,
                                115, 116, 97, 114, 116, 32, 99, 121, 99, 108, 101];
        print_str(&l_c0);
        print_field(start, 22);
        putchar(10);
        // "HPL_trsolve() end cycle"
        let l_c1: [t9; 23] = [72, 80, 76, 95, 116, 114, 115, 111, 108, 118, 101, 40, 41, 32,
                                101, 110, 100, 32, 99, 121, 99, 108, 101];
        print_str(&l_c1);
        print_field(finish, 24);
        putchar(10);
        print_rule(45, 80);

        let r = residual_inf(&a0, &x, &b, n);
        let scale = residual_scale(norm_inf_matrix(&a0, n),
                                   norm_inf_vector(&x, n),
                                   norm_inf_vector(&b, n), nn);

        // Did the pivoting recover the permutation `generate` planted?
        // Row i is heavy in column sigma(i), so the row belonging at
        // position k is the one whose sigma is k, and perm[k] is the one
        // that got there.
        let mut pivots_ok = swaps >= 0;
        let mut k: taddr = 0;
        while k < n {
            if sigma(perm[k], n) != k {
                pivots_ok = false;
            }
            k += 1;
        }

        // "||Ax-b||_oo/(eps*(||A||_oo*||x||_oo+||b||_oo)*N)="
        let l_res: [t9; 49] = [124, 124, 65, 120, 45, 98, 124, 124, 95, 111, 111, 47, 40, 101,
                                 112, 115, 42, 40, 124, 124, 65, 124, 124, 95, 111, 111, 42, 124,
                                 124, 120, 124, 124, 95, 111, 111, 43, 124, 124, 98, 124, 124, 95,
                                 111, 111, 41, 42, 78, 41, 61];
        print_str(&l_res);
        print_ratio(residual_e7(r, scale), 10000000, 7, 17);
        if swaps < 0 {
            // A zero pivot column: HPL's third outcome, not its second.
            // " ...... SKIPPED"
            let l_skip: [t9; 15] = [32, 46, 46, 46, 46, 46, 46, 32, 83, 75, 73, 80, 80, 69, 68];
            print_line(&l_skip);
            skipped += 1;
        } else {
            if pivots_ok && residual_passes(r, scale) {
                // " ...... PASSED"
                let l_pass: [t9; 14] = [32, 46, 46, 46, 46, 46, 46, 32, 80, 65, 83, 83, 69, 68];
                print_line(&l_pass);
                passed += 1;
            } else {
                // " ...... FAILED"
                let l_fail: [t9; 14] = [32, 46, 46, 46, 46, 46, 46, 32, 70, 65, 73, 76, 69, 68];
                print_line(&l_fail);
                failed += 1;
            }
        }
        print_rule(61, 80);
        test += 1;
    }

    putchar(10);
    // "Finished"
    let l_f0: [t9; 8] = [70, 105, 110, 105, 115, 104, 101, 100];
    print_str(&l_f0);
    print_field(4, 7);
    // " tests with the following results:"
    let l_f1: [t9; 34] = [32, 116, 101, 115, 116, 115, 32, 119, 105, 116, 104, 32, 116, 104,
                            101, 32, 102, 111, 108, 108, 111, 119, 105, 110, 103, 32, 114,
                            101, 115, 117, 108, 116, 115, 58];
    print_line(&l_f1);
    print_field(passed, 15);
    // " tests completed and passed residual checks,"
    let l_f2: [t9; 44] = [32, 116, 101, 115, 116, 115, 32, 99, 111, 109, 112, 108, 101, 116,
                            101, 100, 32, 97, 110, 100, 32, 112, 97, 115, 115, 101, 100, 32,
                            114, 101, 115, 105, 100, 117, 97, 108, 32, 99, 104, 101, 99, 107,
                            115, 44];
    print_line(&l_f2);
    print_field(failed, 15);
    // " tests completed and failed residual checks,"
    let l_f3: [t9; 44] = [32, 116, 101, 115, 116, 115, 32, 99, 111, 109, 112, 108, 101, 116,
                            101, 100, 32, 97, 110, 100, 32, 102, 97, 105, 108, 101, 100, 32,
                            114, 101, 115, 105, 100, 117, 97, 108, 32, 99, 104, 101, 99, 107,
                            115, 44];
    print_line(&l_f3);
    print_field(skipped, 15);
    // " tests skipped because of illegal input values."
    let l_f4: [t9; 47] = [32, 116, 101, 115, 116, 115, 32, 115, 107, 105, 112, 112, 101,
                            100, 32, 98, 101, 99, 97, 117, 115, 101, 32, 111, 102, 32, 105,
                            108, 108, 101, 103, 97, 108, 32, 105, 110, 112, 117, 116, 32, 118,
                            97, 108, 117, 101, 115, 46];
    print_line(&l_f4);
    print_rule(45, 80);
    putchar(10);
    // "End of Tests."
    let l_end: [t9; 13] = [69, 110, 100, 32, 111, 102, 32, 84, 101, 115, 116, 115, 46];
    print_line(&l_end);
    print_rule(61, 80);

    // The exit status is the number of tests that did not pass, so the
    // shell learns the same thing the last block of the report says.
    failed + skipped
}
