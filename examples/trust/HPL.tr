// HPL.tr — High-Performance Linpack, in Trust, on TRISC-27.
//
// The benchmark itself: a dense system per test size, LU with partial
// pivoting, a triangular solve, and HPL's own scaled residual check, reported
// in HPL's own output format. Four test sizes, which are the four HPL.dat
// ships with.
//
// What is measured and what is assumed
// ------------------------------------
// `elapsed()` reads the cycle counter (ISA §2.3, device −9) and returns
// instructions retired. That number is real, and the difference of two
// readings is exactly the cost of the code between them.
//
// Seconds are not real. TRISC-27 defines no clock rate — there is no such
// thing as a second on this machine — and HPL's format is built around them,
// so `CLOCK_HZ` below is an invention: one instruction per cycle at 1 MHz.
// It is the only made-up number in this file, it is a single constant, and
// every Time and Gflops printed is that constant away from the honest
// measurement. The residual check does not touch it. When TRISC-27 acquires
// a defined rate, change that one line.
//
// Arithmetic
// ----------
// Fixed point at scale 3^11, so eps is 3^-11 ≈ 5.64e-6, printed in the
// header the way HPL prints a machine epsilon. There is no floating point on
// this machine (AM §7).
//
// `fmul` is exact for any product whose *result* fits, because `mulh` gives
// the high half of the 54-trit product and the two halves recombine with no
// rounding but the final one. What is *not* available is a widening divide,
// and that is what fixes the scale at 3^11 rather than higher: `fdiv` forms
// `a << 11` before dividing, so it needs |a| below 3^(26.5−22), about 121 —
// comfortable for values that reach N, and the reason 3^12 is not on offer.
//
// Rescaling itself is free of apology: `x >> 11` *is* division by 3^11 under
// round-to-nearest, no tie case, no fixup (Ch. 1 §4).
//
// Text
// ----
// Every line of this file's output used to be a hand-encoded array of ASCII
// decimal with the text in a comment above it, because string literals did
// not print. They do now (Ch. 5 §1.5), so the text is the text — 224 lines
// shorter, and the comment can no longer disagree with what is printed.
//
// `putchar` survives in exactly four places, all of them inside the digit
// loops, and that is the boundary rather than an oversight: formatting a
// number is what Ch. 5 §7 does not define, so the loops below *are* the
// formatter, and the bottom of a formatter is where a value becomes a
// character. Going through `char` there would mean `char::try_from(48 + d)`
// and an `unwrap` per digit — a check that cannot fail, paid for once per
// character printed. Everything a human wrote down is a string literal, and
// everything that is one character is `print_char`.

fn putchar(c: t9);

// Instructions retired since reset. The body is in `examples/trisc/runtime.t27`,
// which reads device −9; the difference of two readings needs nothing
// subtracted for the measurement, since reading through a call adds the same
// instructions to both.
fn elapsed() -> t27;

const NMAX: taddr = 35;         // the largest test; every array is this size
const ONE: t27 = 177147;        // 3^11, the fixed-point unit
const HI: t27 = 43046721;       // 3^(27−11), for recombining a wide product

// The invented number. See the header.
const CLOCK_HZ: t27 = 1000000;

// ------------------------------------------------------------- printing

fn print_rule(c: char, n: taddr) {
    let mut i: taddr = 0;
    while i < n {
        print_char(c);
        i += 1;
    }
    print_char('\n');
}

fn spaces(n: taddr) {
    let mut i: taddr = 0;
    while i < n {
        print_char(' ');
        i += 1;
    }
}

// Division rounding toward zero. `/` rounds to nearest (Ch. 1 §4), which is
// what arithmetic wants and what a digit loop must not have.
fn div_floor(a: t27, b: t27) -> t27 {
    let q = a / b;
    if q * b > a { q - 1 } else { q }
}

fn decimal_width(v: t27) -> taddr {
    let mut n = if v < 0 { -v } else { v };
    let mut w: taddr = if v < 0 { 2 } else { 1 };
    while n >= 10 {
        n = div_floor(n, 10);
        w += 1;
    }
    w
}

fn print_decimal(value: t27) {
    let mut n = value;
    if n < 0 {
        print_char('-');
        n = -n;
    }
    if n == 0 {
        print_char('0');
        return;
    }
    let mut digits: [t9; 16] = [0; 16];
    let mut i: taddr = 0;
    while n > 0 {
        digits[i] = (n % 10) as t9;
        n = n / 10;
        if digits[i] < 0 {              // the balanced remainder's one price
            digits[i] += 10;
            n -= 1;
        }
        i += 1;
    }
    while i > 0 {
        i -= 1;
        putchar(digits[i] + 48);
    }
}

// Right-aligned in a field, which is how every column of HPL's table is set.
fn print_field(v: t27, width: taddr) {
    spaces(width - decimal_width(v));
    print_decimal(v);
}

// `whole.frac` with `places` digits after the point, right-aligned.
fn print_ratio(num: t27, den: t27, places: taddr, width: taddr) {
    let whole = div_floor(num, den);
    let mut rest = num - whole * den;
    let mut w = decimal_width(whole) + 1 + places;
    spaces(width - w);
    print_decimal(whole);
    print_char('.');                        // '.'
    let mut k: taddr = 0;
    while k < places {
        rest = rest * 10;
        let d = div_floor(rest, den);
        putchar((d as t9) + 48);
        rest -= d * den;
        k += 1;
    }
}

// `v · 10^exp_off` as `d.ddde±NN`, which is HPL's `%e`. Normalizing in
// integers costs nothing here: shifting the decimal point is multiplying or
// dividing by ten, and the exponent is a running count of how often.
fn print_sci(v: t27, exp_off: t27, digits: taddr, width: taddr) {
    spaces(width - (digits + 5));
    if v == 0 {
        print_char('0');
        print_char('.');
        let mut z: taddr = 1;
        while z < digits {
            print_char('0');
            z += 1;
        }
        print("e+00");
        return;
    }
    let mut m = if v < 0 { -v } else { v };
    let mut e: t27 = 0;
    let mut lo: t27 = 1;
    let mut k: taddr = 1;
    while k < digits {
        lo = lo * 10;
        k += 1;
    }
    let hi = lo * 10;
    while m >= hi {
        m = div_floor(m, 10);
        e += 1;
    }
    while m < lo {
        m = m * 10;
        e -= 1;
    }
    if v < 0 {
        print_char('-');
    }
    // The mantissa, one digit before the point and the rest after it.
    let lead = div_floor(m, lo);
    putchar((lead as t9) + 48);
    print_char('.');
    let mut rest = m - lead * lo;
    let mut place = lo;
    let mut j: taddr = 1;
    while j < digits {
        place = div_floor(place, 10);
        let d = div_floor(rest, place);
        putchar((d as t9) + 48);
        rest -= d * place;
        j += 1;
    }
    print_char('e');                       // 'e'
    let mut ex = e + (digits as t27) - 1 + exp_off;
    if ex < 0 {
        print_char('-');
        ex = -ex;
    } else {
        print_char('+');
    }
    if ex < 10 {
        print_char('0');
    }
    print_decimal(ex);
}

// ---------------------------------------------------------- fixed point

// The exact product, rescaled. `mulh` is the high 27 trits of the 54-trit
// product and `wrapping_mul` is the low 27 (TIR §3.2: the two reconstruct P
// exactly), so this is P >> 11 with one rounding, not two — and it does not
// care how large P was, only that the answer fits.
fn fmul(a: t27, b: t27) -> t27 {
    a.mulh(b) * HI + (a.wrapping_mul(b) >> 11)
}

// The other direction, and the one with a ceiling: there is no widening
// divide, so `a << 11` must fit, which holds for |a| up to about 121.
fn fdiv(a: t27, b: t27) -> t27 {
    (a << 11) / b
}

fn fabs(x: t27) -> t27 {
    if x < 0 { -x } else { x }
}

fn wrap_index(v: taddr, n: taddr) -> taddr {
    let r = v % n;
    if r < 0 { r + n } else { r }
}
fn print_banner() {
    print_rule('=', 80);
    println("HPL-Trust 0.1  --  High-Performance Linpack  --  balanced ternary machine");
    println("An independent implementation in the output format of HPLinpack 2.3 (A.");
    println("Petitet, R. C. Whaley, J. Dongarra and A. Cleary, Innovative Computing");
    println("Laboratory, UTK).  Not their code, not validated by them, and not IEEE");
    println("double -- this machine has no floating point at all.  See eps below.");
    print_rule('=', 80);
    print_char('\n');
    println("An explanation of the input/output parameters follows:");
    println("T/V    : Wall time / encoded variant.");
    println("N      : The order of the coefficient matrix A.");
    println("NB     : The partitioning blocking factor.");
    println("P      : The number of process rows.");
    println("Q      : The number of process columns.");
    println("Time   : Time in seconds to solve the linear system.");
    println("Gflops : Rate of execution for solving the linear system.");
    print_char('\n');
    println("The following parameter values will be used:");
    print_char('\n');
}

fn print_params() {
    println("NB     :       1 ");
    println("PMAP   : Row-major process mapping");
    println("P      :       1 ");
    println("Q      :       1 ");
    println("PFACT  :    Right");
    println("NBMIN  :       1 ");
    println("NDIV   :       1 ");
    println("RFACT  :    Right");
    println("BCAST  :     none");
    println("DEPTH  :       0 ");
    println("SWAP   : Binary-exchange");
    println("L1     : no-transpose form");
    println("U      : no-transpose form");
    println("EQUIL  :      no");
    println("ALIGN  : 3 trytes");
    print_char('\n');
    print_rule('-', 80);
    print_char('\n');
    println("- The matrix A is pseudo-randomly generated for each test, and then one");
    println("  entry per row is weighted by N: fixed point has an absolute resolution,");
    println("  not a relative one, so an unweighted random matrix at these sizes reports");
    println("  its own condition number rather than this machine's arithmetic.");
    println("- The following scaled residual check will be computed:");
    println("      ||Ax-b||_oo / ( eps * ( || x ||_oo * || A ||_oo + || b ||_oo ) * N )");
}

fn print_thresholds() {
    println("- Computational tests pass if scaled residuals are less than                16.0");
    print_char('\n');
    print_rule('=', 80);
}

fn print_table_head() {
    println("T/V                N    NB     P     Q               Time                 Gflops");
    print_rule('-', 80);
}

// -------------------------------------------------------- the system

// A linear congruential generator over the whole word — `wrapping_mul` is
// the release-profile flavor of `*`, asked for by name (Ch. 1 §4) — reduced
// into ±1 by a balanced remainder, whose range is |r| ≤ |b|/2 and so is
// exactly ±3^11 for this divisor. No fold and no bias correction.
struct Rng { s: t27 }

impl Rng {
    fn next_unit(&mut self) -> t27 {
        self.s = self.s.wrapping_mul(1103515).wrapping_add(12345);
        self.s % 354295                 // 2·3^11 + 1, so |r| ≤ 3^11
    }
}

// Where row i carries its weight. This is a permutation of the columns only
// when the multiplier is coprime with N, and it has to be one for every size
// tested: 11 is, against 29, 30 (2·3·5), 34 (2·17) and 35 (5·7). 5 is not —
// it shares a factor with two of the four, which collapses the map onto a
// fifth of the columns, leaves the rest unweighted, and produces exactly the
// small pivots the weighting exists to avoid.
fn sigma(i: taddr, n: taddr) -> taddr {
    wrap_index(11 * i + 3, n)
}

// HPL generates A at random and so does this, with one departure that is not
// cosmetic and one that is.
//
// Not cosmetic: one entry per row carries N. A uniformly random matrix has a
// condition number in the hundreds at these sizes, and fixed point has an
// *absolute* resolution rather than a relative one — so the small pivots such
// a matrix produces are exactly where 3^-11 runs out, and what comes back is
// a coin toss rather than a measurement. Weighting one entry per row buys a
// system whose residual reports the arithmetic instead of the draw.
//
// Cosmetic, but worth the two lines: the weight goes on a *permuted*
// diagonal, not the diagonal. On the diagonal, every pivot search would find
// the element already in place and the partial pivoting this benchmark is
// supposed to be doing would never once exchange a row. Permuted, it costs
// nothing in conditioning — the matrix is a row permutation of the same one —
// and the factorization has to hunt down all N of them. `main` checks that it
// found exactly the permutation planted here, which is a sharper question
// than the residual asks.
fn generate(a: &mut [[t27; NMAX]], b: &mut [t27], n: taddr, rng: &mut Rng) {
    let mut i: taddr = 0;
    while i < n {
        let mut j: taddr = 0;
        while j < n {
            a[i][j] = rng.next_unit();
            j += 1;
        }
        a[i][sigma(i, n)] += (n as t27) * ONE;
        b[i] = rng.next_unit() * (n as t27);
        i += 1;
    }
}

// ------------------------------------------- factor, solve, check

// LU with partial pivoting, in place. `perm[i]` is the original row now
// sitting at row i. Returns the number of row exchanges, or `None` if a pivot
// column was entirely zero.
fn factor(a: &mut [[t27; NMAX]], perm: &mut [taddr], n: taddr) -> Option<t27> {
    let mut swaps: t27 = 0;
    let mut k: taddr = 0;
    while k < n {
        // The largest magnitude at or below the diagonal, which is what holds
        // every multiplier below to |m| ≤ 1 — and with it the growth of the
        // entries that `fdiv`'s ceiling cares about.
        let mut best = k;
        let mut i = k + 1;
        while i < n {
            if fabs(a[i][k]) > fabs(a[best][k]) {
                best = i;
            }
            i += 1;
        }
        if a[best][k] == 0 {
            return Option::None;
        }
        if best != k {
            let mut j: taddr = 0;
            while j < n {
                let t = a[k][j];
                a[k][j] = a[best][j];
                a[best][j] = t;
                j += 1;
            }
            let t = perm[k];
            perm[k] = perm[best];
            perm[best] = t;
            swaps += 1;
        }
        // The elimination: the 2/3·N³ of the reported operation count.
        let mut r = k + 1;
        while r < n {
            let m = fdiv(a[r][k], a[k][k]);
            a[r][k] = m;
            let mut c = k + 1;
            while c < n {
                a[r][c] -= fmul(m, a[k][c]);
                c += 1;
            }
            r += 1;
        }
        k += 1;
    }
    Option::Some(swaps)
}

// Forward then back substitution — the 2·N² — with L's unit diagonal implied
// and `perm` putting the right-hand side in the order the rows ended up in.
fn solve(a: &[[t27; NMAX]], perm: &[taddr], b: &[t27], x: &mut [t27], n: taddr) {
    let mut i: taddr = 0;
    while i < n {
        let mut sum = b[perm[i]];
        let mut j: taddr = 0;
        while j < i {
            sum -= fmul(a[i][j], x[j]);
            j += 1;
        }
        x[i] = sum;
        i += 1;
    }
    let mut r = n;
    while r > 0 {
        r -= 1;
        let mut sum = x[r];
        let mut j = r + 1;
        while j < n {
            sum -= fmul(a[r][j], x[j]);
            j += 1;
        }
        x[r] = fdiv(sum, a[r][r]);
    }
}

// ‖Ax − b‖∞, against the system as it stood before the factorization ate it.
fn residual_inf(a0: &[[t27; NMAX]], x: &[t27], b0: &[t27], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut sum: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            sum += fmul(a0[i][j], x[j]);
            j += 1;
        }
        let r = fabs(sum - b0[i]);
        if r > worst {
            worst = r;
        }
        i += 1;
    }
    worst
}

fn norm_inf_matrix(a: &[[t27; NMAX]], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let mut row: t27 = 0;
        let mut j: taddr = 0;
        while j < n {
            row += fabs(a[i][j]);
            j += 1;
        }
        if row > worst {
            worst = row;
        }
        i += 1;
    }
    worst
}

fn norm_inf_vector(v: &[t27], n: taddr) -> t27 {
    let mut worst: t27 = 0;
    let mut i: taddr = 0;
    while i < n {
        let m = fabs(v[i]);
        if m > worst {
            worst = m;
        }
        i += 1;
    }
    worst
}

// HPL's check is
//
//     ‖Ax−b‖∞ ⁄ ( eps · ( ‖x‖∞·‖A‖∞ + ‖b‖∞ ) · N )
//
// and on this machine it collapses to a single division. eps is the
// fixed-point resolution 3^-11, so eps is the value 1; writing the norm
// expression as the fixed-point value D, the whole quotient is
//
//     (R/3^11) ⁄ ( 3^-11 · (D/3^11) · N )  =  R ⁄ ((D·N) >> 11)
//
// — the residual, in ULPs, over one integer. That integer is worth computing
// once and keeping: printing the quotient and deciding the verdict then ask
// the same question two ways, and only the division can be made to lie.
fn residual_scale(anorm: t27, xnorm: t27, bnorm: t27, n: t27) -> t27 {
    let d = fmul(xnorm, anorm) + bnorm;
    (d * n) >> 11
}

// The number HPL prints, to seven places, as an integer scaled by 10^7. The
// numerator is what overflows; `checked_mul` says so rather than wrapping,
// and the fallback divides first — which loses digits of a residual that is
// already reporting a disaster, and cannot underflow there, because reaching
// it at all means R is larger than the scale by four orders of magnitude.
fn residual_e7(r: t27, scale: t27) -> t27 {
    match r.checked_mul(10000000) {
        Option::Some(v) => v / scale,
        Option::None => (r / scale).saturating_mul(10000000),
    }
}

// The verdict, deliberately not read back off the printed number: `resid < 16`
// is `R < 16·scale`, which is exact, and a comparison cannot be pushed toward
// passing by a numerator that would not fit.
fn residual_passes(r: t27, scale: t27) -> bool {
    r < scale.saturating_mul(16)
}
// ---------------------------------------------------------------- main

fn main() -> t27 {
    // HPL.dat's own four default sizes, which is why they are these.
    let sizes: [taddr; 4] = [29, 30, 34, 35];

    let mut a: [[t27; NMAX]; NMAX] = [[0; NMAX]; NMAX];
    let mut a0: [[t27; NMAX]; NMAX] = [[0; NMAX]; NMAX];
    let mut b: [t27; NMAX] = [0; NMAX];
    let mut x: [t27; NMAX] = [0; NMAX];
    let mut perm: [taddr; NMAX] = [0; NMAX];

    print_banner();

    // The N line carries every size, which is why it is not in the
    // static block with the rest of the parameters.
    print("N      :");
    let mut t: taddr = 0;
    while t < 4 {
        print_field(sizes[t] as t27, 8);
        print_char(' ');
        t += 1;
    }
    print_char('\n');
    print_params();

    // eps is 3^-11 exactly. Printing it needs no float: 10^12 divided by
    // 3^11 is its first thirteen digits, and `print_sci` puts the point
    // and the exponent where HPL's `%e` would.
    print("- The relative machine precision (eps) is taken to be");
    print_sci(1000000000000 / ONE, -12, 7, 27);
    print_char('\n');
    print_thresholds();

    let mut passed: t27 = 0;
    let mut failed: t27 = 0;
    let mut skipped: t27 = 0;

    let mut test: taddr = 0;
    while test < 4 {
        let n = sizes[test];
        let nn = n as t27;

        // Each test draws its own system, from a seed of its own, so no
        // test inherits the state the one before it left.
        let mut rng = Rng { s: 20250814 + nn * 7919 };
        generate(&mut a, &mut b, n, &mut rng);

        // Keep the system: the factorization overwrites it, and a residual
        // is worth nothing measured against the matrix that produced it.
        let mut i: taddr = 0;
        while i < n {
            perm[i] = i;
            let mut j: taddr = 0;
            while j < n {
                a0[i][j] = a[i][j];
                j += 1;
            }
            i += 1;
        }

        // The measured region: everything HPL times, and nothing else.
        let start = elapsed();
        let outcome = factor(&mut a, &mut perm, n);
        let swaps = match outcome {
            Option::Some(s) => s,
            Option::None => -1,
        };
        if swaps >= 0 {
            solve(&a, &perm, &b, &mut x, n);
        }
        let finish = elapsed();
        let cycles = finish - start;

        // 2/3·N³ for the factorization, 2·N² for the two substitutions.
        let ops = (2 * nn * nn * nn) / 3 + 2 * nn * nn;

        print_table_head();

        // The variant code. Every character of HPL's is a parameter this
        // machine has exactly one setting for: wall time, row-major, no
        // broadcast, depth zero, right-looking, one block.
        print("WR00R1R1");
        print_field(nn, 12);
        print_field(1, 6);
        print_field(1, 6);
        print_field(1, 6);
        print_ratio(cycles, CLOCK_HZ, 2, 19);
        // Gflops: operations per second, then the 10^-9. Both stay in
        // integers — `ops · CLOCK_HZ` fits a word at every size here.
        print_sci((ops * CLOCK_HZ) / cycles, -9, 4, 23);
        print_char('\n');

        // HPL prints a start and end wall-clock time here. This machine
        // has no calendar and no clock; it has a count of instructions
        // retired, which is the measurement those two lines exist to
        // bracket, so it is what is printed.
        print("HPL_trsolve() start cycle");
        print_field(start, 22);
        print_char('\n');
        print("HPL_trsolve() end cycle");
        print_field(finish, 24);
        print_char('\n');
        print_rule('-', 80);

        let r = residual_inf(&a0, &x, &b, n);
        let scale = residual_scale(norm_inf_matrix(&a0, n),
                                   norm_inf_vector(&x, n),
                                   norm_inf_vector(&b, n), nn);

        // Did the pivoting recover the permutation `generate` planted?
        // Row i is heavy in column sigma(i), so the row belonging at
        // position k is the one whose sigma is k, and perm[k] is the one
        // that got there.
        let mut pivots_ok = swaps >= 0;
        let mut k: taddr = 0;
        while k < n {
            if sigma(perm[k], n) != k {
                pivots_ok = false;
            }
            k += 1;
        }

        print("||Ax-b||_oo/(eps*(||A||_oo*||x||_oo+||b||_oo)*N)=");
        print_ratio(residual_e7(r, scale), 10000000, 7, 17);
        if swaps < 0 {
            // A zero pivot column: HPL's third outcome, not its second.
            println(" ...... SKIPPED");
            skipped += 1;
        } else {
            if pivots_ok && residual_passes(r, scale) {
                println(" ...... PASSED");
                passed += 1;
            } else {
                println(" ...... FAILED");
                failed += 1;
            }
        }
        print_rule('=', 80);
        test += 1;
    }

    print_char('\n');
    print("Finished");
    print_field(4, 7);
    println(" tests with the following results:");
    print_field(passed, 15);
    println(" tests completed and passed residual checks,");
    print_field(failed, 15);
    println(" tests completed and failed residual checks,");
    print_field(skipped, 15);
    println(" tests skipped because of illegal input values.");
    print_rule('-', 80);
    print_char('\n');
    println("End of Tests.");
    print_rule('=', 80);

    // The exit status is the number of tests that did not pass, so the
    // shell learns the same thing the last block of the report says.
    failed + skipped
}
