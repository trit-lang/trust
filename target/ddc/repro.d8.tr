pub struct Def {
    pub name: String,
    pub field_names: Vec<String>,
}


fn take(defs: Vec<Def>) -> taddr {
    let n = defs[0].field_names.len();
    defs.len() + n
}

fn main() -> t27 {
    let mut defs: Vec<Def> = Vec::new();
    defs.push(Def { name: "a".to_string(), field_names: Vec::new() });
    take(defs) as t27
}
