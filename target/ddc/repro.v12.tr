pub struct Taken {
    pub tok: t27,
    pub at: taddr,
}

pub struct Error {
    pub at: taddr,
}

pub struct Pair {
    pub x: t27,
    pub y: t27,
}

pub enum Choice {
    A(Pair),
    B,
}

pub enum Narrow {
    C(t27),
    D,
}


pub fn pick2() -> Narrow {
    Narrow::C(7)
}

fn main() -> t27 {
    match pick2() {
        Narrow::C(n) => n,
        Narrow::D => 0,
    }
}
