pub struct Def {
    pub name: String,
    pub field_names: Vec<String>,
}


fn first_name(defs: &Vec<Def>) -> String {
    defs[0].name.to_string()
}

fn main() -> t27 {
    let mut defs: Vec<Def> = Vec::new();
    defs.push(Def { name: "a".to_string(), field_names: Vec::new() });
    first_name(&defs).len() as t27
}
