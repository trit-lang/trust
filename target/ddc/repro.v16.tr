pub struct Taken {
    pub tok: t27,
    pub at: taddr,
}

pub struct Error {
    pub at: taddr,
}

pub enum G<A> {
    Gx(A),
    Gy,
}


pub fn give() -> G<Taken> {
    let t = Taken { tok: 1, at: 2 };
    G::Gx(t)
}

fn main() -> t27 {
    match give() {
        G::Gx(t) => t.tok,
        G::Gy => 0,
    }
}
