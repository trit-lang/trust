pub struct Inst2 {
    pub full: String,
    pub base: String,
    pub key: Vec<String>,
}

pub struct Em2 {
    pub instances: Vec<Inst2>,
    pub ty: String,
}

fn copy_names(from: &Vec<String>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(from[i].to_string());
        i += 1;
    }
    out
}


fn f(e: &Em2, inst: taddr) -> String {
    let base = if inst < 0 { "x".to_string() } else { e.instances[0].base.to_string() };
    base
}

fn main() -> t27 {
    let mut instances: Vec<Inst2> = Vec::new();
    0
}
