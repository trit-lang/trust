fn probe(ops: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut cur: String = Vec::new();
    let mut i: taddr = 0;
    while i < ops.len() {
        if ops[i] == ',' {
            out.push(cur);
            cur = Vec::new();
        } else {
            cur.push(ops[i]);
        }
        i += 1;
    }
    out
}
fn main() -> t27 {
    let xs = probe("a,b,c");
    println_int(xs.len() as t27);
    0
}
