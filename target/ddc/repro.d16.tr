pub struct Def {
    pub name: String,
    pub field_names: Vec<String>,
}


fn take(defs: Vec<Def>) -> t27 {
    let mut s = "b".to_string();
    s.push_str(&defs[0].name);
    0
}

fn main() -> t27 {
    let mut defs: Vec<Def> = Vec::new();
    defs.push(Def { name: "a".to_string(), field_names: Vec::new() });
    take(defs) as t27
}
