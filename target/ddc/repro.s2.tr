pub enum Ty {
    Name(t27),
    Unit,
    Ref(Box<Ty>),
    Slice(Vec<String>),
    Seq(Vec<Ty>),
}

pub struct Pair<V> {
    pub a: V,
    pub b: Vec<V>,
}

pub enum Errs<E> {
    Bad(E),
    Plain(taddr),
}

fn unwrap_ty(v: Option<Ty>) -> Ty { v.unwrap() }
fn unwrap_opt_ty(v: Option<Option<Ty>>) -> Option<Ty> { v.unwrap() }
fn unwrap_res(v: Result<Ty, Errs<Ty>>) -> Ty { v.unwrap() }

fn match_owned(e: Ty) -> t27 {
    match e {
        Ty::Name(v) => v,
        Ty::Unit => 0,
        Ty::Ref(inner) => match_owned(*inner),
        Ty::Slice(xs) => xs.len() as t27,
        Ty::Seq(xs) => xs.len() as t27,
    }
}

fn move_match(v: Option<Ty>) -> t27 {
    match v {
        Option::Some(t) => match_owned(t),
        Option::None => 0,
    }
}

fn try_join(p: &mut t27) -> t27 {
    let v: Vec<Ty> = Vec::new();
    match v.into_iter().next() {
        Option::Some(t) => match_owned(t),
        Option::None => 2,
    }
}

fn grow<V>(p: Pair<V>) -> t27 {
    p.b.len() as t27
}

fn via_map(v: Vec<t27>) -> t27 {
    let a: t27 = v.into_iter().map(|x| *x + 1).filter(|x| *x > 2).sum();
    a
}

fn via_closure(v: Vec<t27>, q: t27) -> t27 {
    v.into_iter().filter(|x| *x > q).product()
}

fn written(v: Vec<Ty>) -> t27 {
    let mut acc: t27 = 0;
    let mut cur = Ty::Unit;
    for x in v.into_iter() {
        cur = Ty::Name(acc);
        acc = acc + match_owned(*x);
    }
    acc
}

fn through() -> t27 {
    let mut xs: Vec<Ty> = Vec::new();
    xs.push(Ty::Unit);
    xs.push(Ty::Name(3));
    xs.push(Ty::Seq(Vec::new()));
    let saved = xs[0];
    move_match(Option::Some(saved))
}

fn main() -> t27 {
    let mut n: t27 = 2;
    let a = move_match(Option::Some(Ty::Name(7)));
    let b = try_join(&mut n);
    let c = through();
    let d = via_map(Vec::new());
    let e = via_closure(Vec::new(), 1);
    let f = written(Vec::new());
    let g = unwrap_opt_ty(Option::Some(Option::Some(Ty::Unit)));
    let p: Pair<Ty> = Pair { a: Ty::Unit, b: Vec::new() };
    a + b + c + d + e + f + grow(p) + move_match(g)
}
