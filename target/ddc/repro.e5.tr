pub struct Def {
    pub name: String,
    pub field_names: Vec<String>,
}


fn first_same(defs: &Vec<Def>, w: &str) -> bool {
    let n = &defs[0].name;
    n.same(w)
}

fn main() -> t27 {
    let mut defs: Vec<Def> = Vec::new();
    defs.push(Def { name: "a".to_string(), field_names: Vec::new() });
    if first_same(&defs, "a") {
        return 1;
    }
    0
}
