pub enum Ty {
    Name(Vec<String>),
    Ref(Box<Ty>, bool),
    Tuple(Vec<Ty>),
}

pub fn is_str(t: &Ty) -> bool {
    match t {
        Ty::Name(segments) => {
            segments.len() == 1
        }
        _ => false,
    }
}

fn main() -> t27 {
    let v: Vec<String> = Vec::new();
    let t = Ty::Name(v);
    if is_str(&t) {
        return 1;
    }
    0
}
