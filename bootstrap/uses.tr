// Pass two of Ch. 6 §4, run: what every `use` in a program reaches.
//
//     trust bundle <root.tr> | trust run bootstrap/uses.tr
//
// One line per `use` — `<module> <as written> -> <full name>`, or `!` and
// the one word for the rule that refused it. A refusal is reported by rule
// and not by wording, because two implementations should agree about the
// language and need not agree about a sentence.

mod ast;
mod bundle;
mod input;
mod lex;
mod parse;
mod resolve;

fn main() -> t27 {
    let src = input::read_all();
    let mods = bundle::split(&src);
    let mut w = resolve::World { modules: Vec::new(), defined: Vec::new(), sources: Vec::new() };
    let mut files: Vec<Vec<ast::Item>> = Vec::new();

    // Pass one first — a `use` cannot be resolved before it is known what
    // the program defines, and that is a fact about every module at once.
    let mut i: taddr = 0;
    while i < mods.len() {
        let here = resolve::plain(&mods[i].path);
        w.sources.push(here.to_string());
        files.push(read(&mods[i], &mut w, &here));
        i += 1;
    }

    let mut f: taddr = 0;
    while f < files.len() {
        let here = resolve::plain(&mods[f].path);
        let mut k: taddr = 0;
        while k < files[f].len() {
            match &files[f][k].what {
                ast::What::Use(segments) => report(&w, &mods[f].path, &here, segments),
                _ => {}
            }
            k += 1;
        }
        f += 1;
    }
    0
}

/// One module, parsed, with what it defines added to the world.
fn read(m: &bundle::Module, w: &mut resolve::World, here: &str) -> Vec<ast::Item> {
    let mut p = parse::Parser { src: m.text.to_string(), at: 0, no_struct: false };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut k: taddr = 0;
            while k < items.len() {
                resolve::gather(w, here, &items[k]);
                k += 1;
            }
            items
        }
        Result::Err(err) => {
            print("error ");
            print(&m.path);
            print(" ");
            print_int(err.at as t27);
            println("");
            let empty: Vec<ast::Item> = Vec::new();
            empty
        }
    }
}

/// One `use`, and what it reached.
fn report(w: &resolve::World, shown: &str, here: &str, segments: &Vec<String>) {
    let written = resolve::rejoin(segments);
    print(shown);
    print(" ");
    print(&written);
    match resolve::lookup(w, here, "", segments) {
        Result::Ok(found) => {
            if found.taken == segments.len() {
                print(" -> ");
                println(&found.full);
            } else {
                // `use a::E::V;` reaches the enum and stops: a `use` names
                // an item or a module, not something inside one (§3.2).
                println(" ! deep");
            }
        }
        Result::Err(why) => {
            print(" ! ");
            println(&why);
        }
    }
}
