// The Trust parser, run over a whole file on stdin, printed one item a line.

mod ast;
mod lex;
mod parse;

fn getchar() -> t9;

fn main() -> t27 {
    let src = read_all();
    let mut p = parse::Parser { src: src, at: 0, no_struct: false };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut i: taddr = 0;
            while i < items.len() {
                let mut out: String = Vec::new();
                ast::show_item(&items[i], &mut out);
                println(&out);
                i += 1;
            }
            0
        }
        Result::Err(err) => {
            print("error ");
            print_int(err.at as t27);
            println("");
            0
        }
    }
}

/// Everything on stdin, as text.
fn read_all() -> String {
    let mut out: String = Vec::new();
    loop {
        let b = next_byte();
        if b < 0 {
            return out;
        }
        let extra = if b < 128 { 0 } else if b < 224 { 1 } else if b < 240 { 2 } else { 3 };
        let mut v = if extra == 0 {
            b
        } else if extra == 1 {
            b - 192
        } else if extra == 2 {
            b - 224
        } else {
            b - 240
        };
        let mut k = 0;
        while k < extra {
            let c = next_byte();
            if c < 0 {
                return out;
            }
            v = v * 64 + (c - 128);
            k += 1;
        }
        out.push(char::try_from(v).unwrap());
    }
}

/// One code unit, or −1 when the input has ended (ISA §2.2).
fn next_byte() -> t27 {
    loop {
        let c = getchar() as t27;
        if c == 0 - 2 {
            return 0 - 1;
        }
        if c >= 0 {
            return c;
        }
    }
}
