// A program that uses the **library**, which is handed over rather than
// written here (Ch. 6 §3.3): `Option` is the prelude's, its `unwrap_or` is
// the prelude's generic method, and what reaches the module is one
// instantiation of it per type asked for.
//
// The rest of the prelude is not in the program, because nothing calls it —
// which the two implementations have to agree about as much as they agree
// about what is.

// An `if` whose value is an aggregate builds each arm into the storage the
// caller gave, because there is no value to join: an aggregate *is* its
// storage (TIR §3).
fn pick(n: t27) -> Option<t27> {
    if n > 0 {
        Option::Some(n)
    } else {
        Option::None
    }
}

fn some(n: t27) -> Option<t27> { Option::Some(n) }

fn none() -> Option<t27> {
    let out: Option<t27> = Option::None;
    out
}

fn main() -> t27 {
    let a: Option<t27> = Option::Some(7);
    let b: Option<t27> = Option::None;
    let c = some(3);
    let f = pick(5);
    let g = pick(0);
    let d = none();
    let e: Option<t9> = Option::Some(1);
    a.unwrap_or(0) + b.unwrap_or(1) + c.unwrap_or(2) + d.unwrap_or(4)
        + (e.unwrap_or(1) as t27) + f.unwrap_or(5) + g.unwrap_or(6)
}
