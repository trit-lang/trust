// A closure written for a `Fn` bound, which is a closure that need not say
// what its own types are. Ch. 4 §4.1 lets both be left out and §4.3 says why
// they can be: the bound settles the signature its parameter names, and one
// signature is all a closure has.
//
// So what is compared here is inference and not spelling. Every closure below
// is written the short way, and the types under it come from the parameter it
// was handed to.

// `impl Fn(…)` — the anonymous parameter, which is Ch. 4 §2.2's `impl` in
// argument position and nothing more.
fn twice(f: impl Fn(t27) -> t27, x: t27) -> t27 {
    f(f(x))
}

// The same bound with the name written down. §4.3 says nothing after the
// grammar can tell the two apart, so this had better lower to the same shape
// as the one above — the only difference being the name in the mangling.
fn once<F: Fn(t27) -> t27>(f: F, x: t27) -> t27 {
    f(x)
}

// Nothing to take and nothing to say about what it takes.
fn asked(f: impl Fn() -> t27) -> t27 {
    f()
}

fn added() -> t27 {
    twice(|a| a + 1, 3)
}

fn doubled() -> t27 {
    once(|a| a + a, 4)
}

fn given() -> t27 {
    asked(|| 7)
}

// A capture, which is the other half of a closure: the closure's type is a
// struct of the addresses of the places it names from around it (§4.4), and
// none of that is written either.
fn held() -> t27 {
    let n = 10;
    once(|a| a + n, 1)
}

// The prelude's own `fold`, over the prelude's own `Range` — a generic that
// takes a closure, instantiated at a closure type this file invented. The
// closure is lowered before the range is, because a call cannot say what `F`
// is until it has one, and what is lowered first takes its storage first.
fn summed() -> t27 {
    fold(0..5, 0, |a, b| a + b)
}

fn main() -> t27 {
    added() + doubled() + given() + held() + summed()
}
