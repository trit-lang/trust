// Where a scope ends, and what it owed (Ch. 3 §1.4).
//
// A local whose type has a destructor is dropped when its scope ends. Which
// scope, and where the drop is *written*, is the whole of this file — and
// until it was asked, one implementation dropped at exactly one place, the
// tail of a function that answers with a value, and leaked everywhere else.
//
// The order is the same everywhere and it is not the order it reads in:
// **what the scope answers with is computed first, and the drops go after
// it**. `r.room()` reads the room while the room is still there.

// A function that answers with **nothing** still drops what it owned. There
// is no value to read first, so the drops are the whole of its end.
fn nothing(n: taddr) {
    let r: Raw<t27> = Raw::alloc(n);
}

// Two of them, dropped innermost first — which is declaration order
// reversed, and is what makes the second one's storage still be there while
// the first is let go.
fn two(n: taddr) {
    let a: Raw<t9> = Raw::alloc(n);
    let b: Raw<t27> = Raw::alloc(n);
}

// A `return` leaves along **one path** while the scope's other paths still
// own the same values, so the drops are written at the `return` and again
// at the tail, and nothing is retired at either.
fn early(n: taddr) -> taddr {
    let r: Raw<t27> = Raw::alloc(n);
    if n > 0 {
        return 1;
    }
    r.room()
}

// The same, with something to answer: the answer is read before the room
// it was read out of is freed.
fn early_value(n: taddr) -> taddr {
    let r: Raw<t27> = Raw::alloc(n);
    if n > 0 {
        return r.room();
    }
    0
}

// A local owned **inside a loop** is dropped when the body ends — once per
// iteration, before the jump back to the head. Dropping it once after the
// loop would free the last iteration's room and leak every other.
fn each(n: taddr) -> taddr {
    let mut i: taddr = 0;
    while i < n {
        let r: Raw<t27> = Raw::alloc(1);
        i += 1;
    }
    i
}

// An arm of an `if` **that has a value**: the arm's value first, then the
// arm's drops, then the store into the storage the join reads.
fn armed(n: taddr) -> taddr {
    if n > 0 {
        let r: Raw<t27> = Raw::alloc(n);
        r.room()
    } else {
        0
    }
}

// An arm of an `if` that is a **statement**, where there is no value and
// the drops are all there is between the last statement and the join.
fn armed_statement(n: taddr) -> taddr {
    if n > 0 {
        let r: Raw<t27> = Raw::alloc(n);
    }
    n
}

// A function whose answer is an **aggregate** writes it into the storage
// the caller gave and then answers with nothing — so the drops go between
// the last store into `%sret` and the `ret`.
struct Pair { a: taddr, b: taddr }

fn built(n: taddr) -> Pair {
    let r: Raw<t27> = Raw::alloc(n);
    Pair { a: r.room(), b: 1 }
}

// An arm of a `match`, which is an arm like any other — its block is a
// block, and a block is where a scope ends.
enum Pick { One, Two }

fn picked(p: Pick, n: taddr) -> taddr {
    match p {
        Pick::One => {
            let r: Raw<t27> = Raw::alloc(n);
            r.room()
        }
        Pick::Two => 0,
    }
}

// A block written for no reason but to be one. It is still a scope.
fn nested(n: taddr) -> taddr {
    let held = {
        let r: Raw<t27> = Raw::alloc(n);
        r.room()
    };
    held
}

// And a type with a destructor rather than a `Raw`, so that what a scope
// ends with is a **call** and not a freeing written out in place.
struct Held { room: Raw<t27>, n: taddr }

fn holds(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    if n > 0 {
        return h.n;
    }
    h.n
}

// A parameter taken **by value** owns what it was given (Ch. 3 §1.2): the
// caller handed the value over and this frame is where it dies. So it takes
// the same flag an owned local takes, and takes it *before* the value
// arrives — what the flag says is whether the fields are still there, and
// they are from the moment the function is entered.
fn taken(h: Held) -> taddr {
    h.n
}

fn hands_over(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    taken(h)
}

// And an arm that moves it away and then **leaves**. A path that returns
// says nothing about the paths that did not, so `h` is still owned where
// the program goes on from — and the drop at the tail is written plainly,
// with no flag read, because on the only path that reaches it nothing was
// given up.
fn given_away(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    if n > 0 {
        return taken(h);
    }
    h.n
}

// And the one case a flag was ever made for: two paths that come out the
// other end **disagreeing** about who owns what. Neither the drop nor the
// no-drop is right where the program cannot say which, so the drop is
// written under a test of the flag — the only place anything reads one.
fn maybe_gone(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    let mut k: taddr = 0;
    if n > 0 {
        k = taken(h);
    }
    k
}

// The same question asked of an `if` that **has a value**, where the arms
// are two expressions rather than two blocks of statements.
fn maybe_valued(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    let k: taddr = if n > 0 { taken(h) } else { n };
    k
}

// And of a `match`, where there may be more than two paths and what comes
// after the join is what **all** of them agreed about.
fn maybe_picked(p: Pick, n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    let k: taddr = match p {
        Pick::One => taken(h),
        Pick::Two => n,
    };
    k
}

// Both paths giving it up is not a doubt at all: they agree, so nothing is
// dropped and no flag is read. It is the same join answering `No`.
fn both_ways(n: taddr) -> taddr {
    let h = Held { room: Raw::alloc(n), n: 1 };
    let mut k: taddr = 0;
    if n > 0 {
        k = taken(h);
    } else {
        k = taken(h);
    }
    k
}

// A statement that already **left** has no next one: the `return` is the
// end of the block and what is written after it is code nobody can reach.
// Nothing of it is lowered — an instruction is not text there — while the
// *name* it would have taken still takes its number, exactly as a slot in
// dead code is visible in the entry where the store into it is not
// (G9.166). The block is still checked, because dead code is still code;
// it is the lowering that stops.
fn gone(n: taddr) -> taddr {
    let r: Raw<t27> = Raw::alloc(n);
    return r.room();
    n + 1
}

// A field is not the whole of what it names: moving `two.a` out leaves
// `two.b`, and what is dropped when the scope ends is what is left, a
// field at a time (Ch. 3 §1.3) — recorded where the whole local's moves
// already were.
struct Two { a: Raw<t27>, b: Raw<t27> }

fn field_two(n: taddr) -> taddr {
    let two = Two { a: Raw::alloc(n), b: Raw::alloc(n) };
    let a = two.a;
    a.room()
}

// And the type's own glue is the *whole* value's and no part's: a field
// taken out of a type with a destructor is not the destructor's business
// any more, and what remains is dropped a field at a time without it
// (Ch. 3 §1.4).
struct Owning { a: Raw<t27>, b: Raw<t27> }
impl Drop for Owning { fn drop(self) { } }

fn field_of_owning(n: taddr) -> taddr {
    let owes = Owning { a: Raw::alloc(n), b: Raw::alloc(n) };
    let a = owes.a;
    a.room() + owes.b.room()
}

// A `for` ends the name it iterates: `into_iter(self)` is a receiver taken
// by value, which is a move again and not a copy — what the scope owns after
// the loop is the iterator, not the collection (Ch. 3 §1.2). The flag's
// `store t1 0` is the only drop the collection ever owed (Ch. 3 §1.4).
fn for_ends(n: taddr) -> taddr {
    let mut items: Vec<Raw<t27>> = Vec::new();
    items.push(Raw::alloc(n));
    let mut seen: taddr = 0;
    for r in items {
        seen += r.room();
    }
    seen
}

enum Turn { Left, Right }

// An arm that leaves is never asked what it answers with (G9.159), and a
// match whose *every* arm left has no join to gather at: control never
// arrives, so there is no join to start and nothing after the match at
// all (G9.166).
fn turning(t: Turn) -> taddr {
    match t {
        Turn::Left => return 1,
        Turn::Right => return 2,
    }
}

fn main() -> t27 {
    nothing(1);
    two(2);
    let p = built(3);
    (early(1) + early_value(1) + each(2) + armed(1) + armed_statement(1)
        + p.a + p.b + picked(Pick::One, 1) + nested(1) + holds(1)
        + hands_over(1) + given_away(1) + maybe_gone(1) + maybe_valued(1)
        + maybe_picked(Pick::Two, 1) + both_ways(1)
        + gone(1) + turning(Turn::Left) + field_two(1) + field_of_owning(1)
        + for_ends(1)) as t27
}
