// The heap, at its bottom: `Raw<T>` (Ch. 5 §2.7).
//
// `Raw` is the **compiler's** and not the library's, and for one reason: it
// answers with a *pointer*, and this language has no way to write one. Which
// is what lets everything above it be ordinary Trust — `Vec`, `Box` and
// `String` are library code, and a second implementation compiles them
// rather than reproducing them (docs/ddc.md §3.4).
//
// It is two words: where the room is, and how many positions it has. Nothing
// says what is *in* those positions — a `Raw` does not know what it holds,
// which is why its destructor frees the room and drops nothing.
//
// *`Raw::new()`* is no room at all, which is two zeroes. Which `T` it is of
// is what the written type says, because nothing in the call does.
//
// *`Raw::alloc(n)`* is `n` times the size of a `T` — trapping on overflow,
// because a count whose size in trytes is not a number has not asked for
// anything — and then the target's `alloc`. The answer comes back as an
// address and is compared against zero as a **number**, which is why it goes
// through storage on the way: TIR has no other way to read one width as
// another, and a null is the allocator saying no.
//
// *The destructor* is written out where the binding dies rather than called:
// there is no `impl Drop for Raw` to call, because `Raw` is not a type the
// library wrote. A `Raw` with no allocation frees nothing, which is what the
// null test is for and what makes `Raw::new()` free.
//
// And two declarations, which is what a program that reaches the heap owes
// its target (Ch. 5 §2.1). Both are written down and whichever nothing calls
// is dropped, exactly as any other declaration is — `empty` below never
// allocates, so a program that only called it would owe `free` and not
// `alloc`.

fn empty() -> taddr {
    let r: Raw<t27> = Raw::new();
    r.room()
}

// A word each, so the size the allocator is asked for is three times the
// count and the alignment is three.
fn words(n: taddr) -> taddr {
    let r: Raw<t27> = Raw::alloc(n);
    r.room()
}

// A tryte each, where the size is the count and the alignment is one — so
// that what is passed to `alloc` is read off the element type and not
// assumed.
fn trytes(n: taddr) -> taddr {
    let r: Raw<t9> = Raw::alloc(n);
    r.room()
}

// Two of them alive at once, dropped innermost first.
fn both(n: taddr) -> taddr {
    let a: Raw<t9> = Raw::alloc(n);
    let b: Raw<t27> = Raw::alloc(n);
    a.room() + b.room()
}

// The four that are one question — where the `i`th position is — and then a
// load, a store, or the address itself. Checked, because there is no reason
// for this to be the one index that is not (Ch. 2 §3): at the room or above
// it is a fault, and so is below zero, which is two tests and two traps.
fn stored(n: taddr) -> t27 {
    let mut r: Raw<t27> = Raw::alloc(n);
    r.write(0, 7);
    r.write(1, 8);
    r.read(0) + r.read(1)
}

// A tryte each, so the arithmetic that finds a position is read off the
// element type here too.
fn narrow(n: taddr) -> t9 {
    let mut r: Raw<t9> = Raw::alloc(n);
    r.write(0, 1);
    r.read(0)
}

// `at` answers with the address itself, which is what a reference **is**
// (Ch. 3 §2.1) — so what comes back is read through and not loaded twice.
fn pointed(n: taddr) -> t27 {
    let mut r: Raw<t27> = Raw::alloc(n);
    r.write(0, 9);
    let p = r.at(0);
    *p
}

// An index that is not written down, so the two tests are against a value
// and not a constant.
fn computed(n: taddr, i: taddr) -> t27 {
    let mut r: Raw<t27> = Raw::alloc(n);
    r.write(i, 3);
    r.read(i)
}

// A type that *holds* one owns a destructor for the same reason it holds
// one (Ch. 3 §1.2) — and nobody wrote this one. It is generated: the same
// prologue a written `impl Drop` gets, and then the fields' destructors, in
// declaration order. `Held` has no `impl Drop` anywhere.
struct Held { room: Raw<t27>, n: taddr }

fn made() -> Held {
    Held { room: Raw::alloc(2), n: 0 }
}

fn holds() -> taddr {
    let h = made();
    h.n + h.room.room()
}

// A binding whose value is an aggregate **literal** that holds a `Raw`.
//
// The literal's storage was made for this binding and nothing else names
// it, so it is taken rather than copied out of — and taking it is a
// *rename*. The `Raw` inside is a temporary of its own, which is what makes
// this the smallest program that catches a rename replacing a run of
// characters rather than a name: `%tmp.slot.1` is the beginning of
// `%tmp.slot.10`, and renaming the first renamed the second as well.
fn literal() -> taddr {
    let h = Held { room: Raw::alloc(1), n: 4 };
    h.n
}

// One that holds a type that holds one, so the glue calls glue.
struct Twice { inner: Held, k: taddr }

fn nested() -> taddr {
    let t = Twice { inner: made(), k: 1 };
    t.k
}

// And the same over a **family**, which is where the glue has to be made
// under a key: `drop.Room.t27` is `drop.Room` read at `t27`, and the key is
// known where the drop is written and nowhere else (Ch. 4 §2.5).
struct Room<T> { held: Raw<T>, n: taddr }

impl<T> Room<T> {
    // A static method of a family has no receiver to read its key off, so
    // it comes from what the binding was written as — and it answers with
    // an aggregate, which is storage the caller provides (TIR §3).
    fn new() -> Room<T> { Room { held: Raw::new(), n: 0 } }

    fn keep(n: taddr) -> Room<T> { Room { held: Raw::alloc(n), n: 0 } }

    fn len(&self) -> taddr { self.n }

    // Answering with **nothing**, which is a third thing a call does with
    // its answer and was refused until now.
    fn bump(&mut self) { self.n += 1; }

    fn put(&mut self, at: taddr, value: T) { self.held.write(at, value); }

    fn get(&self, at: taddr) -> T { self.held.read(at) }
}

fn kept() -> taddr {
    let mut r: Room<t27> = Room::keep(4);
    r.put(0, 5);
    r.bump();
    r.len() + (r.get(0) as taddr)
}

fn spare() -> taddr {
    let r: Room<t9> = Room::new();
    r.len()
}

// Assigning an **aggregate** to a field, which is three things and not one:
// where the field is, what is going into it, and what was already there.
// The last is dropped *first* — Ch. 3 §1.1 gives a value one owner and one
// drop, so storing over it would leak the room it held.
//
// And reading `fresh` is a **move**: a name in value position hands the
// value over, which is the one thing a place cannot do twice (Ch. 3 §1.2).
// The flag that says whether it is still there is written down here, and
// what the scope drops at its end is what still owns something.
//
// It is `Vec::regrow` in miniature — allocate, move, let the old room go —
// and it is the shape the library is written in.
struct Bin<T> { held: Raw<T>, n: taddr }

impl<T> Bin<T> {
    fn start(n: taddr) -> Bin<T> { Bin { held: Raw::alloc(n), n: 0 } }

    fn regrow(&mut self, want: taddr) {
        let fresh: Raw<T> = Raw::alloc(want);
        self.held = fresh;
        self.n = 0;
    }

    fn room(&self) -> taddr { self.held.room() }
}

// A destructor somebody **wrote**, on a family. It is one function per key
// like every other method of one (Ch. 4 §2.5), and the impl it is written
// in cannot emit it: what asks for `drop.Bin.t27` is a `Bin<t27>` going out
// of scope and not a call, so the key is known where the drop is written
// and nowhere else. Leaving it to the fields alone would emit a
// `drop.Bin.t27` that silently skipped the body.
//
// Its body **loops**, which no destructor here did before: a `while` in
// last position is a block-shaped expression, so the parser puts it in the
// tail — and a destructor answers with nothing, so its tail is a statement
// (§5.1). Reading it as a value refused every destructor that did anything.
impl<T> Drop for Bin<T> {
    fn drop(self) {
        let mut i: taddr = 0;
        while i < self.n {
            let held = self.held.read(i);
            i += 1;
        }
    }
}

fn regrown() -> taddr {
    let mut b: Bin<t27> = Bin::start(2);
    b.regrow(5);
    b.room()
}

// The same fact about a tail, on a type that is not a family and a body
// that branches rather than loops.
struct Counted { room: Raw<t27>, n: taddr }

impl Drop for Counted {
    fn drop(self) {
        if self.n > 0 {
            let held = self.room.read(0);
        }
    }
}

fn counted() -> taddr {
    let c = Counted { room: Raw::alloc(1), n: 0 };
    c.n
}

// And an aggregate into a field where nothing owns anything: the copy on
// its own, with no drop before it and no flag to clear.
struct Pair { a: taddr, b: taddr }
struct Holder { p: Pair, k: taddr }

fn replaced() -> taddr {
    let mut h = Holder { p: Pair { a: 1, b: 2 }, k: 3 };
    h.p = Pair { a: 4, b: 5 };
    h.p.a + h.k
}

// An **enum** that holds something with a destructor (Ch. 2 §5).
//
// It has no one set of fields — which set it has depends on which variant
// it holds — so what is dropped is decided when it runs: the discriminant
// read once, a test per variant, and every arm ending at one join. A
// variant that carries nothing to drop still gets its arm; it is where the
// test that ruled it in goes, and the arm is empty.
//
// And this is where a `Raw`'s **niche** matters. A `raw.<T>` is a `Raw<T>`
// under the name the lowering gives it, and it is the same type: two words
// with neither of them spare, because the address may be null and a `Raw`
// with no allocation is exactly that (Ch. 5 §2.7). Its first word is
// written down as an address — that is what it is copied as — and reading
// its fields would say there was a value to spare, which would give this
// enum a discriminant with no space and no tag to read.
enum Either { Nothing, Room(Bin<t27>), Number(taddr) }

fn wrapped(n: taddr) -> taddr {
    let held = Either::Room(Bin::start(n));
    match held {
        Either::Nothing => 0,
        Either::Room(r) => r.room(),
        Either::Number(k) => k,
    }
}

// And one whose arm keeps what it bound rather than carrying it on: the
// binding is that arm's to drop, and it is dropped **after** the answer has
// been stored, because the answer was read out of it.
fn held_on(n: taddr) -> taddr {
    let held = Either::Room(Bin::start(n));
    match held {
        Either::Nothing => 0,
        Either::Room(r) => r.room() + 1,
        Either::Number(k) => k,
    }
}

// `_` — the arm that matches whatever the tests ruled out (§5.4).
//
// It is not tested: it is the block the last test falls through to, which
// is the same shape the arm carrying a niche's payload gets and for the
// same reason. And there is no trap after it, because control does arrive
// there — which is the whole of what "exhaustive" means once one is
// written.
fn either_way(n: taddr) -> taddr {
    let held = Either::Room(Bin::start(n));
    match held {
        Either::Room(r) => r.room(),
        _ => 0,
    }
}

// Matching **through a reference** (Ch. 3 §2.3). The scrutinee is read
// through, and then nothing is moved: what is at the other end belongs to
// whoever it points at.
//
// So an arm's binding is not a copy either. A scalar is — a copy of one is
// the same value and nothing can be lost — but anything that owns something
// is bound as the **place** it names, because a copy of a `Bin` would be a
// second header over one allocation and dropping it would free a room
// somebody is still holding.
fn looked_at(held: &Either) -> taddr {
    match held {
        Either::Nothing => 0,
        Either::Room(r) => r.room(),
        Either::Number(k) => k,
    }
}

fn borrowed(n: taddr) -> taddr {
    let held = Either::Room(Bin::start(n));
    looked_at(&held)
}

fn main() -> t27 {
    (empty() + words(4) + trytes(9) + both(2)) as t27
        + stored(2) + (narrow(1) as t27) + pointed(1) + computed(3, 1)
        + (holds() as t27) + (literal() as t27) + (nested() as t27)
        + (kept() as t27) + (spare() as t27)
        + (regrown() as t27) + (counted() as t27) + (replaced() as t27)
        + (wrapped(2) as t27) + (held_on(2) as t27)
        + (either_way(2) as t27) + (borrowed(2) as t27)
}
