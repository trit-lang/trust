// `Box<T>` — one word that owns what it points at (Ch. 5 §2.3).
//
// It is the compiler's for the same reason `Raw<T>` is: it answers with a
// *pointer*, and this language has no way to write one. And it is `Raw`'s
// smaller sibling — one allocation of exactly one `T`, so there is no count
// beside the address and no arithmetic to find a position.
//
// Which makes it **one word and not two**, and that is the difference that
// matters: a `Raw` is an aggregate and is copied field by field, and a
// `Box` is a scalar and is *stored*. What it holds is not in its type as
// TIR sees it — TIR says `ptr` — so what it is a box *of* is carried in the
// name the lowering gives it, the way a `Raw`'s element is.
//
// It is what makes a **recursive** type possible (Ch. 2 §8): a type cannot
// hold itself, but it can hold an address of itself, and the address is a
// word whatever is at the other end.

enum Tree { Leaf(t27), Pair(Box<Tree>, Box<Tree>) }

// `Box::new(v)` is three steps and they are `Raw::alloc`'s three: the value
// somewhere first, then the room for exactly one of it, then the value into
// the room. The allocator saying no is a trap, because a program that has
// nowhere to put something has nothing else to do (Ch. 5 §2.1).
fn leaf(n: t27) -> Tree {
    Tree::Leaf(n)
}

fn pair(n: t27) -> Tree {
    Tree::Pair(Box::new(leaf(n)), Box::new(leaf(n + 1)))
}

// Reading through one. A `Box` owns what it holds, so reaching through it
// is a place it gives exclusively — there is nothing to borrow and nothing
// to check.
fn depth(t: &Tree) -> t27 {
    match t {
        Tree::Leaf(v) => 1,
        Tree::Pair(a, b) => 2,
    }
}

// And dropping one, which is the step a `Raw`'s destructor does not have:
// what it points at is dropped **first**, and then the room goes. A `Raw`
// frees the room and drops nothing, because a `Raw` does not know what is
// in it; a `Box` does.
fn built(n: t27) -> t27 {
    let t = pair(n);
    depth(&t)
}

// A `Box` of something with no destructor of its own still frees its room:
// what it owns is the *allocation*, and that is true whatever is in it.
fn plain(n: t27) -> t27 {
    let b: Box<t27> = Box::new(n);
    *b
}

// One that holds a structure, so that what goes into the room is copied
// field by field and what comes back out is read through.
struct Held { a: t27, b: t27 }

fn structured(n: t27) -> t27 {
    let h: Box<Held> = Box::new(Held { a: n, b: n + 1 });
    (*h).a + (*h).b
}

// And **walking** one, which is what a recursive type is for and what the
// three lines above stop short of.
//
// `&*a` is the box read as the address it already is: one load, and the
// name it takes says `%v`, because the program asked for the reference
// itself. Reaching through one nobody wrote — `a.n`, `a[i]` — is a step on
// the way to a place and takes `%p`. The instruction is the same either way
// and the name is not, and the name is what is compared (G9.154).
//
// Every arm here answers with nothing, written both ways: `out.push('l')`
// is a call whose type is `()`, and `{ … }` with no tail has no type at
// all. They mean the same thing, and an implementation carrying a type as
// text has to be told so (G9.155).
fn tag(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => out.push('l'),
        Tree::Pair(a, b) => out.push('p'),
    }
}

// One arm ends in a `while`. A block-shaped expression written last in a
// block is where the parser puts it — the tail — and is still a statement,
// which is the reading a loop body already gives its own tail (G9.156).
fn show(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => {
            let mut k = v;
            while k > 0 {
                out.push('1');
                k -= 1;
            }
        }
        Tree::Pair(a, b) => {
            out.push('(');
            show(&*a, out);
            out.push('+');
            show(&*b, out);
            out.push(')');
        }
    }
}

// And an arm can end in an `if` or a `match` the same way: §5.1 draws no
// line between the block-shapes, so their being statements where nothing
// is wanted is not a decision to be taken one shape at a time (G9.157).
fn signed(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => {
            if v > 0 {
                out.push('+');
            } else {
                out.push('0');
            }
        }
        Tree::Pair(a, b) => {
            let sub = &*a;
            match sub {
                Tree::Leaf(l) => out.push('l'),
                Tree::Pair(x, y) => out.push('p'),
            }
        }
    }
}

// Nor between the loops. `drained` ends an arm in a `loop` whose `break`
// is not its last word, so the jump back to the head has an edge to take;
// `halt` ends one in a `loop` whose body *is* its last word, and there is
// nowhere to jump back from — the jump would hang off a block nobody falls
// into, and dead text is still text. The text is what is compared
// (G9.158).
fn drained(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => out.push('.'),
        Tree::Pair(a, b) => {
            let mut k = 1;
            loop {
                if k > 1 {
                    break;
                }
                k += 1;
            }
        }
    }
}

fn halt(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => out.push('.'),
        Tree::Pair(a, b) => {
            loop {
                break;
            }
        }
    }
}

// The same economy in statement position: a `while` body ending in
// `break`, a `loop` whose body is one, and a nested block written as a
// statement — which wants nothing in the *other* spelling, with no `()`
// to say so, and answers with nothing either way (G9.158, G9.155).
fn settled(out: &mut String) {
    let mut k = 0;
    while k > 0 {
        out.push('w');
        break;
    }
    loop {
        break;
    }
    {
        out.push('a');
    }
    {
        if k > 0 {
            out.push('i');
        } else {
            out.push('n');
        }
    }
    out.push('d');
}

// And the borrow does not have to be named first: `match &c` says at the
// `match` what `let r = &c; match r` says in two steps — the arms look at
// what it points at and move nothing, so the scrutinee's place is the
// referent's own and there is no reference lowered as a value anywhere
// (Ch. 0 §5.4, Ch. 3 §2.3).
fn peeked(t: &Tree, out: &mut String) {
    match t {
        Tree::Leaf(v) => out.push('.'),
        Tree::Pair(a, b) => {
            let c = leaf(0);
            match &c {
                Tree::Leaf(l) => out.push('l'),
                Tree::Pair(x, y) => out.push('p'),
            }
        }
    }
}

// A `Box` can be **handed over**: one word is the parameter, stored like
// a scalar's at the door, and what it owns travels with it — the flag an
// owned local takes is what the end of the scope reads (Ch. 5 §2.3,
// G9.167). The match over the word is the move the box is for (G9.161).
fn taken(b: Box<Tree>, out: &mut String) {
    match *b {
        Tree::Leaf(l) => out.push('l'),
        Tree::Pair(x, y) => out.push('p'),
    }
}

// And one that is never opened at all: the flag is still `1` where the
// scope ends, so the word and the tree behind it are dropped there —
// the box's own freedom nobody else had to ask for.
fn spared(n: t27) -> t27 {
    let b: Box<Tree> = Box::new(pair(n));
    n
}

// A bare name where the pattern stands is the catch-all with a handle:
// nothing to test and no variant to select, so the name binds the whole
// of what is matched (Ch. 0 §4). Through a reference the name is a copy
// the referent still owns — and nothing of the copy is dropped — and it
// is a copy still, one word and then the next (G9.164).
fn caught(n: t27, out: &mut String) {
    let t = pair(n);
    match &t {
        x => {
            tag(&x, out);
            depth(&x);
        }
    }
    match t {
        x => {
            tag(&x, out);
            depth(&x);
        }
    }
}

fn walked(n: t27) -> t27 {
    let t = pair(n);
    let mut out: String = Vec::new();
    tag(&t, &mut out);
    show(&t, &mut out);
    signed(&t, &mut out);
    drained(&t, &mut out);
    halt(&t, &mut out);
    settled(&mut out);
    peeked(&t, &mut out);
    taken(Box::new(pair(n)), &mut out);
    let c = spared(n);
    caught(n, &mut out);
    c + out.len() as t27
}

fn main() -> t27 {
    built(1) + plain(2) + structured(3) + walked(1)
}
