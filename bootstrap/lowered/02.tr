fn f(a: t27, b: t9) -> t27 {
    let x = a + 1;
    let y: t9 = b;
    return x;
}
fn g() -> t9 { 7 }
fn h(a: t27) -> t27 { f(a, g()) }
fn u(a: t27) { }
fn widths(a: taddr, b: bool, c: char, d: trit) -> taddr {
    let x = a * 2;
    let y = a - 1;
    x
}
fn t() -> bool { true }
fn n() -> trit { 0t }
fn nested(a: t27) -> t27 { (a + 1) * (a - 2) }

// `let _ = e;` binds nothing a program can name, and it is a **binding**
// all the same: the value is dropped where any other one would be, at the
// end of the scope rather than at the end of the statement. So it is given
// a name no program can write — `#` is not an identifier character — and
// the parser counts them, which is what puts a number on each (§5.2).
fn discarded(a: t27) -> t27 {
    let _ = a + 1;
    let _ = a + 2;
    let kept = a + 3;
    let _ = kept;
    kept
}
