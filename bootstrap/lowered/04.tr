fn pick(a: t27) -> t27 { if a > 0 { 1 } else { 2 } }
fn nested(a: t27, b: t27) -> t27 {
    if a > b { if a > 0 { a } else { b } } else { 0 }
}
fn chain(a: t27) -> t27 {
    if a > 2 { 3 } else if a > 1 { 2 } else { 1 }
}
fn counted(a: t27) -> t27 {
    let mut n = a;
    let mut total = 0;
    while n > 0 {
        total = total + n;
        n = n - 1;
    }
    total
}
fn both(a: t27) -> t27 {
    let mut n = a;
    while n > 0 {
        n = if n > 10 { n - 10 } else { n - 1 };
    }
    n
}

// Three shapes this file had never had, and every one of them is in the
// first loop over text anybody writes (G9.98–G9.101).

// An `if` that is a **statement**: no value, so no slot to join in and
// nothing to load afterwards. The blocks are the same three all the same,
// and an arm that has already left does not jump to the join as well.
fn guard(a: t27) -> t27 {
    if a < 0 {
        return 0;
    }
    a + 1
}

// The same with an `else`, and one with neither arm leaving — so that what
// is compared is the `br` at the end of each and not only the `ret`.
fn either(a: t27) -> t27 {
    let mut n = a;
    if n > 0 {
        n = n + 1;
    } else {
        n = n - 1;
    }
    if n > 100 {
        n = 100;
    }
    n
}

// `n += 1` is `n = n + 1`: the same load, the same arithmetic, the same
// store, which is why it is lowered by being written that way.
fn stepped(a: t27) -> t27 {
    let mut n = a;
    n += 1;
    n -= 2;
    n *= 3;
    let mut i = 0;
    while i < 4 {
        n += i;
        i += 1;
    }
    n
}

// Two literals compared. A comparison answers `bool` whatever it compares,
// so what is around it says nothing about how wide its operands are — and
// `1 != 2` inside a condition had been comparing two *trits*, which is not
// a width either literal fits (Ch. 0 §5.2).
fn literals() -> t27 {
    if 1 != 2 {
        return 5;
    }
    if 7 > 3 { 1 } else { 0 }
}

// Two more, and both are one line of TIR (G9.103, G9.104).

// `-x` needs no flavor and no fixup: the range is symmetric, so
// `MIN == -MAX` and there is nothing for a negation to overflow (Ch. 1 §4).
// A binary machine's compiler has to say more here than this one does.
fn negated(a: t27) -> t27 {
    let mut n = a;
    if n < 0 {
        n = -n;
    }
    -n + -(a - 1)
}

// A function that answers with **nothing** and whose last expression is a
// statement all the same. `while` has no value, so it is not the block's
// answer — it is the last thing the block does, and what says so is the
// answer the function was written with and not the shape of the tail
// (§5.1).
fn counted_down(a: t27) {
    let mut i = a;
    while i > 0 {
        i -= 1;
    }
}

// The same with a call that answers with nothing, which is the other shape
// a unit tail comes in.
fn passes_on(a: t27) {
    counted_down(a)
}
