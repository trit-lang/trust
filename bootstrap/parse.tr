// The parser (Ch. 0 §2), in Trust.
//
// Recursive descent with the precedence table of §2.1, which is where the
// mutual recursion is: `expr` calls `binary` calls `unary` calls `primary`
// calls `expr`. A compiler is that shape all the way down, and it is what
// found the inliner unrolling a call cycle without bound (G9.28).

// A `use` is absolute — resolved from the root (Ch. 6 §3.1) — which is how
// this module names its siblings at all.
use ast;
use ast::Expr;
use lex;
use lex::Tok;

/// Where the parser is, and what it is reading.
pub struct Parser {
    pub src: String,
    pub at: taddr,
    /// Set where a `{` would be a block and not a struct literal — the
    /// condition of an `if` or a `while` (§2.8). The ambiguity is real and
    /// the flag is how both parsers resolve it.
    pub no_struct: bool,
}

/// The next token, without consuming it.
///
/// It takes the shared reference it needs, and every caller holds the
/// exclusive one — which is accepted where a shared one is wanted (Ch. 3
/// §2.3a). Draft 0.1 had no such rule, and this said `&mut` and meant `&`.
pub fn peek(p: &Parser) -> Result<lex::Taken, lex::Error> {
    lex::one(&p.src, p.at)
}

/// The next token, consumed.
pub fn bump(p: &mut Parser) -> Result<Tok, lex::Error> {
    let t = lex::one(&p.src, p.at)?;
    p.at = t.at;
    Result::Ok(t.tok)
}

/// A whole expression: assignment, which is §2.1's loosest level and is
/// right-associative.
pub fn expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    let left = binary(p, 1)?;
    let t = peek(p)?;
    let next = t.at;
    let op = match t.tok {
        Tok::Op(o) => o,
        _ => return Result::Ok(left),
    };
    if !ast::assigns(&op) {
        return Result::Ok(left);
    }
    p.at = next;
    let right = expr(p)?;
    Result::Ok(Expr::Assign(op, Box::new(left), Box::new(right)))
}

/// The left-associative levels, loosest first.
pub fn binary(p: &mut Parser, min: taddr) -> Result<Expr, lex::Error> {
    let mut left = unary(p)?;
    loop {
        let t = peek(p)?;
        // Ownership is tracked per local and not per place, so taking the
        // payload out of `t.tok` marks all of `t` moved — including `t.at`.
        // Reading the position first is the whole of the workaround, and it
        // is what `docs/status.md` §11 says to expect.
        let next = t.at;
        let op = match t.tok {
            Tok::Op(o) => o,
            _ => return Result::Ok(left),
        };
        let l = ast::level(&op);
        if l < min || l == 0 {
            return Result::Ok(left);
        }
        p.at = next;
        let right = binary(p, l + 1)?;
        left = Expr::Binary(op, Box::new(left), Box::new(right));
    }
}

/// A primary, and whatever follows it: `.f`, `.m(args)` (§2.6).
pub fn postfix(p: &mut Parser) -> Result<Expr, lex::Error> {
    let mut e = primary(p)?;
    loop {
        let t = peek(p)?;
        let next = t.at;
        let op = match t.tok {
            Tok::Op(o) => o,
            Tok::Kw(k) => k,
            _ => return Result::Ok(e),
        };
        if op.same("[") {
            p.at = next;
            let at = expr(p)?;
            expect_op(p, "]")?;
            e = Expr::Index(Box::new(e), Box::new(at));
            continue;
        }
        if op.same("?") {
            p.at = next;
            e = Expr::Try(Box::new(e));
            continue;
        }
        if op.same("as") {
            p.at = next;
            let ty = type_name(p)?;
            e = Expr::Cast(Box::new(e), ty);
            continue;
        }
        if !op.same(".") {
            return Result::Ok(e);
        }
        p.at = next;
        let name = ident(p)?;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let is_call = match t2.tok {
            Tok::Op(o) => o.same("("),
            _ => false,
        };
        if is_call {
            p.at = at2;
            let args = arguments(p)?;
            e = Expr::Method(Box::new(e), name, args);
        } else {
            e = Expr::Field(Box::new(e), name);
        }
    }
}

/// `-e`, `!e`, or a postfix chain.
pub fn unary(p: &mut Parser) -> Result<Expr, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Op(o) => {
            if o.same("-") || o.same("!") {
                p.at = next;
                let inner = unary(p)?;
                return Result::Ok(Expr::Unary(o, Box::new(inner)));
            }
            if o.same("&") || o.same("&&") {
                // `&&e` lexes as the logical-and by maximal munch, and only
                // this position knows it is two borrows. The second `&` is
                // left for the next turn, exactly as a type does it.
                if o.same("&&") {
                    p.at = next - 1;
                } else {
                    p.at = next;
                }
                let t2 = peek(p)?;
                let at2 = t2.at;
                let mutable = match t2.tok {
                    Tok::Kw(k) => k.same("mut"),
                    _ => false,
                };
                if mutable {
                    p.at = at2;
                }
                let inner = unary(p)?;
                return Result::Ok(Expr::Borrow(Box::new(inner), mutable));
            }
            if o.same("*") {
                p.at = next;
                let inner = unary(p)?;
                return Result::Ok(Expr::Deref(Box::new(inner)));
            }
            postfix(p)
        }
        _ => postfix(p),
    }
}

/// Whether an expression is written with braces, and so may stand as a
/// statement without a `;` (§5.1).
pub fn block_shaped(e: &Expr) -> bool {
    match e {
        Expr::Nested(b) => true,
        Expr::If(c, t, o) => true,
        Expr::While(c, b) => true,
        Expr::For(n, e, b) => true,
        Expr::Loop(b) => true,
        Expr::Match(e, arms) => true,
        _ => false,
    }
}

/// A literal, a name, a call, a parenthesized expression, or one of §5's
/// constructs written with braces.
pub fn primary(p: &mut Parser) -> Result<Expr, lex::Error> {
    let ahead = peek(p)?;
    let after = ahead.at;
    let keyword = match ahead.tok {
        Tok::Kw(k) => k,
        _ => "".to_string(),
    };
    if keyword.same("if") {
        return if_expr(p);
    }

    if keyword.same("while") {
        p.at = after;
        let c = no_struct_expr(p)?;
        let b = block(p)?;
        return Result::Ok(Expr::While(Box::new(c), Box::new(b)));
    }
    if keyword.same("match") {
        p.at = after;
        return match_expr(p);
    }
    if keyword.same("for") {
        p.at = after;
        let name = ident(p)?;
        expect_kw(p, "in")?;
        let iter = no_struct_expr(p)?;
        let b = block(p)?;
        return Result::Ok(Expr::For(name, Box::new(iter), Box::new(b)));
    }
    if keyword.same("loop") {
        p.at = after;
        let b = block(p)?;
        return Result::Ok(Expr::Loop(Box::new(b)));
    }
    if keyword.same("return") {
        p.at = after;
        return Result::Ok(Expr::Return(optional_value(p)?));
    }
    if keyword.same("break") {
        p.at = after;
        return Result::Ok(Expr::Break(optional_value(p)?));
    }
    if keyword.same("continue") {
        p.at = after;
        return Result::Ok(Expr::Continue);
    }
    // `self` is a keyword and a name at once: it is the receiver's, and it is
    // written the way any other local is (Ch. 3 §1.4).
    if keyword.same("self") {
        p.at = after;
        return Result::Ok(Expr::Name("self".to_string()));
    }
    if keyword.same("true") {
        p.at = after;
        return Result::Ok(Expr::Bool(true));
    }
    if keyword.same("false") {
        p.at = after;
        return Result::Ok(Expr::Bool(false));
    }
    let braced = peek(p)?;
    let opens = match braced.tok {
        Tok::Op(o) => o.same("{"),
        _ => false,
    };
    if opens {
        let b = block(p)?;
        return Result::Ok(Expr::Nested(Box::new(b)));
    }

    let t = peek(p)?;
    p.at = t.at;
    match t.tok {
        Tok::Int(v) => Result::Ok(Expr::Int(v)),
        Tok::TritLit(v) => Result::Ok(Expr::Int(v)),
        Tok::CharLit(v) => Result::Ok(Expr::Int(v)),
        Tok::Str(text) => Result::Ok(Expr::Str(text)),
        Tok::Ident(n) => path_expr(p, n),
        Tok::Op(o) => {
            if o.same("(") {
                // A struct literal is legal again inside parentheses: the
                // `{` cannot be a block here, because a block cannot open
                // where an expression has already begun.
                let outer = p.no_struct;
                p.no_struct = false;
                let e = parenthesized(p);
                p.no_struct = outer;
                return e;
            }
            Result::Err(lex::Error { at: p.at, message: "expected an expression".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected an expression".to_string() }),
    }
}

/// `if c { … } else { … }` (§5.3). The `else` is an expression, so `else if`
/// is an `if` rather than a third shape.
fn if_expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    expect_kw(p, "if")?;
    let c = no_struct_expr(p)?;
    let then = block(p)?;
    let t = peek(p)?;
    let next = t.at;
    let has_else = match t.tok {
        Tok::Kw(k) => k.same("else"),
        _ => false,
    };
    if !has_else {
        return Result::Ok(Expr::If(Box::new(c), Box::new(then), Option::None));
    }
    p.at = next;
    let t2 = peek(p)?;
    let chained = match t2.tok {
        Tok::Kw(k) => k.same("if"),
        _ => false,
    };
    let other = if chained {
        if_expr(p)?
    } else {
        let b = block(p)?;
        Expr::Nested(Box::new(b))
    };
    Result::Ok(Expr::If(Box::new(c), Box::new(then), Option::Some(Box::new(other))))
}

/// A condition: an expression, read where a `{` opens the block that follows
/// rather than a struct literal (§2.8). Nothing here reads a struct literal
/// at all, so the rule costs nothing and is written for the reader.
fn no_struct_expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    let outer = p.no_struct;
    p.no_struct = true;
    let e = expr(p);
    p.no_struct = outer;
    e
}

/// `return`, `break` — a value, unless what follows cannot start one.
fn optional_value(p: &mut Parser) -> Result<Option<Box<Expr>>, lex::Error> {
    let t = peek(p)?;
    let ends = match t.tok {
        Tok::Op(o) => o.same(";") || o.same("}") || o.same(")") || o.same(","),
        Tok::Eof => true,
        _ => false,
    };
    if ends {
        return Result::Ok(Option::None);
    }
    let e = expr(p)?;
    Result::Ok(Option::Some(Box::new(e)))
}

/// `a, b, c)` — the arguments of a call, the `(` already read.
/// A path, and whatever it opens: `f(a)` is a call, `A::B(a)` an aggregate
/// whose fields are its positions, `T { a: 1 }` an aggregate written out, and
/// a path alone is a name.
///
/// A one-segment name followed by `(` is a *call* and a longer one is an
/// aggregate, because only the names decide which — and this parser does not
/// know them. That is the same split the Rust parser makes, and it is made
/// here for the same reason: it is the last point where the two can agree
/// without knowing anything.
fn path_expr(p: &mut Parser, first: String) -> Result<Expr, lex::Error> {
    let mut path = first;
    let mut segments: taddr = 1;
    loop {
        let t = peek(p)?;
        let next = t.at;
        let more = match t.tok {
            Tok::Op(o) => o.same("::"),
            _ => false,
        };
        if !more {
            break;
        }
        p.at = next;
        path.push_str("::");
        let seg = ident(p)?;
        path.push_str(&seg);
        segments += 1;
    }
    let t = peek(p)?;
    let next = t.at;
    let opener = match t.tok {
        Tok::Op(o) => o,
        _ => "".to_string(),
    };
    if opener.same("(") {
        p.at = next;
        if segments == 1 {
            let args = arguments(p)?;
            return Result::Ok(Expr::Call(path, args));
        }
        let fields = argument_fields(p)?;
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    if opener.same("{") && !p.no_struct {
        p.at = next;
        let fields = field_values(p)?;
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    if segments > 1 {
        let fields: Vec<ast::Field> = Vec::new();
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    Result::Ok(Expr::Name(path))
}

/// `a: 1, b: 2 }` after the `{` — the fields of a struct literal.
///
/// A field written with no value is the value of the name: `Span { lo, hi }`
/// is `Span { lo: lo, hi: hi }`, which is the one shorthand the language has.
fn field_values(p: &mut Parser) -> Result<Vec<ast::Field>, lex::Error> {
    let mut out: Vec<ast::Field> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated struct literal".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(out);
        }
        let name = ident(p)?;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let written = match t2.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        let value = if written {
            p.at = at2;
            // A field's value is a whole expression, and a `{` inside it is
            // no longer ambiguous — the literal is already open.
            let outer = p.no_struct;
            p.no_struct = false;
            let e = expr(p);
            p.no_struct = outer;
            e?
        } else {
            Expr::Name(name.to_string())
        };
        out.push(ast::Field { name: name, value: value });
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at3;
        }
    }
}

/// The arguments of `A::B(…)`, named by their positions (§3.3).
fn argument_fields(p: &mut Parser) -> Result<Vec<ast::Field>, lex::Error> {
    let mut out: Vec<ast::Field> = Vec::new();
    let first = peek(p)?;
    let skip = first.at;
    match first.tok {
        Tok::Op(o) => {
            if o.same(")") {
                p.at = skip;
                return Result::Ok(out);
            }
        }
        _ => {}
    }
    loop {
        let mut name: String = Vec::new();
        ast::push_int(&mut name, out.len() as t27);
        let outer = p.no_struct;
        p.no_struct = false;
        let value = expr(p);
        p.no_struct = outer;
        out.push(ast::Field { name: name, value: value? });
        let t = bump(p)?;
        match t {
            Tok::Op(o) => {
                if o.same(")") {
                    return Result::Ok(out);
                }
                if !o.same(",") {
                    return Result::Err(lex::Error {
                        at: p.at,
                        message: "expected `,` or `)`".to_string(),
                    });
                }
            }
            _ => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "expected `,` or `)`".to_string(),
                });
            }
        }
    }
}

fn arguments(p: &mut Parser) -> Result<Vec<Expr>, lex::Error> {
    let mut out: Vec<Expr> = Vec::new();
    let first = peek(p)?;
    let skip = first.at;
    match first.tok {
        Tok::Op(o) => {
            if o.same(")") {
                p.at = skip;
                return Result::Ok(out);
            }
        }
        _ => {}
    }
    loop {
        let e = expr(p)?;
        out.push(e);
        let t = bump(p)?;
        match t {
            Tok::Op(o) => {
                if o.same(")") {
                    return Result::Ok(out);
                }
                // A trailing comma closes the list: an argument written on
                // its own line ends with one, and a diff of the line after it
                // should not be a diff of the line before.
                if o.same(",") {
                    let t2 = peek(p)?;
                    let at2 = t2.at;
                    let closes = match t2.tok {
                        Tok::Op(c) => c.same(")"),
                        _ => false,
                    };
                    if closes {
                        p.at = at2;
                        return Result::Ok(out);
                    }
                }
                if !o.same(",") {
                    return Result::Err(lex::Error {
                        at: p.at,
                        message: "expected `,` or `)`".to_string(),
                    });
                }
            }
            _ => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "expected `,` or `)`".to_string(),
                });
            }
        }
    }
}

// ------------------------------------------------------- statements, items

/// `{ stmt* expr? }` (§5.1).
pub fn block(p: &mut Parser) -> Result<ast::Block, lex::Error> {
    expect_op(p, "{")?;
    let mut stmts: Vec<ast::Stmt> = Vec::new();
    let mut tail: Option<Box<Expr>> = Option::None;
    loop {
        let t = peek(p)?;
        let next = t.at;
        match t.tok {
            Tok::Eof => return Result::Err(lex::Error {
                at: p.at,
                message: "unterminated block".to_string(),
            }),
            Tok::Op(o) => {
                if o.same("}") {
                    p.at = next;
                    return Result::Ok(ast::Block { stmts: stmts, tail: tail });
                }
                if o.same(";") {
                    p.at = next;
                }
            }
            _ => {}
        }
        let t2 = peek(p)?;
        let after = t2.at;
        let is_close = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if is_close {
            p.at = after;
            return Result::Ok(ast::Block { stmts: stmts, tail: tail });
        }
        // A `let` is a statement and nothing else is decided until the
        // terminator: `e;` is a statement and `e}` is the block's value.
        let ahead = peek(p)?;
        let is_let = match ahead.tok {
            Tok::Kw(k) => k.same("let"),
            _ => false,
        };
        if is_let {
            stmts.push(let_stmt(p)?);
        } else {
            let e = expr(p)?;
            let t3 = peek(p)?;
            let at3 = t3.at;
            let ends = match t3.tok {
                Tok::Op(o) => o.same(";"),
                _ => false,
            };
            if ends {
                p.at = at3;
                stmts.push(ast::Stmt::Do(e));
            } else if block_shaped(&e) {
                // A block-shaped expression may stand as a statement with no
                // terminator (§5.1) — unless it is the block's own value,
                // which is what a `}` after it says.
                let t4 = peek(p)?;
                let closes = match t4.tok {
                    Tok::Op(o) => o.same("}"),
                    _ => false,
                };
                if closes {
                    tail = Option::Some(Box::new(e));
                } else {
                    stmts.push(ast::Stmt::Do(e));
                }
            } else {
                tail = Option::Some(Box::new(e));
            }
        }
    }
}

/// `let mut? name = expr;` (§5.2).
fn let_stmt(p: &mut Parser) -> Result<ast::Stmt, lex::Error> {
    let kw = bump(p)?;
    let _ = kw;
    let mut mutable = false;
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Kw(k) => {
            if k.same("mut") {
                mutable = true;
                p.at = next;
            }
        }
        _ => {}
    }
    // `let P { a, b } = e;` and `let (a, b) = e;` take the value apart, and
    // what they bind is the pattern's (§4). A struct pattern is told from a
    // name by the `{` after it; a tuple one by opening with `(`.
    let t0 = peek(p)?;
    let at0 = t0.at;
    let tuple = match &t0.tok {
        Tok::Op(o) => o.same("("),
        _ => false,
    };
    let structured = match &t0.tok {
        Tok::Ident(n) => {
            let save = p.at;
            p.at = at0;
            let t1 = peek(p)?;
            let braced = match &t1.tok {
                Tok::Op(o) => o.same("{"),
                _ => false,
            };
            p.at = save;
            braced
        }
        _ => false,
    };
    if !mutable && (tuple || structured) {
        let pat = pattern(p)?;
        // A written type is read and dropped here as it is anywhere else.
        let t2 = peek(p)?;
        let at2 = t2.at;
        let has_ty = match &t2.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        if has_ty {
            p.at = at2;
            let _ = type_name(p)?;
        }
        expect_op(p, "=")?;
        let e = expr(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::Stmt::LetPattern(pat, e));
    }
    // `let _ = e;` binds nothing and is how a value is discarded (§5.2).
    // The wildcard is punctuation, not a name, so it is read here.
    let t1 = peek(p)?;
    let at1 = t1.at;
    let wild = match t1.tok {
        Tok::Op(o) => o.same("_"),
        _ => false,
    };
    let name = if wild {
        p.at = at1;
        "_".to_string()
    } else {
        ident(p)?
    };
    // A written type is read and dropped: nothing here does anything with
    // one, and pretending otherwise would be a second thing to keep right.
    let t2 = peek(p)?;
    let at2 = t2.at;
    let has_ty = match t2.tok {
        Tok::Op(o) => o.same(":"),
        _ => false,
    };
    if has_ty {
        p.at = at2;
        let _ = type_name(p)?;
    }
    expect_op(p, "=")?;
    let e = expr(p)?;
    expect_op(p, ";")?;
    Result::Ok(ast::Stmt::Let(mutable, name, e))
}

/// `fn name(a: T, …) -> R { … }` (§3.1).
pub fn function(p: &mut Parser) -> Result<ast::Fn, lex::Error> {
    expect_kw(p, "fn")?;
    let name = ident(p)?;
    let generics = generic_params(p)?;
    expect_op(p, "(")?;
    let mut params: Vec<ast::Param> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same(")"),
            _ => false,
        };
        if done {
            p.at = next;
            break;
        }
        match receiver(p)? {
            Option::Some(r) => {
                params.push(r);
            }
            Option::None => {
                let pname = ident(p)?;
                expect_op(p, ":")?;
                let pty = type_name(p)?;
                params.push(ast::Param { name: pname, ty: pty });
            }
        }
        let t2 = peek(p)?;
        let at2 = t2.at;
        match t2.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at2;
                }
            }
            _ => {}
        }
    }
    // A function with no `->` returns `()` (§3.1), which is a type like any
    // other and is written out here so nothing below has to know it is the
    // one that was left out.
    let mut ret = ast::Ty::Unit;
    let t = peek(p)?;
    let next = t.at;
    let arrow = match t.tok {
        Tok::Op(o) => o.same("->"),
        _ => false,
    };
    if arrow {
        p.at = next;
        ret = type_name(p)?;
    }
    // `where` comes after the return type and before the body. Its type
    // bounds belong to the parameters they name, and are folded into them:
    // `fn f<T>(…) where T: Eq` and `fn f<T: Eq>(…)` are one function.
    let clause = where_clause(p)?;
    let generics = merge_bounds(generics, clause.bounds)?;
    let requires = clause.requires;
    // A function with no body is a declaration (§3.1): the signature is the
    // whole item, and what defines it is outside the language.
    let t2 = peek(p)?;
    let at2 = t2.at;
    let declared = match t2.tok {
        Tok::Op(o) => o.same(";"),
        _ => false,
    };
    if declared {
        p.at = at2;
        return Result::Ok(ast::Fn {
            name: name,
            generics: generics,
            requires: requires,
            params: params,
            ret: ret,
            body: Option::None,
        });
    }
    let body = block(p)?;
    Result::Ok(ast::Fn {
        name: name,
        generics: generics,
        requires: requires,
        params: params,
        ret: ret,
        body: Option::Some(body),
    })
}

/// One of the shortened receiver forms — `self`, `&self`, `&mut self`
/// (Ch. 3 §1.4) — if that is what comes next.
///
/// `&mut self` and `&mut x: T` share a prefix, so the position is put back
/// when the word after the prefix turns out not to be `self`.
fn receiver(p: &mut Parser) -> Result<Option<ast::Param>, lex::Error> {
    let start = p.at;
    let mut amp = false;
    let mut mutable = false;
    let t = peek(p)?;
    let at = t.at;
    let borrowed = match t.tok {
        Tok::Op(o) => o.same("&"),
        _ => false,
    };
    if borrowed {
        p.at = at;
        amp = true;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let m = match t2.tok {
            Tok::Kw(k) => k.same("mut"),
            _ => false,
        };
        if m {
            p.at = at2;
            mutable = true;
        }
    }
    let t3 = peek(p)?;
    let at3 = t3.at;
    let is_self = match t3.tok {
        Tok::Kw(k) => k.same("self"),
        _ => false,
    };
    if is_self {
        p.at = at3;
        // The long form `self: Buffer` is an ordinary parameter and is left
        // to the ordinary path.
        let t4 = peek(p)?;
        let colon = match t4.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        if colon {
            p.at = start;
            return Result::Ok(Option::None);
        }
        // `self` is `Self`, `&self` is `&Self`: the shortened forms are the
        // written ones with the type left out (Ch. 3 §1.4).
        let ty = if amp {
            ast::Ty::Ref(Box::new(ast::Ty::SelfTy), mutable)
        } else {
            ast::Ty::SelfTy
        };
        return Result::Ok(Option::Some(ast::Param { name: "self".to_string(), ty: ty }));
    }
    p.at = start;
    Result::Ok(Option::None)
}

/// A type, as the text it was written with.
///
/// Nothing here reads a type for anything but printing it, so it is kept as
/// the characters it was written with — and read *recursively*, because
/// `Vec<t27>` and `&[t27]` are types with types inside them and stopping at
/// the first name would leave the rest for the caller to trip over.
fn type_name(p: &mut Parser) -> Result<ast::Ty, lex::Error> {
    // `&` and `mut` are prefixes and may repeat (Ch. 3 §2.1), so a reference
    // is read here and wrapped around whatever the rest of it turns out to
    // be — which is why this is written before the name and not after.
    let t = peek(p)?;
    let next = t.at;
    let mut reference = false;
    match t.tok {
        Tok::Op(o) => {
            if o.same("&") {
                p.at = next;
                reference = true;
            } else if o.same("&&") {
                // `&&T` lexes as the logical-and by maximal munch, and only
                // the type grammar knows it is two references. One is taken
                // here and the position is left *before* the second
                // character, so the next turn takes the other.
                p.at = next - 1;
                reference = true;
            }
        }
        _ => {}
    }
    if reference {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let mutable = match t2.tok {
            Tok::Kw(k) => k.same("mut"),
            _ => false,
        };
        if mutable {
            p.at = at2;
        }
        let inner = type_name(p)?;
        return Result::Ok(ast::Ty::Ref(Box::new(inner), mutable));
    }

    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Kw(k) => {
            // `Self` is a type and is a keyword (Ch. 4 §1.2).
            if k.same("Self") {
                p.at = next;
                return Result::Ok(ast::Ty::SelfTy);
            }
            Result::Err(lex::Error { at: p.at, message: "expected a type".to_string() })
        }
        Tok::Ident(n) => {
            p.at = next;
            let mut segments: Vec<String> = Vec::new();
            segments.push(n);
            // `lex::Taken` — a type through the module holding it (Ch. 6 §3.1).
            loop {
                let q = peek(p)?;
                let at_q = q.at;
                let qualified = match q.tok {
                    Tok::Op(o) => o.same("::"),
                    _ => false,
                };
                if !qualified {
                    break;
                }
                p.at = at_q;
                segments.push(ident(p)?);
            }
            let t2 = peek(p)?;
            let at2 = t2.at;
            let generic = match t2.tok {
                Tok::Op(o) => o.same("<"),
                _ => false,
            };
            if !generic {
                return Result::Ok(ast::Ty::Name(segments));
            }
            p.at = at2;
            let mut args: Vec<ast::Ty> = Vec::new();
            loop {
                args.push(type_name(p)?);
                let t3 = peek(p)?;
                let at3 = t3.at;
                let more = match t3.tok {
                    Tok::Op(o) => o.same(","),
                    _ => false,
                };
                if !more {
                    break;
                }
                p.at = at3;
            }
            close_angle(p)?;
            Result::Ok(ast::Ty::App(segments, args))
        }
        Tok::Op(o) => {
            if o.same("[") {
                p.at = next;
                let inner = type_name(p)?;
                expect_op(p, "]")?;
                return Result::Ok(ast::Ty::Slice(Box::new(inner)));
            }
            if o.same("(") {
                p.at = next;
                expect_op(p, ")")?;
                return Result::Ok(ast::Ty::Unit);
            }
            Result::Err(lex::Error { at: p.at, message: "expected a type".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected a type".to_string() }),
    }
}

fn ident(p: &mut Parser) -> Result<String, lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Ident(n) => Result::Ok(n),
        _ => Result::Err(lex::Error { at: p.at, message: "expected a name".to_string() }),
    }
}

/// Close one level of angle brackets, splitting a `>>` the same way.
fn close_angle(p: &mut Parser) -> Result<(), lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Op(o) => {
            if o.same(">") {
                p.at = next;
                return Result::Ok(());
            }
            if o.same(">>") {
                // Leave the second `>` where it is, for the caller's caller.
                p.at = next - 1;
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "expected `>`".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected `>`".to_string() }),
    }
}

fn expect_op(p: &mut Parser, want: &str) -> Result<(), lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Op(o) => {
            if o.same(want) {
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "unexpected operator".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected an operator".to_string() }),
    }
}

fn expect_kw(p: &mut Parser, want: &str) -> Result<(), lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Kw(k) => {
            if k.same(want) {
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "unexpected keyword".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected a keyword".to_string() }),
    }
}

/// A whole file: items, in the order written (§3).
pub fn file(p: &mut Parser) -> Result<Vec<ast::Item>, lex::Error> {
    let mut out: Vec<ast::Item> = Vec::new();
    loop {
        let t = peek(p)?;
        match t.tok {
            Tok::Eof => return Result::Ok(out),
            _ => {}
        }
        out.push(item(p)?);
    }
}

/// One item. `pub` is read and dropped: it decides visibility (Ch. 6 §2) and
/// nothing here asks about visibility.
pub fn item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    // An attribute attaches to the item that follows (§3.4), and comes
    // before a `pub`: the word is about the item and the attribute is too.
    let mut linear = false;
    let mut derives: Vec<String> = Vec::new();
    loop {
        let a = peek(p)?;
        let at_a = a.at;
        let more = match &a.tok {
            Tok::Op(o) => o.same("#"),
            _ => false,
        };
        if !more {
            break;
        }
        p.at = at_a;
        expect_op(p, "[")?;
        let name = ident(p)?;
        expect_op(p, "(")?;
        if name.same("repr") {
            let how = ident(p)?;
            if how.same("linear") {
                linear = true;
            } else if !how.same("lang") {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "not a layout regime; use `lang` or `linear`".to_string(),
                });
            }
        } else if name.same("derive") {
            loop {
                derives.push(ident(p)?);
                let c = peek(p)?;
                let at_c = c.at;
                let comma = match &c.tok {
                    Tok::Op(o) => o.same(","),
                    _ => false,
                };
                if !comma {
                    break;
                }
                p.at = at_c;
            }
        } else {
            return Result::Err(lex::Error {
                at: p.at,
                message: "the language defines `repr` and `derive`".to_string(),
            });
        }
        expect_op(p, ")")?;
        expect_op(p, "]")?;
    }
    let t = peek(p)?;
    let at = t.at;
    let public = match t.tok {
        Tok::Kw(k) => k.same("pub"),
        _ => false,
    };
    if public {
        p.at = at;
    }
    let what = what(p)?;
    Result::Ok(ast::Item {
        public: public,
        linear: linear,
        derives: derives,
        what: what,
    })
}

/// The item itself, after any `pub`.
fn what(p: &mut Parser) -> Result<ast::What, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    let word = match t.tok {
        Tok::Kw(k) => k,
        _ => "".to_string(),
    };
    if word.same("fn") {
        let f = function(p)?;
        return Result::Ok(ast::What::Function(f));
    }
    if word.same("struct") {
        return struct_item(p);
    }
    if word.same("enum") {
        return enum_item(p);
    }
    if word.same("mod") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::What::Mod(name));
    }
    if word.same("use") {
        p.at = next;
        return use_item(p);
    }
    if word.same("type") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, "=")?;
        let ty = type_name(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::What::Alias(name, ty));
    }
    if word.same("const") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, ":")?;
        let ty = type_name(p)?;
        expect_op(p, "=")?;
        let value = expr(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::What::Const(name, ty, value));
    }
    if word.same("impl") {
        return impl_item(p);
    }
    if word.same("trait") {
        return trait_item(p);
    }
    Result::Err(lex::Error { at: p.at, message: "expected an item".to_string() })
}

/// `struct Name { a: T, … }`, `struct Name;` (§3.3).
fn struct_item(p: &mut Parser) -> Result<ast::What, lex::Error> {
    expect_kw(p, "struct")?;
    let name = ident(p)?;
    let generics = generic_params(p)?;
    let mut fields: Vec<ast::Param> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let unit = match t.tok {
        Tok::Op(o) => o.same(";"),
        _ => false,
    };
    if unit {
        p.at = next;
        return Result::Ok(ast::What::Struct(name, generics, fields));
    }
    expect_op(p, "{")?;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let done = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = at2;
            return Result::Ok(ast::What::Struct(name, generics, fields));
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let public = match t3.tok {
            Tok::Kw(k) => k.same("pub"),
            _ => false,
        };
        if public {
            p.at = at3;
        }
        let fname = ident(p)?;
        expect_op(p, ":")?;
        let fty = type_name(p)?;
        fields.push(ast::Param { name: fname, ty: fty });
        let t4 = peek(p)?;
        let at4 = t4.at;
        match t4.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at4;
                }
            }
            _ => {}
        }
    }
}

/// `enum Name { A, B(T, U), … }` (§3.3).
fn enum_item(p: &mut Parser) -> Result<ast::What, lex::Error> {
    expect_kw(p, "enum")?;
    let name = ident(p)?;
    let generics = generic_params(p)?;
    expect_op(p, "{")?;
    let mut variants: Vec<ast::Variant> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(ast::What::Enum(name, generics, variants));
        }
        let vname = ident(p)?;
        let mut fields: Vec<ast::Ty> = Vec::new();
        let t2 = peek(p)?;
        let at2 = t2.at;
        let payload = match t2.tok {
            Tok::Op(o) => o.same("("),
            _ => false,
        };
        if payload {
            p.at = at2;
            loop {
                let t3 = peek(p)?;
                let at3 = t3.at;
                let close = match t3.tok {
                    Tok::Op(o) => o.same(")"),
                    _ => false,
                };
                if close {
                    p.at = at3;
                    break;
                }
                let ty = type_name(p)?;
                fields.push(ty);
                let t4 = peek(p)?;
                let at4 = t4.at;
                match t4.tok {
                    Tok::Op(o) => {
                        if o.same(",") {
                            p.at = at4;
                        }
                    }
                    _ => {}
                }
            }
        }
        variants.push(ast::Variant { name: vname, fields: fields });
        let t5 = peek(p)?;
        let at5 = t5.at;
        match t5.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at5;
                }
            }
            _ => {}
        }
    }
}

/// `use a::b::c;` — the segments, in order (Ch. 6 §3.2).
fn use_item(p: &mut Parser) -> Result<ast::What, lex::Error> {
    let mut segments: Vec<String> = Vec::new();
    segments.push(ident(p)?);
    loop {
        let t = peek(p)?;
        let next = t.at;
        let more = match t.tok {
            Tok::Op(o) => o.same("::"),
            _ => false,
        };
        if !more {
            expect_op(p, ";")?;
            return Result::Ok(ast::What::Use(segments));
        }
        p.at = next;
        segments.push(ident(p)?);
    }
}

/// `impl Type { … }` or `impl Trait for Type { … }` (Ch. 4 §1.2).
///
/// Both halves are read as types and only then told apart, because the
/// difference is the `for` and nothing before it.
fn impl_item(p: &mut Parser) -> Result<ast::What, lex::Error> {
    expect_kw(p, "impl")?;
    let generics = generic_params(p)?;
    // Both halves are read as types and only then told apart, because the
    // difference is the `for` and nothing before it.
    let first = type_name(p)?;
    let mut tr: Option<ast::Ty> = Option::None;
    let mut ty = first;
    let t = peek(p)?;
    let next = t.at;
    let has_for = match t.tok {
        Tok::Kw(k) => k.same("for"),
        _ => false,
    };
    if has_for {
        p.at = next;
        tr = Option::Some(ty);
        ty = type_name(p)?;
    }
    expect_op(p, "{")?;
    let mut fns: Vec<ast::Fn> = Vec::new();
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let done = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = at2;
            return Result::Ok(ast::What::Impl(generics, tr, ty, fns));
        }
        // An `impl` block takes no `pub`, and neither does anything in one:
        // its methods are as visible as the block, which is as visible as the
        // more private of the type and the trait (Ch. 6 §5, G9.42).
        let t3 = peek(p)?;
        let public = match t3.tok {
            Tok::Kw(k) => k.same("pub"),
            _ => false,
        };
        if public {
            return Result::Err(lex::Error {
                at: p.at,
                message: "`pub` on a method of an impl".to_string(),
            });
        }
        fns.push(function(p)?);
    }
}

/// `match e { p => v, … }` (§5.4), after the word.
fn match_expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    let scrutinee = no_struct_expr(p)?;
    expect_op(p, "{")?;
    let mut arms: Vec<ast::Arm> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated `match`".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(Expr::Match(Box::new(scrutinee), arms));
        }
        let mut patterns: Vec<ast::Pattern> = Vec::new();
        patterns.push(pattern(p)?);
        loop {
            let t2 = peek(p)?;
            let at2 = t2.at;
            let more = match t2.tok {
                Tok::Op(o) => o.same("|"),
                _ => false,
            };
            if !more {
                break;
            }
            p.at = at2;
            patterns.push(pattern(p)?);
        }
        // A guard is an ordinary expression and its `{` would be a block, so
        // the restriction that stands over the scrutinee stands over it too.
        let t3 = peek(p)?;
        let at3 = t3.at;
        let guarded = match t3.tok {
            Tok::Kw(k) => k.same("if"),
            _ => false,
        };
        let guard: Option<Expr> = if guarded {
            p.at = at3;
            Option::Some(expr(p)?)
        } else {
            Option::None
        };
        expect_op(p, "=>")?;
        let body = expr(p)?;
        let needs_comma = !block_shaped(&body);
        arms.push(ast::Arm { patterns: patterns, guard: guard, body: body });
        let t4 = peek(p)?;
        let at4 = t4.at;
        let comma = match t4.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at4;
        } else if needs_comma {
            let t5 = peek(p)?;
            let closes = match t5.tok {
                Tok::Op(o) => o.same("}"),
                _ => false,
            };
            if !closes {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "expected `,` between match arms".to_string(),
                });
            }
        }
    }
}

/// One pattern (§4).
fn pattern(p: &mut Parser) -> Result<ast::Pattern, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Int(v) => {
            p.at = next;
            Result::Ok(ast::Pattern::Int(v))
        }
        Tok::TritLit(v) => {
            p.at = next;
            Result::Ok(ast::Pattern::Int(v))
        }
        Tok::CharLit(v) => {
            p.at = next;
            Result::Ok(ast::Pattern::Int(v))
        }
        Tok::Kw(k) => {
            if k.same("true") {
                p.at = next;
                return Result::Ok(ast::Pattern::Bool(true));
            }
            if k.same("false") {
                p.at = next;
                return Result::Ok(ast::Pattern::Bool(false));
            }
            Result::Err(lex::Error { at: p.at, message: "expected a pattern".to_string() })
        }
        Tok::Ident(n) => {
            p.at = next;
            path_pattern(p, n)
        }
        Tok::Op(o) => {
            if o.same("_") {
                p.at = next;
                return Result::Ok(ast::Pattern::Wild);
            }
            if o.same("-") {
                p.at = next;
                let after = bump(p)?;
                match after {
                    Tok::Int(v) => Result::Ok(ast::Pattern::Int(0 - v)),
                    Tok::TritLit(v) => Result::Ok(ast::Pattern::Int(0 - v)),
                    _ => Result::Err(lex::Error {
                        at: p.at,
                        message: "expected a literal after `-`".to_string(),
                    }),
                }
            } else if o.same("(") {
                p.at = next;
                let items = pattern_list(p, ")")?;
                Result::Ok(ast::Pattern::Tuple(items))
            } else {
                Result::Err(lex::Error { at: p.at, message: "expected a pattern".to_string() })
            }
        }
        Tok::Eof => Result::Err(lex::Error {
            at: p.at,
            message: "expected a pattern, found the end".to_string(),
        }),
        _ => Result::Err(lex::Error { at: p.at, message: "expected a pattern".to_string() }),
    }
}

/// A pattern that began with a name: a binding, or an aggregate.
///
/// One segment and nothing after it *binds* — `x` is a name for whatever was
/// matched and not a comparison against something called `x`, which is the
/// one place a pattern reads unlike the expression it resembles.
fn path_pattern(p: &mut Parser, first: String) -> Result<ast::Pattern, lex::Error> {
    let mut path = first;
    let mut segments: taddr = 1;
    loop {
        let t = peek(p)?;
        let next = t.at;
        let more = match t.tok {
            Tok::Op(o) => o.same("::"),
            _ => false,
        };
        if !more {
            break;
        }
        p.at = next;
        path.push_str("::");
        let seg = ident(p)?;
        path.push_str(&seg);
        segments += 1;
    }
    let t = peek(p)?;
    let next = t.at;
    let opener = match t.tok {
        Tok::Op(o) => o,
        _ => "".to_string(),
    };
    if opener.same("(") {
        p.at = next;
        let fields = pattern_fields(p)?;
        return Result::Ok(ast::Pattern::Aggregate(path, fields));
    }
    if opener.same("{") {
        p.at = next;
        let fields = field_patterns(p)?;
        return Result::Ok(ast::Pattern::Aggregate(path, fields));
    }
    if segments > 1 {
        let fields: Vec<ast::PatField> = Vec::new();
        return Result::Ok(ast::Pattern::Aggregate(path, fields));
    }
    // `name @ pattern` binds the whole and matches the part (§4). It is kept
    // as a field named `@`, which no program can write and so cannot collide.
    let t2 = peek(p)?;
    let at2 = t2.at;
    let at_sign = match t2.tok {
        Tok::Op(o) => o.same("@"),
        _ => false,
    };
    if at_sign {
        p.at = at2;
        let inner = pattern(p)?;
        let mut fields: Vec<ast::PatField> = Vec::new();
        fields.push(ast::PatField { name: "@".to_string(), pat: inner });
        return Result::Ok(ast::Pattern::Aggregate(path, fields));
    }
    Result::Ok(ast::Pattern::Bind(path))
}

/// Patterns up to `close`, separated by commas.
fn pattern_list(p: &mut Parser, close: &str) -> Result<Vec<ast::Pattern>, lex::Error> {
    let mut out: Vec<ast::Pattern> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same(close),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated pattern list".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(out);
        }
        out.push(pattern(p)?);
        let t2 = peek(p)?;
        let at2 = t2.at;
        let comma = match t2.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at2;
        }
    }
}

/// The patterns of `A::B(…)`, named by their positions — the same shape a
/// tuple variant's *expression* takes, and named the same way.
fn pattern_fields(p: &mut Parser) -> Result<Vec<ast::PatField>, lex::Error> {
    let mut out: Vec<ast::PatField> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same(")"),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated pattern list".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(out);
        }
        let mut name: String = Vec::new();
        ast::push_int(&mut name, out.len() as t27);
        let pat = pattern(p)?;
        out.push(ast::PatField { name: name, pat: pat });
        let t2 = peek(p)?;
        let at2 = t2.at;
        let comma = match t2.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at2;
        }
    }
}

/// `a: p, b, … }` after the `{` — the fields of a struct pattern. A field
/// with no pattern binds its own name, as it does in a literal.
fn field_patterns(p: &mut Parser) -> Result<Vec<ast::PatField>, lex::Error> {
    let mut out: Vec<ast::PatField> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated field pattern".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(out);
        }
        let name = ident(p)?;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let written = match t2.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        let pat = if written {
            p.at = at2;
            pattern(p)?
        } else {
            ast::Pattern::Bind(name.to_string())
        };
        out.push(ast::PatField { name: name, pat: pat });
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at3;
        }
    }
}

/// What follows a `(`: nothing, one expression, or a tuple of them.
fn parenthesized(p: &mut Parser) -> Result<Expr, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    let empty = match t.tok {
        Tok::Op(o) => o.same(")"),
        _ => false,
    };
    if empty {
        p.at = next;
        return Result::Ok(Expr::Unit);
    }
    let first = expr(p)?;
    let t2 = peek(p)?;
    let at2 = t2.at;
    let comma = match t2.tok {
        Tok::Op(o) => o.same(","),
        _ => false,
    };
    if !comma {
        expect_op(p, ")")?;
        return Result::Ok(Expr::Group(Box::new(first)));
    }
    let mut items: Vec<Expr> = Vec::new();
    items.push(first);
    p.at = at2;
    loop {
        let t3 = peek(p)?;
        let at3 = t3.at;
        let done = match t3.tok {
            Tok::Op(o) => o.same(")"),
            _ => false,
        };
        if done {
            p.at = at3;
            return Result::Ok(Expr::Tuple(items));
        }
        items.push(expr(p)?);
        let t4 = peek(p)?;
        let at4 = t4.at;
        let more = match t4.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if more {
            p.at = at4;
        } else {
            expect_op(p, ")")?;
            return Result::Ok(Expr::Tuple(items));
        }
    }
}

/// `<T, U: Bound + Other, const N: taddr>`, or nothing at all (Ch. 4 §2.1).
///
/// A lifetime is read and dropped wherever one may appear: they are erased
/// (Ch. 3 §3.2), and a parser that refused them would refuse programs the
/// language accepts.
fn generic_params(p: &mut Parser) -> Result<Vec<ast::Generic>, lex::Error> {
    let mut out: Vec<ast::Generic> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let opens = match t.tok {
        Tok::Op(o) => o.same("<"),
        _ => false,
    };
    if !opens {
        return Result::Ok(out);
    }
    p.at = next;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        // Borrowed rather than taken: the token is asked two questions and
        // a move would leave nothing to ask the second (Ch. 3 §1.2).
        let done = match &t2.tok {
            Tok::Op(o) => o.same(">") || o.same(">>"),
            _ => false,
        };
        if done {
            close_angle(p)?;
            return Result::Ok(out);
        }
        match t2.tok {
            Tok::Lifetime(l) => {
                p.at = at2;
                // `'a: 'b` outlives, and is erased with the rest of them.
                skip_lifetime_bounds(p)?;
            }
            Tok::Kw(k) => {
                if !k.same("const") {
                    return Result::Err(lex::Error {
                        at: p.at,
                        message: "expected a generic parameter".to_string(),
                    });
                }
                p.at = at2;
                let name = ident(p)?;
                expect_op(p, ":")?;
                let ty = type_name(p)?;
                out.push(ast::Generic::Const(name, ty));
            }
            _ => {
                let name = ident(p)?;
                let bounds = bound_list(p)?;
                out.push(ast::Generic::Type(name, bounds));
            }
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at3;
        }
    }
}

/// `: A + B<t9> + C<Item = t27>`, or nothing.
fn bound_list(p: &mut Parser) -> Result<Vec<ast::Bound>, lex::Error> {
    let mut out: Vec<ast::Bound> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let colon = match t.tok {
        Tok::Op(o) => o.same(":"),
        _ => false,
    };
    if !colon {
        return Result::Ok(out);
    }
    p.at = next;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        match t2.tok {
            // A lifetime bound — `T: 'a` — is erased with the rest.
            Tok::Lifetime(l) => {
                p.at = at2;
            }
            _ => {
                out.push(one_bound(p)?);
            }
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let more = match t3.tok {
            Tok::Op(o) => o.same("+"),
            _ => false,
        };
        if !more {
            return Result::Ok(out);
        }
        p.at = at3;
    }
}

/// One bound: a trait, and what it carries (Ch. 4 §1.7).
fn one_bound(p: &mut Parser) -> Result<ast::Bound, lex::Error> {
    let name = ident(p)?;
    let mut args: Vec<ast::Ty> = Vec::new();
    let mut assoc: Vec<ast::Named> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let opens = match t.tok {
        Tok::Op(o) => o.same("<"),
        _ => false,
    };
    if !opens {
        return Result::Ok(ast::Bound { name: name, args: args, assoc: assoc });
    }
    p.at = next;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let done = match t2.tok {
            Tok::Op(o) => o.same(">") || o.same(">>"),
            _ => false,
        };
        if done {
            close_angle(p)?;
            return Result::Ok(ast::Bound { name: name, args: args, assoc: assoc });
        }
        // `Item = t27` binds what the implementation chose; anything else is
        // an argument saying which implementation is meant.
        let binding = looks_like_binding(p)?;
        if binding {
            let key = ident(p)?;
            expect_op(p, "=")?;
            let ty = type_name(p)?;
            assoc.push(ast::Named { name: key, ty: ty });
        } else {
            args.push(type_name(p)?);
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at3;
        }
    }
}

/// Whether what comes next is `name = …` rather than a type.
fn looks_like_binding(p: &mut Parser) -> Result<bool, lex::Error> {
    let start = p.at;
    let t = peek(p)?;
    let at = t.at;
    let named = match t.tok {
        Tok::Ident(n) => true,
        _ => false,
    };
    if !named {
        return Result::Ok(false);
    }
    p.at = at;
    let t2 = peek(p)?;
    let assigns = match t2.tok {
        Tok::Op(o) => o.same("="),
        _ => false,
    };
    p.at = start;
    Result::Ok(assigns)
}

/// `'a: 'b + 'c`, all of which is erased (Ch. 3 §3.2).
fn skip_lifetime_bounds(p: &mut Parser) -> Result<(), lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    let colon = match t.tok {
        Tok::Op(o) => o.same(":"),
        _ => false,
    };
    if !colon {
        return Result::Ok(());
    }
    p.at = next;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        match t2.tok {
            Tok::Lifetime(l) => {
                p.at = at2;
            }
            _ => return Result::Ok(()),
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let more = match t3.tok {
            Tok::Op(o) => o.same("+"),
            _ => false,
        };
        if !more {
            return Result::Ok(());
        }
        p.at = at3;
    }
}

/// `trait Name<T>: Super { … }` (Ch. 4 §1.1).
///
/// A trait's body holds method signatures — with a body or without — and
/// associated type and constant names. A `pub` on any of them is an error
/// for the same reason it is on an `impl`'s method: they are as visible as
/// the trait (Ch. 6 §2.2).
fn trait_item(p: &mut Parser) -> Result<ast::What, lex::Error> {
    expect_kw(p, "trait")?;
    let name = ident(p)?;
    let mut params: Vec<String> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let generic = match t.tok {
        Tok::Op(o) => o.same("<"),
        _ => false,
    };
    if generic {
        p.at = next;
        loop {
            let t2 = peek(p)?;
            let at2 = t2.at;
            let done = match &t2.tok {
                Tok::Op(o) => o.same(">") || o.same(">>"),
                _ => false,
            };
            if done {
                close_angle(p)?;
                break;
            }
            params.push(ident(p)?);
            let t3 = peek(p)?;
            let at3 = t3.at;
            let comma = match t3.tok {
                Tok::Op(o) => o.same(","),
                _ => false,
            };
            if comma {
                p.at = at3;
            }
        }
    }
    let mut supers: Vec<String> = Vec::new();
    let bounds = bound_list(p)?;
    for b in bounds {
        supers.push(b.name);
    }
    expect_op(p, "{")?;
    let mut assoc: Vec<String> = Vec::new();
    let mut fns: Vec<ast::Fn> = Vec::new();
    loop {
        let t4 = peek(p)?;
        let at4 = t4.at;
        let done = match &t4.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = at4;
            return Result::Ok(ast::What::Trait(name, params, supers, assoc, fns));
        }
        let word = match &t4.tok {
            Tok::Kw(k) => k.to_string(),
            _ => "".to_string(),
        };
        if word.same("type") {
            p.at = at4;
            assoc.push(ident(p)?);
            expect_op(p, ";")?;
        } else if word.same("fn") {
            fns.push(function(p)?);
        } else {
            return Result::Err(lex::Error {
                at: p.at,
                message: "expected `fn` or `type` in a trait".to_string(),
            });
        }
    }
}

/// What a `where` clause said: predicates, and bounds for named parameters.
pub struct Where {
    pub requires: Vec<Expr>,
    pub bounds: Vec<Extra>,
}

/// Bounds a `where` clause put on one type parameter.
pub struct Extra {
    pub name: String,
    pub bounds: Vec<ast::Bound>,
}

/// `where T: Bound, n > 0` (Ch. 4 §2.6, §2.8).
///
/// A bound names a type parameter of this item and belongs to it; a
/// predicate is an expression and is kept apart. They are told from each
/// other by what follows the first name: a `:` makes it a bound.
///
/// What it finds is *answered* rather than written into the parameter list.
/// Reaching into a `Vec` through a `&mut` and pushing to what a pattern
/// bound would push to a copy (G9.50), and a function that answers cannot
/// make that mistake.
fn where_clause(p: &mut Parser) -> Result<Where, lex::Error> {
    let mut requires: Vec<Expr> = Vec::new();
    let mut bounds: Vec<Extra> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let has = match &t.tok {
        Tok::Kw(k) => k.same("where"),
        _ => false,
    };
    if !has {
        return Result::Ok(Where { requires: requires, bounds: bounds });
    }
    p.at = next;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        match &t2.tok {
            // A lifetime bound is erased with the rest of them (§3.2).
            Tok::Lifetime(l) => {
                p.at = at2;
                skip_lifetime_bounds(p)?;
            }
            _ => {
                if bound_ahead(p)? {
                    let name = ident(p)?;
                    let these = bound_list(p)?;
                    bounds.push(Extra { name: name, bounds: these });
                } else {
                    // A predicate is followed by the body's `{`, so a struct
                    // literal is off here for the reason it is off in an
                    // `if` condition (§5.3).
                    requires.push(no_struct_expr(p)?);
                }
            }
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match &t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if !comma {
            return Result::Ok(Where { requires: requires, bounds: bounds });
        }
        p.at = at3;
        let t4 = peek(p)?;
        let opens = match &t4.tok {
            Tok::Op(o) => o.same("{"),
            _ => false,
        };
        if opens {
            return Result::Ok(Where { requires: requires, bounds: bounds });
        }
    }
}

/// Whether what comes next is `name:` — a bound rather than a predicate.
fn bound_ahead(p: &mut Parser) -> Result<bool, lex::Error> {
    let start = p.at;
    let t = peek(p)?;
    let at = t.at;
    let named = match &t.tok {
        Tok::Ident(n) => true,
        _ => false,
    };
    if !named {
        return Result::Ok(false);
    }
    p.at = at;
    let t2 = peek(p)?;
    let colon = match &t2.tok {
        Tok::Op(o) => o.same(":"),
        _ => false,
    };
    p.at = start;
    Result::Ok(colon)
}

/// Fold a `where` clause's bounds into the parameters they name.
///
/// `fn f<T>(…) where T: Eq` and `fn f<T: Eq>(…)` are one function, so the
/// two lists become one. It is done by value, a bound at a time: a `Vec`
/// reached through a `&mut` that a pattern bound is a copy (G9.50), and a
/// list that is consumed and answered cannot be the wrong one.
fn merge_bounds(
    gs: Vec<ast::Generic>,
    extra: Vec<Extra>,
) -> Result<Vec<ast::Generic>, lex::Error> {
    let mut out = gs;
    for e in extra {
        let at = index_of(&out, &e.name);
        if at < 0 {
            return Result::Err(lex::Error {
                at: 0,
                message: "not a type parameter of this item".to_string(),
            });
        }
        out = with_bounds(out, at, e.bounds);
    }
    Result::Ok(out)
}

/// Which parameter is called this, or −1.
fn index_of(gs: &Vec<ast::Generic>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < gs.len() {
        let hit = match &gs[i] {
            ast::Generic::Type(n, bs) => n.same(name),
            ast::Generic::Const(n, ty) => false,
        };
        if hit {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The same list with `more` added to the parameter at `at`.
fn with_bounds(
    gs: Vec<ast::Generic>,
    at: taddr,
    more: Vec<ast::Bound>,
) -> Vec<ast::Generic> {
    // Popped rather than moved: a value moved inside a loop would be moved
    // again on the next turn, and this one is wanted on exactly one.
    let mut held = more;
    let mut out: Vec<ast::Generic> = Vec::new();
    let mut i: taddr = 0;
    for g in gs {
        match g {
            ast::Generic::Type(name, bs) => {
                let mut list = bs;
                if i == at {
                    let mut back: Vec<ast::Bound> = Vec::new();
                    loop {
                        match held.pop() {
                            Option::Some(b) => back.push(b),
                            Option::None => break,
                        }
                    }
                    loop {
                        match back.pop() {
                            Option::Some(b) => list.push(b),
                            Option::None => break,
                        }
                    }
                }
                out.push(ast::Generic::Type(name, list));
            }
            other => out.push(other),
        }
        i += 1;
    }
    out
}
