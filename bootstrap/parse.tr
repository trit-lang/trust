// The parser (Ch. 0 §2), in Trust.
//
// Recursive descent with the precedence table of §2.1, which is where the
// mutual recursion is: `expr` calls `binary` calls `unary` calls `primary`
// calls `expr`. A compiler is that shape all the way down, and it is what
// found the inliner unrolling a call cycle without bound (G9.28).

// A `use` is absolute — resolved from the root (Ch. 6 §3.1) — which is how
// this module names its siblings at all.
use ast;
use ast::Expr;
use lex;
use lex::Tok;

/// Where the parser is, and what it is reading.
pub struct Parser {
    pub src: String,
    pub at: taddr,
    /// Set where a `{` would be a block and not a struct literal — the
    /// condition of an `if` or a `while` (§2.8). The ambiguity is real and
    /// the flag is how both parsers resolve it.
    pub no_struct: bool,
}

/// The next token, without consuming it.
///
/// It takes the shared reference it needs, and every caller holds the
/// exclusive one — which is accepted where a shared one is wanted (Ch. 3
/// §2.3a). Draft 0.1 had no such rule, and this said `&mut` and meant `&`.
pub fn peek(p: &Parser) -> Result<lex::Taken, lex::Error> {
    lex::one(&p.src, p.at)
}

/// The next token, consumed.
pub fn bump(p: &mut Parser) -> Result<Tok, lex::Error> {
    let t = lex::one(&p.src, p.at)?;
    p.at = t.at;
    Result::Ok(t.tok)
}

/// A whole expression: assignment, which is §2.1's loosest level and is
/// right-associative.
pub fn expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    let left = binary(p, 1)?;
    let t = peek(p)?;
    let next = t.at;
    let op = match t.tok {
        Tok::Op(o) => o,
        _ => return Result::Ok(left),
    };
    if !ast::assigns(&op) {
        return Result::Ok(left);
    }
    p.at = next;
    let right = expr(p)?;
    Result::Ok(Expr::Assign(op, Box::new(left), Box::new(right)))
}

/// The left-associative levels, loosest first.
pub fn binary(p: &mut Parser, min: taddr) -> Result<Expr, lex::Error> {
    let mut left = unary(p)?;
    loop {
        let t = peek(p)?;
        // Ownership is tracked per local and not per place, so taking the
        // payload out of `t.tok` marks all of `t` moved — including `t.at`.
        // Reading the position first is the whole of the workaround, and it
        // is what `docs/status.md` §11 says to expect.
        let next = t.at;
        let op = match t.tok {
            Tok::Op(o) => o,
            _ => return Result::Ok(left),
        };
        let l = ast::level(&op);
        if l < min || l == 0 {
            return Result::Ok(left);
        }
        p.at = next;
        let right = binary(p, l + 1)?;
        left = Expr::Binary(op, Box::new(left), Box::new(right));
    }
}

/// A primary, and whatever follows it: `.f`, `.m(args)` (§2.6).
pub fn postfix(p: &mut Parser) -> Result<Expr, lex::Error> {
    let mut e = primary(p)?;
    loop {
        let t = peek(p)?;
        let next = t.at;
        let dot = match t.tok {
            Tok::Op(o) => o.same("."),
            _ => false,
        };
        if !dot {
            return Result::Ok(e);
        }
        p.at = next;
        let name = ident(p)?;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let is_call = match t2.tok {
            Tok::Op(o) => o.same("("),
            _ => false,
        };
        if is_call {
            p.at = at2;
            let args = arguments(p)?;
            e = Expr::Method(Box::new(e), name, args);
        } else {
            e = Expr::Field(Box::new(e), name);
        }
    }
}

/// `-e`, `!e`, or a postfix chain.
pub fn unary(p: &mut Parser) -> Result<Expr, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Op(o) => {
            if o.same("-") || o.same("!") {
                p.at = next;
                let inner = unary(p)?;
                return Result::Ok(Expr::Unary(o, Box::new(inner)));
            }
            postfix(p)
        }
        _ => postfix(p),
    }
}

/// Whether an expression is written with braces, and so may stand as a
/// statement without a `;` (§5.1).
pub fn block_shaped(e: &Expr) -> bool {
    match e {
        Expr::Nested(b) => true,
        Expr::If(c, t, o) => true,
        Expr::While(c, b) => true,
        Expr::Loop(b) => true,
        _ => false,
    }
}

/// A literal, a name, a call, a parenthesized expression, or one of §5's
/// constructs written with braces.
pub fn primary(p: &mut Parser) -> Result<Expr, lex::Error> {
    let ahead = peek(p)?;
    let after = ahead.at;
    let keyword = match ahead.tok {
        Tok::Kw(k) => k,
        _ => "".to_string(),
    };
    if keyword.same("if") {
        return if_expr(p);
    }
    if keyword.same("while") {
        p.at = after;
        let c = no_struct_expr(p)?;
        let b = block(p)?;
        return Result::Ok(Expr::While(Box::new(c), Box::new(b)));
    }
    if keyword.same("loop") {
        p.at = after;
        let b = block(p)?;
        return Result::Ok(Expr::Loop(Box::new(b)));
    }
    if keyword.same("return") {
        p.at = after;
        return Result::Ok(Expr::Return(optional_value(p)?));
    }
    if keyword.same("break") {
        p.at = after;
        return Result::Ok(Expr::Break(optional_value(p)?));
    }
    if keyword.same("continue") {
        p.at = after;
        return Result::Ok(Expr::Continue);
    }
    // `self` is a keyword and a name at once: it is the receiver's, and it is
    // written the way any other local is (Ch. 3 §1.4).
    if keyword.same("self") {
        p.at = after;
        return Result::Ok(Expr::Name("self".to_string()));
    }
    let braced = peek(p)?;
    let opens = match braced.tok {
        Tok::Op(o) => o.same("{"),
        _ => false,
    };
    if opens {
        let b = block(p)?;
        return Result::Ok(Expr::Nested(Box::new(b)));
    }

    let t = peek(p)?;
    p.at = t.at;
    match t.tok {
        Tok::Int(v) => Result::Ok(Expr::Int(v)),
        Tok::TritLit(v) => Result::Ok(Expr::Int(v)),
        Tok::CharLit(v) => Result::Ok(Expr::Int(v)),
        Tok::Ident(n) => path_expr(p, n),
        Tok::Op(o) => {
            if o.same("(") {
                let inner = expr(p)?;
                let close = bump(p)?;
                match close {
                    Tok::Op(c) => {
                        if !c.same(")") {
                            return Result::Err(lex::Error {
                                at: p.at,
                                message: "expected `)`".to_string(),
                            });
                        }
                    }
                    _ => {
                        return Result::Err(lex::Error {
                            at: p.at,
                            message: "expected `)`".to_string(),
                        });
                    }
                }
                return Result::Ok(Expr::Group(Box::new(inner)));
            }
            Result::Err(lex::Error { at: p.at, message: "expected an expression".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected an expression".to_string() }),
    }
}

/// `if c { … } else { … }` (§5.3). The `else` is an expression, so `else if`
/// is an `if` rather than a third shape.
fn if_expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    expect_kw(p, "if")?;
    let c = no_struct_expr(p)?;
    let then = block(p)?;
    let t = peek(p)?;
    let next = t.at;
    let has_else = match t.tok {
        Tok::Kw(k) => k.same("else"),
        _ => false,
    };
    if !has_else {
        return Result::Ok(Expr::If(Box::new(c), Box::new(then), Option::None));
    }
    p.at = next;
    let t2 = peek(p)?;
    let chained = match t2.tok {
        Tok::Kw(k) => k.same("if"),
        _ => false,
    };
    let other = if chained {
        if_expr(p)?
    } else {
        let b = block(p)?;
        Expr::Nested(Box::new(b))
    };
    Result::Ok(Expr::If(Box::new(c), Box::new(then), Option::Some(Box::new(other))))
}

/// A condition: an expression, read where a `{` opens the block that follows
/// rather than a struct literal (§2.8). Nothing here reads a struct literal
/// at all, so the rule costs nothing and is written for the reader.
fn no_struct_expr(p: &mut Parser) -> Result<Expr, lex::Error> {
    let outer = p.no_struct;
    p.no_struct = true;
    let e = expr(p);
    p.no_struct = outer;
    e
}

/// `return`, `break` — a value, unless what follows cannot start one.
fn optional_value(p: &mut Parser) -> Result<Option<Box<Expr>>, lex::Error> {
    let t = peek(p)?;
    let ends = match t.tok {
        Tok::Op(o) => o.same(";") || o.same("}") || o.same(")") || o.same(","),
        Tok::Eof => true,
        _ => false,
    };
    if ends {
        return Result::Ok(Option::None);
    }
    let e = expr(p)?;
    Result::Ok(Option::Some(Box::new(e)))
}

/// `a, b, c)` — the arguments of a call, the `(` already read.
/// A path, and whatever it opens: `f(a)` is a call, `A::B(a)` an aggregate
/// whose fields are its positions, `T { a: 1 }` an aggregate written out, and
/// a path alone is a name.
///
/// A one-segment name followed by `(` is a *call* and a longer one is an
/// aggregate, because only the names decide which — and this parser does not
/// know them. That is the same split the Rust parser makes, and it is made
/// here for the same reason: it is the last point where the two can agree
/// without knowing anything.
fn path_expr(p: &mut Parser, first: String) -> Result<Expr, lex::Error> {
    let mut path = first;
    let mut segments: taddr = 1;
    loop {
        let t = peek(p)?;
        let next = t.at;
        let more = match t.tok {
            Tok::Op(o) => o.same("::"),
            _ => false,
        };
        if !more {
            break;
        }
        p.at = next;
        path.push_str("::");
        let seg = ident(p)?;
        path.push_str(&seg);
        segments += 1;
    }
    let t = peek(p)?;
    let next = t.at;
    let opener = match t.tok {
        Tok::Op(o) => o,
        _ => "".to_string(),
    };
    if opener.same("(") {
        p.at = next;
        if segments == 1 {
            let args = arguments(p)?;
            return Result::Ok(Expr::Call(path, args));
        }
        let fields = argument_fields(p)?;
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    if opener.same("{") && !p.no_struct {
        p.at = next;
        let fields = field_values(p)?;
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    if segments > 1 {
        let fields: Vec<ast::Field> = Vec::new();
        return Result::Ok(Expr::Aggregate(path, fields));
    }
    Result::Ok(Expr::Name(path))
}

/// `a: 1, b: 2 }` after the `{` — the fields of a struct literal.
///
/// A field written with no value is the value of the name: `Span { lo, hi }`
/// is `Span { lo: lo, hi: hi }`, which is the one shorthand the language has.
fn field_values(p: &mut Parser) -> Result<Vec<ast::Field>, lex::Error> {
    let mut out: Vec<ast::Field> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            Tok::Eof => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "unterminated struct literal".to_string(),
                });
            }
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(out);
        }
        let name = ident(p)?;
        let t2 = peek(p)?;
        let at2 = t2.at;
        let written = match t2.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        let value = if written {
            p.at = at2;
            // A field's value is a whole expression, and a `{` inside it is
            // no longer ambiguous — the literal is already open.
            let outer = p.no_struct;
            p.no_struct = false;
            let e = expr(p);
            p.no_struct = outer;
            e?
        } else {
            Expr::Name(name.to_string())
        };
        out.push(ast::Field { name: name, value: value });
        let t3 = peek(p)?;
        let at3 = t3.at;
        let comma = match t3.tok {
            Tok::Op(o) => o.same(","),
            _ => false,
        };
        if comma {
            p.at = at3;
        }
    }
}

/// The arguments of `A::B(…)`, named by their positions (§3.3).
fn argument_fields(p: &mut Parser) -> Result<Vec<ast::Field>, lex::Error> {
    let mut out: Vec<ast::Field> = Vec::new();
    let first = peek(p)?;
    let skip = first.at;
    match first.tok {
        Tok::Op(o) => {
            if o.same(")") {
                p.at = skip;
                return Result::Ok(out);
            }
        }
        _ => {}
    }
    loop {
        let mut name: String = Vec::new();
        ast::push_int(&mut name, out.len() as t27);
        let outer = p.no_struct;
        p.no_struct = false;
        let value = expr(p);
        p.no_struct = outer;
        out.push(ast::Field { name: name, value: value? });
        let t = bump(p)?;
        match t {
            Tok::Op(o) => {
                if o.same(")") {
                    return Result::Ok(out);
                }
                if !o.same(",") {
                    return Result::Err(lex::Error {
                        at: p.at,
                        message: "expected `,` or `)`".to_string(),
                    });
                }
            }
            _ => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "expected `,` or `)`".to_string(),
                });
            }
        }
    }
}

fn arguments(p: &mut Parser) -> Result<Vec<Expr>, lex::Error> {
    let mut out: Vec<Expr> = Vec::new();
    let first = peek(p)?;
    let skip = first.at;
    match first.tok {
        Tok::Op(o) => {
            if o.same(")") {
                p.at = skip;
                return Result::Ok(out);
            }
        }
        _ => {}
    }
    loop {
        let e = expr(p)?;
        out.push(e);
        let t = bump(p)?;
        match t {
            Tok::Op(o) => {
                if o.same(")") {
                    return Result::Ok(out);
                }
                if !o.same(",") {
                    return Result::Err(lex::Error {
                        at: p.at,
                        message: "expected `,` or `)`".to_string(),
                    });
                }
            }
            _ => {
                return Result::Err(lex::Error {
                    at: p.at,
                    message: "expected `,` or `)`".to_string(),
                });
            }
        }
    }
}

// ------------------------------------------------------- statements, items

/// `{ stmt* expr? }` (§5.1).
pub fn block(p: &mut Parser) -> Result<ast::Block, lex::Error> {
    expect_op(p, "{")?;
    let mut stmts: Vec<ast::Stmt> = Vec::new();
    let mut tail: Option<Box<Expr>> = Option::None;
    loop {
        let t = peek(p)?;
        let next = t.at;
        match t.tok {
            Tok::Eof => return Result::Err(lex::Error {
                at: p.at,
                message: "unterminated block".to_string(),
            }),
            Tok::Op(o) => {
                if o.same("}") {
                    p.at = next;
                    return Result::Ok(ast::Block { stmts: stmts, tail: tail });
                }
                if o.same(";") {
                    p.at = next;
                }
            }
            _ => {}
        }
        let t2 = peek(p)?;
        let after = t2.at;
        let is_close = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if is_close {
            p.at = after;
            return Result::Ok(ast::Block { stmts: stmts, tail: tail });
        }
        // A `let` is a statement and nothing else is decided until the
        // terminator: `e;` is a statement and `e}` is the block's value.
        let ahead = peek(p)?;
        let is_let = match ahead.tok {
            Tok::Kw(k) => k.same("let"),
            _ => false,
        };
        if is_let {
            stmts.push(let_stmt(p)?);
        } else {
            let e = expr(p)?;
            let t3 = peek(p)?;
            let at3 = t3.at;
            let ends = match t3.tok {
                Tok::Op(o) => o.same(";"),
                _ => false,
            };
            if ends {
                p.at = at3;
                stmts.push(ast::Stmt::Do(e));
            } else if block_shaped(&e) {
                // A block-shaped expression may stand as a statement with no
                // terminator (§5.1) — unless it is the block's own value,
                // which is what a `}` after it says.
                let t4 = peek(p)?;
                let closes = match t4.tok {
                    Tok::Op(o) => o.same("}"),
                    _ => false,
                };
                if closes {
                    tail = Option::Some(Box::new(e));
                } else {
                    stmts.push(ast::Stmt::Do(e));
                }
            } else {
                tail = Option::Some(Box::new(e));
            }
        }
    }
}

/// `let mut? name = expr;` (§5.2).
fn let_stmt(p: &mut Parser) -> Result<ast::Stmt, lex::Error> {
    let kw = bump(p)?;
    let _ = kw;
    let mut mutable = false;
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Kw(k) => {
            if k.same("mut") {
                mutable = true;
                p.at = next;
            }
        }
        _ => {}
    }
    let name = ident(p)?;
    // A written type is read and dropped: nothing here does anything with
    // one, and pretending otherwise would be a second thing to keep right.
    let t2 = peek(p)?;
    let at2 = t2.at;
    let has_ty = match t2.tok {
        Tok::Op(o) => o.same(":"),
        _ => false,
    };
    if has_ty {
        p.at = at2;
        let _ = type_name(p)?;
    }
    expect_op(p, "=")?;
    let e = expr(p)?;
    expect_op(p, ";")?;
    Result::Ok(ast::Stmt::Let(mutable, name, e))
}

/// `fn name(a: T, …) -> R { … }` (§3.1).
pub fn function(p: &mut Parser) -> Result<ast::Fn, lex::Error> {
    expect_kw(p, "fn")?;
    let name = ident(p)?;
    expect_op(p, "(")?;
    let mut params: Vec<ast::Param> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same(")"),
            _ => false,
        };
        if done {
            p.at = next;
            break;
        }
        match receiver(p)? {
            Option::Some(r) => {
                params.push(r);
            }
            Option::None => {
                let pname = ident(p)?;
                expect_op(p, ":")?;
                let pty = type_name(p)?;
                params.push(ast::Param { name: pname, ty: pty });
            }
        }
        let t2 = peek(p)?;
        let at2 = t2.at;
        match t2.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at2;
                }
            }
            _ => {}
        }
    }
    let mut ret: String = "()".to_string();
    let t = peek(p)?;
    let next = t.at;
    let arrow = match t.tok {
        Tok::Op(o) => o.same("->"),
        _ => false,
    };
    if arrow {
        p.at = next;
        ret = type_name(p)?;
    }
    // A function with no body is a declaration (§3.1): the signature is the
    // whole item, and what defines it is outside the language.
    let t2 = peek(p)?;
    let at2 = t2.at;
    let declared = match t2.tok {
        Tok::Op(o) => o.same(";"),
        _ => false,
    };
    if declared {
        p.at = at2;
        return Result::Ok(ast::Fn {
            name: name,
            params: params,
            ret: ret,
            body: Option::None,
        });
    }
    let body = block(p)?;
    Result::Ok(ast::Fn {
        name: name,
        params: params,
        ret: ret,
        body: Option::Some(body),
    })
}

/// One of the shortened receiver forms — `self`, `&self`, `&mut self`
/// (Ch. 3 §1.4) — if that is what comes next.
///
/// `&mut self` and `&mut x: T` share a prefix, so the position is put back
/// when the word after the prefix turns out not to be `self`.
fn receiver(p: &mut Parser) -> Result<Option<ast::Param>, lex::Error> {
    let start = p.at;
    let mut ty: String = Vec::new();
    let t = peek(p)?;
    let at = t.at;
    let amp = match t.tok {
        Tok::Op(o) => o.same("&"),
        _ => false,
    };
    if amp {
        p.at = at;
        ty.push_str("&");
        let t2 = peek(p)?;
        let at2 = t2.at;
        let mutable = match t2.tok {
            Tok::Kw(k) => k.same("mut"),
            _ => false,
        };
        if mutable {
            p.at = at2;
            ty.push_str("mut ");
        }
    }
    let t3 = peek(p)?;
    let at3 = t3.at;
    let is_self = match t3.tok {
        Tok::Kw(k) => k.same("self"),
        _ => false,
    };
    if is_self {
        p.at = at3;
        // The long form `self: Buffer` is an ordinary parameter and is left
        // to the ordinary path.
        let t4 = peek(p)?;
        let colon = match t4.tok {
            Tok::Op(o) => o.same(":"),
            _ => false,
        };
        if colon {
            p.at = start;
            return Result::Ok(Option::None);
        }
        ty.push_str("Self");
        return Result::Ok(Option::Some(ast::Param { name: "self".to_string(), ty: ty }));
    }
    p.at = start;
    Result::Ok(Option::None)
}

/// A type, as the text it was written with.
///
/// Nothing here reads a type for anything but printing it, so it is kept as
/// the characters it was written with — and read *recursively*, because
/// `Vec<t27>` and `&[t27]` are types with types inside them and stopping at
/// the first name would leave the rest for the caller to trip over.
fn type_name(p: &mut Parser) -> Result<String, lex::Error> {
    let mut out: String = Vec::new();
    // `&` and `mut` are prefixes and may repeat (Ch. 3 §2.1).
    loop {
        let t = peek(p)?;
        let next = t.at;
        let mut went = false;
        match t.tok {
            Tok::Op(o) => {
                if o.same("&") {
                    p.at = next;
                    out.push_str("&");
                    went = true;
                } else if o.same("&&") {
                    // `&&T` lexes as the logical-and by maximal munch, and
                    // only the type grammar knows it is two references. One
                    // is taken here and the position is left *before* the
                    // second character, so the next turn takes the other.
                    p.at = next - 1;
                    out.push_str("&");
                    went = true;
                }
            }
            Tok::Kw(k) => {
                if k.same("mut") {
                    p.at = next;
                    out.push_str("mut ");
                    went = true;
                }
            }
            _ => {}
        }
        if !went {
            break;
        }
    }

    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Ident(n) => {
            p.at = next;
            out.push_str(&n);
            let t2 = peek(p)?;
            let at2 = t2.at;
            let generic = match t2.tok {
                Tok::Op(o) => o.same("<"),
                _ => false,
            };
            if generic {
                p.at = at2;
                out.push_str("<");
                loop {
                    let inner = type_name(p)?;
                    out.push_str(&inner);
                    let t3 = peek(p)?;
                    let at3 = t3.at;
                    let more = match t3.tok {
                        Tok::Op(o) => o.same(","),
                        _ => false,
                    };
                    if !more {
                        break;
                    }
                    p.at = at3;
                    out.push_str(",");
                }
                close_angle(p)?;
                out.push_str(">");
            }
            Result::Ok(out)
        }
        Tok::Op(o) => {
            if o.same("[") {
                p.at = next;
                out.push_str("[");
                let inner = type_name(p)?;
                out.push_str(&inner);
                expect_op(p, "]")?;
                out.push_str("]");
                return Result::Ok(out);
            }
            if o.same("(") {
                p.at = next;
                expect_op(p, ")")?;
                out.push_str("()");
                return Result::Ok(out);
            }
            Result::Err(lex::Error { at: p.at, message: "expected a type".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected a type".to_string() }),
    }
}

fn ident(p: &mut Parser) -> Result<String, lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Ident(n) => Result::Ok(n),
        _ => Result::Err(lex::Error { at: p.at, message: "expected a name".to_string() }),
    }
}

/// Close one level of angle brackets, splitting a `>>` the same way.
fn close_angle(p: &mut Parser) -> Result<(), lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    match t.tok {
        Tok::Op(o) => {
            if o.same(">") {
                p.at = next;
                return Result::Ok(());
            }
            if o.same(">>") {
                // Leave the second `>` where it is, for the caller's caller.
                p.at = next - 1;
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "expected `>`".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected `>`".to_string() }),
    }
}

fn expect_op(p: &mut Parser, want: &str) -> Result<(), lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Op(o) => {
            if o.same(want) {
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "unexpected operator".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected an operator".to_string() }),
    }
}

fn expect_kw(p: &mut Parser, want: &str) -> Result<(), lex::Error> {
    let t = bump(p)?;
    match t {
        Tok::Kw(k) => {
            if k.same(want) {
                return Result::Ok(());
            }
            Result::Err(lex::Error { at: p.at, message: "unexpected keyword".to_string() })
        }
        _ => Result::Err(lex::Error { at: p.at, message: "expected a keyword".to_string() }),
    }
}

/// A whole file: items, in the order written (§3).
pub fn file(p: &mut Parser) -> Result<Vec<ast::Item>, lex::Error> {
    let mut out: Vec<ast::Item> = Vec::new();
    loop {
        let t = peek(p)?;
        match t.tok {
            Tok::Eof => return Result::Ok(out),
            _ => {}
        }
        out.push(item(p)?);
    }
}

/// One item. `pub` is read and dropped: it decides visibility (Ch. 6 §2) and
/// nothing here asks about visibility.
pub fn item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    let t = peek(p)?;
    let next = t.at;
    let word = match t.tok {
        Tok::Kw(k) => k,
        _ => "".to_string(),
    };
    if word.same("pub") {
        p.at = next;
        return item(p);
    }
    if word.same("fn") {
        let f = function(p)?;
        return Result::Ok(ast::Item::Function(f));
    }
    if word.same("struct") {
        return struct_item(p);
    }
    if word.same("enum") {
        return enum_item(p);
    }
    if word.same("mod") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::Item::Mod(name));
    }
    if word.same("use") {
        p.at = next;
        return use_item(p);
    }
    if word.same("type") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, "=")?;
        let ty = type_name(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::Item::Alias(name, ty));
    }
    if word.same("const") {
        p.at = next;
        let name = ident(p)?;
        expect_op(p, ":")?;
        let ty = type_name(p)?;
        expect_op(p, "=")?;
        let value = expr(p)?;
        expect_op(p, ";")?;
        return Result::Ok(ast::Item::Const(name, ty, value));
    }
    if word.same("impl") {
        return impl_item(p);
    }
    Result::Err(lex::Error { at: p.at, message: "expected an item".to_string() })
}

/// `struct Name { a: T, … }`, `struct Name;` (§3.3).
fn struct_item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    expect_kw(p, "struct")?;
    let name = ident(p)?;
    let mut fields: Vec<ast::Param> = Vec::new();
    let t = peek(p)?;
    let next = t.at;
    let unit = match t.tok {
        Tok::Op(o) => o.same(";"),
        _ => false,
    };
    if unit {
        p.at = next;
        return Result::Ok(ast::Item::Struct(name, fields));
    }
    expect_op(p, "{")?;
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let done = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = at2;
            return Result::Ok(ast::Item::Struct(name, fields));
        }
        let t3 = peek(p)?;
        let at3 = t3.at;
        let public = match t3.tok {
            Tok::Kw(k) => k.same("pub"),
            _ => false,
        };
        if public {
            p.at = at3;
        }
        let fname = ident(p)?;
        expect_op(p, ":")?;
        let fty = type_name(p)?;
        fields.push(ast::Param { name: fname, ty: fty });
        let t4 = peek(p)?;
        let at4 = t4.at;
        match t4.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at4;
                }
            }
            _ => {}
        }
    }
}

/// `enum Name { A, B(T, U), … }` (§3.3).
fn enum_item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    expect_kw(p, "enum")?;
    let name = ident(p)?;
    expect_op(p, "{")?;
    let mut variants: Vec<ast::Variant> = Vec::new();
    loop {
        let t = peek(p)?;
        let next = t.at;
        let done = match t.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = next;
            return Result::Ok(ast::Item::Enum(name, variants));
        }
        let vname = ident(p)?;
        let mut fields: Vec<String> = Vec::new();
        let t2 = peek(p)?;
        let at2 = t2.at;
        let payload = match t2.tok {
            Tok::Op(o) => o.same("("),
            _ => false,
        };
        if payload {
            p.at = at2;
            loop {
                let t3 = peek(p)?;
                let at3 = t3.at;
                let close = match t3.tok {
                    Tok::Op(o) => o.same(")"),
                    _ => false,
                };
                if close {
                    p.at = at3;
                    break;
                }
                let ty = type_name(p)?;
                fields.push(ty);
                let t4 = peek(p)?;
                let at4 = t4.at;
                match t4.tok {
                    Tok::Op(o) => {
                        if o.same(",") {
                            p.at = at4;
                        }
                    }
                    _ => {}
                }
            }
        }
        variants.push(ast::Variant { name: vname, fields: fields });
        let t5 = peek(p)?;
        let at5 = t5.at;
        match t5.tok {
            Tok::Op(o) => {
                if o.same(",") {
                    p.at = at5;
                }
            }
            _ => {}
        }
    }
}

/// `use a::b::c;` — the segments, in order (Ch. 6 §3.2).
fn use_item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    let mut segments: Vec<String> = Vec::new();
    segments.push(ident(p)?);
    loop {
        let t = peek(p)?;
        let next = t.at;
        let more = match t.tok {
            Tok::Op(o) => o.same("::"),
            _ => false,
        };
        if !more {
            expect_op(p, ";")?;
            return Result::Ok(ast::Item::Use(segments));
        }
        p.at = next;
        segments.push(ident(p)?);
    }
}

/// `impl Type { … }` or `impl Trait for Type { … }` (Ch. 4 §1.2).
///
/// Both halves are read as types and only then told apart, because the
/// difference is the `for` and nothing before it.
fn impl_item(p: &mut Parser) -> Result<ast::Item, lex::Error> {
    expect_kw(p, "impl")?;
    let first = type_name(p)?;
    let mut tr: String = Vec::new();
    let mut ty = first;
    let t = peek(p)?;
    let next = t.at;
    let has_for = match t.tok {
        Tok::Kw(k) => k.same("for"),
        _ => false,
    };
    if has_for {
        p.at = next;
        tr = ty;
        ty = type_name(p)?;
    }
    expect_op(p, "{")?;
    let mut fns: Vec<ast::Fn> = Vec::new();
    loop {
        let t2 = peek(p)?;
        let at2 = t2.at;
        let done = match t2.tok {
            Tok::Op(o) => o.same("}"),
            _ => false,
        };
        if done {
            p.at = at2;
            return Result::Ok(ast::Item::Impl(tr, ty, fns));
        }
        // An `impl` block takes no `pub`, and neither does anything in one:
        // its methods are as visible as the block, which is as visible as the
        // more private of the type and the trait (Ch. 6 §5, G9.42).
        let t3 = peek(p)?;
        let public = match t3.tok {
            Tok::Kw(k) => k.same("pub"),
            _ => false,
        };
        if public {
            return Result::Err(lex::Error {
                at: p.at,
                message: "`pub` on a method of an impl".to_string(),
            });
        }
        fns.push(function(p)?);
    }
}
