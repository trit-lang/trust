// The Trust parser, run over one expression on stdin.
//
// It prints the tree with every operator a prefix and every child
// parenthesized — a form neither parser writes for any other purpose, so
// agreeing on it is agreeing on the shape rather than on the printing.

mod ast;
mod input;
mod lex;
mod parse;

// The character port is the target's and not the language's (Ch. 5 §1.5),
// and it answers in UTF-8 **code units** — so the text a `str` holds has to
// be decoded from them (Ch. 5 §1.1).
fn main() -> t27 {
    let src = input::read_all();
    let mut p = parse::Parser { src: src, at: 0, no_struct: false, in_macro: false, counter: 0 };
    match parse::expr(&mut p) {
        // The whole of the input or none of it. `trust ast` reads the
        // expression inside a function it writes around it, so text left over
        // is a statement that did not end — and it refuses at the character
        // the leftover begins at, which is a question the token stream cannot
        // be asked: `next` says where the one *after* it starts.
        Result::Ok(e) => {
            let rest = match lex::skip(&p.src, p.at) {
                Result::Ok(at) => at,
                Result::Err(err) => err.at,
            };
            if rest < p.src.len() {
                print("error ");
                print_int(rest as t27);
                println("");
            } else {
                let mut out: String = Vec::new();
                ast::show(&e, &mut out);
                println(&out);
            }
            0
        }
        // Where, not why — the same rule the lexers are compared under.
        Result::Err(err) => {
            print("error ");
            print_int(err.at as t27);
            println("");
            0
        }
    }
}
