struct Bag { items: Vec<t27> }
fn total(b: Bag) -> t27 {
    let mut sum = 0;
    for x in b.items {
        sum += x;
    }
    for c in "abc" {
        sum += c as t27;
    }
    sum
}
fn nested(rows: Vec<Vec<t27>>) -> t27 {
    let mut n = 0;
    for row in rows {
        for v in row {
            if v > 0 { n += v; } else { continue; }
        }
    }
    n
}
