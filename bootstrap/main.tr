// The Trust lexer, run over whatever is on stdin.
//
// It prints one token per line in a form the Rust lexer can be printed in
// too, so that `scripts/bootstrap.sh` can compare them character for
// character. That comparison is the whole point: a second implementation
// of anything is worth having only if something holds it to the first.

mod input;
mod lex;

use lex::Tok;

// The character port is the target's and not the language's (Ch. 5 §1.5),
// and it answers in UTF-8 **code units** — so the text a `str` holds has to
// be decoded from them (Ch. 5 §1.1).
fn main() -> t27 {
    let src = input::read_all();
    let mut at: taddr = 0;
    loop {
        let taken = match lex::one(&src, at) {
            Result::Ok(t) => t,
            // A refusal prints where it refused and nothing about *why*:
            // the two lexers are held to agreeing on what is wrong and on
            // the character it is at, and not on how each says it. Wording
            // is not the thing a second implementation checks.
            Result::Err(e) => {
                print("error ");
                print_int(e.at as t27);
                println("");
                return 0;
            }
        };
        let t = taken;
        at = t.at;
        match t.tok {
            Tok::Eof => { println("eof"); return 0; }
            Tok::Ident(n) => { print("ident "); println(&n); }
            Tok::Kw(k) => { print("kw "); println(&k); }
            Tok::Op(o) => { print("op "); println(&o); }
            Tok::Str(s) => { print("str "); println(&s); }
            Tok::Int(v) => { print("int "); print_int(v); println(""); }
            Tok::TritLit(v) => { print("trit "); print_int(v); println(""); }
            Tok::CharLit(v) => { print("char "); print_int(v); println(""); }
            Tok::Lifetime(l) => { print("lifetime "); println(&l); }
        }
    }
}
