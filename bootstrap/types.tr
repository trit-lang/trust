// Ch. 4, in Trust: what type every binding in a function turned out to have.
//
//     trust run bootstrap/types.tr < file.tr
//
// One line per `let` — `<function> <name> <type>` — in source order, which
// is what `trust types` prints. A `let` is where inference is visible: it is
// the thing `let n = 1;` does not say, and the whole of what a checker knows
// about an expression has to be right for the answer to be.
//
// It types a *file*, not a program: the question needs no module machinery,
// and asking it of one file keeps the spans and the scopes to one place.
//
// What it does not do yet is generics. A generic function is typed once per
// instantiation (Ch. 4 §2.5), so there is no one answer to print, and both
// implementations skip one.

mod ast;
mod input;
mod lex;
mod parse;

/// One name in scope, and what it is.
pub struct Binding {
    pub name: String,
    pub ty: ast::Ty,
}

/// One field of one struct, flattened: nothing here needs them grouped.
pub struct Field {
    pub owner: String,
    pub name: String,
    pub ty: ast::Ty,
}

/// A function's signature, which is all a call needs.
pub struct Sig {
    pub name: String,
    pub params: Vec<ast::Ty>,
    pub ret: ast::Ty,
}

/// One variant, and what its enum is.
///
/// A generic enum's variant carries the enum's parameters, so what
/// `Option::Some(3)` is depends on what `3` is: the payload's declared
/// types are matched against the arguments' and the answer is the enum with
/// those (Ch. 4 §2.3).
pub struct Variant {
    pub owner: String,
    pub params: Vec<String>,
    pub name: String,
    pub fields: Vec<ast::Ty>,
}

/// One method, and the type it is written on. A method is reached through
/// its receiver, so the receiver's head is half of its name (Ch. 4 §1.2).
pub struct Method {
    pub owner: String,
    pub name: String,
    pub ret: ast::Ty,
}

/// What the file defines, and what is in scope where the walk has reached.
/// What the walk is being asked for.
///
/// Both questions are one walk, because the second is the first with an
/// answer compared: a checker that reported types it had not checked would
/// be reporting what it guessed.
pub struct World {
    /// Set to report which functions are refused, rather than what every
    /// binding is.
    pub agreeing: bool,
    /// Whether the function being walked has already been refused: one
    /// answer per function, as the Rust side gives (it stops at the first).
    pub refused: bool,
    /// Whether it was refused by a rule that is not a type that does not
    /// match — a wrong number of arguments is one, and the Rust side calls
    /// it something else, so this must too.
    pub other: bool,
    /// What the function being walked answers with, for its tail and its
    /// `return`s to be claims about (Ch. 4 §2.2).
    pub returns: ast::Ty,
    /// `type Name = T;` — only a name (Ch. 0 §3.6), so a name is what it
    /// is taken off before anything else asks what a type is.
    pub aliases: Vec<Binding>,
    pub fields: Vec<Field>,
    pub sigs: Vec<Sig>,
    pub methods: Vec<Method>,
    pub variants: Vec<Variant>,
    pub locals: Vec<Binding>,
}

fn main() -> t27 {
    let src = input::read_all();
    // `agree` on the first line asks the second question; anything else
    // asks the first. The driver has no arguments to give.
    let agreeing = starts_with_agree(&src);
    let mut p = parse::Parser { src: src, at: 0, no_struct: false, counter: 0 };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut w = World {
                agreeing: agreeing,
                refused: false,
                other: false,
                returns: ast::Ty::Unit,
                aliases: Vec::new(),
                fields: Vec::new(),
                sigs: Vec::new(),
                methods: Vec::new(),
                variants: Vec::new(),
                locals: Vec::new(),
            };
            prelude(&mut w);
            // Aliases first: one may be written after what uses it, and
            // nothing below should ever see a name that is only a name.
            let mut a: taddr = 0;
            while a < items.len() {
                gather_alias(&mut w, &items[a]);
                a += 1;
            }
            let mut i: taddr = 0;
            while i < items.len() {
                gather(&mut w, &items[i]);
                i += 1;
            }
            let mut k: taddr = 0;
            while k < items.len() {
                walk_item(&mut w, &items[k]);
                k += 1;
            }
            0
        }
        Result::Err(err) => {
            print("error ");
            print_int(err.at as t27);
            println("");
            0
        }
    }
}

/// Whether the file opens with the line that asks for the other question.
fn starts_with_agree(src: &str) -> bool {
    let mut i: taddr = 0;
    let want = "// agree";
    while i < want.len() {
        if i >= src.len() || src[i] != want[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// The aliases, which are read before anything else (Ch. 0 §3.6).
fn gather_alias(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Alias(name, ty) => {
            w.aliases.push(Binding { name: name.to_string(), ty: ast::copy_ty(ty) });
        }
        _ => {}
    }
}

/// What one item defines, for the passes that follow.
fn gather(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Struct(name, gs, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                let t = expand(w, &fields[i].ty);
                w.fields.push(Field {
                    owner: name.to_string(),
                    name: fields[i].name.to_string(),
                    ty: t,
                });
                i += 1;
            }
        }
        ast::What::Enum(name, gs, variants) => {
            let mut params: Vec<String> = Vec::new();
            let mut g: taddr = 0;
            while g < gs.len() {
                match &gs[g] {
                    ast::Generic::Type(n, bounds) => params.push(n.to_string()),
                    ast::Generic::Const(n, ty) => {}
                }
                g += 1;
            }
            let mut i: taddr = 0;
            while i < variants.len() {
                let mut fields: Vec<ast::Ty> = Vec::new();
                let mut k: taddr = 0;
                while k < variants[i].fields.len() {
                    fields.push(expand(w, &variants[i].fields[k]));
                    k += 1;
                }
                w.variants.push(Variant {
                    owner: name.to_string(),
                    params: ast::copy_names(&params),
                    name: variants[i].name.to_string(),
                    fields: fields,
                });
                i += 1;
            }
        }
        ast::What::Impl(gs, tr, ty, fns) => {
            // A method of a generic impl is typed once per instantiation,
            // so there is no one answer and it is left out (§2.5).
            if gs.len() > 0 {
                return;
            }
            let owner = head_of(ty);
            let mut i: taddr = 0;
            while i < fns.len() {
                let ret = expand(w, &fns[i].ret);
                w.methods.push(Method {
                    owner: owner.to_string(),
                    name: fns[i].name.to_string(),
                    ret: ret,
                });
                i += 1;
            }
        }
        ast::What::Function(f) => {
            let mut params: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < f.params.len() {
                params.push(expand(w, &f.params[i].ty));
                i += 1;
            }
            let ret = expand(w, &f.ret);
            w.sigs.push(Sig { name: f.name.to_string(), params: params, ret: ret });
        }
        _ => {}
    }
}

/// Every `let` in an item's functions, and what it turned out to be.
fn walk_item(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Function(f) => {
            // A generic function is typed once per instantiation, so there
            // is no one answer to print (Ch. 4 §2.5).
            if f.generics.len() > 0 {
                return;
            }
            match &f.body {
                Option::Some(b) => {
                    w.refused = false;
                    w.other = false;
                    walk_fn(w, f, b);
                    if w.agreeing {
                        print(&f.name);
                        // A refusal is reported by its rule, and the rule
                        // that fires first is the one the Rust side stops
                        // at — which is the count, since it is asked before
                        // any argument is looked at.
                        if w.other {
                            println(" other");
                        } else if w.refused {
                            println(" mismatch");
                        } else {
                            println(" ok");
                        }
                    }
                }
                Option::None => {}
            }
        }
        _ => {}
    }
}

fn walk_fn(w: &mut World, f: &ast::Fn, body: &ast::Block) {
    let mark = w.locals.len();
    w.returns = expand(w, &f.ret);
    let mut i: taddr = 0;
    while i < f.params.len() {
        let t = expand(w, &f.params[i].ty);
        w.locals.push(Binding { name: f.params[i].name.to_string(), ty: t });
        i += 1;
    }
    walk_block(w, &f.name, body);
    check_body(w, body);
    unbind(w, mark);
}

fn walk_block(w: &mut World, what: &str, b: &ast::Block) {
    let mark = w.locals.len();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, value) => {
                // A written type is the answer; inference is for the `let`
                // that does not say (§5.2).
                let from = type_of(w, value);
                // And neither type lets a `()` be *bound*: there is nothing
                // to hold, and the other implementation's word for it is
                // `other`, not a mismatch (G9.171).
                if is_unit_ty(&from) {
                    w.other = true;
                }
                let t = match written {
                    Option::Some(x) => {
                        let want = expand(w, x);
                        if !agrees(&want, &from) {
                            w.refused = true;
                        }
                        want
                    }
                    Option::None => from,
                };
                if !w.agreeing {
                    print(what);
                    print(" ");
                    print(name);
                    print(" ");
                    let mut out: String = Vec::new();
                    show_type(&t, &mut out);
                    println(&out);
                }
                // The value's own blocks come after, because a `let` is
                // reported where it is written and what is inside it is
                // written after it.
                walk_expr(w, what, value);
                w.locals.push(Binding { name: name.to_string(), ty: t });
            }
            // What a pattern binds is the pattern's, and nothing records
            // those yet — on either side.
            ast::Stmt::LetPattern(held, pat, value) => {
                let t = type_of(w, value);
            }
            ast::Stmt::Do(e) => walk_expr(w, what, e),
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(e) => walk_expr(w, what, e),
        Option::None => {}
    }
    unbind(w, mark);
}

/// Whether an expression never gives a value back to what follows it.
fn diverges(e: &ast::Expr) -> bool {
    match e {
        ast::Expr::Return(v) => true,
        ast::Expr::Break(v) => true,
        ast::Expr::Continue => true,
        // A `loop` with no `break` in it never ends; one with a `break`
        // gives `()` and this does not need to tell them apart, because
        // `()` is what a block with no tail is either way.
        ast::Expr::Loop(b) => true,
        _ => false,
    }
}

/// A function's body is a claim about what it answers with (Ch. 4 §2.2).
fn check_body(w: &mut World, body: &ast::Block) {
    let want = ast::copy_ty(&w.returns);
    let got = block_type(w, body);
    if !agrees(&want, &got) {
        w.refused = true;
    }
}

/// The blocks an expression holds, in source order.
fn walk_expr(w: &mut World, what: &str, e: &ast::Expr) {
    match e {
        ast::Expr::Nested(b) => walk_block(w, what, b),
        ast::Expr::If(c, t, o) => {
            walk_expr(w, what, c);
            walk_block(w, what, t);
            match o {
                Option::Some(x) => walk_expr(w, what, x),
                Option::None => {}
            }
            // A condition is a `bool` and nothing else is (§5.3): a trit
            // is three-valued and a number is not a question.
            let cond = type_of(w, c);
            let want = named("bool");
            if !agrees(&want, &cond) {
                w.refused = true;
            }
            // Both branches answer the same thing, since the `if` answers
            // one of them and does not know which.
            let then = block_type(w, t);
            match o {
                Option::Some(x) => {
                    let other = type_of(w, x);
                    if !agrees(&then, &other) && !agrees(&other, &then) {
                        w.refused = true;
                    }
                }
                Option::None => {}
            }
        }
        ast::Expr::While(c, b) => {
            walk_expr(w, what, c);
            walk_block(w, what, b);
            let cond = type_of(w, c);
            let want = named("bool");
            if !agrees(&want, &cond) {
                w.refused = true;
            }
        }
        ast::Expr::Loop(b) => walk_block(w, what, b),
        ast::Expr::For(name, it, b) => {
            walk_expr(w, what, it);
            // The binding is what the loop walks over, one at a time, and
            // is in scope for the body (Ch. 4 §5.7).
            let over = type_of(w, it);
            let bare = strip(&over);
            let each = element_of(&bare);
            let mark = w.locals.len();
            w.locals.push(Binding { name: name.to_string(), ty: each });
            walk_block(w, what, b);
            unbind(w, mark);
        }
        ast::Expr::Match(s, arms) => {
            walk_expr(w, what, s);
            // `match *c` asks the arms to move out of what `c` points at.
            // A `Box` owns what is at the other end of its word, and the
            // move is the point of one; a reference only *lends*, and what
            // it points at is still its owner's to drop (Ch. 3 §1.2) — a
            // refusal the other implementation words as moving out of a
            // reference rather than as a type that does not match, which
            // is the `other` of the two.
            match &*s {
                ast::Expr::Deref(a) => {
                    let inner = type_of(w, &*a);
                    match &inner {
                        ast::Ty::Ref(r, m) => {
                            w.other = true;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            let mut i: taddr = 0;
            while i < arms.len() {
                match &arms[i].guard {
                    Option::Some(g) => walk_expr(w, what, g),
                    Option::None => {}
                }
                walk_expr(w, what, &arms[i].body);
                i += 1;
            }
            // A bare name in a scalar arm binds nothing (G9.163): asking
            // for it in the body is the name the lowering has not got,
            // and the other implementation answers with not-in-scope.
            let whole = type_of(w, s);
            let bare = strip(&whole);
            if scalar_named_ty(&bare) {
                i = 0;
                while i < arms.len() {
                    let mut j: taddr = 0;
                    while j < arms[i].patterns.len() {
                        match &arms[i].patterns[j] {
                            ast::Pattern::Bind(n) => {
                                if arm_body_uses(w, &arms[i].body, n) {
                                    w.other = true;
                                }
                            }
                            _ => {}
                        }
                        j += 1;
                    }
                    i += 1;
                }
            }
            // An arm that answers is asked what it answers by every other
            // arm that answers; an arm that left, and one whose block
            // leaves it, is never asked (§5.4, G9.159, G9.165). An arm
            // whose block *completes* answering nothing — written `{ g(); }`
            // — is a mismatch beside an arm that answers, whichever
            // direction (G9.166's probes say both).
            let mut answer = unknown();
            let mut answered = false;
            let mut unit_arm = false;
            let mut m: taddr = 0;
            while m < arms.len() {
                let here = type_of(w, &arms[m].body);
                m += 1;
                if is_unknown(&here) {
                    continue;
                }
                if is_unit_ty(&here) {
                    if !arm_body_leaves(&arms[m - 1].body) {
                        unit_arm = true;
                    }
                    continue;
                }
                if !answered {
                    answer = here;
                    answered = true;
                } else if !agrees(&answer, &here) && !agrees(&here, &answer) {
                    w.refused = true;
                }
            }
            if answered && unit_arm {
                w.refused = true;
            }
        }
        ast::Expr::Binary(op, a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
            // An operator is a claim about both sides: there are no
            // implicit conversions, so `t27 + t9` is two types (§2.1).
            let left = type_of(w, a);
            let right = type_of(w, b);
            if !agrees(&left, &right) && !agrees(&right, &left) {
                w.refused = true;
            }
        }
        ast::Expr::Assign(op, a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
        }
        ast::Expr::Group(a) => walk_expr(w, what, a),
        ast::Expr::Unary(op, a) => {
            walk_expr(w, what, a);
            // `!` is the logical negation and applies to a `bool`; there is
            // no bitwise one to share the symbol with (Ch. 1 §2). It is a
            // different refusal from a type that does not match, and the
            // Rust side reports it as one.
            if op.same("!") {
                let inner = type_of(w, a);
                let want = named("bool");
                if !agrees(&want, &inner) {
                    w.other = true;
                }
            }
        }
        ast::Expr::Borrow(a, m) => walk_expr(w, what, a),
        ast::Expr::Deref(a) => walk_expr(w, what, a),
        ast::Expr::Try(a) => walk_expr(w, what, a),
        ast::Expr::Cast(a, t) => walk_expr(w, what, a),
        ast::Expr::Field(a, name) => walk_expr(w, what, a),
        ast::Expr::Index(a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
        }
        // A variant is written with its payload or it is not that variant:
        // `Kind::B` where `B` carries one is a different refusal.
        ast::Expr::Aggregate(path, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                walk_expr(w, what, &fields[i].value);
                i += 1;
            }
            check_aggregate(w, path, fields);
        }
        ast::Expr::Method(r, name, args) => {
            walk_expr(w, what, r);
            let mut i: taddr = 0;
            while i < args.len() {
                walk_expr(w, what, &args[i]);
                i += 1;
            }
        }
        ast::Expr::Call(name, args) => {
            let mut i: taddr = 0;
            while i < args.len() {
                walk_expr(w, what, &args[i]);
                i += 1;
            }
            check_call(w, name, args);
        }
        ast::Expr::Return(v) => walk_optional(w, what, v),
        ast::Expr::Break(v) => walk_optional(w, what, v),
        _ => {}
    }
}

fn walk_optional(w: &mut World, what: &str, v: &Option<Box<ast::Expr>>) {
    match v {
        Option::Some(e) => walk_expr(w, what, e),
        Option::None => {}
    }
}

/// An argument is a claim about a parameter (Ch. 4 §2.2).
///
/// A call of something this checker has no signature for says nothing: it
/// is not in the file, and what it wants is not this file's to know.
fn check_call(w: &mut World, name: &str, args: &Vec<ast::Expr>) {
    let at = sig_at(w, name);
    if at < 0 {
        return;
    }
    if w.sigs[at].params.len() != args.len() {
        // A different *count* is a different refusal, and is reported as
        // one: nothing about the arguments is a type that does not match
        // when there are the wrong number of them.
        w.other = true;
        return;
    }
    let mut i: taddr = 0;
    while i < args.len() {
        let want = ast::copy_ty(&w.sigs[at].params[i]);
        let got = type_of(w, &args[i]);
        if !agrees(&want, &got) {
            w.refused = true;
        }
        i += 1;
    }
}

/// Whether a variant was written with the payload it carries (§3.3).
fn check_aggregate(w: &mut World, path: &str, fields: &Vec<ast::Field>) {
    let segments = split_path(path);
    if segments.len() < 2 {
        return;
    }
    let owner = segments[0].to_string();
    let variant = segments[1].to_string();
    let at = variant_at(w, &owner, &variant);
    if at < 0 {
        return;
    }
    if w.variants[at].fields.len() != fields.len() {
        w.other = true;
    }
}

/// Which signature is called that, or −1.
fn sig_at(w: &World, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < w.sigs.len() {
        if w.sigs[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// What an expression is.
pub fn type_of(w: &mut World, e: &ast::Expr) -> ast::Ty {
    match e {
        // An integer literal takes its width from what is around it, and
        // is a word where nothing says (§5.2). It is carried as a type of
        // its own until something decides: printed as `t27`, and agreeing
        // with any width, which is what "takes its width" means.
        ast::Expr::Int(v) => named("#int"),
        ast::Expr::Char(v) => named("char"),
        ast::Expr::Trit(v) => named("trit"),
        ast::Expr::Bool(b) => named("bool"),
        ast::Expr::Str(s) => ast::Ty::Ref(Box::new(named("str")), false),
        ast::Expr::Unit => ast::Ty::Unit,
        ast::Expr::Name(n) => look_up(w, n),
        ast::Expr::Group(a) => type_of(w, a),
        ast::Expr::Cast(a, t) => expand(w, t),
        ast::Expr::Borrow(a, m) => ast::Ty::Ref(Box::new(type_of(w, a)), m),
        ast::Expr::Deref(a) => {
            let inner = type_of(w, a);
            target_of(&inner)
        }
        ast::Expr::Unary(op, a) => {
            if op.same("!") {
                named("bool")
            } else {
                type_of(w, a)
            }
        }
        ast::Expr::Binary(op, a, b) => {
            if ast::level(op) <= 4 {
                // Comparison and the two logical operators answer `bool`;
                // `<=>` answers a `trit` (Ch. 1 §4).
                if op.same("<=>") {
                    named("trit")
                } else {
                    named("bool")
                }
            } else {
                type_of(w, a)
            }
        }
        ast::Expr::Assign(op, a, b) => ast::Ty::Unit,
        // `e?` is the value when there is one and a return when there is
        // not, so what it *is* is the first argument of either answer
        // (Ch. 5 §6.2).
        ast::Expr::Try(a) => {
            let whole = type_of(w, a);
            first_argument(&whole)
        }
        ast::Expr::Field(a, name) => {
            let whole = type_of(w, a);
            let base = strip(&whole);
            let owner = head_of(&base);
            field_type(w, &owner, name)
        }
        ast::Expr::Index(a, i) => {
            let whole = type_of(w, a);
            let base = strip(&whole);
            element_of(&base)
        }
        ast::Expr::Call(name, args) => return_of(w, name),
        ast::Expr::Method(r, name, args) => {
            let whole = type_of(w, r);
            let on = strip(&whole);
            method_type(w, &on, name)
        }
        ast::Expr::Aggregate(path, fields) => aggregate_type(w, path, fields),
        ast::Expr::Nested(b) => block_type(w, b),
        // An `if` with no `else` is `()` wherever a value is read from it:
        // the arm that is not written answers nothing (§5.3). An arm whose
        // last word already left does not answer either; where neither arm
        // answers the `if` answers `()` — the same refusal the other
        // implementation words as a type that does not match (G9.171).
        ast::Expr::If(c, t, o) => {
            let tt = block_type(w, t);
            if !is_unknown(&tt) && !is_unit_ty(&tt) {
                match o {
                    Option::Some(x) => {
                        let et = type_of(w, x);
                        if !is_unknown(&et) && !is_unit_ty(&et)
                            && !agrees(&tt, &et) && !agrees(&et, &tt)
                        {
                            w.refused = true;
                        }
                    }
                    Option::None => {}
                }
                return tt;
            }
            ast::Ty::Unit
        }
        // A `while` answers with nothing wherever it is written — it is a
        // statement, and where a block must answer that is the refusal the
        // other implementation words as a type that does not match
        // (§5.5, G9.159).
        ast::Expr::While(c, b) => ast::Ty::Unit,
        ast::Expr::Loop(b) => loop_type(w, b),
        ast::Expr::Match(s, arms) => {
            if arms.len() == 0 {
                return unknown();
            }
            // What the arms that answer bring: the first one, and an arm
            // that left or whose block completed with nothing is never
            // asked (§5.4, G9.165).
            let mut i: taddr = 0;
            while i < arms.len() {
                let here = type_of(w, &arms[i].body);
                if !is_unknown(&here) && !is_unit_ty(&here) {
                    return here;
                }
                i += 1;
            }
            // Every arm left: what the match answers is `()` where a
            // scalar's chain of tests is done — a refusal wherever a value
            // was wanted, which is G9.165 — and nothing at all where an
            // enum's variants or a trit's three doors were the question,
            // because asking what those answer is already answered.
            let whole = type_of(w, s);
            let bare = strip(&whole);
            if enum_named_ty(w, &bare) {
                return unknown();
            }
            if trit_dispatch_ty(&bare, arms) {
                return unknown();
            }
            ast::Ty::Unit
        }
        _ => unknown(),
    }
}

/// What a `loop` answers with (§5.5): the type a `break` carries where
/// one does, `()` where nothing is carried — so that an arm asking the
/// loop for an answer and getting none is the same refusal a wrong type
/// is (G9.159) — and what this checker says wherever nothing leaves:
/// such a loop never ends, and what it would answer is never asked.
/// The `()` of a block that completed with nothing — told from the
/// checker saying it does not know, which is a different sentence: one it
/// may not refuse, and one it must (G9.171).
fn is_unit_ty(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Unit => true,
        _ => false,
    }
}

/// Whether this is one of the scalars a `match` dispatches over by test —
/// the scrutinee is stripped of references first, as everywhere else here.
fn scalar_named_ty(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Name(segments) => {
            let head = joined(segments);
            head.same("t27") || head.same("taddr") || head.same("t9")
                || head.same("bool") || head.same("trit") || head.same("char")
        }
        _ => false,
    }
}

/// Whether the name is one a program defined variants for — which is what
/// asks the match's question where a scalar asks with tests.
fn enum_named_ty(w: &World, t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Name(segments) => {
            let head = joined(segments);
            let mut i: taddr = 0;
            while i < w.variants.len() {
                if w.variants[i].owner.same(&head) {
                    return true;
                }
                i += 1;
            }
            false
        }
        _ => false,
    }
}

/// The trit literal's own dispatch: arms of nothing but trit literals,
/// naming each of the three values exactly once (Ch. 1 §5).
fn trit_dispatch_ty(t: &ast::Ty, arms: &Vec<ast::Arm>) -> bool {
    let is_trit = match t {
        ast::Ty::Name(segments) => joined(segments).same("trit"),
        _ => false,
    };
    if !is_trit {
        return false;
    }
    let mut seen: Vec<t27> = Vec::new();
    let mut i: taddr = 0;
    while i < arms.len() {
        match &arms[i].guard {
            Option::Some(g) => return false,
            Option::None => {}
        }
        let mut j: taddr = 0;
        while j < arms[i].patterns.len() {
            match &arms[i].patterns[j] {
                ast::Pattern::Trit(v) => {
                    let mut k: taddr = 0;
                    while k < seen.len() {
                        if seen[k] == v {
                            return false;
                        }
                        k += 1;
                    }
                    seen.push(v);
                }
                _ => return false,
            }
            j += 1;
        }
        i += 1;
    }
    seen.len() == 3
}

/// Whether an arm's body ends leaving — which is what a bare `return` and
/// a block that never reaches its end have in common, and what a
/// completed `{ g(); }` does not.
fn arm_body_leaves(body: &ast::Expr) -> bool {
    match body {
        ast::Expr::Nested(b) => {
            if b.stmts.len() == 0 {
                return false;
            }
            match &b.stmts[b.stmts.len() - 1] {
                ast::Stmt::Do(e) => diverges(e),
                _ => false,
            }
        }
        _ => true,
    }
}

/// Whether the arm's body *names* this pattern bind — which a bare name
/// in a scalar arm never introduced, so the ask is not-in-scope wherever
/// it happens (G9.163). Names the body itself declares shadow it, as they
/// do everywhere.
fn arm_body_uses(w: &mut World, body: &ast::Expr, name: &str) -> bool {
    let mut declared: Vec<String> = Vec::new();
    expr_names(body, name, &mut declared)
}

fn block_names(b: &ast::Block, name: &str, declared: &mut Vec<String>) -> bool {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(m, n, written, v) => {
                if expr_names(v, name, declared) {
                    return true;
                }
                declared.push(n.to_string());
            }
            ast::Stmt::LetPattern(n, p, v) => {
                if expr_names(v, name, declared) {
                    return true;
                }
            }
            ast::Stmt::Do(e) => {
                if expr_names(e, name, declared) {
                    return true;
                }
            }
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(e) => expr_names(e, name, declared),
        Option::None => false,
    }
}

fn jump_names(v: &Option<Box<ast::Expr>>, name: &str, declared: &mut Vec<String>) -> bool {
    match v {
        Option::Some(x) => expr_names(&*x, name, declared),
        Option::None => false,
    }
}

fn call_args_names(args: &Vec<ast::Expr>, name: &str, declared: &mut Vec<String>) -> bool {
    item_names(args, name, declared)
}

fn item_names(items: &Vec<ast::Expr>, name: &str, declared: &mut Vec<String>) -> bool {
    let mut i: taddr = 0;
    while i < items.len() {
        if expr_names(&items[i], name, declared) {
            return true;
        }
        i += 1;
    }
    false
}

fn expr_names(e: &ast::Expr, name: &str, declared: &mut Vec<String>) -> bool {
    match e {
        ast::Expr::Name(n) => {
            if !n.same(name) {
                return false;
            }
            let mut i: taddr = 0;
            while i < declared.len() {
                if declared[i].same(name) {
                    return false;
                }
                i += 1;
            }
            true
        }
        ast::Expr::Nested(b) => block_names(b, name, declared),
        ast::Expr::Group(a) => expr_names(&*a, name, declared),
        ast::Expr::Try(a) => expr_names(&*a, name, declared),
        ast::Expr::Borrow(a, m) => expr_names(&*a, name, declared),
        ast::Expr::Deref(a) => expr_names(&*a, name, declared),
        ast::Expr::Cast(a, t) => expr_names(&*a, name, declared),
        ast::Expr::Field(a, f) => expr_names(&*a, name, declared),
        ast::Expr::Unary(op, a) => expr_names(&*a, name, declared),
        ast::Expr::Binary(op, a, b) => {
            expr_names(&*a, name, declared) || expr_names(&*b, name, declared)
        }
        ast::Expr::Assign(op, a, b) => {
            expr_names(&*a, name, declared) || expr_names(&*b, name, declared)
        }
        ast::Expr::Repeat(a, b) => {
            expr_names(&*a, name, declared) || expr_names(&*b, name, declared)
        }
        ast::Expr::Index(a, b) => {
            expr_names(&*a, name, declared) || expr_names(&*b, name, declared)
        }
        ast::Expr::Call(n, args) => call_args_names(args, name, declared),
        ast::Expr::CallExpr(n, args) => call_args_names(args, name, declared),
        ast::Expr::Method(r, n, args) => {
            if expr_names(&*r, name, declared) {
                return true;
            }
            let mut i: taddr = 0;
            while i < args.len() {
                if expr_names(&args[i], name, declared) {
                    return true;
                }
                i += 1;
            }
            false
        }
        ast::Expr::Aggregate(p, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                if expr_names(&fields[i].value, name, declared) {
                    return true;
                }
                i += 1;
            }
            false
        }
        ast::Expr::Array(items) => item_names(items, name, declared),
        ast::Expr::Tuple(items) => item_names(items, name, declared),
        ast::Expr::If(c, t, o) => {
            if expr_names(c, name, declared) || block_names(t, name, declared) {
                return true;
            }
            match o {
                Option::Some(x) => expr_names(&*x, name, declared),
                Option::None => false,
            }
        }
        ast::Expr::While(c, b) => {
            expr_names(c, name, declared) || block_names(b, name, declared)
        }
        ast::Expr::Loop(b) => block_names(b, name, declared),
        ast::Expr::Match(s, arms) => {
            if expr_names(&*s, name, declared) {
                return true;
            }
            let mut i: taddr = 0;
            while i < arms.len() {
                match &arms[i].guard {
                    Option::Some(g) => {
                        if expr_names(g, name, declared) {
                            return true;
                        }
                    }
                    Option::None => {}
                }
                if expr_names(&arms[i].body, name, declared) {
                    return true;
                }
                i += 1;
            }
            false
        }
        ast::Expr::Closure(params, ret, body) => {
            let mut i: taddr = 0;
            while i < params.len() {
                if params[i].name.same(name) {
                    declared.push(name.to_string());
                }
                i += 1;
            }
            expr_names(&*body, name, declared)
        }
        ast::Expr::Break(v) => jump_names(v, name, declared),
        ast::Expr::Return(v) => jump_names(v, name, declared),
        _ => false,
    }
}

fn loop_type(w: &mut World, b: &ast::Block) -> ast::Ty {
    let mut any = false;
    let mut value: Option<ast::Ty> = Option::None;
    scan_block(w, b, &mut any, &mut value);
    match value {
        Option::Some(t) => t,
        Option::None => {
            if any {
                ast::Ty::Unit
            } else {
                unknown()
            }
        }
    }
}

/// The `break`s a loop body holds, told as `any` and the first value one
/// carries. A `break` inside a `while`, another loop or a closure leaves
/// *that* construct and says nothing here.
fn scan_block(
    w: &mut World,
    b: &ast::Block,
    any: &mut bool,
    value: &mut Option<ast::Ty>,
) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(m, name, written, v) => scan_expr(w, v, any, value),
            ast::Stmt::LetPattern(name, pat, v) => scan_expr(w, v, any, value),
            ast::Stmt::Do(e) => scan_expr(w, e, any, value),
            _ => {}
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(e) => scan_expr(w, e, any, value),
        Option::None => {}
    }
}

fn scan_expr(
    w: &mut World,
    e: &ast::Expr,
    any: &mut bool,
    value: &mut Option<ast::Ty>,
) {
    match e {
        ast::Expr::Break(v) => {
            *any = true;
            match v {
                Option::Some(x) => {
                    match value {
                        Option::Some(t) => {}
                        Option::None => *value = Option::Some(type_of(w, x)),
                    }
                }
                Option::None => {}
            }
        }
        ast::Expr::While(c, b) => {}
        ast::Expr::Loop(b) => {}
        ast::Expr::For(n, it, b) => scan_expr(w, it, any, value),
        ast::Expr::Closure(params, answer, body) => {}
        ast::Expr::Nested(b) => scan_block(w, b, any, value),
        ast::Expr::If(c, t, o) => {
            scan_expr(w, c, any, value);
            scan_block(w, t, any, value);
            match o {
                Option::Some(x) => scan_expr(w, x, any, value),
                Option::None => {}
            }
        }
        ast::Expr::Match(s, arms) => {
            scan_expr(w, s, any, value);
            let mut i: taddr = 0;
            while i < arms.len() {
                match &arms[i].guard {
                    Option::Some(g) => scan_expr(w, g, any, value),
                    Option::None => {}
                }
                scan_expr(w, &arms[i].body, any, value);
                i += 1;
            }
        }
        ast::Expr::Group(a) => scan_expr(w, a, any, value),
        ast::Expr::Try(a) => scan_expr(w, a, any, value),
        ast::Expr::Unary(op, a) => scan_expr(w, a, any, value),
        ast::Expr::Borrow(a, m) => scan_expr(w, a, any, value),
        ast::Expr::Deref(a) => scan_expr(w, a, any, value),
        ast::Expr::Field(a, name) => scan_expr(w, a, any, value),
        ast::Expr::Cast(a, t) => scan_expr(w, a, any, value),
        ast::Expr::Binary(op, a, b) => {
            scan_expr(w, a, any, value);
            scan_expr(w, b, any, value);
        }
        ast::Expr::Assign(op, a, b) => {
            scan_expr(w, a, any, value);
            scan_expr(w, b, any, value);
        }
        ast::Expr::Index(a, i) => {
            scan_expr(w, a, any, value);
            scan_expr(w, i, any, value);
        }
        ast::Expr::Call(name, args) => scan_all(w, args, any, value),
        ast::Expr::CallExpr(f, args) => {
            scan_expr(w, f, any, value);
            scan_all(w, args, any, value);
        }
        ast::Expr::Method(r, name, args) => {
            scan_expr(w, r, any, value);
            scan_all(w, args, any, value);
        }
        ast::Expr::Array(parts) => scan_all(w, parts, any, value),
        ast::Expr::Tuple(parts) => scan_all(w, parts, any, value),
        ast::Expr::Repeat(a, n) => {
            scan_expr(w, a, any, value);
            scan_expr(w, n, any, value);
        }
        ast::Expr::Aggregate(path, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                scan_expr(w, &fields[i].value, any, value);
                i += 1;
            }
        }
        ast::Expr::Return(v) => {
            match v {
                Option::Some(x) => scan_expr(w, x, any, value),
                Option::None => {}
            }
        }
        _ => {}
    }
}

fn scan_all(
    w: &mut World,
    args: &Vec<ast::Expr>,
    any: &mut bool,
    value: &mut Option<ast::Ty>,
) {
    let mut i: taddr = 0;
    while i < args.len() {
        scan_expr(w, &args[i], any, value);
        i += 1;
    }
}

/// Whether a value of the second type is one of the first.
///
/// There are no implicit conversions (Ch. 0 §5.2), so this is equality —
/// with one exception, and it is the one the language states: `()` is what
/// this checker answers where it does not know, and a thing it does not
/// know is not a thing it may refuse.
pub fn agrees(want: &ast::Ty, got: &ast::Ty) -> bool {
    // `()` on the answering side is this checker saying it does not know,
    // and a thing it does not know is not a thing it may refuse. It says so
    // at every level, because an argument it could not work out does not
    // make the type around it wrong.
    if is_unknown(got) {
        return true;
    }
    match got {
        ast::Ty::Name(segments) => {
            // A literal takes its width from what is around it (§5.2).
            if joined(segments).same("#int") {
                return is_integer(want);
            }
        }
        _ => {}
    }
    match want {
        ast::Ty::Ref(a, m) => {
            match got {
                ast::Ty::Ref(b, n) => {
                    // A `&Vec<T>` is accepted where a `&[T]` is wanted, and
                    // a `&Vec<char>` where a `&str` is: what a vector owns
                    // is a run of elements, and a slice is a run of them
                    // (Ch. 5 §2). The permission goes down, never up.
                    if slice_of(a, b) {
                        return true;
                    }
                    agrees(a, b)
                }
                _ => false,
            }
        }
        ast::Ty::Slice(a) => {
            match got {
                ast::Ty::Slice(b) => agrees(a, b),
                _ => false,
            }
        }
        ast::Ty::App(head, args) => {
            match got {
                ast::Ty::App(other, given) => {
                    let a = joined(head);
                    let b = joined(other);
                    if !a.same(&b) || args.len() != given.len() {
                        return false;
                    }
                    let mut i: taddr = 0;
                    while i < args.len() {
                        if !agrees(&args[i], &given[i]) {
                            return false;
                        }
                        i += 1;
                    }
                    true
                }
                _ => false,
            }
        }
        _ => same_ty(want, got),
    }
}

/// Whether `want` is the slice a `Vec` of `got` lends.
fn slice_of(want: &ast::Ty, got: &ast::Ty) -> bool {
    let element = match got {
        ast::Ty::App(segments, args) => {
            if !joined(segments).same("Vec") || args.len() != 1 {
                return false;
            }
            ast::copy_ty(&args[0])
        }
        _ => return false,
    };
    match want {
        ast::Ty::Slice(inner) => agrees(inner, &element),
        // A `str` is a slice of characters (Ch. 5 §1.1).
        ast::Ty::Name(segments) => {
            let ch = named("char");
            joined(segments).same("str") && agrees(&ch, &element)
        }
        _ => false,
    }
}

/// Whether a type is one an integer literal may become (Ch. 1 §2).
fn is_integer(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Name(segments) => {
            let n = joined(segments);
            n.same("t9") || n.same("t27") || n.same("taddr") || n.same("#int")
        }
        _ => false,
    }
}

/// Whether two types are the same type.
fn same_ty(a: &ast::Ty, b: &ast::Ty) -> bool {
    let mut x: String = Vec::new();
    let mut y: String = Vec::new();
    show_type(a, &mut x);
    show_type(b, &mut y);
    x.same(&y)
}

/// What this checker answers where it does not know.
///
/// Told apart from `()`, which is a type a program can write and therefore
/// a type it can get wrong: `fn f() -> t27 { }` answers `()` and is refused,
/// and it would not be if not knowing and answering nothing were the same
/// thing. It prints as `()` because nothing that reaches a report is one.
fn unknown() -> ast::Ty {
    named("#unknown")
}

/// Whether a type is this checker's admission that it does not know.
fn is_unknown(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Name(segments) => joined(segments).same("#unknown"),
        _ => false,
    }
}

/// A type, as the name it has once it is one type and not a family.
///
/// A generic type is *monomorphized* (Ch. 4 §2.5): `Option<taddr>` becomes
/// one type whose name is its head and its arguments with `.` between them,
/// which is how Ch. 6 §4 writes a path and for the same reason — TIR §1
/// admits a `.` in an identifier and not a `<`.
///
/// A `Vec` is the exception because it is not a family the program can
/// instantiate: it is one type the language writes, and it keeps its name.
/// A type argument, as the one name an instantiation takes it under.
///
/// The arguments are joined with `.` and each argument is written *flat*:
/// `Holder<Pair<t27>>` is `Holder.Pair_t27_` and not `Holder.Pair.t27`,
/// because the second cannot be read back — the dots do not say where one
/// argument stops. Every character a name cannot hold becomes `_`
/// (Ch. 6 §4).
fn flattened(t: &ast::Ty) -> String {
    let mut written: String = Vec::new();
    // As it was *written*, and then flattened: `show_type` has already
    // turned an application into a name, and a name has nothing left to
    // flatten. A bare name is the exception, because that is where `#int`
    // becomes the word §5.2 says it is.
    // An argument that is itself a *type the program defines* is one type
    // by then, and contributes the name that type has: `Holder<Option<t27>>`
    // is `Holder.Option.t27`. One the compiler keeps structural — a `Box`, a
    // reference — has no such name, so what it contributes is what was
    // written, with every character a name cannot hold made `_`. `Vec` was
    // in that list while it was a type the compiler knew; it is a type the
    // library defines now, and has a name like any other (G9.86).
    let structural = match t {
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            head.same("Box")
        }
        ast::Ty::Name(segments) => false,
        _ => true,
    };
    if structural {
        ast::show_ty(t, &mut written);
    } else {
        show_type(t, &mut written);
    }
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < written.len() {
        let c = written[i];
        if c == '<' || c == '>' || c == ',' || c == ' ' || c == '&'
            || c == '[' || c == ']' || c == '(' || c == ')'
        {
            out.push('_');
        } else {
            out.push(c);
        }
        i += 1;
    }
    out
}

pub fn show_type(t: &ast::Ty, out: &mut String) {
    match t {
        // A literal that nothing decided is a word (§5.2), and what this
        // checker does not know prints as nothing, which is what it is.
        ast::Ty::Name(segments) => {
            let n = joined(segments);
            if n.same("#int") {
                out.push_str("t27");
            } else if n.same("#unknown") {
                out.push_str("()");
            } else {
                ast::show_ty(t, out);
            }
        }
        // Every instantiation prints under the name it was made with —
        // `Pair.t27`, and `Vec.char` with it. `Vec` used to be spelled the
        // way it is written, because it used to be a type the compiler
        // knew; it is library code now and is no more special than `Pair`
        // (G9.86).
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            out.push_str(&head);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(".");
                let each = flattened(&args[i]);
                out.push_str(&each);
                i += 1;
            }
        }
        ast::Ty::Ref(inner, mutable) => {
            if mutable {
                out.push_str("&mut ");
            } else {
                out.push_str("&");
            }
            show_type(inner, out);
        }
        ast::Ty::Slice(inner) => {
            out.push_str("[");
            show_type(inner, out);
            out.push_str("]");
        }
        _ => ast::show_ty(t, out),
    }
}

/// A block's type is its tail's, or `()` when it has none (§5.1).
///
/// Its statements are typed on the way: the tail may name what a `let`
/// inside it bound, and a scope that was not entered has nothing to say
/// about `{ let inner = n * 2; inner }`.
fn block_type(w: &mut World, b: &ast::Block) -> ast::Ty {
    let mark = w.locals.len();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, value) => {
                let t = match written {
                    Option::Some(x) => expand(w, x),
                    Option::None => type_of(w, value),
                };
                w.locals.push(Binding { name: name.to_string(), ty: t });
            }
            _ => {}
        }
        i += 1;
    }
    let out = match &b.tail {
        Option::Some(e) => type_of(w, e),
        // A block with no tail is `()`, and leaving does not change that —
        // dead code is still code, and a type is not a complaint: the tail
        // that was never reached says the same thing either way (G9.166,
        // G9.171).
        Option::None => ast::Ty::Unit
    };
    unbind(w, mark);
    out
}

/// What a name in scope is, or nothing when this checker does not know.
///
/// A pattern's bindings are not in scope here — they are the pattern's, and
/// nothing records them yet — so a name it has not seen is an admission and
/// not a claim that the name is `()`.
fn look_up(w: &mut World, name: &str) -> ast::Ty {
    let mut i = w.locals.len();
    while i > 0 {
        i -= 1;
        if w.locals[i].name.same(name) {
            return ast::copy_ty(&w.locals[i].ty);
        }
    }
    unknown()
}

/// The type of a field of a named struct.
fn field_type(w: &mut World, owner: &str, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < w.fields.len() {
        if w.fields[i].owner.same(owner) && w.fields[i].name.same(name) {
            return ast::copy_ty(&w.fields[i].ty);
        }
        i += 1;
    }
    unknown()
}

/// What a function of this name answers with.
fn return_of(w: &mut World, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < w.sigs.len() {
        if w.sigs[i].name.same(name) {
            return ast::copy_ty(&w.sigs[i].ret);
        }
        i += 1;
    }
    unknown()
}

/// `Kind::Rect(2, 3)` is a value of `Kind`; `Point { x: 1 }` is one of
/// `Point`. Both are written the same way and told apart by the `::`.
fn aggregate_type(w: &mut World, path: &str, fields: &Vec<ast::Field>) -> ast::Ty {
    let segments = split_path(path);
    if segments.len() < 2 {
        return named(path);
    }
    let owner = segments[0].to_string();
    let variant = segments[1].to_string();
    let at = variant_at(w, &owner, &variant);
    if at < 0 {
        // Not a variant of anything known: `Vec::new()` is a call of an
        // associated function, and answering `Vec` would be a guess. This
        // checker says what it knows, and says so.
        return unknown();
    }
    if w.variants[at].params.len() == 0 {
        return named(&owner);
    }
    // What the parameters are is what the payload turned out to be.
    let params = ast::copy_names(&w.variants[at].params);
    let mut bound: Vec<Binding> = Vec::new();
    let mut i: taddr = 0;
    while i < fields.len() && i < w.variants[at].fields.len() {
        let declared = ast::copy_ty(&w.variants[at].fields[i]);
        let actual = type_of(w, &fields[i].value);
        bind_params(&params, &declared, &actual, &mut bound);
        i += 1;
    }
    let mut args: Vec<ast::Ty> = Vec::new();
    let mut k: taddr = 0;
    while k < params.len() {
        args.push(bound_or_unit(&bound, &params[k]));
        k += 1;
    }
    ast::Ty::App(path_of(&owner), args)
}

/// Which variant of which enum, or −1.
fn variant_at(w: &World, owner: &str, variant: &str) -> taddr {
    let mut i: taddr = 0;
    while i < w.variants.len() {
        if w.variants[i].owner.same(owner) && w.variants[i].name.same(variant) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Match a declared type against what was passed, binding the parameters
/// it names on the way (Ch. 4 §2.3).
fn bind_params(
    params: &Vec<String>,
    declared: &ast::Ty,
    actual: &ast::Ty,
    out: &mut Vec<Binding>,
) {
    match declared {
        ast::Ty::Name(segments) => {
            let name = joined(segments);
            if holds_name(params, &name) {
                out.push(Binding { name: name, ty: ast::copy_ty(actual) });
            }
        }
        ast::Ty::Ref(inner, m) => {
            match actual {
                ast::Ty::Ref(other, n) => bind_params(params, inner, other, out),
                _ => {}
            }
        }
        ast::Ty::App(segments, args) => {
            match actual {
                ast::Ty::App(other, given) => {
                    let mut i: taddr = 0;
                    while i < args.len() && i < given.len() {
                        bind_params(params, &args[i], &given[i], out);
                        i += 1;
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
}

fn holds_name(names: &Vec<String>, name: &str) -> bool {
    let mut i: taddr = 0;
    while i < names.len() {
        if names[i].same(name) {
            return true;
        }
        i += 1;
    }
    false
}

fn bound_or_unit(bound: &Vec<Binding>, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < bound.len() {
        if bound[i].name.same(name) {
            return ast::copy_ty(&bound[i].ty);
        }
        i += 1;
    }
    unknown()
}

/// A path written `a::b`, as its segments.
fn split_path(path: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut cur: String = Vec::new();
    let mut i: taddr = 0;
    while i < path.len() {
        if path[i] == ':' && i + 1 < path.len() && path[i + 1] == ':' {
            out.push(cur);
            cur = Vec::new();
            i += 2;
        } else {
            cur.push(path[i]);
            i += 1;
        }
    }
    out.push(cur);
    out
}

/// The two enums Ch. 5 §6 makes language types. They are not in the file
/// being read, and a checker that did not know them would answer nothing
/// about the two answers every fallible function gives.
fn prelude(w: &mut World) {
    // Ch. 0 §3.6 and Ch. 5 §1.1: a `String` is a `Vec<char>` and is one
    // name for it, not a type of its own.
    w.aliases.push(Binding {
        name: "String".to_string(),
        ty: ast::Ty::App(path_of("Vec"), one_ty(named("char"))),
    });
    let mut t: Vec<String> = Vec::new();
    t.push("T".to_string());
    w.variants.push(Variant {
        owner: "Option".to_string(),
        params: ast::copy_names(&t),
        name: "None".to_string(),
        fields: Vec::new(),
    });
    w.variants.push(Variant {
        owner: "Option".to_string(),
        params: ast::copy_names(&t),
        name: "Some".to_string(),
        fields: one_ty(named("T")),
    });
    let mut te: Vec<String> = Vec::new();
    te.push("T".to_string());
    te.push("E".to_string());
    w.variants.push(Variant {
        owner: "Result".to_string(),
        params: ast::copy_names(&te),
        name: "Ok".to_string(),
        fields: one_ty(named("T")),
    });
    w.variants.push(Variant {
        owner: "Result".to_string(),
        params: ast::copy_names(&te),
        name: "Err".to_string(),
        fields: one_ty(named("E")),
    });
}

/// The methods the language writes, by receiver (Ch. 5 §2).
fn method_type(w: &mut World, on: &ast::Ty, name: &str) -> ast::Ty {
    // What the program wrote comes first: a method the language also names
    // is the program's on a type the language writes nothing on (§2.5).
    let owner = head_of(on);
    let mut i: taddr = 0;
    while i < w.methods.len() {
        if w.methods[i].owner.same(&owner) && w.methods[i].name.same(name) {
            return ast::copy_ty(&w.methods[i].ret);
        }
        i += 1;
    }
    if name.same("len") {
        return named("taddr");
    }
    if name.same("is_empty") {
        return named("bool");
    }
    if name.same("push") || name.same("clear") || name.same("reserve") {
        return ast::Ty::Unit;
    }
    if name.same("to_string") {
        return ast::Ty::App(path_of("Vec"), one_ty(named("char")));
    }
    if name.same("same") || name.same("starts_with") || name.same("contains") {
        return named("bool");
    }
    unknown()
}

/// The first type argument of `Option<T>` or `Result<T, E>`.
fn first_argument(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            if (head.same("Option") || head.same("Result")) && args.len() > 0 {
                return ast::copy_ty(&args[0]);
            }
            unknown()
        }
        _ => unknown(),
    }
}

/// What indexing gives: a `Vec`'s element, a slice's, a string's character.
fn element_of(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::App(segments, args) => {
            if args.len() == 1 {
                return ast::copy_ty(&args[0]);
            }
            unknown()
        }
        ast::Ty::Slice(inner) => ast::copy_ty(inner),
        ast::Ty::Name(segments) => {
            // A `str` is characters, and walking one gives them (Ch. 5 §1.1).
            if joined(segments).same("str") {
                named("char")
            } else {
                unknown()
            }
        }
        _ => unknown(),
    }
}

/// What a reference points at.
fn target_of(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Ref(inner, m) => ast::copy_ty(inner),
        _ => unknown(),
    }
}

/// A type with its references taken off, which is what a `.` reaches
/// through (Ch. 3 §2.3).
fn strip(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Ref(inner, m) => strip(inner),
        _ => ast::copy_ty(t),
    }
}

/// The name at the head of a type, or nothing for one that has none.
fn head_of(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        ast::Ty::App(segments, args) => joined(segments),
        _ => "".to_string(),
    }
}

fn joined(segments: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < segments.len() {
        if i > 0 {
            out.push_str("::");
        }
        out.push_str(&segments[i]);
        i += 1;
    }
    out
}

fn named(name: &str) -> ast::Ty {
    ast::Ty::Name(path_of(name))
}

fn path_of(name: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    out.push(name.to_string());
    out
}

fn one_ty(t: ast::Ty) -> Vec<ast::Ty> {
    let mut out: Vec<ast::Ty> = Vec::new();
    out.push(t);
    out
}

/// A type with every alias taken off (Ch. 0 §3.6). An alias is a name for
/// a type and never a type, so nothing below here should ever see one.
fn expand(w: &World, t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => {
            let name = joined(segments);
            let mut i: taddr = 0;
            while i < w.aliases.len() {
                if w.aliases[i].name.same(&name) {
                    let inner = ast::copy_ty(&w.aliases[i].ty);
                    return expand(w, &inner);
                }
                i += 1;
            }
            ast::copy_ty(t)
        }
        ast::Ty::App(segments, args) => {
            let mut out: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                out.push(expand(w, &args[i]));
                i += 1;
            }
            ast::Ty::App(ast::copy_names(segments), out)
        }
        ast::Ty::Ref(inner, m) => ast::Ty::Ref(Box::new(expand(w, inner)), m),
        ast::Ty::Slice(inner) => ast::Ty::Slice(Box::new(expand(w, inner))),
        _ => ast::copy_ty(t),
    }
}



/// Forget every local bound since the mark.
fn unbind(w: &mut World, mark: taddr) {
    while w.locals.len() > mark {
        w.locals.pop();
    }
}


