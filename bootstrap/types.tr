// Ch. 4, in Trust: what type every binding in a function turned out to have.
//
//     trust run bootstrap/types.tr < file.tr
//
// One line per `let` — `<function> <name> <type>` — in source order, which
// is what `trust types` prints. A `let` is where inference is visible: it is
// the thing `let n = 1;` does not say, and the whole of what a checker knows
// about an expression has to be right for the answer to be.
//
// It types a *file*, not a program: the question needs no module machinery,
// and asking it of one file keeps the spans and the scopes to one place.
//
// What it does not do yet is generics. A generic function is typed once per
// instantiation (Ch. 4 §2.5), so there is no one answer to print, and both
// implementations skip one.

mod ast;
mod input;
mod lex;
mod parse;

/// One name in scope, and what it is.
pub struct Binding {
    pub name: String,
    pub ty: ast::Ty,
}

/// One field of one struct, flattened: nothing here needs them grouped.
pub struct Field {
    pub owner: String,
    pub name: String,
    pub ty: ast::Ty,
}

/// A function's signature, which is all a call needs.
pub struct Sig {
    pub name: String,
    pub params: Vec<ast::Ty>,
    pub ret: ast::Ty,
}

/// One variant, and what its enum is.
///
/// A generic enum's variant carries the enum's parameters, so what
/// `Option::Some(3)` is depends on what `3` is: the payload's declared
/// types are matched against the arguments' and the answer is the enum with
/// those (Ch. 4 §2.3).
pub struct Variant {
    pub owner: String,
    pub params: Vec<String>,
    pub name: String,
    pub fields: Vec<ast::Ty>,
}

/// One method, and the type it is written on. A method is reached through
/// its receiver, so the receiver's head is half of its name (Ch. 4 §1.2).
pub struct Method {
    pub owner: String,
    pub name: String,
    pub ret: ast::Ty,
}

/// What the file defines, and what is in scope where the walk has reached.
pub struct World {
    /// `type Name = T;` — only a name (Ch. 0 §3.6), so a name is what it
    /// is taken off before anything else asks what a type is.
    pub aliases: Vec<Binding>,
    pub fields: Vec<Field>,
    pub sigs: Vec<Sig>,
    pub methods: Vec<Method>,
    pub variants: Vec<Variant>,
    pub locals: Vec<Binding>,
}

fn main() -> t27 {
    let src = input::read_all();
    let mut p = parse::Parser { src: src, at: 0, no_struct: false };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut w = World {
                aliases: Vec::new(),
                fields: Vec::new(),
                sigs: Vec::new(),
                methods: Vec::new(),
                variants: Vec::new(),
                locals: Vec::new(),
            };
            prelude(&mut w);
            // Aliases first: one may be written after what uses it, and
            // nothing below should ever see a name that is only a name.
            let mut a: taddr = 0;
            while a < items.len() {
                gather_alias(&mut w, &items[a]);
                a += 1;
            }
            let mut i: taddr = 0;
            while i < items.len() {
                gather(&mut w, &items[i]);
                i += 1;
            }
            let mut k: taddr = 0;
            while k < items.len() {
                walk_item(&mut w, &items[k]);
                k += 1;
            }
            0
        }
        Result::Err(err) => {
            print("error ");
            print_int(err.at as t27);
            println("");
            0
        }
    }
}

/// The aliases, which are read before anything else (Ch. 0 §3.6).
fn gather_alias(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Alias(name, ty) => {
            w.aliases.push(Binding { name: name.to_string(), ty: copy_ty(ty) });
        }
        _ => {}
    }
}

/// What one item defines, for the passes that follow.
fn gather(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Struct(name, gs, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                let t = expand(w, &fields[i].ty);
                w.fields.push(Field {
                    owner: name.to_string(),
                    name: fields[i].name.to_string(),
                    ty: t,
                });
                i += 1;
            }
        }
        ast::What::Enum(name, gs, variants) => {
            let mut params: Vec<String> = Vec::new();
            let mut g: taddr = 0;
            while g < gs.len() {
                match &gs[g] {
                    ast::Generic::Type(n, bounds) => params.push(n.to_string()),
                    ast::Generic::Const(n, ty) => {}
                }
                g += 1;
            }
            let mut i: taddr = 0;
            while i < variants.len() {
                let mut fields: Vec<ast::Ty> = Vec::new();
                let mut k: taddr = 0;
                while k < variants[i].fields.len() {
                    fields.push(expand(w, &variants[i].fields[k]));
                    k += 1;
                }
                w.variants.push(Variant {
                    owner: name.to_string(),
                    params: copy_names(&params),
                    name: variants[i].name.to_string(),
                    fields: fields,
                });
                i += 1;
            }
        }
        ast::What::Impl(gs, tr, ty, fns) => {
            // A method of a generic impl is typed once per instantiation,
            // so there is no one answer and it is left out (§2.5).
            if gs.len() > 0 {
                return;
            }
            let owner = head_of(ty);
            let mut i: taddr = 0;
            while i < fns.len() {
                let ret = expand(w, &fns[i].ret);
                w.methods.push(Method {
                    owner: owner.to_string(),
                    name: fns[i].name.to_string(),
                    ret: ret,
                });
                i += 1;
            }
        }
        ast::What::Function(f) => {
            let mut params: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < f.params.len() {
                params.push(expand(w, &f.params[i].ty));
                i += 1;
            }
            let ret = expand(w, &f.ret);
            w.sigs.push(Sig { name: f.name.to_string(), params: params, ret: ret });
        }
        _ => {}
    }
}

/// Every `let` in an item's functions, and what it turned out to be.
fn walk_item(w: &mut World, item: &ast::Item) {
    match &item.what {
        ast::What::Function(f) => {
            // A generic function is typed once per instantiation, so there
            // is no one answer to print (Ch. 4 §2.5).
            if f.generics.len() > 0 {
                return;
            }
            match &f.body {
                Option::Some(b) => walk_fn(w, f, b),
                Option::None => {}
            }
        }
        _ => {}
    }
}

fn walk_fn(w: &mut World, f: &ast::Fn, body: &ast::Block) {
    let mark = w.locals.len();
    let mut i: taddr = 0;
    while i < f.params.len() {
        let t = expand(w, &f.params[i].ty);
        w.locals.push(Binding { name: f.params[i].name.to_string(), ty: t });
        i += 1;
    }
    walk_block(w, &f.name, body);
    unbind(w, mark);
}

fn walk_block(w: &mut World, what: &str, b: &ast::Block) {
    let mark = w.locals.len();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, value) => {
                // A written type is the answer; inference is for the `let`
                // that does not say (§5.2).
                let t = match written {
                    Option::Some(x) => expand(w, x),
                    Option::None => type_of(w, value),
                };
                print(what);
                print(" ");
                print(name);
                print(" ");
                let mut out: String = Vec::new();
                show_type(&t, &mut out);
                println(&out);
                // The value's own blocks come after, because a `let` is
                // reported where it is written and what is inside it is
                // written after it.
                walk_expr(w, what, value);
                w.locals.push(Binding { name: name.to_string(), ty: t });
            }
            // What a pattern binds is the pattern's, and nothing records
            // those yet — on either side.
            ast::Stmt::LetPattern(pat, value) => {
                let t = type_of(w, value);
            }
            ast::Stmt::Do(e) => walk_expr(w, what, e),
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(e) => walk_expr(w, what, e),
        Option::None => {}
    }
    unbind(w, mark);
}

/// The blocks an expression holds, in source order.
fn walk_expr(w: &mut World, what: &str, e: &ast::Expr) {
    match e {
        ast::Expr::Nested(b) => walk_block(w, what, b),
        ast::Expr::If(c, t, o) => {
            walk_expr(w, what, c);
            walk_block(w, what, t);
            match o {
                Option::Some(x) => walk_expr(w, what, x),
                Option::None => {}
            }
        }
        ast::Expr::While(c, b) => {
            walk_expr(w, what, c);
            walk_block(w, what, b);
        }
        ast::Expr::Loop(b) => walk_block(w, what, b),
        ast::Expr::For(name, it, b) => {
            walk_expr(w, what, it);
            // The binding is what the loop walks over, one at a time, and
            // is in scope for the body (Ch. 4 §5.7).
            let over = type_of(w, it);
            let bare = strip(&over);
            let each = element_of(&bare);
            let mark = w.locals.len();
            w.locals.push(Binding { name: name.to_string(), ty: each });
            walk_block(w, what, b);
            unbind(w, mark);
        }
        ast::Expr::Match(s, arms) => {
            walk_expr(w, what, s);
            let mut i: taddr = 0;
            while i < arms.len() {
                match &arms[i].guard {
                    Option::Some(g) => walk_expr(w, what, g),
                    Option::None => {}
                }
                walk_expr(w, what, &arms[i].body);
                i += 1;
            }
        }
        ast::Expr::Binary(op, a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
        }
        ast::Expr::Assign(op, a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
        }
        ast::Expr::Group(a) => walk_expr(w, what, a),
        ast::Expr::Unary(op, a) => walk_expr(w, what, a),
        ast::Expr::Borrow(a, m) => walk_expr(w, what, a),
        ast::Expr::Deref(a) => walk_expr(w, what, a),
        ast::Expr::Try(a) => walk_expr(w, what, a),
        ast::Expr::Cast(a, t) => walk_expr(w, what, a),
        ast::Expr::Field(a, name) => walk_expr(w, what, a),
        ast::Expr::Index(a, b) => {
            walk_expr(w, what, a);
            walk_expr(w, what, b);
        }
        ast::Expr::Method(r, name, args) => {
            walk_expr(w, what, r);
            let mut i: taddr = 0;
            while i < args.len() {
                walk_expr(w, what, &args[i]);
                i += 1;
            }
        }
        ast::Expr::Call(name, args) => {
            let mut i: taddr = 0;
            while i < args.len() {
                walk_expr(w, what, &args[i]);
                i += 1;
            }
        }
        ast::Expr::Return(v) => walk_optional(w, what, v),
        ast::Expr::Break(v) => walk_optional(w, what, v),
        _ => {}
    }
}

fn walk_optional(w: &mut World, what: &str, v: &Option<Box<ast::Expr>>) {
    match v {
        Option::Some(e) => walk_expr(w, what, e),
        Option::None => {}
    }
}

/// What an expression is.
pub fn type_of(w: &mut World, e: &ast::Expr) -> ast::Ty {
    match e {
        // An integer with nothing to say otherwise is a word (§5.2).
        ast::Expr::Int(v) => named("t27"),
        ast::Expr::Char(v) => named("char"),
        ast::Expr::Trit(v) => named("trit"),
        ast::Expr::Bool(b) => named("bool"),
        ast::Expr::Str(s) => ast::Ty::Ref(Box::new(named("str")), false),
        ast::Expr::Unit => ast::Ty::Unit,
        ast::Expr::Name(n) => look_up(w, n),
        ast::Expr::Group(a) => type_of(w, a),
        ast::Expr::Cast(a, t) => expand(w, t),
        ast::Expr::Borrow(a, m) => ast::Ty::Ref(Box::new(type_of(w, a)), m),
        ast::Expr::Deref(a) => {
            let inner = type_of(w, a);
            target_of(&inner)
        }
        ast::Expr::Unary(op, a) => {
            if op.same("!") {
                named("bool")
            } else {
                type_of(w, a)
            }
        }
        ast::Expr::Binary(op, a, b) => {
            if ast::level(op) <= 4 {
                // Comparison and the two logical operators answer `bool`;
                // `<=>` answers a `trit` (Ch. 1 §4).
                if op.same("<=>") {
                    named("trit")
                } else {
                    named("bool")
                }
            } else {
                type_of(w, a)
            }
        }
        ast::Expr::Assign(op, a, b) => ast::Ty::Unit,
        // `e?` is the value when there is one and a return when there is
        // not, so what it *is* is the first argument of either answer
        // (Ch. 5 §6.2).
        ast::Expr::Try(a) => {
            let whole = type_of(w, a);
            first_argument(&whole)
        }
        ast::Expr::Field(a, name) => {
            let whole = type_of(w, a);
            let base = strip(&whole);
            let owner = head_of(&base);
            field_type(w, &owner, name)
        }
        ast::Expr::Index(a, i) => {
            let whole = type_of(w, a);
            let base = strip(&whole);
            element_of(&base)
        }
        ast::Expr::Call(name, args) => return_of(w, name),
        ast::Expr::Method(r, name, args) => {
            let whole = type_of(w, r);
            let on = strip(&whole);
            method_type(w, &on, name)
        }
        ast::Expr::Aggregate(path, fields) => aggregate_type(w, path, fields),
        ast::Expr::Nested(b) => block_type(w, b),
        ast::Expr::If(c, t, o) => block_type(w, t),
        ast::Expr::Match(s, arms) => {
            if arms.len() == 0 {
                return ast::Ty::Unit;
            }
            type_of(w, &arms[0].body)
        }
        _ => ast::Ty::Unit,
    }
}

/// A type, as the name it has once it is one type and not a family.
///
/// A generic type is *monomorphized* (Ch. 4 §2.5): `Option<taddr>` becomes
/// one type whose name is its head and its arguments with `.` between them,
/// which is how Ch. 6 §4 writes a path and for the same reason — TIR §1
/// admits a `.` in an identifier and not a `<`.
///
/// A `Vec` is the exception because it is not a family the program can
/// instantiate: it is one type the language writes, and it keeps its name.
pub fn show_type(t: &ast::Ty, out: &mut String) {
    match t {
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            if head.same("Vec") {
                ast::show_ty(t, out);
                return;
            }
            out.push_str(&head);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(".");
                show_type(&args[i], out);
                i += 1;
            }
        }
        ast::Ty::Ref(inner, mutable) => {
            if mutable {
                out.push_str("&mut ");
            } else {
                out.push_str("&");
            }
            show_type(inner, out);
        }
        ast::Ty::Slice(inner) => {
            out.push_str("[");
            show_type(inner, out);
            out.push_str("]");
        }
        _ => ast::show_ty(t, out),
    }
}

/// A block's type is its tail's, or `()` when it has none (§5.1).
///
/// Its statements are typed on the way: the tail may name what a `let`
/// inside it bound, and a scope that was not entered has nothing to say
/// about `{ let inner = n * 2; inner }`.
fn block_type(w: &mut World, b: &ast::Block) -> ast::Ty {
    let mark = w.locals.len();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, value) => {
                let t = match written {
                    Option::Some(x) => expand(w, x),
                    Option::None => type_of(w, value),
                };
                w.locals.push(Binding { name: name.to_string(), ty: t });
            }
            _ => {}
        }
        i += 1;
    }
    let out = match &b.tail {
        Option::Some(e) => type_of(w, e),
        Option::None => ast::Ty::Unit,
    };
    unbind(w, mark);
    out
}

/// What a name in scope is, or `()` when nothing here is called that.
fn look_up(w: &mut World, name: &str) -> ast::Ty {
    let mut i = w.locals.len();
    while i > 0 {
        i -= 1;
        if w.locals[i].name.same(name) {
            return copy_ty(&w.locals[i].ty);
        }
    }
    ast::Ty::Unit
}

/// The type of a field of a named struct.
fn field_type(w: &mut World, owner: &str, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < w.fields.len() {
        if w.fields[i].owner.same(owner) && w.fields[i].name.same(name) {
            return copy_ty(&w.fields[i].ty);
        }
        i += 1;
    }
    ast::Ty::Unit
}

/// What a function of this name answers with.
fn return_of(w: &mut World, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < w.sigs.len() {
        if w.sigs[i].name.same(name) {
            return copy_ty(&w.sigs[i].ret);
        }
        i += 1;
    }
    ast::Ty::Unit
}

/// `Kind::Rect(2, 3)` is a value of `Kind`; `Point { x: 1 }` is one of
/// `Point`. Both are written the same way and told apart by the `::`.
fn aggregate_type(w: &mut World, path: &str, fields: &Vec<ast::Field>) -> ast::Ty {
    let segments = split_path(path);
    if segments.len() < 2 {
        return named(path);
    }
    let owner = segments[0].to_string();
    let variant = segments[1].to_string();
    let at = variant_at(w, &owner, &variant);
    if at < 0 {
        return named(&owner);
    }
    if w.variants[at].params.len() == 0 {
        return named(&owner);
    }
    // What the parameters are is what the payload turned out to be.
    let params = copy_names(&w.variants[at].params);
    let mut bound: Vec<Binding> = Vec::new();
    let mut i: taddr = 0;
    while i < fields.len() && i < w.variants[at].fields.len() {
        let declared = copy_ty(&w.variants[at].fields[i]);
        let actual = type_of(w, &fields[i].value);
        bind_params(&params, &declared, &actual, &mut bound);
        i += 1;
    }
    let mut args: Vec<ast::Ty> = Vec::new();
    let mut k: taddr = 0;
    while k < params.len() {
        args.push(bound_or_unit(&bound, &params[k]));
        k += 1;
    }
    ast::Ty::App(path_of(&owner), args)
}

/// Which variant of which enum, or −1.
fn variant_at(w: &World, owner: &str, variant: &str) -> taddr {
    let mut i: taddr = 0;
    while i < w.variants.len() {
        if w.variants[i].owner.same(owner) && w.variants[i].name.same(variant) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Match a declared type against what was passed, binding the parameters
/// it names on the way (Ch. 4 §2.3).
fn bind_params(
    params: &Vec<String>,
    declared: &ast::Ty,
    actual: &ast::Ty,
    out: &mut Vec<Binding>,
) {
    match declared {
        ast::Ty::Name(segments) => {
            let name = joined(segments);
            if holds_name(params, &name) {
                out.push(Binding { name: name, ty: copy_ty(actual) });
            }
        }
        ast::Ty::Ref(inner, m) => {
            match actual {
                ast::Ty::Ref(other, n) => bind_params(params, inner, other, out),
                _ => {}
            }
        }
        ast::Ty::App(segments, args) => {
            match actual {
                ast::Ty::App(other, given) => {
                    let mut i: taddr = 0;
                    while i < args.len() && i < given.len() {
                        bind_params(params, &args[i], &given[i], out);
                        i += 1;
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
}

fn holds_name(names: &Vec<String>, name: &str) -> bool {
    let mut i: taddr = 0;
    while i < names.len() {
        if names[i].same(name) {
            return true;
        }
        i += 1;
    }
    false
}

fn bound_or_unit(bound: &Vec<Binding>, name: &str) -> ast::Ty {
    let mut i: taddr = 0;
    while i < bound.len() {
        if bound[i].name.same(name) {
            return copy_ty(&bound[i].ty);
        }
        i += 1;
    }
    ast::Ty::Unit
}

/// A path written `a::b`, as its segments.
fn split_path(path: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut cur: String = Vec::new();
    let mut i: taddr = 0;
    while i < path.len() {
        if path[i] == ':' && i + 1 < path.len() && path[i + 1] == ':' {
            out.push(cur);
            cur = Vec::new();
            i += 2;
        } else {
            cur.push(path[i]);
            i += 1;
        }
    }
    out.push(cur);
    out
}

/// The two enums Ch. 5 §6 makes language types. They are not in the file
/// being read, and a checker that did not know them would answer nothing
/// about the two answers every fallible function gives.
fn prelude(w: &mut World) {
    // Ch. 0 §3.6 and Ch. 5 §1.1: a `String` is a `Vec<char>` and is one
    // name for it, not a type of its own.
    w.aliases.push(Binding {
        name: "String".to_string(),
        ty: ast::Ty::App(path_of("Vec"), one_ty(named("char"))),
    });
    let mut t: Vec<String> = Vec::new();
    t.push("T".to_string());
    w.variants.push(Variant {
        owner: "Option".to_string(),
        params: copy_names(&t),
        name: "None".to_string(),
        fields: Vec::new(),
    });
    w.variants.push(Variant {
        owner: "Option".to_string(),
        params: copy_names(&t),
        name: "Some".to_string(),
        fields: one_ty(named("T")),
    });
    let mut te: Vec<String> = Vec::new();
    te.push("T".to_string());
    te.push("E".to_string());
    w.variants.push(Variant {
        owner: "Result".to_string(),
        params: copy_names(&te),
        name: "Ok".to_string(),
        fields: one_ty(named("T")),
    });
    w.variants.push(Variant {
        owner: "Result".to_string(),
        params: copy_names(&te),
        name: "Err".to_string(),
        fields: one_ty(named("E")),
    });
}

/// The methods the language writes, by receiver (Ch. 5 §2).
fn method_type(w: &mut World, on: &ast::Ty, name: &str) -> ast::Ty {
    // What the program wrote comes first: a method the language also names
    // is the program's on a type the language writes nothing on (§2.5).
    let owner = head_of(on);
    let mut i: taddr = 0;
    while i < w.methods.len() {
        if w.methods[i].owner.same(&owner) && w.methods[i].name.same(name) {
            return copy_ty(&w.methods[i].ret);
        }
        i += 1;
    }
    if name.same("len") {
        return named("taddr");
    }
    if name.same("is_empty") {
        return named("bool");
    }
    if name.same("push") || name.same("clear") || name.same("reserve") {
        return ast::Ty::Unit;
    }
    if name.same("to_string") {
        return ast::Ty::App(path_of("Vec"), one_ty(named("char")));
    }
    if name.same("same") || name.same("starts_with") || name.same("contains") {
        return named("bool");
    }
    ast::Ty::Unit
}

/// The first type argument of `Option<T>` or `Result<T, E>`.
fn first_argument(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            if (head.same("Option") || head.same("Result")) && args.len() > 0 {
                return copy_ty(&args[0]);
            }
            ast::Ty::Unit
        }
        _ => ast::Ty::Unit,
    }
}

/// What indexing gives: a `Vec`'s element, a slice's, a string's character.
fn element_of(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::App(segments, args) => {
            if args.len() == 1 {
                return copy_ty(&args[0]);
            }
            ast::Ty::Unit
        }
        ast::Ty::Slice(inner) => copy_ty(inner),
        ast::Ty::Name(segments) => {
            // A `str` is characters, and walking one gives them (Ch. 5 §1.1).
            if joined(segments).same("str") {
                named("char")
            } else {
                ast::Ty::Unit
            }
        }
        _ => ast::Ty::Unit,
    }
}

/// What a reference points at.
fn target_of(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Ref(inner, m) => copy_ty(inner),
        _ => ast::Ty::Unit,
    }
}

/// A type with its references taken off, which is what a `.` reaches
/// through (Ch. 3 §2.3).
fn strip(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Ref(inner, m) => strip(inner),
        _ => copy_ty(t),
    }
}

/// The name at the head of a type, or nothing for one that has none.
fn head_of(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        ast::Ty::App(segments, args) => joined(segments),
        _ => "".to_string(),
    }
}

fn joined(segments: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < segments.len() {
        if i > 0 {
            out.push_str("::");
        }
        out.push_str(&segments[i]);
        i += 1;
    }
    out
}

fn named(name: &str) -> ast::Ty {
    ast::Ty::Name(path_of(name))
}

fn path_of(name: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    out.push(name.to_string());
    out
}

fn one_ty(t: ast::Ty) -> Vec<ast::Ty> {
    let mut out: Vec<ast::Ty> = Vec::new();
    out.push(t);
    out
}

/// A type with every alias taken off (Ch. 0 §3.6). An alias is a name for
/// a type and never a type, so nothing below here should ever see one.
fn expand(w: &World, t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => {
            let name = joined(segments);
            let mut i: taddr = 0;
            while i < w.aliases.len() {
                if w.aliases[i].name.same(&name) {
                    let inner = copy_ty(&w.aliases[i].ty);
                    return expand(w, &inner);
                }
                i += 1;
            }
            copy_ty(t)
        }
        ast::Ty::App(segments, args) => {
            let mut out: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                out.push(expand(w, &args[i]));
                i += 1;
            }
            ast::Ty::App(copy_names(segments), out)
        }
        ast::Ty::Ref(inner, m) => ast::Ty::Ref(Box::new(expand(w, inner)), m),
        ast::Ty::Slice(inner) => ast::Ty::Slice(Box::new(expand(w, inner))),
        _ => copy_ty(t),
    }
}

/// A type, copied. There is no `Clone` here and a type is a tree.
fn copy_ty(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => ast::Ty::Name(copy_names(segments)),
        ast::Ty::App(segments, args) => {
            let mut out: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                out.push(copy_ty(&args[i]));
                i += 1;
            }
            ast::Ty::App(copy_names(segments), out)
        }
        ast::Ty::Ref(inner, m) => ast::Ty::Ref(Box::new(copy_ty(inner)), m),
        ast::Ty::Slice(inner) => ast::Ty::Slice(Box::new(copy_ty(inner))),
        ast::Ty::Unit => ast::Ty::Unit,
        ast::Ty::SelfTy => ast::Ty::SelfTy,
    }
}

fn copy_names(from: &Vec<String>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(from[i].to_string());
        i += 1;
    }
    out
}

/// Forget every local bound since the mark.
fn unbind(w: &mut World, mark: taddr) {
    while w.locals.len() > mark {
        w.locals.pop();
    }
}
