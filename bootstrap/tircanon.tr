// Canonicalization of TIR, in Trust.
//
// This is `compiler/src/tir/canon.rs` written again in the language it
// helps compile: the target-independent optimization TIR §6 places between
// parsing and legalization. A canonicalizer's contract is narrow — the same
// program in a form later passes handle better — and the way to hold a
// second writing of it to the first is what it always is here: the two
// print the same module, character for character, on every module the suite
// stands up. `trustc canon` is this oracle's other side; the passes
// themselves live in `bootstrap/canon.tr`, where the inliner's runner can
// compose them too.
//
// The passes run in the order the Rust one runs them, per function:
// promote_slots, mem2reg, fold_constants, elide_sign_checks,
// branch_through_select, elide_dominated_checks, remove_dead.

mod canon;
mod input;
mod tir;

fn main() -> t27 {
    let src = input::read_all();
    match tir::parse(&src) {
        Result::Ok(m) => {
            let out = canon::canonicalize(m);
            tir::print_module(&out);
            0
        }
        Result::Err(e) => {
            let _ = e;
            1
        }
    }
}
