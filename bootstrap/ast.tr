// What a parse produces (Ch. 0 §§3–5), as much of it as the parser below
// reads.
//
// The shape is the compiler's own, one chapter down: an expression is a tree
// held together by `Box`, which is what Ch. 5 §2.3 is for and what made
// `E::Add(E::Lit(a), E::Lit(b))` worth being able to write (G9.29).

/// An expression.
pub enum Expr {
    Int(t27),
    /// `'x'` — its scalar value, which is what it is (Ch. 5 §1.4). It
    /// prints as a number, as an integer does, and it is a `char`.
    Char(t27),
    /// `0t`, `1t`, `-1t` — a `trit` (§1.4).
    Trit(t27),
    Name(String),
    /// A binary operator and its two sides (§2.1).
    Binary(String, Box<Expr>, Box<Expr>),
    /// `-e` and `!e`.
    Unary(String, Box<Expr>),
    /// `f(a, b)`.
    Call(String, Vec<Expr>),
    /// `Point { x: 1 }`, `Kind::Rect(2, 3)`, `Kind::Dot` — one shape, because
    /// a tuple form's fields are its positions written out, and a bare path
    /// to a variant is that shape with no fields at all.
    Aggregate(String, Vec<Field>),
    /// `"…"` — the characters, as they were written after the escapes.
    Str(String),
    /// `true` and `false`.
    Bool(bool),
    /// `&e` and `&mut e`; the flag is the `mut` (Ch. 3 §2.1).
    Borrow(Box<Expr>, bool),
    /// `*e` (Ch. 3 §2.2).
    Deref(Box<Expr>),
    /// `a[i]` (Ch. 3 §5.5).
    Index(Box<Expr>, Box<Expr>),
    /// `e as T` (§2.6). The type is the text it was written with.
    Cast(Box<Expr>, Ty),
    /// `e?` (Ch. 5 §6.2).
    Try(Box<Expr>),
    /// `()` — the one value of the unit type (Ch. 2 §1).
    Unit,
    /// `(a, b)` (Ch. 2 §3).
    Tuple(Vec<Expr>),
    /// `match e { p => v, … }` (§5.4).
    Match(Box<Expr>, Vec<Arm>),
    /// `(e)`, kept so that printing round-trips.
    Group(Box<Expr>),
    /// `x.f` — a field.
    Field(Box<Expr>, String),
    /// `x.m(args)` — a method call (§2.6).
    Method(Box<Expr>, String, Vec<Expr>),
    /// `a = b`, and the compound forms, which are §2.1's loosest level and
    /// right-associative.
    Assign(String, Box<Expr>, Box<Expr>),
    /// A block used as an expression (§5.1).
    Nested(Box<Block>),
    /// `if c { … } else { … }` (§5.3). The alternative is an expression so
    /// that `else if` is an `if` and not a third shape.
    If(Box<Expr>, Box<Block>, Option<Box<Expr>>),
    /// `for x in e { … }` (Ch. 4 §5.7). It is written as itself and turned
    /// into a `loop` and a `match` at lowering, so a reader and an editor
    /// see the loop they wrote.
    For(String, Box<Expr>, Box<Block>),
    /// `while c { … }` (§5.5).
    While(Box<Expr>, Box<Block>),
    /// `loop { … }` (§5.5).
    Loop(Box<Block>),
    /// `return e?`, `break e?`, `continue` (§§5.5, 5.7).
    Return(Option<Box<Expr>>),
    Break(Option<Box<Expr>>),
    Continue,
}

/// A written type (§3.4).
///
/// It was text until a resolver wanted to read one: a name inside a type is
/// a path like any other (Ch. 6 §3.1), and a pass that rewrites paths cannot
/// rewrite a string it would have to re-parse. A type is a tree now, and
/// printing it back gives the characters it was written with.
pub enum Ty {
    /// A name, through the modules holding it: `t27`, `lex::Taken`.
    Name(Vec<String>),
    /// A name applied to arguments: `Vec<char>`, `Result<T, E>`.
    App(Vec<String>, Vec<Ty>),
    /// `&T` and `&mut T`; the flag is the `mut` (Ch. 3 §2.1).
    Ref(Box<Ty>, bool),
    /// `[T]` (Ch. 2 §4).
    Slice(Box<Ty>),
    /// `()`, which is a type and a value both (Ch. 2 §1).
    Unit,
    /// `Self`, inside an `impl` (Ch. 4 §1.2).
    SelfTy,
}

/// A statement (§5.2).
pub enum Stmt {
    /// `let mut? name: T? = expr;` — the type when one was written, which
    /// is the thing `let n = 1;` leaves for inference (§5.2).
    Let(bool, String, Option<Ty>, Expr),
    /// `let P { a, b } = expr;` — what it binds is the pattern's (§4).
    LetPattern(Pattern, Expr),
    /// An expression evaluated for its effect.
    Do(Expr),
}

/// A block: statements, then an optional trailing expression (§5.1).
pub struct Block {
    pub stmts: Vec<Stmt>,
    pub tail: Option<Box<Expr>>,
}

/// One bound: a trait's name, its type arguments, and what it binds
/// (Ch. 4 §1.7). `From<t9>` is a different requirement from `From<t27>`,
/// which is the whole reason a trait may carry parameters.
pub struct Bound {
    pub name: String,
    pub args: Vec<Ty>,
    /// `Iterator<Item = t27>`: a binding says what the implementation chose,
    /// where an argument says which implementation is meant.
    pub assoc: Vec<Named>,
}

/// A name bound to a type, which is what an associated binding is.
pub struct Named {
    pub name: String,
    pub ty: Ty,
}

/// One generic parameter (Ch. 4 §2.1).
pub enum Generic {
    /// `T: Bound + Other`.
    Type(String, Vec<Bound>),
    /// `const N: taddr` (§2.4).
    Const(String, Ty),
}

/// One parameter: a name and its written type.
pub struct Param {
    pub name: String,
    pub ty: Ty,
}

/// One variant of an enum: a name, and its payload types (§3.3).
pub struct Variant {
    pub name: String,
    pub fields: Vec<Ty>,
}

/// A top-level item (§3).
/// One item, and whether it is visible outside the module that holds it
/// (Ch. 6 §2). The flag is separate from the shape because `pub` is written
/// in one place and means one thing whatever follows it.
pub struct Item {
    pub public: bool,
    /// `#[repr(linear)]` — fields in declaration order (Ch. 2 §1). The
    /// language defines two attributes and this is one of them (§3.4).
    pub linear: bool,
    /// `#[derive(Eq, Ord, Clone)]`, in the order written (Ch. 4 §6).
    pub derives: Vec<String>,
    pub what: What,
}

pub enum What {
    Function(Fn),
    /// `struct Name<T> { field: T, … }`, or a unit struct with no fields.
    Struct(String, Vec<Generic>, Vec<Param>),
    /// `enum Name<T> { A, B(T), … }`.
    Enum(String, Vec<Generic>, Vec<Variant>),
    /// `mod m;` — a module, which is a file (Ch. 6 §1).
    Mod(String),
    /// `use a::b::c;` — the segments, in order (Ch. 6 §3.2).
    Use(Vec<String>),
    /// `type Name = T;` (Ch. 0 §3.6).
    Alias(String, Ty),
    /// `const NAME: T = e;`
    Const(String, Ty, Expr),
    /// `impl Trait for Type { … }`. There is no trait for an inherent impl
    /// (Ch. 4 §1.2), which is the difference a reader sees.
    Impl(Vec<Generic>, Option<Ty>, Ty, Vec<Fn>),
    /// `trait Name<T>: Super { … }` (Ch. 4 §1.1): its type parameters, its
    /// supertraits, its associated type names, and its methods.
    Trait(String, Vec<String>, Vec<String>, Vec<String>, Vec<Fn>),
}

/// One arm: its patterns, its guard if it has one, and its value.
pub struct Arm {
    pub patterns: Vec<Pattern>,
    pub guard: Option<Expr>,
    pub body: Expr,
}

/// A pattern (§4). It has the shape of an expression and is not one: a
/// pattern is *matched*, and the only names in it are the ones it binds.
pub enum Pattern {
    /// `_` — matches and binds nothing.
    Wild,
    /// A name, which binds.
    Bind(String),
    /// A literal, as its value; a `trit` and a `char` are numbers here.
    Int(t27),
    /// `true` and `false`.
    Bool(bool),
    /// `Kind::Rect(a, b)`, `Span { lo, hi }`, `Kind::Dot` — one shape, as in
    /// an expression, and for the same reason.
    Aggregate(String, Vec<PatField>),
    /// `(a, b)`.
    Tuple(Vec<Pattern>),
}

/// One field of a pattern: the name it is written under, and the pattern.
pub struct PatField {
    pub name: String,
    pub pat: Pattern,
}

/// One field of an aggregate: the name it is written under, and its value.
pub struct Field {
    pub name: String,
    pub value: Expr,
}

pub struct Fn {
    pub name: String,
    pub generics: Vec<Generic>,
    /// What the caller must have established, written in the same `where`
    /// clause as the type bounds and checked once on entry (Ch. 4 §2.8).
    pub requires: Vec<Expr>,
    pub params: Vec<Param>,
    pub ret: Ty,
    /// The body, or nothing for a declaration — a signature whose definition
    /// is outside the language (§3.1).
    pub body: Option<Block>,
}

/// Whether `op` assigns (§2.1's loosest level).
pub fn assigns(op: &str) -> bool {
    op.same("=") || op.same("+=") || op.same("-=") || op.same("*=")
        || op.same("/=") || op.same("%=") || op.same("<<=") || op.same(">>=")
}

/// How tightly an operator binds (§2.1), loosest first. Zero means it is not
/// a binary operator at all.
pub fn level(op: &str) -> taddr {
    if op.same("||") {
        1
    } else if op.same("&&") {
        2
    } else if op.same("==") || op.same("!=") || op.same("<") || op.same("<=")
        || op.same(">") || op.same(">=")
    {
        3
    } else if op.same("<=>") {
        4
    } else if op.same("<<") || op.same(">>") {
        5
    } else if op.same("+") || op.same("-") {
        6
    } else if op.same("*") || op.same("/") || op.same("%") {
        7
    } else {
        0
    }
}

/// The tree, written out in a form that says its shape without ambiguity:
/// every operator is a prefix and every child is parenthesized.
pub fn show(e: &Expr, out: &mut String) {
    match e {
        Expr::Int(v) => push_int(out, v),
        Expr::Char(v) => push_int(out, v),
        Expr::Trit(v) => push_int(out, v),
        Expr::Name(n) => out.push_str(n),
        Expr::Group(inner) => show(&*inner, out),
        Expr::Unary(op, a) => {
            out.push_str("(");
            out.push_str(op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(")");
        }
        Expr::Nested(b) => show_block(&*b, out),
        Expr::If(c, then, other) => {
            out.push_str("(if ");
            show(&*c, out);
            out.push_str(" ");
            show_block(&*then, out);
            match &other {
                Option::Some(e) => {
                    out.push_str(" ");
                    show(&*e, out);
                }
                Option::None => {}
            }
            out.push_str(")");
        }
        Expr::For(name, iter, b) => {
            out.push_str("(for ");
            out.push_str(name);
            out.push_str(" ");
            show(&*iter, out);
            out.push_str(" ");
            show_block(&*b, out);
            out.push_str(")");
        }
        Expr::While(c, b) => {
            out.push_str("(while ");
            show(&*c, out);
            out.push_str(" ");
            show_block(&*b, out);
            out.push_str(")");
        }
        Expr::Loop(b) => {
            out.push_str("(loop ");
            show_block(&*b, out);
            out.push_str(")");
        }
        Expr::Return(v) => show_jump("return", v, out),
        Expr::Break(v) => show_jump("break", v, out),
        Expr::Continue => out.push_str("(continue)"),
        Expr::Field(base, name) => {
            out.push_str("(field ");
            show(&*base, out);
            out.push_str(" ");
            out.push_str(name);
            out.push_str(")");
        }
        Expr::Method(base, name, args) => {
            out.push_str("(method ");
            show(&*base, out);
            out.push_str(" ");
            out.push_str(name);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(" ");
                show(&args[i], out);
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Assign(op, a, b) => {
            out.push_str("(");
            out.push_str(op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(" ");
            show(&*b, out);
            out.push_str(")");
        }
        Expr::Binary(op, a, b) => {
            out.push_str("(");
            out.push_str(op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(" ");
            show(&*b, out);
            out.push_str(")");
        }
        Expr::Call(f, args) => {
            out.push_str("(call ");
            out.push_str(f);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(" ");
                show(&args[i], out);
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Str(text) => {
            out.push_str("(str ");
            out.push_str(text);
            out.push_str(")");
        }
        Expr::Bool(b) => {
            if b {
                out.push_str("true");
            } else {
                out.push_str("false");
            }
        }
        Expr::Borrow(inner, mutable) => {
            if mutable {
                out.push_str("(&mut ");
            } else {
                out.push_str("(& ");
            }
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Deref(inner) => {
            out.push_str("(* ");
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Index(base, at) => {
            out.push_str("(index ");
            show(&*base, out);
            out.push_str(" ");
            show(&*at, out);
            out.push_str(")");
        }
        Expr::Cast(inner, ty) => {
            out.push_str("(as ");
            show(&*inner, out);
            out.push_str(" ");
            show_ty(ty, out);
            out.push_str(")");
        }
        Expr::Try(inner) => {
            out.push_str("(try ");
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Unit => out.push_str("(unit)"),
        Expr::Tuple(items) => {
            out.push_str("(tuple");
            let mut i: taddr = 0;
            while i < items.len() {
                out.push_str(" ");
                show(&items[i], out);
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Match(scrutinee, arms) => {
            out.push_str("(match ");
            show(&*scrutinee, out);
            let mut i: taddr = 0;
            while i < arms.len() {
                out.push_str(" (arm (");
                let mut k: taddr = 0;
                while k < arms[i].patterns.len() {
                    if k > 0 {
                        out.push_str(" ");
                    }
                    show_pattern(&arms[i].patterns[k], out);
                    k += 1;
                }
                out.push_str(")");
                match &arms[i].guard {
                    Option::Some(g) => {
                        out.push_str(" (when ");
                        show(g, out);
                        out.push_str(")");
                    }
                    Option::None => {}
                }
                out.push_str(" ");
                show(&arms[i].body, out);
                out.push_str(")");
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Aggregate(path, fields) => {
            out.push_str("(agg ");
            out.push_str(path);
            let mut i: taddr = 0;
            while i < fields.len() {
                out.push_str(" (");
                out.push_str(&fields[i].name);
                out.push_str(" ");
                show(&fields[i].value, out);
                out.push_str(")");
                i += 1;
            }
            out.push_str(")");
        }
    }
}

/// A generic parameter list, written out. Nothing at all when there is
/// none, which is what a program that names no type parameter reads as.
pub fn show_generics(gs: &Vec<Generic>, out: &mut String) {
    out.push_str("<");
    let mut i: taddr = 0;
    while i < gs.len() {
        if i > 0 {
            out.push_str(" ");
        }
        match &gs[i] {
            Generic::Type(name, bounds) => {
                out.push_str(name);
                let mut k: taddr = 0;
                while k < bounds.len() {
                    if k == 0 {
                        out.push_str(":");
                    } else {
                        out.push_str("+");
                    }
                    show_bound(&bounds[k], out);
                    k += 1;
                }
            }
            Generic::Const(name, ty) => {
                out.push_str("const ");
                out.push_str(name);
                out.push_str(":");
                show_ty(ty, out);
            }
        }
        i += 1;
    }
    out.push_str(">");
}

/// One bound, written out.
pub fn show_bound(b: &Bound, out: &mut String) {
    out.push_str(&b.name);
    if b.args.len() == 0 && b.assoc.len() == 0 {
        return;
    }
    out.push_str("<");
    let mut first = true;
    let mut i: taddr = 0;
    while i < b.args.len() {
        if !first {
            out.push_str(",");
        }
        first = false;
        show_ty(&b.args[i], out);
        i += 1;
    }
    let mut k: taddr = 0;
    while k < b.assoc.len() {
        if !first {
            out.push_str(",");
        }
        first = false;
        out.push_str(&b.assoc[k].name);
        out.push_str("=");
        show_ty(&b.assoc[k].ty, out);
        k += 1;
    }
    out.push_str(">");
}

/// A type, written back out as the characters it was written with.
pub fn show_ty(t: &Ty, out: &mut String) {
    match t {
        Ty::Name(segments) => show_path(segments, out),
        Ty::App(segments, args) => {
            show_path(segments, out);
            out.push_str("<");
            let mut i: taddr = 0;
            while i < args.len() {
                if i > 0 {
                    out.push_str(",");
                }
                show_ty(&args[i], out);
                i += 1;
            }
            out.push_str(">");
        }
        Ty::Ref(inner, mutable) => {
            if mutable {
                out.push_str("&mut ");
            } else {
                out.push_str("&");
            }
            show_ty(&*inner, out);
        }
        Ty::Slice(inner) => {
            out.push_str("[");
            show_ty(&*inner, out);
            out.push_str("]");
        }
        Ty::Unit => out.push_str("()"),
        Ty::SelfTy => out.push_str("Self"),
    }
}

/// The segments of a path, with `::` between them.
fn show_path(segments: &Vec<String>, out: &mut String) {
    let mut i: taddr = 0;
    while i < segments.len() {
        if i > 0 {
            out.push_str("::");
        }
        out.push_str(&segments[i]);
        i += 1;
    }
}

/// A pattern, written out.
pub fn show_pattern(p: &Pattern, out: &mut String) {
    match p {
        Pattern::Wild => out.push_str("_"),
        Pattern::Bind(n) => out.push_str(n),
        Pattern::Int(v) => push_int(out, v),
        Pattern::Bool(b) => {
            if b {
                out.push_str("true");
            } else {
                out.push_str("false");
            }
        }
        Pattern::Aggregate(path, fields) => {
            out.push_str("(pat ");
            out.push_str(path);
            let mut i: taddr = 0;
            while i < fields.len() {
                out.push_str(" (");
                out.push_str(&fields[i].name);
                out.push_str(" ");
                show_pattern(&fields[i].pat, out);
                out.push_str(")");
                i += 1;
            }
            out.push_str(")");
        }
        Pattern::Tuple(items) => {
            out.push_str("(tuple");
            let mut i: taddr = 0;
            while i < items.len() {
                out.push_str(" ");
                show_pattern(&items[i], out);
                i += 1;
            }
            out.push_str(")");
        }
    }
}

/// `return`, `break` — a word and an optional value.
fn show_jump(word: &str, v: &Option<Box<Expr>>, out: &mut String) {
    out.push_str("(");
    out.push_str(word);
    match v {
        Option::Some(e) => {
            out.push_str(" ");
            show(&*e, out);
        }
        Option::None => {}
    }
    out.push_str(")");
}

/// A block, written out.
pub fn show_block(b: &Block, out: &mut String) {
    out.push_str("(block");
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        out.push_str(" ");
        show_stmt(&b.stmts[i], out);
        i += 1;
    }
    match &b.tail {
        // The binding is read *through* the reference the match borrowed,
        // so it names the box rather than taking it (Ch. 3 §1.2).
        Option::Some(t) => {
            out.push_str(" (tail ");
            show(&*t, out);
            out.push_str(")");
        }
        Option::None => {}
    }
    out.push_str(")");
}

pub fn show_stmt(s: &Stmt, out: &mut String) {
    match s {
        Stmt::LetPattern(pat, e) => {
            out.push_str("(let-pat ");
            show_pattern(pat, out);
            out.push_str(" ");
            show(e, out);
            out.push_str(")");
        }
        Stmt::Let(mutable, name, ty, e) => {
            if mutable {
                out.push_str("(let-mut ");
            } else {
                out.push_str("(let ");
            }
            out.push_str(name);
            match ty {
                Option::Some(t) => {
                    out.push_str(":");
                    show_ty(t, out);
                }
                Option::None => {}
            }
            out.push_str(" ");
            show(e, out);
            out.push_str(")");
        }
        Stmt::Do(e) => {
            out.push_str("(do ");
            show(e, out);
            out.push_str(")");
        }
    }
}

/// One item, written out.
pub fn show_item(i: &Item, out: &mut String) {
    // An attribute is written before the item and is printed before it, so
    // that what a reader wrote and what the tree holds are the same shape.
    if i.linear {
        out.push_str("(repr linear) ");
    }
    let mut d: taddr = 0;
    while d < i.derives.len() {
        out.push_str("(derive ");
        out.push_str(&i.derives[d]);
        out.push_str(") ");
        d += 1;
    }
    match &i.what {
        What::Function(f) => show_fn(f, out),
        What::Struct(name, gs, fields) => {
            out.push_str("(struct ");
            out.push_str(name);
            out.push_str(" ");
            if gs.len() > 0 {
                show_generics(gs, out);
                out.push_str(" ");
            }
            out.push_str("(");
            let mut k: taddr = 0;
            while k < fields.len() {
                if k > 0 {
                    out.push_str(" ");
                }
                out.push_str(&fields[k].name);
                out.push_str(":");
                show_ty(&fields[k].ty, out);
                k += 1;
            }
            out.push_str("))");
        }
        What::Enum(name, gs, variants) => {
            out.push_str("(enum ");
            out.push_str(name);
            if gs.len() > 0 {
                out.push_str(" ");
                show_generics(gs, out);
            }
            let mut k: taddr = 0;
            while k < variants.len() {
                out.push_str(" (");
                out.push_str(&variants[k].name);
                let mut j: taddr = 0;
                while j < variants[k].fields.len() {
                    out.push_str(" ");
                    show_ty(&variants[k].fields[j], out);
                    j += 1;
                }
                out.push_str(")");
                k += 1;
            }
            out.push_str(")");
        }
        What::Trait(name, params, supers, assoc, fns) => {
            out.push_str("(trait ");
            out.push_str(name);
            if params.len() > 0 {
                out.push_str(" <");
                let mut i: taddr = 0;
                while i < params.len() {
                    if i > 0 {
                        out.push_str(" ");
                    }
                    out.push_str(&params[i]);
                    i += 1;
                }
                out.push_str(">");
            }
            let mut k: taddr = 0;
            while k < supers.len() {
                out.push_str(" :");
                out.push_str(&supers[k]);
                k += 1;
            }
            let mut j: taddr = 0;
            while j < assoc.len() {
                out.push_str(" (type ");
                out.push_str(&assoc[j]);
                out.push_str(")");
                j += 1;
            }
            let mut m: taddr = 0;
            while m < fns.len() {
                out.push_str(" ");
                show_fn(&fns[m], out);
                m += 1;
            }
            out.push_str(")");
        }
        What::Mod(name) => {
            out.push_str("(mod ");
            out.push_str(name);
            out.push_str(")");
        }
        What::Use(segments) => {
            out.push_str("(use ");
            let mut k: taddr = 0;
            while k < segments.len() {
                if k > 0 {
                    out.push_str("::");
                }
                out.push_str(&segments[k]);
                k += 1;
            }
            out.push_str(")");
        }
        What::Alias(name, ty) => {
            out.push_str("(type ");
            out.push_str(name);
            out.push_str(" ");
            show_ty(ty, out);
            out.push_str(")");
        }
        What::Const(name, ty, value) => {
            out.push_str("(const ");
            out.push_str(name);
            out.push_str(":");
            show_ty(ty, out);
            out.push_str(" ");
            show(value, out);
            out.push_str(")");
        }
        What::Impl(gs, tr, ty, fns) => {
            out.push_str("(impl ");
            if gs.len() > 0 {
                show_generics(gs, out);
                out.push_str(" ");
            }
            match &tr {
                Option::Some(t) => {
                    show_ty(t, out);
                    out.push_str(" for ");
                }
                Option::None => {}
            }
            show_ty(ty, out);
            let mut k: taddr = 0;
            while k < fns.len() {
                out.push_str(" ");
                show_fn(&fns[k], out);
                k += 1;
            }
            out.push_str(")");
        }
    }
}

/// Whether an item is a *declaration* — a signature whose definition is
/// outside the language (§3.1).
///
/// Ch. 6 §4 renames every item to its path, and the outside does not know
/// about modules: `putchar` is a symbol in a runtime written before this
/// program existed, and `input.putchar` is not. A declaration keeps the name
/// it was written with, wherever it was written (G9.44).
pub fn declared(w: &What) -> bool {
    match w {
        What::Function(f) => {
            match &f.body {
                Option::Some(b) => false,
                Option::None => true,
            }
        }
        _ => false,
    }
}

/// The name an item defines, or nothing for a `use` or an `impl`, which
/// define none (Ch. 6 §4).
pub fn defines(w: &What) -> Option<String> {
    match w {
        What::Function(f) => Option::Some(f.name.to_string()),
        What::Struct(name, gs, fields) => Option::Some(name.to_string()),
        What::Enum(name, gs, variants) => Option::Some(name.to_string()),
        What::Alias(name, ty) => Option::Some(name.to_string()),
        What::Const(name, ty, value) => Option::Some(name.to_string()),
        What::Mod(name) => Option::Some(name.to_string()),
        What::Use(segments) => Option::None,
        What::Impl(gs, tr, ty, fns) => Option::None,
        What::Trait(name, params, supers, assoc, fns) => Option::Some(name.to_string()),
    }
}

/// What an item is, as the one word a reader would use.
pub fn kind(w: &What) -> String {
    match w {
        What::Function(f) => "fn".to_string(),
        What::Struct(name, gs, fields) => "struct".to_string(),
        What::Enum(name, gs, variants) => "enum".to_string(),
        What::Alias(name, ty) => "type".to_string(),
        What::Const(name, ty, value) => "const".to_string(),
        What::Mod(name) => "mod".to_string(),
        What::Use(segments) => "use".to_string(),
        What::Impl(gs, tr, ty, fns) => "impl".to_string(),
        What::Trait(name, params, supers, assoc, fns) => "trait".to_string(),
    }
}

/// A function, written out.
pub fn show_fn(f: &Fn, out: &mut String) {
    out.push_str("(fn ");
    out.push_str(&f.name);
    out.push_str(" ");
    if f.generics.len() > 0 {
        show_generics(&f.generics, out);
        out.push_str(" ");
    }
    out.push_str("(");
    let mut i: taddr = 0;
    while i < f.params.len() {
        if i > 0 {
            out.push_str(" ");
        }
        out.push_str(&f.params[i].name);
        out.push_str(":");
        show_ty(&f.params[i].ty, out);
        i += 1;
    }
    out.push_str(") ");
    show_ty(&f.ret, out);
    let mut r: taddr = 0;
    while r < f.requires.len() {
        out.push_str(" (requires ");
        show(&f.requires[r], out);
        out.push_str(")");
        r += 1;
    }
    match &f.body {
        Option::Some(b) => {
            out.push_str(" ");
            show_block(b, out);
        }
        Option::None => {}
    }
    out.push_str(")");
}

/// A number, written into `out`.
///
/// `/` and `%` are **symmetric** (Ch. 1 §4): they round the quotient to
/// nearest, so `15 / 10` is 2 and `15 % 10` is −5. A decimal printer wants
/// the floor, so the correction is written out — the same correction the
/// prelude's `print_int` makes, and the sixth place in this repository where
/// the radix's division has to be said out loud.
pub fn push_int(out: &mut String, v: t27) {
    let mut n = v;
    if n < 0 {
        out.push('-');
        n = 0 - n;
    }
    if n == 0 {
        out.push('0');
        return;
    }
    let mut digits: Vec<t27> = Vec::new();
    while n > 0 {
        let mut d = n % 10;
        n = n / 10;
        if d < 0 {
            d += 10;
            n -= 1;
        }
        digits.push(d);
    }
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(char::try_from(('0' as t27) + digits[i]).unwrap());
    }
}
