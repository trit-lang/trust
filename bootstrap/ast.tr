// What a parse produces (Ch. 0 §§3–5), as much of it as the parser below
// reads.
//
// The shape is the compiler's own, one chapter down: an expression is a tree
// held together by `Box`, which is what Ch. 5 §2.3 is for and what made
// `E::Add(E::Lit(a), E::Lit(b))` worth being able to write (G9.29).

/// An expression.
pub enum Expr {
    Int(t27),
    Name(String),
    /// A binary operator and its two sides (§2.1).
    Binary(String, Box<Expr>, Box<Expr>),
    /// `-e` and `!e`.
    Unary(String, Box<Expr>),
    /// `f(a, b)`.
    Call(String, Vec<Expr>),
    /// `Point { x: 1 }`, `Kind::Rect(2, 3)`, `Kind::Dot` — one shape, because
    /// a tuple form's fields are its positions written out, and a bare path
    /// to a variant is that shape with no fields at all.
    Aggregate(String, Vec<Field>),
    /// `"…"` — the characters, as they were written after the escapes.
    Str(String),
    /// `true` and `false`.
    Bool(bool),
    /// `&e` and `&mut e`; the flag is the `mut` (Ch. 3 §2.1).
    Borrow(Box<Expr>, bool),
    /// `*e` (Ch. 3 §2.2).
    Deref(Box<Expr>),
    /// `a[i]` (Ch. 3 §5.5).
    Index(Box<Expr>, Box<Expr>),
    /// `e as T` (§2.6). The type is the text it was written with.
    Cast(Box<Expr>, String),
    /// `e?` (Ch. 5 §6.2).
    Try(Box<Expr>),
    /// `(e)`, kept so that printing round-trips.
    Group(Box<Expr>),
    /// `x.f` — a field.
    Field(Box<Expr>, String),
    /// `x.m(args)` — a method call (§2.6).
    Method(Box<Expr>, String, Vec<Expr>),
    /// `a = b`, and the compound forms, which are §2.1's loosest level and
    /// right-associative.
    Assign(String, Box<Expr>, Box<Expr>),
    /// A block used as an expression (§5.1).
    Nested(Box<Block>),
    /// `if c { … } else { … }` (§5.3). The alternative is an expression so
    /// that `else if` is an `if` and not a third shape.
    If(Box<Expr>, Box<Block>, Option<Box<Expr>>),
    /// `while c { … }` (§5.5).
    While(Box<Expr>, Box<Block>),
    /// `loop { … }` (§5.5).
    Loop(Box<Block>),
    /// `return e?`, `break e?`, `continue` (§§5.5, 5.7).
    Return(Option<Box<Expr>>),
    Break(Option<Box<Expr>>),
    Continue,
}

/// A statement (§5.2).
pub enum Stmt {
    /// `let mut? name = expr;`
    Let(bool, String, Expr),
    /// An expression evaluated for its effect.
    Do(Expr),
}

/// A block: statements, then an optional trailing expression (§5.1).
pub struct Block {
    pub stmts: Vec<Stmt>,
    pub tail: Option<Box<Expr>>,
}

/// One parameter: a name and its written type, kept as text because nothing
/// here reads a type for anything but printing it.
pub struct Param {
    pub name: String,
    pub ty: String,
}

/// One variant of an enum: a name, and its payload types as text (§3.3).
pub struct Variant {
    pub name: String,
    pub fields: Vec<String>,
}

/// A top-level item (§3).
pub enum Item {
    Function(Fn),
    /// `struct Name { field: T, … }`, or a unit struct with no fields.
    Struct(String, Vec<Param>),
    /// `enum Name { A, B(T), … }`.
    Enum(String, Vec<Variant>),
    /// `mod m;` — a module, which is a file (Ch. 6 §1).
    Mod(String),
    /// `use a::b::c;` — the segments, in order (Ch. 6 §3.2).
    Use(Vec<String>),
    /// `type Name = T;` (Ch. 0 §3.6).
    Alias(String, String),
    /// `const NAME: T = e;`
    Const(String, String, Expr),
    /// `impl Trait for Type { … }`. The trait is empty for an inherent impl
    /// (Ch. 4 §1.2), which is the difference a reader sees.
    Impl(String, String, Vec<Fn>),
}

/// One field of an aggregate: the name it is written under, and its value.
pub struct Field {
    pub name: String,
    pub value: Expr,
}

pub struct Fn {
    pub name: String,
    pub params: Vec<Param>,
    pub ret: String,
    /// The body, or nothing for a declaration — a signature whose definition
    /// is outside the language (§3.1).
    pub body: Option<Block>,
}

/// Whether `op` assigns (§2.1's loosest level).
pub fn assigns(op: &str) -> bool {
    op.same("=") || op.same("+=") || op.same("-=") || op.same("*=")
        || op.same("/=") || op.same("%=") || op.same("<<=") || op.same(">>=")
}

/// How tightly an operator binds (§2.1), loosest first. Zero means it is not
/// a binary operator at all.
pub fn level(op: &str) -> taddr {
    if op.same("||") {
        1
    } else if op.same("&&") {
        2
    } else if op.same("==") || op.same("!=") || op.same("<") || op.same("<=")
        || op.same(">") || op.same(">=")
    {
        3
    } else if op.same("<=>") {
        4
    } else if op.same("<<") || op.same(">>") {
        5
    } else if op.same("+") || op.same("-") {
        6
    } else if op.same("*") || op.same("/") || op.same("%") {
        7
    } else {
        0
    }
}

/// The tree, written out in a form that says its shape without ambiguity:
/// every operator is a prefix and every child is parenthesized.
pub fn show(e: &Expr, out: &mut String) {
    match e {
        Expr::Int(v) => push_int(out, v),
        Expr::Name(n) => out.push_str(&n),
        Expr::Group(inner) => show(&*inner, out),
        Expr::Unary(op, a) => {
            out.push_str("(");
            out.push_str(&op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(")");
        }
        Expr::Nested(b) => show_block(&*b, out),
        Expr::If(c, then, other) => {
            out.push_str("(if ");
            show(&*c, out);
            out.push_str(" ");
            show_block(&*then, out);
            match &other {
                Option::Some(e) => {
                    out.push_str(" ");
                    show(&*e, out);
                }
                Option::None => {}
            }
            out.push_str(")");
        }
        Expr::While(c, b) => {
            out.push_str("(while ");
            show(&*c, out);
            out.push_str(" ");
            show_block(&*b, out);
            out.push_str(")");
        }
        Expr::Loop(b) => {
            out.push_str("(loop ");
            show_block(&*b, out);
            out.push_str(")");
        }
        Expr::Return(v) => show_jump("return", &v, out),
        Expr::Break(v) => show_jump("break", &v, out),
        Expr::Continue => out.push_str("(continue)"),
        Expr::Field(base, name) => {
            out.push_str("(field ");
            show(&*base, out);
            out.push_str(" ");
            out.push_str(&name);
            out.push_str(")");
        }
        Expr::Method(base, name, args) => {
            out.push_str("(method ");
            show(&*base, out);
            out.push_str(" ");
            out.push_str(&name);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(" ");
                show(&args[i], out);
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Assign(op, a, b) => {
            out.push_str("(");
            out.push_str(&op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(" ");
            show(&*b, out);
            out.push_str(")");
        }
        Expr::Binary(op, a, b) => {
            out.push_str("(");
            out.push_str(&op);
            out.push_str(" ");
            show(&*a, out);
            out.push_str(" ");
            show(&*b, out);
            out.push_str(")");
        }
        Expr::Call(f, args) => {
            out.push_str("(call ");
            out.push_str(&f);
            let mut i: taddr = 0;
            while i < args.len() {
                out.push_str(" ");
                show(&args[i], out);
                i += 1;
            }
            out.push_str(")");
        }
        Expr::Str(text) => {
            out.push_str("(str ");
            out.push_str(&text);
            out.push_str(")");
        }
        Expr::Bool(b) => {
            if b {
                out.push_str("true");
            } else {
                out.push_str("false");
            }
        }
        Expr::Borrow(inner, mutable) => {
            if mutable {
                out.push_str("(&mut ");
            } else {
                out.push_str("(& ");
            }
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Deref(inner) => {
            out.push_str("(* ");
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Index(base, at) => {
            out.push_str("(index ");
            show(&*base, out);
            out.push_str(" ");
            show(&*at, out);
            out.push_str(")");
        }
        Expr::Cast(inner, ty) => {
            out.push_str("(as ");
            show(&*inner, out);
            out.push_str(" ");
            out.push_str(&ty);
            out.push_str(")");
        }
        Expr::Try(inner) => {
            out.push_str("(try ");
            show(&*inner, out);
            out.push_str(")");
        }
        Expr::Aggregate(path, fields) => {
            out.push_str("(agg ");
            out.push_str(&path);
            let mut i: taddr = 0;
            while i < fields.len() {
                out.push_str(" (");
                out.push_str(&fields[i].name);
                out.push_str(" ");
                show(&fields[i].value, out);
                out.push_str(")");
                i += 1;
            }
            out.push_str(")");
        }
    }
}

/// `return`, `break` — a word and an optional value.
fn show_jump(word: &str, v: &Option<Box<Expr>>, out: &mut String) {
    out.push_str("(");
    out.push_str(word);
    match v {
        Option::Some(e) => {
            out.push_str(" ");
            show(&*e, out);
        }
        Option::None => {}
    }
    out.push_str(")");
}

/// A block, written out.
pub fn show_block(b: &Block, out: &mut String) {
    out.push_str("(block");
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        out.push_str(" ");
        show_stmt(&b.stmts[i], out);
        i += 1;
    }
    match &b.tail {
        // The binding is read *through* the reference the match borrowed,
        // so it names the box rather than taking it (Ch. 3 §1.2).
        Option::Some(t) => {
            out.push_str(" (tail ");
            show(&*t, out);
            out.push_str(")");
        }
        Option::None => {}
    }
    out.push_str(")");
}

pub fn show_stmt(s: &Stmt, out: &mut String) {
    match s {
        Stmt::Let(mutable, name, e) => {
            if mutable {
                out.push_str("(let-mut ");
            } else {
                out.push_str("(let ");
            }
            out.push_str(&name);
            out.push_str(" ");
            show(&e, out);
            out.push_str(")");
        }
        Stmt::Do(e) => {
            out.push_str("(do ");
            show(&e, out);
            out.push_str(")");
        }
    }
}

/// One item, written out.
pub fn show_item(i: &Item, out: &mut String) {
    match i {
        Item::Function(f) => show_fn(&f, out),
        Item::Struct(name, fields) => {
            out.push_str("(struct ");
            out.push_str(&name);
            out.push_str(" (");
            let mut k: taddr = 0;
            while k < fields.len() {
                if k > 0 {
                    out.push_str(" ");
                }
                out.push_str(&fields[k].name);
                out.push_str(":");
                out.push_str(&fields[k].ty);
                k += 1;
            }
            out.push_str("))");
        }
        Item::Enum(name, variants) => {
            out.push_str("(enum ");
            out.push_str(&name);
            let mut k: taddr = 0;
            while k < variants.len() {
                out.push_str(" (");
                out.push_str(&variants[k].name);
                let mut j: taddr = 0;
                while j < variants[k].fields.len() {
                    out.push_str(" ");
                    out.push_str(&variants[k].fields[j]);
                    j += 1;
                }
                out.push_str(")");
                k += 1;
            }
            out.push_str(")");
        }
        Item::Mod(name) => {
            out.push_str("(mod ");
            out.push_str(&name);
            out.push_str(")");
        }
        Item::Use(segments) => {
            out.push_str("(use ");
            let mut k: taddr = 0;
            while k < segments.len() {
                if k > 0 {
                    out.push_str("::");
                }
                out.push_str(&segments[k]);
                k += 1;
            }
            out.push_str(")");
        }
        Item::Alias(name, ty) => {
            out.push_str("(type ");
            out.push_str(&name);
            out.push_str(" ");
            out.push_str(&ty);
            out.push_str(")");
        }
        Item::Const(name, ty, value) => {
            out.push_str("(const ");
            out.push_str(&name);
            out.push_str(":");
            out.push_str(&ty);
            out.push_str(" ");
            show(&value, out);
            out.push_str(")");
        }
        Item::Impl(tr, ty, fns) => {
            out.push_str("(impl ");
            if tr.len() > 0 {
                out.push_str(&tr);
                out.push_str(" for ");
            }
            out.push_str(&ty);
            let mut k: taddr = 0;
            while k < fns.len() {
                out.push_str(" ");
                show_fn(&fns[k], out);
                k += 1;
            }
            out.push_str(")");
        }
    }
}

/// A function, written out.
pub fn show_fn(f: &Fn, out: &mut String) {
    out.push_str("(fn ");
    out.push_str(&f.name);
    out.push_str(" (");
    let mut i: taddr = 0;
    while i < f.params.len() {
        if i > 0 {
            out.push_str(" ");
        }
        out.push_str(&f.params[i].name);
        out.push_str(":");
        out.push_str(&f.params[i].ty);
        i += 1;
    }
    out.push_str(") ");
    out.push_str(&f.ret);
    match &f.body {
        Option::Some(b) => {
            out.push_str(" ");
            show_block(&b, out);
        }
        Option::None => {}
    }
    out.push_str(")");
}

/// A number, written into `out`.
///
/// `/` and `%` are **symmetric** (Ch. 1 §4): they round the quotient to
/// nearest, so `15 / 10` is 2 and `15 % 10` is −5. A decimal printer wants
/// the floor, so the correction is written out — the same correction the
/// prelude's `print_int` makes, and the sixth place in this repository where
/// the radix's division has to be said out loud.
pub fn push_int(out: &mut String, v: t27) {
    let mut n = v;
    if n < 0 {
        out.push('-');
        n = 0 - n;
    }
    if n == 0 {
        out.push('0');
        return;
    }
    let mut digits: Vec<t27> = Vec::new();
    while n > 0 {
        let mut d = n % 10;
        n = n / 10;
        if d < 0 {
            d += 10;
            n -= 1;
        }
        digits.push(d);
    }
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(char::try_from(('0' as t27) + digits[i]).unwrap());
    }
}
