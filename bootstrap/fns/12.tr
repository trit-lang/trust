fn go(n: t27) -> t27 {
    let mut s = 0;
    while n > 0 {
        if n > 10 {
            s += 1;
        } else if n > 5 {
            s += 2;
        } else {
            s += 3;
        }
        n -= 1;
    }
    loop {
        if s > 100 { break; }
        s += 10;
    }
    { let a = 1; a }
}
