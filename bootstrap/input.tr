// Reading stdin, once, for every driver in this directory.
//
// The machine has a character port and no filesystem (ISA §2.2), so a
// program that reads anything reads it here. Seven copies of this were
// seven chances for two of them to differ.

fn getchar() -> t9;

/// Everything on stdin, as text.
pub fn read_all() -> String {
    let mut out: String = Vec::new();
    loop {
        let b = next_byte();
        if b < 0 {
            return out;
        }
        // UTF-8, at the boundary and nowhere inside: a `char` is one word
        // wide in this language (Ch. 5 §1.1), and the carrier is the
        // outside world's business.
        let extra = if b < 128 { 0 } else if b < 224 { 1 } else if b < 240 { 2 } else { 3 };
        let mut v = if extra == 0 {
            b
        } else if extra == 1 {
            b - 192
        } else if extra == 2 {
            b - 224
        } else {
            b - 240
        };
        let mut k = 0;
        while k < extra {
            let c = next_byte();
            if c < 0 {
                return out;
            }
            v = v * 64 + (c - 128);
            k += 1;
        }
        out.push(char::try_from(v).unwrap());
    }
}

/// One code unit, or −1 when the input has ended (ISA §2.2).
fn next_byte() -> t27 {
    loop {
        let c = getchar() as t27;
        if c == 0 - 2 {
            return 0 - 1;
        }
        if c >= 0 {
            return c;
        }
    }
}
