// The TIR a program lowers to, printed as `trustc build` prints it.
//
//     trust run bootstrap/build.tr < file.tr
//
// One file, because a type and a lowering are facts about a file and the
// module machinery is asked elsewhere. A function this does not lower yet is
// left out rather than lowered wrongly, which is why the corpus is what it
// is and not the whole of `bootstrap/`.

mod ast;
mod input;
mod layout;
mod lex;
mod lower;
mod parse;

fn main() -> t27 {
    let src = input::read_all();
    let mut p = parse::Parser { src: src, at: 0, no_struct: false };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            println("tir 0.1 target \"tritium\"");
            // Ordinary functions first and destructors after them, which
            // is the order the module is written in, and the instantiations
            // of Ch. 4 §2.5 last, because a call is what asks for one.
            let mut queued: Vec<lower::Job> = Vec::new();
            let mut i: taddr = 0;
            while i < items.len() {
                match &items[i].what {
                    ast::What::Function(f) => {
                        let mut out: String = Vec::new();
                        if lower::function(
                            f, lower::context(&items), "".to_string(),
                            Vec::new(), &mut queued, &mut out)
                        {
                            println("");
                            print(&out);
                        }
                    }
                    _ => {}
                }
                i += 1;
            }
            let mut d: taddr = 0;
            while d < items.len() {
                match &items[d].what {
                    ast::What::Impl(gs, tr, ty, fns) => {
                        let owner = lower::written_head(ty);
                        let named = match tr {
                            Option::Some(t) => lower::written_head(t),
                            Option::None => "".to_string(),
                        };
                        let mut k: taddr = 0;
                        while k < fns.len() {
                            let mut out: String = Vec::new();
                            // `Drop` is the one impl whose method becomes a
                            // function named after the *type* and not after
                            // the method (Ch. 3 §1.4).
                            // An impl with parameters of its own is one impl per
                            // instantiation of the type, and its methods are named
                            // after that — which is a type this does not instantiate.
                            let made = if !lower::plain_impl(gs) {
                                false
                            } else if named.same("Drop") {
                                lower::destructor(
                                    &fns[k], &owner, lower::context(&items), &mut out)
                            } else {
                                lower::function(
                                    &fns[k], lower::context(&items),
                                    owner.to_string(), Vec::new(),
                                    &mut queued, &mut out)
                            };
                            if made {
                                println("");
                                print(&out);
                            }
                            k += 1;
                        }
                    }
                    _ => {}
                }
                d += 1;
            }
            let made = lower::instantiations(&items, &mut queued);
            let mut z: taddr = 0;
            while z < made.len() {
                println("");
                print(&made[z].text);
                z += 1;
            }
            0
        }
        Result::Err(err) => {
            print("error ");
            print_int(err.at as t27);
            println("");
            0
        }
    }
}
