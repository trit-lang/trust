// The lexer, in Trust (Ch. 0 §1).
//
// This is the first piece of the compiler written in the language it
// compiles. What it is for is not elegance: it is to be *used*, so that
// what the language still cannot express is found by trying rather than by
// thinking.

/// What a token is. The payloads are what the rest of a compiler needs and
/// nothing more (§1.3, §1.4, §1.5).
pub enum Tok {
    Ident(String),
    Int(t27),
    Kw(String),
    Op(String),
    Str(String),
    /// A `trit` literal: `-1t`, `0t`, `1t` (§1.4).
    TritLit(t27),
    /// A character literal, as its scalar value (Ch. 5 §1.4).
    CharLit(t27),
    /// `'a` — a lifetime, without its quote (Ch. 3 §3.2).
    Lifetime(String),
    Eof,
}

pub fn is_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

pub fn is_alpha(c: char) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

pub fn is_alnum(c: char) -> bool {
    is_alpha(c) || is_digit(c)
}

pub fn is_space(c: char) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

/// Whether two pieces of text are the same, however each is held.
///
/// A `String` is a `Vec<char>` (Ch. 0 §3.6) and has `Eq`'s `eq`, which takes
/// another `Vec<char>`; a literal is a `&str`. Both *are* `&str` once
/// borrowed, so the comparison is written where they agree — and this is
/// the one place a self-hosted lexer needed the language to be told twice
/// what it already knows (G9.36).
pub fn same(a: &str, b: &str) -> bool {
    a.eq(b)
}

/// Whether `w` is one of §1.3's keywords.
pub fn is_keyword(w: &str) -> bool {
    same(w, "as") || same(w, "break") || same(w, "const") || same(w, "continue")
        || same(w, "dyn") || same(w, "else") || same(w, "enum") || same(w, "false")
        || same(w, "fn") || same(w, "for") || same(w, "if") || same(w, "impl")
        || same(w, "in") || same(w, "let") || same(w, "loop") || same(w, "macro")
        || same(w, "match") || same(w, "mod") || same(w, "mut") || same(w, "pub")
        || same(w, "return") || same(w, "self") || same(w, "Self") || same(w, "struct")
        || same(w, "trait") || same(w, "true") || same(w, "type") || same(w, "use")
        || same(w, "where") || same(w, "while")
}

/// One token and where it ended, so the caller can go on from there.
pub struct Taken {
    pub tok: Tok,
    pub at: taddr,
}

/// Read one token from `s` starting at `at`, having skipped whitespace and
/// comments. `at` is one past the end of the token.
pub fn one(s: &str, from: taddr) -> Taken {
    let mut i = skip(s, from);
    if i >= s.len() {
        return Taken { tok: Tok::Eof, at: i };
    }
    let c = s[i];

    if is_digit(c) {
        // One run of digits and letters, exactly as §1.4 reads it, and then
        // what it means is decided from the run — which is what makes `0t`
        // a trit literal and `0t1T0` an integer by maximal munch alone.
        let start = i;
        while i < s.len() && is_alnum(s[i]) {
            i += 1;
        }
        let text = slice(s, start, i);
        if trit_literal(&text) {
            return Taken { tok: Tok::TritLit(trit_value(&text)), at: i };
        }
        return Taken { tok: Tok::Int(number(&text)), at: i };
    }

    // A lifetime and a character literal both open with `'`, and are told
    // apart by the third character: `'a'` closes and `'a` does not (§1.4).
    if c == '\'' {
        if i + 2 < s.len() && s[i + 2] == '\'' && s[i + 1] != '\\' {
            return Taken { tok: Tok::CharLit(s[i + 1] as t27), at: i + 3 };
        }
        if i + 1 < s.len() && s[i + 1] == '\\' {
            return escape_literal(s, i);
        }
        let start = i + 1;
        let mut j = start;
        while j < s.len() && is_alnum(s[j]) {
            j += 1;
        }
        return Taken { tok: Tok::Lifetime(slice(s, start, j)), at: j };
    }

    if is_alpha(c) {
        let start = i;
        while i < s.len() && is_alnum(s[i]) {
            i += 1;
        }
        let w = slice(s, start, i);
        if is_keyword(&w) {
            return Taken { tok: Tok::Kw(w), at: i };
        }
        return Taken { tok: Tok::Ident(w), at: i };
    }

    if c == '"' {
        i += 1;
        let start = i;
        while i < s.len() && s[i] != '"' {
            i += 1;
        }
        let text = slice(s, start, i);
        return Taken { tok: Tok::Str(text), at: i + 1 };
    }

    // An operator, longest first (§1.5).
    let three = slice(s, i, min(i + 3, s.len()));
    if same(&three, "<<=") || same(&three, ">>=") || same(&three, "<=>") || same(&three, "..=") {
        return Taken { tok: Tok::Op(three), at: i + 3 };
    }
    let two = slice(s, i, min(i + 2, s.len()));
    if same(&two, "..") || same(&two, "==") || same(&two, "!=") || same(&two, "<=") || same(&two, ">=")
        || same(&two, "&&") || same(&two, "||") || same(&two, "->") || same(&two, "=>")
        || same(&two, "::") || same(&two, "+=") || same(&two, "-=") || same(&two, "*=")
        || same(&two, "/=") || same(&two, "%=") || same(&two, "<<") || same(&two, ">>")
    {
        return Taken { tok: Tok::Op(two), at: i + 2 };
    }
    let one = slice(s, i, i + 1);
    Taken { tok: Tok::Op(one), at: i + 1 }
}

/// A character literal whose character is written `\\…` (Ch. 5 §1.4).
fn escape_literal(s: &str, at: taddr) -> Taken {
    let e = s[at + 2];
    if e == 'u' {
        // `\u{…}`, hexadecimal, because it names a code point in a standard
        // that writes them that way.
        let mut i = at + 4;
        let mut v = 0;
        while i < s.len() && s[i] != '}' {
            v = v * 16 + hex(s[i]);
            i += 1;
        }
        return Taken { tok: Tok::CharLit(v), at: i + 2 };
    }
    let v = if e == 'n' {
        10
    } else if e == 'r' {
        13
    } else if e == 't' {
        9
    } else if e == '0' {
        0
    } else {
        e as t27
    };
    Taken { tok: Tok::CharLit(v), at: at + 4 }
}

fn hex(c: char) -> t27 {
    if is_digit(c) {
        (c as t27) - ('0' as t27)
    } else if c >= 'a' && c <= 'f' {
        (c as t27) - ('a' as t27) + 10
    } else {
        (c as t27) - ('A' as t27) + 10
    }
}

fn min(a: taddr, b: taddr) -> taddr {
    if a < b { a } else { b }
}

/// The characters `s[from..to]`, as text of its own.
fn slice(s: &str, from: taddr, to: taddr) -> String {
    let mut out: String = Vec::new();
    let mut i = from;
    while i < to {
        out.push(s[i]);
        i += 1;
    }
    out
}

/// Past whitespace and comments (§1.2), which are the same thing.
fn skip(s: &str, from: taddr) -> taddr {
    let mut i = from;
    while i < s.len() {
        if is_space(s[i]) {
            i += 1;
        } else if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '/' {
            while i < s.len() && s[i] != '\n' {
                i += 1;
            }
        } else if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '*' {
            i = block_comment(s, i);
        } else {
            return i;
        }
    }
    i
}

/// Past a block comment, which nests (§1.2).
fn block_comment(s: &str, from: taddr) -> taddr {
    let mut i = from + 2;
    let mut depth = 1;
    while i < s.len() && depth > 0 {
        if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '*' {
            depth += 1;
            i += 2;
        } else if s[i] == '*' && i + 1 < s.len() && s[i + 1] == '/' {
            depth -= 1;
            i += 2;
        } else {
            i += 1;
        }
    }
    i
}

/// Whether a run of digits and letters is a `trit` literal (§1.4).
///
/// `0t`, `1t` and nothing else: `0t1T0` is an integer, and the two are told
/// apart by there being anything after the `t`.
fn trit_literal(text: &str) -> bool {
    text.len() == 2 && (text[0] == '0' || text[0] == '1') && text[1] == 't'
}

fn trit_value(text: &str) -> t27 {
    if text[0] == '1' { 1 } else { 0 }
}

/// The value of a numeric literal, in any of the three radices (§1.4).
fn number(text: &str) -> t27 {
    if text.len() > 2 && text[0] == '0' && (text[1] == 't' || text[1] == 'T') {
        return ternary(text);
    }
    if text.len() > 2 && text[0] == '0' && (text[1] == 'h' || text[1] == 'H') {
        return hept(text);
    }
    let mut v = 0;
    let mut i: taddr = 0;
    while i < text.len() {
        if text[i] != '_' {
            v = v * 10 + ((text[i] as t27) - ('0' as t27));
        }
        i += 1;
    }
    v
}

/// `0t1T0` — balanced ternary, where `T` is −1 (Naming §3).
fn ternary(text: &str) -> t27 {
    let mut v = 0;
    let mut i: taddr = 2;
    while i < text.len() {
        let c = text[i];
        if c != '_' {
            let d = if c == 'T' || c == 't' {
                0 - 1
            } else if c == '1' {
                1
            } else {
                0
            };
            v = v * 3 + d;
        }
        i += 1;
    }
    v
}

/// `0hJ` — heptavintimal, whose digits are **balanced** and whose zero is
/// written `D` (Ch. 1 §3.1). A leading `0` is not neutral: it is −13.
fn hept(text: &str) -> t27 {
    let mut v = 0;
    let mut i: taddr = 2;
    while i < text.len() {
        let c = text[i];
        if c != '_' {
            let d = if is_digit(c) {
                (c as t27) - ('0' as t27) - 13
            } else if c >= 'A' && c <= 'Q' {
                (c as t27) - ('A' as t27) - 3
            } else {
                (c as t27) - ('a' as t27) - 3
            };
            v = v * 27 + d;
        }
        i += 1;
    }
    v
}
