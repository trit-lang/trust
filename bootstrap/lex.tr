// The lexer, in Trust (Ch. 0 §1).
//
// This is the first piece of the compiler written in the language it
// compiles. What it is for is not elegance: it is to be *used*, so that
// what the language still cannot express is found by trying rather than by
// thinking.

/// What a token is. The payloads are what the rest of a compiler needs and
/// nothing more (§1.3, §1.4, §1.5).
pub enum Tok {
    Ident(String),
    Int(t27),
    Kw(String),
    Op(String),
    Str(String),
    /// A `trit` literal: `-1t`, `0t`, `1t` (§1.4).
    TritLit(t27),
    /// A character literal, as its scalar value (Ch. 5 §1.4).
    CharLit(t27),
    /// `'a` — a lifetime, without its quote (Ch. 3 §3.2).
    Lifetime(String),
    Eof,
}

pub fn is_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

pub fn is_alpha(c: char) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

pub fn is_alnum(c: char) -> bool {
    is_alpha(c) || is_digit(c)
}

pub fn is_space(c: char) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

/// Whether `w` is one of §1.3's keywords.
pub fn is_keyword(w: &str) -> bool {
    w.same("as") || w.same("break") || w.same("const") || w.same("continue")
        || w.same("dyn") || w.same("else") || w.same("enum") || w.same("false")
        || w.same("fn") || w.same("for") || w.same("if") || w.same("impl")
        || w.same("in") || w.same("let") || w.same("loop") || w.same("macro")
        || w.same("match") || w.same("mod") || w.same("mut") || w.same("pub")
        || w.same("return") || w.same("self") || w.same("Self") || w.same("struct")
        || w.same("trait") || w.same("true") || w.same("type") || w.same("use")
        || w.same("where") || w.same("while")
}

/// One token and where it ended, so the caller can go on from there.
pub struct Taken {
    pub tok: Tok,
    pub at: taddr,
}

/// What is wrong, and where.
///
/// The position is a character offset, which is what a `str` is indexed by
/// (Ch. 5 §1.1) — not a byte, and not a line, because a line is computed
/// from an offset and an offset is not computed from a line.
pub struct Error {
    pub at: taddr,
    pub message: String,
}

fn wrong(at: taddr, message: &str) -> Error {
    Error { at: at, message: message.to_string() }
}

/// Reserved for a chapter that does not exist yet (§1.3). Using one is an
/// error that names the reason, rather than a mysterious parse failure.
pub fn is_reserved(w: &str) -> bool {
    w.same("crate") || w.same("move") || w.same("ref") || w.same("static")
        || w.same("union") || w.same("unsafe")
}

/// Read one token from `s` starting at `at`, having skipped whitespace and
/// comments. `at` is one past the end of the token.
pub fn one(s: &str, from: taddr) -> Result<Taken, Error> {
    let mut i = skip(s, from)?;
    if i >= s.len() {
        return Result::Ok(Taken { tok: Tok::Eof, at: i });
    }
    let c = s[i];

    if is_digit(c) {
        // One run of digits and letters, exactly as §1.4 reads it, and then
        // what it means is decided from the run — which is what makes `0t`
        // a trit literal and `0t1T0` an integer by maximal munch alone.
        let start = i;
        while i < s.len() && is_alnum(s[i]) {
            i += 1;
        }
        let text = slice(s, start, i);
        if trit_literal(&text) {
            return Result::Ok(Taken { tok: Tok::TritLit(trit_value(&text)), at: i });
        }
        if !well_formed(&text) {
            return Result::Err(wrong(start, "this is not a number in any of the three radices"));
        }
        return Result::Ok(Taken { tok: Tok::Int(number(&text)), at: i });
    }

    // A lifetime and a character literal both open with `'`, and are told
    // apart by the third character: `'a'` closes and `'a` does not (§1.4).
    if c == '\'' {
        if i + 2 < s.len() && s[i + 2] == '\'' && s[i + 1] != '\\' {
            return Result::Ok(Taken { tok: Tok::CharLit(s[i + 1] as t27), at: i + 3 });
        }
        if i + 1 < s.len() && s[i + 1] == '\\' {
            return escape_literal(s, i);
        }
        let start = i + 1;
        let mut j = start;
        while j < s.len() && is_alnum(s[j]) {
            j += 1;
        }
        if j == start {
            return Result::Err(wrong(i, "in a character literal: it is empty, or is not closed"));
        }
        return Result::Ok(Taken { tok: Tok::Lifetime(slice(s, start, j)), at: j });
    }

    if is_alpha(c) {
        let start = i;
        while i < s.len() && is_alnum(s[i]) {
            i += 1;
        }
        let w = slice(s, start, i);
        if is_keyword(&w) {
            return Result::Ok(Taken { tok: Tok::Kw(w), at: i });
        }
        if is_reserved(&w) {
            return Result::Err(wrong(start, "reserved for a chapter that is not written yet"));
        }
        return Result::Ok(Taken { tok: Tok::Ident(w), at: i });
    }

    if c == '"' {
        let open = i;
        i += 1;
        let start = i;
        // A newline inside one ends it: an unclosed quote would otherwise
        // swallow the rest of the file and be reported somewhere unrelated.
        while i < s.len() && s[i] != '"' && s[i] != '\n' {
            i += 1;
        }
        if i >= s.len() || s[i] == '\n' {
            return Result::Err(wrong(open, "unterminated string literal"));
        }
        let text = slice(s, start, i);
        return Result::Ok(Taken { tok: Tok::Str(text), at: i + 1 });
    }

    // `^` and `~` are reserved, and the refusal names what replaces them.
    if c == '^' || c == '~' {
        return Result::Err(wrong(
            i,
            "reserved: the trit-wise operations are the methods `tmin`, `tmax`, `tmul` and `tneg`",
        ));
    }

    // An operator, longest first (§1.5).
    let three = slice(s, i, min(i + 3, s.len()));
    if three.same("<<=") || three.same(">>=") || three.same("<=>") || three.same("..=") {
        return Result::Ok(Taken { tok: Tok::Op(three), at: i + 3 });
    }
    let two = slice(s, i, min(i + 2, s.len()));
    if two.same("..") || two.same("==") || two.same("!=") || two.same("<=") || two.same(">=")
        || two.same("&&") || two.same("||") || two.same("->") || two.same("=>")
        || two.same("::") || two.same("+=") || two.same("-=") || two.same("*=")
        || two.same("/=") || two.same("%=") || two.same("<<") || two.same(">>")
    {
        return Result::Ok(Taken { tok: Tok::Op(two), at: i + 2 });
    }
    let one = slice(s, i, i + 1);
    if !is_punctuation(c) {
        return Result::Err(wrong(i, "unexpected character"));
    }
    Result::Ok(Taken { tok: Tok::Op(one), at: i + 1 })
}

/// §1.5's punctuation, one character at a time.
fn is_punctuation(c: char) -> bool {
    c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}'
        || c == ',' || c == ';' || c == ':' || c == '.' || c == '#' || c == '='
        || c == '<' || c == '>' || c == '+' || c == '-' || c == '*' || c == '/'
        || c == '%' || c == '!' || c == '&' || c == '|' || c == '@' || c == '_'
        || c == '?' || c == '$'
}

/// Whether a run of digits and letters is a number at all (§1.4).
fn well_formed(text: &str) -> bool {
    if text.len() > 2 && text[0] == '0' && (text[1] == 't' || text[1] == 'T') {
        let mut i: taddr = 2;
        while i < text.len() {
            let c = text[i];
            if c != '_' && c != '0' && c != '1' && c != 'T' && c != 't' {
                return false;
            }
            i += 1;
        }
        return true;
    }
    if text.len() > 2 && text[0] == '0' && (text[1] == 'h' || text[1] == 'H') {
        let mut i: taddr = 2;
        while i < text.len() {
            let c = text[i];
            let ok = c == '_' || is_digit(c) || (c >= 'A' && c <= 'Q') || (c >= 'a' && c <= 'q');
            if !ok {
                return false;
            }
            i += 1;
        }
        return true;
    }
    let mut i: taddr = 0;
    while i < text.len() {
        if text[i] != '_' && !is_digit(text[i]) {
            return false;
        }
        i += 1;
    }
    true
}

/// A character literal whose character is written `\\…` (Ch. 5 §1.4).
fn escape_literal(s: &str, at: taddr) -> Result<Taken, Error> {
    if at + 2 >= s.len() {
        return Result::Err(wrong(at, "in an escape: the file ends"));
    }
    let e = s[at + 2];
    if e == 'u' {
        // `\u{…}`, hexadecimal, because it names a code point in a standard
        // that writes them that way.
        let mut i = at + 4;
        let mut v = 0;
        while i < s.len() && s[i] != '}' {
            v = v * 16 + hex(s[i]);
            i += 1;
        }
        return Result::Ok(Taken { tok: Tok::CharLit(v), at: i + 2 });
    }
    let known = e == 'n' || e == 'r' || e == 't' || e == '0' || e == '\\'
        || e == '\'' || e == '"';
    if !known {
        return Result::Err(wrong(at, "in an escape: that is not one"));
    }
    let v = if e == 'n' {
        10
    } else if e == 'r' {
        13
    } else if e == 't' {
        9
    } else if e == '0' {
        0
    } else {
        e as t27
    };
    Result::Ok(Taken { tok: Tok::CharLit(v), at: at + 4 })
}

fn hex(c: char) -> t27 {
    if is_digit(c) {
        (c as t27) - ('0' as t27)
    } else if c >= 'a' && c <= 'f' {
        (c as t27) - ('a' as t27) + 10
    } else {
        (c as t27) - ('A' as t27) + 10
    }
}

fn min(a: taddr, b: taddr) -> taddr {
    if a < b { a } else { b }
}

/// The characters `s[from..to]`, as text of its own.
fn slice(s: &str, from: taddr, to: taddr) -> String {
    let mut out: String = Vec::new();
    let mut i = from;
    while i < to {
        out.push(s[i]);
        i += 1;
    }
    out
}

/// Past whitespace and comments (§1.2), which are the same thing.
fn skip(s: &str, from: taddr) -> Result<taddr, Error> {
    let mut i = from;
    while i < s.len() {
        if is_space(s[i]) {
            i += 1;
        } else if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '/' {
            while i < s.len() && s[i] != '\n' {
                i += 1;
            }
        } else if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '*' {
            i = block_comment(s, i)?;
        } else {
            return Result::Ok(i);
        }
    }
    Result::Ok(i)
}

/// Past a block comment, which nests (§1.2).
fn block_comment(s: &str, from: taddr) -> Result<taddr, Error> {
    let mut i = from + 2;
    let mut depth = 1;
    while i < s.len() && depth > 0 {
        if s[i] == '/' && i + 1 < s.len() && s[i + 1] == '*' {
            depth += 1;
            i += 2;
        } else if s[i] == '*' && i + 1 < s.len() && s[i + 1] == '/' {
            depth -= 1;
            i += 2;
        } else {
            i += 1;
        }
    }
    if depth > 0 {
        return Result::Err(wrong(from, "unterminated block comment"));
    }
    Result::Ok(i)
}

/// Whether a run of digits and letters is a `trit` literal (§1.4).
///
/// `0t`, `1t` and nothing else: `0t1T0` is an integer, and the two are told
/// apart by there being anything after the `t`.
fn trit_literal(text: &str) -> bool {
    text.len() == 2 && (text[0] == '0' || text[0] == '1') && text[1] == 't'
}

fn trit_value(text: &str) -> t27 {
    if text[0] == '1' { 1 } else { 0 }
}

/// The value of a numeric literal, in any of the three radices (§1.4).
fn number(text: &str) -> t27 {
    if text.len() > 2 && text[0] == '0' && (text[1] == 't' || text[1] == 'T') {
        return ternary(text);
    }
    if text.len() > 2 && text[0] == '0' && (text[1] == 'h' || text[1] == 'H') {
        return hept(text);
    }
    let mut v = 0;
    let mut i: taddr = 0;
    while i < text.len() {
        if text[i] != '_' {
            v = v * 10 + ((text[i] as t27) - ('0' as t27));
        }
        i += 1;
    }
    v
}

/// `0t1T0` — balanced ternary, where `T` is −1 (Naming §3).
fn ternary(text: &str) -> t27 {
    let mut v = 0;
    let mut i: taddr = 2;
    while i < text.len() {
        let c = text[i];
        if c != '_' {
            let d = if c == 'T' || c == 't' {
                0 - 1
            } else if c == '1' {
                1
            } else {
                0
            };
            v = v * 3 + d;
        }
        i += 1;
    }
    v
}

/// `0hJ` — heptavintimal, whose digits are **balanced** and whose zero is
/// written `D` (Ch. 1 §3.1). A leading `0` is not neutral: it is −13.
fn hept(text: &str) -> t27 {
    let mut v = 0;
    let mut i: taddr = 2;
    while i < text.len() {
        let c = text[i];
        if c != '_' {
            let d = if is_digit(c) {
                (c as t27) - ('0' as t27) - 13
            } else if c >= 'A' && c <= 'Q' {
                (c as t27) - ('A' as t27) - 3
            } else {
                (c as t27) - ('a' as t27) - 3
            };
            v = v * 27 + d;
        }
        i += 1;
    }
    v
}
