// TIR, in Trust: the module a program lowers to (TIR §1).
//
// The first slice of the compiler's *back* half, and the one that makes
// `stage1` exist (docs/ddc.md §4). It answers with the same canonical text
// `trustc tir` prints — names included, `%v.3` and `%a.5` as much as the
// instructions, because equality is on the text and a comparison that
// normalized the names away could not see two implementations emitting
// different code.
//
// What it lowers so far: a function's parameters, a `let` of a scalar, the
// arithmetic of Ch. 1, a call, a `return`, and a tail. Not yet: control
// flow, comparisons, aggregates, and the drops Ch. 3 §1.4 puts at the end
// of a scope — in that order, which is the order the corpus grew.

use ast;
use ast::Ty;
use layout;

/// The signatures of the file, so a call knows what it answers with. Set
/// before any function is lowered, since a call may name one written later.
pub struct Sig {
    pub name: String,
    pub ret: String,
}

/// A generic function as it was written, so a call can work out which
/// instantiation it means (Ch. 4 §2.5).
///
/// What is written is not one function; it is a family, and what a program
/// contains is one member of it per distinct set of type arguments. Nothing
/// here is the family's body: a member is made by reading the same source
/// again under a key.
pub struct Family {
    pub name: String,
    /// Its type parameters, in declaration order — which is the order a key
    /// is in, and the only thing that makes a key readable back.
    pub tyvars: Vec<String>,
    /// How many of them the *receiver* decides. A method of an
    /// `impl<T> Pair<T>` is a family whose first parameter is not written
    /// anywhere a call can see: it is whatever the receiver turned out to
    /// be, so it is read off the receiver's own instantiation and the rest
    /// are inferred from the arguments as usual.
    pub from_self: taddr,
    /// The written head of each parameter's type, `,`-joined: a type
    /// parameter's own name wherever that is what was written.
    pub params: String,
    /// The written head of what it answers with.
    pub ret: String,
}

/// One instantiation waiting to be emitted: the family it comes from and
/// the type arguments, in declaration order (Ch. 4 §2.7).
pub struct Job {
    pub name: String,
    pub key: Vec<String>,
}

/// What a mangled name was made from.
///
/// `Holder.Pair.t27` cannot be read back into a head and its arguments —
/// the dots do not say where one stops — so what made it is remembered
/// rather than parsed. A method of a parameterized impl needs exactly that
/// reading: which instantiation its receiver is.
pub struct Inst {
    pub full: String,
    pub base: String,
    pub key: Vec<String>,
}

/// What a function answers with, as it was written.
///
/// `sigs` carries the name TIR gives an answer and has none for an
/// aggregate, because TIR does not answer with one — it is written into
/// storage the caller provides (TIR §3). So the caller needs the type
/// itself, to know how much storage that is.
pub struct RetTy {
    pub name: String,
    pub ty: ast::Ty,
}

/// A generic type as it was written (Ch. 4 §2.5).
///
/// A type with parameters is not a type; it is one type per instantiation,
/// and none of them is called what is written. Its fields still name its
/// parameters here, because what makes a member of the family is reading
/// them again under a key. A type written with no parameters is a family of
/// one and is its own member, which is what `definitions` takes out.
pub struct TyFamily {
    pub name: String,
    pub tyvars: Vec<String>,
    pub def: layout::Def,
}

/// One function that was emitted: the name TIR knows it by, and its text.
pub struct Made {
    pub name: String,
    pub text: String,
}

/// A closure, as the function and the type it turns into (Ch. 4 §4.1).
///
/// It is found while a body is lowered and not before, because what it
/// captures is which of the names it uses are *locals here* — a question
/// only the function holding it can answer.
pub struct Closed {
    /// `main.closure1` — which closure of which function, and nothing about
    /// how either was numbered (G9.67).
    pub name: String,
    pub params: Vec<ast::Named>,
    pub ret: Option<ast::Ty>,
    /// What it captures: the local's name, its storage, and its type. Each
    /// becomes a field of the closure's type, holding the *address*.
    pub captures: Vec<Slot>,
    pub body: ast::Expr,
}

/// What lowering one function left for the next: the instantiations it
/// asked for, and the closures it turned out to hold.
///
/// One value rather than two out-parameters, because they travel together
/// and because a function is given at most eight things (Ch. 5).
pub struct Work {
    pub jobs: Vec<Job>,
    pub closed: Vec<Closed>,
    /// The string literals the module holds, in the order they were first
    /// seen, and the characters of each. Unlike everything else a function
    /// leaves behind, this cannot be recovered from the finished text:
    /// `@vt.Sq.Area` says which type and which trait in its own name, and
    /// `@str.0` says nothing at all about what is in it.
    pub strings: Vec<String>,
}

/// What a function is lowered against: everything about the file that is not
/// the function itself.
///
/// One value rather than five parameters, because they always travel
/// together and because a function is given at most eight things (Ch. 5).
pub struct Cx {
    /// The closures found so far, which are types like any other by the
    /// time whatever uses them is lowered.
    pub closed: Vec<Closed>,
    pub sigs: Vec<Sig>,
    pub params: Vec<Sig>,
    pub defs: Vec<layout::Def>,
    pub drops: Vec<String>,
    pub families: Vec<Family>,
    pub tyfams: Vec<TyFamily>,
    pub rets: Vec<RetTy>,
}

/// One local: the name it was written with, its slot, and its type.
pub struct Slot {
    pub name: String,
    pub slot: String,
    pub ty: String,
}

/// One basic block: its label, and what runs in it (TIR §2).
pub struct Chunk {
    pub label: String,
    pub insts: Vec<String>,
}

/// A function being emitted.
///
/// Slots are kept apart from instructions because TIR prints them first,
/// whatever order they were made in — a slot is storage and storage has no
/// place in the order of what runs.
///
/// Finished blocks are kept in the order they were *finished*, which is not
/// the order they run in: a `while`'s body is lowered before its head, so
/// the body is printed first and jumped over. Both implementations have to
/// agree about that order, since equality is on the text.
pub struct Emit {
    pub slots: Vec<String>,
    pub insts: Vec<String>,
    pub label: String,
    pub blocks: Vec<Chunk>,
    pub locals: Vec<Slot>,
    /// One counter for slots and values both, which is what makes two
    /// implementations that agree about the order agree about the names.
    pub next: t27,
    /// Whether anything could not be lowered, in which case nothing is
    /// printed for this function rather than something wrong.
    pub stuck: bool,
    /// What every function in the file answers with: a call is the one
    /// thing a function cannot work out from itself.
    pub sigs: Vec<Sig>,
    /// Whether the block being lowered has already left, in which case
    /// nothing after it is reached and no `ret` is added at its end.
    pub done: bool,
    /// What the parameters of each function are, so an argument knows what
    /// width a literal written for it should be.
    pub params: Vec<Sig>,
    /// The nominal types the file defines, for the offsets Ch. 2 gives
    /// them. It is the same engine `bootstrap/sizes.tr` is held to.
    pub defs: Vec<layout::Def>,
    /// Which types have a destructor, by name (Ch. 3 §1.4).
    pub drops: Vec<String>,
    /// The locals this scope is responsible for dropping, innermost last.
    pub owned: Vec<Slot>,
    /// The type an `impl`'s `self` points at, for a field read through it.
    pub self_ty: String,
    /// The generic functions of the file, so a call to one can work out
    /// which instantiation it means (Ch. 4 §2.5).
    pub families: Vec<Family>,
    /// Every instantiation asked for so far, in the order it was first
    /// asked for. Append-only: a key that has been asked for once is never
    /// asked for again, which is what makes the queue drain.
    pub jobs: Vec<Job>,
    /// The type parameters of the function being emitted, and what this
    /// instantiation puts for them — so that a type written in the *body*
    /// is read under the key too, and not only the signature.
    pub tyvars: Vec<String>,
    pub key: Vec<String>,
    /// The generic types of the file. `defs` holds the members that have
    /// been asked for; this holds what the rest are made from.
    pub tyfams: Vec<TyFamily>,
    /// What each function answers with, as written, for the storage a
    /// caller has to provide when the answer is an aggregate.
    pub rets: Vec<RetTy>,
    /// Every instantiation of a type made so far, with what it was made
    /// from — the reading a mangled name cannot be parsed back into.
    pub instances: Vec<Inst>,
    /// The closures this function turned out to hold, and how many it has
    /// made — which is what names the next one (G9.67).
    pub closed: Vec<Closed>,
    pub closures_made: t27,
    /// The name this function is emitted under, which a closure's is made
    /// from.
    pub owner_name: String,
    /// The instantiations being made right now, so that a type reaching
    /// itself is refused rather than read for ever. Nothing is taken off
    /// it: by the time one finishes, its name is in `defs`, and that is
    /// what every later ask finds first.
    pub making: Vec<String>,
    /// Every string literal the module has written down so far, the ones
    /// this function found last. It comes in from the module and goes back
    /// out to it, because two functions writing the same characters write
    /// the same global (Ch. 2 §4).
    pub strings: Vec<String>,
}

/// A value in TIR: either a name or a constant, as it is written.
pub struct Value {
    pub text: String,
    pub ty: String,
}

/// The name a written type has, which is what the emitter carries.
///
/// The *written* one, not TIR's: `trit` and `bool` are both one trit wide
/// and a monomorphization has to tell them apart — `id.trit` is not
/// `id.t1` (Ch. 6 §4). What TIR calls it is asked for where TIR is written,
/// by `tir_of`, so there is one truth and it is this one.
pub fn tir_ty(t: &ast::Ty) -> String {
    let none: Vec<String> = Vec::new();
    let empty: Vec<String> = Vec::new();
    tir_ty_at(&none, &empty, t)
}

/// The same, read under a key: a type parameter stands for whatever the
/// instantiation put there (Ch. 4 §2.5), and everything else is itself.
pub fn tir_ty_at(tyvars: &Vec<String>, key: &Vec<String>, t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => {
            let written = joined(segments);
            let n = subst(tyvars, key, &written);
            scalar_named(&n)
        }
        _ => "?".to_string(),
    }
}

/// The name a reference type has here: `&` and then the name of what it
/// points at. TIR spells every reference `ptr`, so this is the only place
/// the referent survives, and a dereference is the only thing that needs it.
pub fn ref_name(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Ref(held, m) => {
            if unsized_ref(&*held) {
                return "".to_string();
            }
            let inner = name_head(&*held);
            if inner.len() == 0 {
                return "".to_string();
            }
            let mut out: String = Vec::new();
            out.push('&');
            out.push_str(&inner);
            out
        }
        _ => "".to_string(),
    }
}

/// What a `&T` points at, by name, or nothing for a name that is not one.
pub fn referent_name(name: &str) -> String {
    if name.len() > 1 && name[0] == '&' {
        let mut out: String = Vec::new();
        let mut i: taddr = 1;
        while i < name.len() {
            out.push(name[i]);
            i += 1;
        }
        return out;
    }
    "".to_string()
}

/// The name a trait object has here: `dyn.<Trait>`.
///
/// A trait object has no size of its own (Ch. 4 §3.1) and a *reference* to
/// one is two words, which TIR has no name for. So what carries it is a
/// definition nobody wrote — the data address and the table's — and this is
/// what that definition is called.
pub fn dyn_name(trait_name: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("dyn.");
    out.push_str(trait_name);
    out
}

/// The name the shape of a trait's table has: `vtable.<Trait>`, one field
/// per method under the method's own name — which is what turns `x.twice()`
/// into an index and the index into an offset (Ch. 4 §3.3).
pub fn vtable_name(trait_name: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("vtable.");
    out.push_str(trait_name);
    out
}

/// The name the two words a `&str` is have: `fat.str`.
///
/// Text whose length its own type does not say is not one word but two —
/// where the characters are, and how many of them there are (Ch. 2 §4) — and
/// TIR has no name for a pair. So it needs a definition nobody wrote, of the
/// same shape and for the same reason `dyn.<Trait>` needs one. The `.` is
/// what keeps it out of the way: a program may still call a type of its own
/// `str`, and nothing it can write is spelled like this.
pub fn str_name() -> String {
    "fat.str".to_string()
}

/// The name the global holding the nth string literal has.
pub fn string_symbol(n: taddr) -> String {
    let mut out: String = Vec::new();
    out.push_str("str.");
    push_int(&mut out, n as t27);
    out
}

/// Whether a written type is `str`.
pub fn is_str(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Name(segments) => {
            let n = joined(segments);
            n.same("str")
        }
        _ => false,
    }
}

/// The definition a *reference* to this written type is, or nothing where a
/// reference to it is one word and TIR can say so itself.
///
/// Both kinds are two words and neither pair is a type TIR names:
/// `&dyn Trait` carries the table beside the address and `&str` carries the
/// length. Everything that reads one reads the other the same way, which is
/// what one name for the question is for.
pub fn fat_name(t: &ast::Ty) -> String {
    let object = dyn_referent(t);
    if object.len() > 0 {
        return dyn_name(&object);
    }
    match t {
        ast::Ty::Ref(held, m) => {
            if is_str(&*held) {
                str_name()
            } else {
                "".to_string()
            }
        }
        _ => "".to_string(),
    }
}

/// The name an array type has here: `array.<T>.<N>`.
///
/// An array is N elements of one type at `i × size_of::<T>()` (Ch. 2 §3),
/// which is a definition with N fields — so it is given one, and everything
/// that fills, copies and lays out an aggregate works on it unchanged. The
/// definition is made where the type is first named, exactly as an
/// instantiation is.
pub fn array_name(elem: &str, n: taddr) -> String {
    let mut out: String = Vec::new();
    out.push_str("array.");
    out.push_str(elem);
    out.push_str(".");
    push_int(&mut out, n as t27);
    out
}

/// The name a tuple type has here: `tuple.<A>.<B>`.
///
/// A tuple is a product with no name (Ch. 2 §2), so it is given one — the
/// same `.`-joining a monomorphization uses, and read back the same way,
/// which is to say never: what is in it is read off the definition.
pub fn tuple_name(elems: &Vec<String>) -> String {
    mangled("tuple", elems)
}

/// The name a written tuple type has, worked out from the writing alone.
///
/// Which is all a *signature* can do: `nominal` needs an emitter and a
/// signature is read before there is one. An element whose type is not
/// written as a plain name leaves nothing to say, and the answer is then
/// nothing at all rather than a name that is not the type's.
pub fn written_tuple(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Tuple(args) => {
            let mut elems: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = written_element(&args[i]);
                if each.len() == 0 {
                    return "".to_string();
                }
                elems.push(each);
                i += 1;
            }
            if elems.len() == 0 {
                return "".to_string();
            }
            tuple_name(&elems)
        }
        _ => "".to_string(),
    }
}

/// What one element of a written tuple is called: a tuple's own name where
/// it is one, and the written head where it is not.
pub fn written_element(t: &ast::Ty) -> String {
    let held = written_tuple(t);
    if held.len() > 0 {
        return held;
    }
    name_head(t)
}

/// Whether a name is a tuple's.
pub fn is_tuple(name: &str) -> bool {
    let head = "tuple.";
    if name.len() <= head.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < head.len() {
        if name[i] != head[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// Whether a name is an array's. Only the head is asked: what is *in* the
/// name is read off the definition, which is where it will still be right.
pub fn is_array(name: &str) -> bool {
    let head = "array.";
    if name.len() <= head.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < head.len() {
        if name[i] != head[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// Which trait a `dyn.<Trait>` is of, or nothing for a name that is not one.
pub fn dyn_trait(name: &str) -> String {
    let head = "dyn.";
    if name.len() <= head.len() {
        return "".to_string();
    }
    let mut i: taddr = 0;
    while i < head.len() {
        if name[i] != head[i] {
            return "".to_string();
        }
        i += 1;
    }
    let mut out: String = Vec::new();
    let mut k = head.len();
    while k < name.len() {
        out.push(name[k]);
        k += 1;
    }
    out
}

/// The trait a written type is an object of, or nothing for one that is not.
pub fn dyn_of(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Dyn(name) => name.to_string(),
        _ => "".to_string(),
    }
}

/// The trait a written type is a *reference* to an object of, or nothing.
pub fn dyn_referent(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Ref(held, m) => dyn_of(&*held),
        _ => "".to_string(),
    }
}

/// The name a parameter's written type has here.
///
/// TIR's for everything it has a name for, and `&dyn.<Trait>` for a
/// reference to a trait object — which TIR spells with no name at all,
/// since it is two words and every TIR type of that width is one thing.
/// It is the same job `&P` does for a plain reference (Ch. 3 §2.1).
pub fn param_name(t: &ast::Ty) -> String {
    let object = dyn_referent(t);
    if object.len() > 0 {
        let mut out: String = Vec::new();
        out.push('&');
        let held = dyn_name(&object);
        out.push_str(&held);
        return out;
    }
    // A tuple has no name to look up, so an argument written `(1, 2)` takes
    // its element types from the parameter — which means the parameter has
    // to be able to say. `definitions` has put the shape there already.
    let tuple = written_tuple(t);
    if tuple.len() > 0 {
        return tuple;
    }
    tir_ty(t)
}

/// What TIR calls the type of a *field*.
///
/// A field may be a reference, which TIR spells `ptr` — and a reference to
/// something whose size is not in its type is two words and not one, which
/// TIR has no name for, so a field of that kind is refused (Ch. 2 §4).
pub fn field_tir(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Ref(held, m) => {
            if unsized_ref(&*held) {
                "?".to_string()
            } else {
                "ptr".to_string()
            }
        }
        _ => tir_ty(t),
    }
}

/// Whether a reference to this carries a length beside the address, which
/// makes it two words and not one (Ch. 2 §4).
fn unsized_ref(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Slice(inner) => true,
        // A trait object's type is not known at all, so a reference to one
        // carries the table beside the address (Ch. 4 §3.1) — which is the
        // same two words, and the same reason `layout.tr` says so too.
        ast::Ty::Dyn(name) => true,
        ast::Ty::Name(segments) => {
            let n = joined(segments);
            n.same("str")
        }
        _ => false,
    }
}

/// A name TIR has a spelling for, or `?` for one it does not.
pub fn scalar_named(n: &str) -> String {
    if n.same("t9") || n.same("bool") || n.same("trit") || n.same("t27")
        || n.same("taddr") || n.same("char")
    {
        n.to_string()
    } else {
        "?".to_string()
    }
}

/// What a signature says a function answers with.
///
/// TIR's name for it, or `()` where it answers with **nothing** — which TIR
/// spells by leaving the arrow off the header and off the call. That is not
/// the same fact as `?`, a type this cannot name, and telling the two apart
/// is the whole of what lets a call to a `fn f() { … }` be lowered rather
/// than refused.
pub fn written_answer(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Unit => "()".to_string(),
        _ => tir_ty(t),
    }
}

/// Whether a name is the one for answering with nothing.
pub fn answers_nothing(name: &str) -> bool {
    name.same("()")
}

/// What a name stands for under a key: the type argument written for it
/// where it is a type parameter, and itself where it is not.
pub fn subst(tyvars: &Vec<String>, key: &Vec<String>, name: &str) -> String {
    let mut i: taddr = 0;
    while i < tyvars.len() && i < key.len() {
        if tyvars[i].same(name) {
            return key[i].to_string();
        }
        i += 1;
    }
    name.to_string()
}

/// The name an instantiation is known by: the family's, with its type
/// arguments after it, which is the same `.` `drop.Buffer` already uses
/// (Ch. 6 §4).
pub fn mangled(name: &str, key: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    out.push_str(name);
    let mut i: taddr = 0;
    while i < key.len() {
        out.push_str(".");
        out.push_str(&key[i]);
        i += 1;
    }
    out
}

/// What TIR calls a type of this name (§1). A `bool` and a `trit` are both
/// one trit wide, and `taddr` and `char` are words.
pub fn tir_of(name: &str) -> String {
    // A reference is an address whatever it points at, and `&t27` is the
    // name that says *what* — which TIR does not need and a dereference
    // does (Ch. 3 §2.1).
    if name.len() > 1 && name[0] == '&' {
        return "ptr".to_string();
    }
    if name.same("t9") {
        "t9".to_string()
    } else if name.same("bool") || name.same("trit") {
        "t1".to_string()
    } else if name.same("t27") || name.same("taddr") || name.same("char") {
        "t27".to_string()
    } else {
        name.to_string()
    }
}

/// What a reference points at, or the unit for a type that is not one.
fn referent(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Ref(held, m) => ast::copy_ty(&*held),
        _ => ast::Ty::Unit,
    }
}

/// Whether a written type is a reference (Ch. 3 §2.1).
pub fn is_reference(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Ref(inner, m) => true,
        _ => false,
    }
}

/// How many trytes a TIR type takes (Ch. 2 §1).
pub fn trytes(ty: &str) -> t27 {
    if ty.same("t9") || ty.same("t1") {
        1
    } else {
        3
    }
}

/// A fresh label, `^<prefix>.<n>`, and the counter moves on.
fn label(e: &mut Emit, prefix: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("^");
    out.push_str(prefix);
    out.push_str(".");
    push_int(&mut out, e.next);
    e.next = e.next + 1;
    out
}

/// End the block being emitted and start another.
fn start(e: &mut Emit, name: &str) {
    let mut held: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < e.insts.len() {
        held.push(e.insts[i].to_string());
        i += 1;
    }
    e.blocks.push(Chunk { label: e.label.to_string(), insts: held });
    e.insts = Vec::new();
    let mut open: String = Vec::new();
    open.push_str(name);
    open.push_str(":");
    e.label = open;
    e.done = false;
}

/// `br ^somewhere`.
fn jump(e: &mut Emit, to: &str) {
    let mut line: String = Vec::new();
    line.push_str("    br ");
    line.push_str(to);
    e.insts.push(line);
    e.done = true;
}

/// A fresh name, `%<prefix>.<n>`, and the counter moves on.
fn fresh(e: &mut Emit, prefix: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("%");
    out.push_str(prefix);
    out.push_str(".");
    push_int(&mut out, e.next);
    e.next = e.next + 1;
    out
}

/// A slot for a local, made where the value that fills it is ready.
fn slot_for(e: &mut Emit, name: &str, ty: &str) -> String {
    let mut prefix: String = Vec::new();
    prefix.push_str(name);
    prefix.push_str(".slot");
    let slot = fresh(e, &prefix);
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    let wide = tir_of(ty);
    let size = sized(e, &wide);
    push_int(&mut line, size);
    line.push_str("]");
    e.slots.push(line);
    e.locals.push(Slot {
        name: name.to_string(),
        slot: slot.to_string(),
        ty: ty.to_string(),
    });
    slot
}

/// How many trytes storage of this type takes: Ch. 2's answer where the
/// type is one the program defines, and TIR's where it is a scalar.
fn sized(e: &Emit, ty: &str) -> t27 {
    let at = def_at(&e.defs, ty);
    if at < 0 {
        return trytes(ty);
    }
    let self_ty = ast::Ty::Name(one_name(ty));
    match layout::of(&e.defs, &self_ty, 0) {
        // Storage is never nothing: a type with no fields still has an
        // address, and an address needs somewhere to point (Ch. 2 §1).
        Result::Ok(l) => {
            if l.size < 1 {
                1
            } else {
                l.size as t27
            }
        }
        Result::Err(why) => trytes(ty),
    }
}

/// Which local is called this, or −1.
fn local_at(e: &Emit, name: &str) -> taddr {
    let mut i = e.locals.len();
    while i > 0 {
        i -= 1;
        if e.locals[i].name.same(name) {
            return i as taddr;
        }
    }
    0 - 1
}

/// One function, as the text TIR prints it, or nothing when something in it
/// is not lowered yet.
pub fn function(
    f: &ast::Fn,
    cx: Cx,
    owner: String,
    outer: Vec<String>,
    key: Vec<String>,
    work: &mut Work,
    out: &mut String,
) -> bool {
    // A generic function is one function per instantiation and none of them
    // is the one that was written (Ch. 4 §2.5): emitting it as written would
    // be emitting a function no program calls under a name no call uses. A
    // *key* is what says this reading is an instantiation — the type
    // arguments, in declaration order — so what is refused here is a family
    // read without one, and a key that does not fit the family it is for.
    // The receiver's parameters come first: a method of an
    // `impl<T> Pair<T>` is read under `T` and then under its own.
    let mut tyvars = ast::copy_names(&outer);
    let own = all_tyvars(f);
    let mut g: taddr = 0;
    while g < own.len() {
        tyvars.push(own[g].to_string());
        g += 1;
    }
    if tyvars.len() != key.len() {
        return false;
    }
    let mut e = Emit {
        slots: Vec::new(),
        insts: Vec::new(),
        locals: Vec::new(),
        next: 1,
        stuck: false,
        sigs: cx.sigs,
        done: false,
        params: cx.params,
        label: "^entry:".to_string(),
        blocks: Vec::new(),
        defs: cx.defs,
        drops: cx.drops,
        owned: Vec::new(),
        self_ty: owner.to_string(),
        families: cx.families,
        jobs: copy_jobs(&work.jobs),
        tyvars: ast::copy_names(&tyvars),
        key: ast::copy_names(&key),
        tyfams: cx.tyfams,
        rets: cx.rets,
        instances: Vec::new(),
        making: Vec::new(),
        closed: cx.closed,
        closures_made: 0,
        owner_name: "".to_string(),
        strings: ast::copy_names(&work.strings),
    };
    // What a closure found before this was lowered is a type like any
    // other: its storage is a field per capture, holding an address.
    let mut c: taddr = 0;
    while c < e.closed.len() {
        let held = one_closed(&e.closed[c]);
        note_closure(&mut e, &held);
        c += 1;
    }

    settle(&mut e);

    // What `self` points at is the receiver's *instantiation*, not the
    // family: `&self` in an `impl<T> Pair<T>` reads the fields of the
    // `Pair.t27` this one is for.
    if outer.len() > 0 {
        let mut mine: Vec<String> = Vec::new();
        let mut o: taddr = 0;
        while o < outer.len() {
            mine.push(key[o].to_string());
            o += 1;
        }
        let held = instantiate(&mut e, &owner, &mine);
        if held.len() == 0 {
            return false;
        }
        e.self_ty = held;
    }

    // A parameter arrives as a value and is given storage at once, so that
    // everything below reads it the same way a local is read.
    let mut header: String = Vec::new();
    header.push_str("fn @");
    if owner.len() > 0 {
        header.push_str(&owner);
        header.push_str(".");
    }
    header.push_str(&f.name);
    // An instantiation carries its type arguments in its name, which is the
    // whole of what tells `id.trit` from `id.t27` (Ch. 6 §4).
    let mut g: taddr = 0;
    while g < key.len() {
        header.push_str(".");
        header.push_str(&key[g]);
        g += 1;
    }
    // What a closure written in here is named after: the function as it is
    // emitted, instantiation and all, so two instantiations of one generic
    // do not name the same closure type.
    let mut mine: String = Vec::new();
    if owner.len() > 0 {
        mine.push_str(&owner);
        mine.push_str(".");
    }
    mine.push_str(&f.name);
    let mut g: taddr = 0;
    while g < key.len() {
        mine.push_str(".");
        mine.push_str(&key[g]);
        g += 1;
    }
    e.owner_name = mine;
    header.push_str("(");
    // A function whose answer is an aggregate is given the storage for it,
    // because a value that big is not carried in a register (TIR §3).
    // An application is a type once it is instantiated (Ch. 4 §2.5), so
    // asking what the answer *is* is what makes `Pair<t27>` exist.
    let written = subst_ty(&mut e, &tyvars, &key, &f.ret);
    let answer = nominal(&mut e, &written);
    let sret = def_at(&e.defs, &answer) >= 0;
    if sret {
        header.push_str("%sret: ptr");
    }
    let mut i: taddr = 0;
    while i < f.params.len() {
        if i > 0 || sret {
            header.push_str(", ");
        }
        let written_param = param_written(f, i);
        let ty = tir_ty_at(&tyvars, &key, &written_param);
        let name = f.params[i].name.to_string();
        // `&self` is a reference and stays one: what a method is given is an
        // address, and reading through it is a load and then the field's own
        // (Ch. 3 §2.2). An aggregate *value* is copied in; an address is not.
        // A receiver taken **by value** on a scalar is a value: it arrives
        // in a register like any other parameter, and what a caller hands
        // over is the value and not where it is (Ch. 3 §2.2). On an
        // aggregate it is still a pointer to the caller's copy, which the
        // branch further down already reads under the owner's name.
        if name.same("self") && !is_reference(&f.params[i].ty) {
            let mine = e.self_ty.to_string();
            let held = scalar_named(&mine);
            if !held.same("?") {
                header.push_str("%self: ");
                let shown = tir_of(&mine);
                header.push_str(&shown);
                let slot = slot_for(&mut e, "self", &mine);
                let mut store: String = Vec::new();
                store.push_str("    store ");
                let wide = tir_of(&mine);
                store.push_str(&wide);
                store.push_str(" %self, ");
                store.push_str(&slot);
                e.insts.push(store);
                i += 1;
                continue;
            }
        }
        if name.same("self") && is_reference(&f.params[i].ty) {
            // What a reference to the impl's own type *is*. On `impl str`
            // it is two words and not one, exactly as a written `&str`
            // parameter is — a receiver is a parameter whose type the impl
            // says rather than the list (Ch. 3 §2.2), and here what it says
            // has no size of its own.
            let mine = ast::Ty::Ref(Box::new(ast::Ty::Name(one_name(&owner))), false);
            let wide = fat_name(&mine);
            if wide.len() > 0 {
                let at = def_at(&e.defs, &wide);
                if at < 0 {
                    return false;
                }
                header.push_str("%self: ptr");
                let copied = copy_in(&mut e, "self", at);
                if !copied {
                    return false;
                }
                i += 1;
                continue;
            }
            // What `self` points at, where the function was not written on
            // an `impl` and so has no owner to say: a closure's `call` is
            // the one of those (Ch. 4 §4.1).
            if e.self_ty.len() == 0 {
                let held = referent(&f.params[i].ty);
                e.self_ty = nominal(&mut e, &held);
            }
            header.push_str("%self: ptr");
            let slot = slot_for(&mut e, "self", "ptr");
            let mut store: String = Vec::new();
            store.push_str("    store ptr %self, ");
            store.push_str(&slot);
            e.insts.push(store);
            i += 1;
            continue;
        }
        // A **fat** reference is not one word but two: `&dyn Trait` carries
        // the table of its type's methods beside the address (Ch. 4 §3.1)
        // and `&str` carries the length (Ch. 2 §4). Either arrives as a
        // pointer to those two words and is copied into storage of its own
        // exactly as any two-field aggregate is — which is the whole of what
        // the synthetic `dyn.<Trait>` and `fat.str` are definitions for.
        if ty.same("?") {
            let held = subst_ty(&mut e, &tyvars, &key, &written_param);
            let named = fat_name(&held);
            if named.len() > 0 {
                let at = def_at(&e.defs, &named);
                if at < 0 {
                    return false;
                }
                header.push_str("%");
                header.push_str(&name);
                header.push_str(": ptr");
                let copied = copy_in(&mut e, &name, at);
                if !copied {
                    return false;
                }
                i += 1;
                continue;
            }
        }
        // A parameter that is a *reference* is an address, and TIR spells
        // every address `ptr` — what the name `&P` is for is the
        // dereference, which is the only thing that needs to know what it
        // points at (Ch. 3 §2.1).
        if ty.same("?") {
            let held = subst_ty(&mut e, &tyvars, &key, &written_param);
            let by_ref = ref_name(&held);
            if by_ref.len() > 0 {
                header.push_str("%");
                header.push_str(&name);
                header.push_str(": ptr");
                let slot = slot_for(&mut e, &name, &by_ref);
                let mut store: String = Vec::new();
                store.push_str("    store ptr %");
                store.push_str(&name);
                store.push_str(", ");
                store.push_str(&slot);
                e.insts.push(store);
                i += 1;
                continue;
            }
        }
        if ty.same("?") {
            // An aggregate arrives as a pointer and is copied into storage
            // of its own on entry, field by field: what a function is given
            // is the caller's and what it holds is its own (Ch. 3 §1.1).
            let written = subst_ty(&mut e, &tyvars, &key, &written_param);
            let owner = nominal(&mut e, &written);
            let at = def_at(&e.defs, &owner);
            if at < 0 {
                return false;
            }
            header.push_str("%");
            header.push_str(&name);
            header.push_str(": ptr");
            let copied = copy_in(&mut e, &name, at);
            if !copied {
                return false;
            }
            i += 1;
            continue;
        }
        header.push_str("%");
        header.push_str(&name);
        header.push_str(": ");
        let shown = tir_of(&ty);
        header.push_str(&shown);
        let slot = slot_for(&mut e, &name, &ty);
        let mut store: String = Vec::new();
        store.push_str("    store ");
        let shown = tir_of(&ty);
        store.push_str(&shown);
        store.push_str(" %");
        store.push_str(&name);
        store.push_str(", ");
        store.push_str(&slot);
        e.insts.push(store);
        i += 1;
    }
    header.push_str(")");
    let ret = tir_ty_at(&tyvars, &key, &f.ret);
    let unit = match &f.ret {
        ast::Ty::Unit => true,
        _ => sret,
    };
    if !unit {
        if ret.same("?") {
            return false;
        }
        header.push_str(" -> ");
        let shown_ret = tir_of(&ret);
        header.push_str(&shown_ret);
    }
    header.push_str(" {");

    let body = match &f.body {
        Option::Some(b) => b,
        Option::None => return false,
    };
    if sret {
        aggregate_body(&mut e, body, &answer);
    } else {
        block(&mut e, body, &ret, unit);
    }
    if e.stuck {
        return false;
    }

    // What this function asked for, handed back to the queue the caller
    // drains. Only from here: a function that was not emitted is not in the
    // program, and what it would have asked for is not either.
    let mut q = work.jobs.len();
    while q < e.jobs.len() {
        work.jobs.push(Job {
            name: e.jobs[q].name.to_string(),
            key: ast::copy_names(&e.jobs[q].key),
        });
        q += 1;
    }
    let mut c = work.closed.len();
    while c < e.closed.len() {
        work.closed.push(one_closed(&e.closed[c]));
        c += 1;
    }
    let mut t = work.strings.len();
    while t < e.strings.len() {
        work.strings.push(e.strings[t].to_string());
        t += 1;
    }

    start(&mut e, "^");
    out.push_str(&header);
    out.push_str("\n");
    let mut n: taddr = 0;
    while n < e.blocks.len() {
        out.push_str(&e.blocks[n].label);
        out.push_str("\n");
        // Every slot of the function belongs to its entry block: storage is
        // named where it is declared and used wherever it is (TIR §2).
        if n == 0 {
            let mut k: taddr = 0;
            while k < e.slots.len() {
                out.push_str(&e.slots[k]);
                out.push_str("\n");
                k += 1;
            }
        }
        let mut j: taddr = 0;
        while j < e.blocks[n].insts.len() {
            out.push_str(&e.blocks[n].insts[j]);
            out.push_str("\n");
            j += 1;
        }
        n += 1;
    }
    out.push_str("}\n");
    true
}

/// Which field of that definition is called this, or −1. A struct's fields
/// are in declaration order and its `counts` are empty, which is what tells
/// one from an enum here.
fn field_at(e: &Emit, which: taddr, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.defs[which].field_names.len() {
        if e.defs[which].field_names[i].same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Which definition is called this, or −1.
fn def_at(defs: &Vec<layout::Def>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < defs.len() {
        if defs[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The head of a written type, or nothing for one that has no name.
pub fn written_head(t: &ast::Ty) -> String {
    head_of(t)
}

fn head_of(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        ast::Ty::App(segments, args) => joined(segments),
        _ => "".to_string(),
    }
}

/// `%p.N = offset %base, const t27 <at>` — or the base itself at zero,
/// since an offset of nothing is the thing itself.
fn offset_of(e: &mut Emit, base: &str, at: taddr) -> String {
    if at == 0 {
        return base.to_string();
    }
    let name = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&name);
    line.push_str(" = offset ");
    line.push_str(base);
    line.push_str(", const t27 ");
    push_int(&mut line, at as t27);
    e.insts.push(line);
    name
}

/// Copy an aggregate parameter into storage of its own, field by field.
fn copy_in(e: &mut Emit, name: &str, at: taddr) -> bool {
    let self_ty = ast::Ty::Name(one_name(&e.defs[at].name));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    let mut slot: String = Vec::new();
    slot.push_str("%");
    slot.push_str(name);
    slot.push_str(".slot.");
    push_int(&mut slot, e.next);
    e.next = e.next + 1;
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    // Storage is never nothing: a type with no fields still has an address
    // (Ch. 2 §1), and a closure that captures nothing is exactly that.
    let wide = if l.size < 1 {
        1
    } else {
        l.size as t27
    };
    push_int(&mut line, wide);
    line.push_str("]");
    e.slots.push(line);
    e.locals.push(Slot {
        name: name.to_string(),
        slot: slot.to_string(),
        ty: e.defs[at].name.to_string(),
    });

    let mut from: String = Vec::new();
    from.push_str("%");
    from.push_str(name);
    let owner = e.defs[at].name.to_string();
    copy_fields(e, &from, &slot, &owner)
}

/// Which global holds these characters, adding one where none does.
///
/// Numbered by when the literal was first *seen*, which is the order the
/// functions are emitted in — so two implementations that agree about that
/// order agree about the names, and equality is on the text.
fn interned(e: &mut Emit, text: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.strings.len() {
        if e.strings[i].same(text) {
            return i;
        }
        i += 1;
    }
    let n = e.strings.len() as taddr;
    e.strings.push(text.to_string());
    n
}

/// A string literal: the two words a `&str` is, in a temporary of its own.
///
/// The characters go in a global and what is built here is the reference to
/// it — the address, and the count. Which is `coerce`'s shape with a number
/// where the table would be, because a fat reference is a fat reference.
fn text_value(e: &mut Emit, text: &str) -> Value {
    let named = str_name();
    let self_ty = ast::Ty::Name(one_name(&named));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let which = interned(e, text);
    let held = fresh(e, "tmp.slot");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&held);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    let mut global: String = Vec::new();
    global.push_str("@");
    let symbol = string_symbol(which);
    global.push_str(&symbol);
    store_into(e, "ptr", &global, &held);
    let where_ = offset_of(e, &held, l.offsets[1]);
    let mut count: String = Vec::new();
    count.push_str("const t27 ");
    push_int(&mut count, text.len() as t27);
    store_into(e, "t27", &count, &where_);
    Value { text: held, ty: named }
}

/// `s.len()`, which is not a call: how many characters there are is the
/// second word of the reference itself, so this is where that word is and a
/// load from there. Every *other* method of `str` is an ordinary function
/// written on `impl str`.
fn str_len(e: &mut Emit, slot: &str) -> Value {
    let named = str_name();
    let self_ty = ast::Ty::Name(one_name(&named));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let src = offset_of(e, slot, l.offsets[1]);
    let v = fresh(e, "v");
    let mut load: String = Vec::new();
    load.push_str("    ");
    load.push_str(&v);
    load.push_str(" = load t27 ");
    load.push_str(&src);
    e.insts.push(load);
    Value { text: v, ty: "taddr".to_string() }
}

/// `s[i]` where `s` is text: the first thing this language lowers that can
/// fail while it *runs* rather than be refused before it does.
///
/// The address and the length are read first and the index after them,
/// because that is the order the expression is written in. Then two tests,
/// each of them one `cmp` and all three of its answers at once: below zero
/// is a fault, and so is at the length or above it — a bound has two ends
/// and a three-way branch takes one of them per instruction (Ch. 3 §3.2).
/// Only then is the offset computed, one element being one word.
///
/// Nothing here folds a constant index. `s[0]` is checked exactly as `s[i]`
/// is, because what a lowering writes is what the program said and what is
/// provable about it is a later pass's business.
fn index_place(e: &mut Emit, base: &ast::Expr, at: &ast::Expr) -> Value {
    let held = place(e, base);
    if e.stuck {
        return unknown_value();
    }
    let named = str_name();
    let mut data: String = Vec::new();
    let mut count: String = Vec::new();
    let mut elem: String = Vec::new();
    if held.ty.same(&named) {
        // Text. Where the characters are and how many there are are the
        // two words of the reference, so both are read out of it — and
        // before the index is, because that is the order it is written in.
        let self_ty = ast::Ty::Name(one_name(&named));
        let l = match layout::of(&e.defs, &self_ty, 0) {
            Result::Ok(x) => x,
            Result::Err(why) => {
                e.stuck = true;
                return unknown_value();
            }
        };
        data = fresh(e, "p");
        let mut line: String = Vec::new();
        line.push_str("    ");
        line.push_str(&data);
        line.push_str(" = load ptr ");
        line.push_str(&held.text);
        e.insts.push(line);
        let ending = offset_of(e, &held.text, l.offsets[1]);
        count = fresh(e, "v");
        let mut line: String = Vec::new();
        line.push_str("    ");
        line.push_str(&count);
        line.push_str(" = load t27 ");
        line.push_str(&ending);
        e.insts.push(line);
        elem = "char".to_string();
    } else {
        // An array. Both answers are in the *type* — how many elements
        // there are is what the definition has fields, and the storage is
        // the array itself and not something it points at — so nothing is
        // read before the index at all.
        let which = def_at(&e.defs, &held.ty);
        if which < 0 || !is_array(&held.ty) {
            e.stuck = true;
            return unknown_value();
        }
        data = held.text.to_string();
        let mut written: String = Vec::new();
        written.push_str("const t27 ");
        push_int(&mut written, e.defs[which].fields.len() as t27);
        count = written;
        elem = name_head(&e.defs[which].fields[0]);
        if elem.len() == 0 {
            e.stuck = true;
            return unknown_value();
        }
    }
    let wide = tir_of(&elem);
    let step = sized(e, &wide);
    let idx = value(e, at, "taddr");
    if e.stuck {
        return unknown_value();
    }
    let low = fresh(e, "c");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&low);
    line.push_str(" = cmp t27 ");
    line.push_str(&idx.text);
    line.push_str(", const t27 0");
    e.insts.push(line);
    let lo = label(e, "idx.lo");
    let bad = label(e, "idx.fault");
    let mut line: String = Vec::new();
    line.push_str("    br3 ");
    line.push_str(&low);
    line.push_str(", ");
    line.push_str(&bad);
    line.push_str(", ");
    line.push_str(&lo);
    line.push_str(", ");
    line.push_str(&lo);
    e.insts.push(line);
    start(e, &bad);
    e.insts.push("    trap F_TRAP".to_string());
    start(e, &lo);
    let high = fresh(e, "c");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&high);
    line.push_str(" = cmp t27 ");
    line.push_str(&idx.text);
    line.push_str(", ");
    line.push_str(&count);
    e.insts.push(line);
    let ok = label(e, "idx.ok");
    let mut line: String = Vec::new();
    line.push_str("    br3 ");
    line.push_str(&high);
    line.push_str(", ");
    line.push_str(&ok);
    line.push_str(", ");
    line.push_str(&bad);
    line.push_str(", ");
    line.push_str(&bad);
    e.insts.push(line);
    start(e, &ok);
    let scaled = fresh(e, "a");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&scaled);
    line.push_str(" = mul.trap t27 ");
    line.push_str(&idx.text);
    line.push_str(", const t27 ");
    push_int(&mut line, step);
    e.insts.push(line);
    let there = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&there);
    line.push_str(" = offset ");
    line.push_str(&data);
    line.push_str(", ");
    line.push_str(&scaled);
    e.insts.push(line);
    Value { text: there, ty: elem }
}

/// `s[i]` as a **value**: where it is, and then what is there.
fn index_value(e: &mut Emit, base: &ast::Expr, at: &ast::Expr) -> Value {
    let held = index_place(e, base, at);
    if e.stuck {
        return unknown_value();
    }
    // An element that is itself an aggregate has no value to load: it
    // **is** the storage at that offset (TIR §3).
    if def_at(&e.defs, &held.ty) >= 0 {
        return held;
    }
    let v = fresh(e, "v");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&v);
    line.push_str(" = load ");
    let wide = tir_of(&held.ty);
    line.push_str(&wide);
    line.push_str(" ");
    line.push_str(&held.text);
    e.insts.push(line);
    Value { text: v, ty: held.ty }
}

/// `(a, b)` — the elements, and then storage holding them (Ch. 2 §2).
///
/// Every element is lowered before the storage is made, as an array's are
/// and for the same reason: a tuple is written as a run of values, and each
/// one is a value before any of them is anywhere. What differs is where they
/// go — the fields are permuted by alignment, so element 0 is not always at
/// offset 0, and the *stores* are still in written order.
fn tuple_value(e: &mut Emit, items: &Vec<ast::Expr>, want: &str) -> Value {
    if items.len() == 0 {
        e.stuck = true;
        return unknown_value();
    }
    // What the written type says each element is, where it says anything.
    // Copied out first: lowering an element may make a definition of its
    // own, and an index into `defs` does not survive that.
    let mut written: Vec<String> = Vec::new();
    let at = def_at(&e.defs, want);
    if at >= 0 && is_tuple(want) && e.defs[at].fields.len() == items.len() {
        let mut k: taddr = 0;
        while k < items.len() {
            written.push(name_head(&e.defs[at].fields[k]));
            k += 1;
        }
    }
    let mut elems: Vec<String> = Vec::new();
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        let mut hint: String = Vec::new();
        if written.len() > i {
            hint = written[i].to_string();
        }
        let v = value(e, &items[i], &hint);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        let mine = if hint.len() > 0 {
            hint
        } else {
            v.ty.to_string()
        };
        elems.push(mine);
        i += 1;
    }
    let named = tuple_def(e, &elems);
    if named.len() == 0 {
        e.stuck = true;
        return unknown_value();
    }
    let self_ty = ast::Ty::Name(one_name(&named));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let held = fresh(e, "tmp.slot");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&held);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    let mut i: taddr = 0;
    while i < items.len() {
        let there = offset_of(e, &held, l.offsets[i]);
        if def_at(&e.defs, &elems[i]) >= 0 {
            copy_between(e, &texts[i], &there, &elems[i]);
        } else {
            store_into(e, &elems[i], &texts[i], &there);
        }
        if e.stuck {
            return unknown_value();
        }
        i += 1;
    }
    Value { text: held, ty: named }
}

/// `[a, b, c]` — a run of values, and then storage holding them (Ch. 2 §3).
///
/// Every element is lowered *before* the storage is made, which is what
/// decides the numbers and is what an array literal says: it is a run of
/// values, and each one is a value before any of them is anywhere. A struct
/// literal is the other way round, field by field, and the two orders are
/// both visible in the text.
fn array_value(e: &mut Emit, items: &Vec<ast::Expr>, want: &str) -> Value {
    let mut elem = array_element(e, want, items.len());
    if elem.len() == 0 {
        // Nothing said, so the first element does. An empty run with no
        // written type says nothing at all and is refused (Ch. 4 §2.3).
        if items.len() == 0 {
            e.stuck = true;
            return unknown_value();
        }
        elem = guess_ty(e, &items[0]);
    }
    if elem.len() == 0 {
        e.stuck = true;
        return unknown_value();
    }
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        let v = value(e, &items[i], &elem);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        i += 1;
    }
    array_storage(e, &elem, items.len(), &texts)
}

/// `[v; n]` — the same value in every element, and evaluated **once**
/// (Ch. 2 §3).
fn repeat_value(e: &mut Emit, v: &ast::Expr, count: &ast::Expr, want: &str) -> Value {
    let n = match count {
        ast::Expr::Int(k) => k as taddr,
        _ => {
            e.stuck = true;
            return unknown_value();
        }
    };
    if n < 1 {
        e.stuck = true;
        return unknown_value();
    }
    let mut elem = array_element(e, want, n);
    if elem.len() == 0 {
        elem = guess_ty(e, v);
    }
    if elem.len() == 0 {
        e.stuck = true;
        return unknown_value();
    }
    let held = value(e, v, &elem);
    if e.stuck {
        return unknown_value();
    }
    let mut texts: Vec<String> = Vec::new();
    texts.push(held.text);
    array_storage(e, &elem, n, &texts)
}

/// What the elements of an array written here are, where the type says so.
///
/// A written type is the only thing that can say when the run is empty, and
/// it is what `let d: [t9; 4] = [0; 4]` is told by — without it the first
/// element decides, which is what `let a = [1, 2, 3]` has to be read from.
fn array_element(e: &mut Emit, want: &str, n: taddr) -> String {
    let at = def_at(&e.defs, want);
    if at >= 0 && is_array(want) {
        if e.defs[at].fields.len() != n {
            return "".to_string();
        }
        return name_head(&e.defs[at].fields[0]);
    }
    "".to_string()
}

/// Storage for a run of values already lowered, and each of them put in it.
///
/// One text per element, or **one** text for all of them, which is what
/// `[v; n]` is: the value is evaluated once and stored n times.
fn array_storage(e: &mut Emit, elem: &str, n: taddr, texts: &Vec<String>) -> Value {
    let named = array_def(e, elem, n);
    if named.len() == 0 {
        e.stuck = true;
        return unknown_value();
    }
    let self_ty = ast::Ty::Name(one_name(&named));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let held = fresh(e, "tmp.slot");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&held);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    let aggregate = def_at(&e.defs, elem) >= 0;
    let mut i: taddr = 0;
    while i < n {
        let there = offset_of(e, &held, l.offsets[i]);
        let one: taddr = 0;
        let which = if texts.len() == 1 {
            one
        } else {
            i
        };
        if aggregate {
            copy_between(e, &texts[which], &there, elem);
        } else {
            store_into(e, elem, &texts[which], &there);
        }
        if e.stuck {
            return unknown_value();
        }
        i += 1;
    }
    Value { text: held, ty: named }
}

/// The global one string literal is written as: one word per character,
/// which is three trytes each and the reason `len` counts characters.
fn one_string(text: &str, n: taddr) -> String {
    let mut out: String = Vec::new();
    out.push_str("global @");
    let symbol = string_symbol(n);
    out.push_str(&symbol);
    out.push_str(" : tryte[");
    push_int(&mut out, 3 * (text.len() as t27));
    out.push_str("] = [");
    let mut i: taddr = 0;
    while i < text.len() {
        if i > 0 {
            out.push_str(", ");
        }
        push_int(&mut out, text[i] as t27);
        out.push_str(", 0, 0");
        i += 1;
    }
    out.push_str("]\n");
    out
}

fn one_name(name: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    out.push(name.to_string());
    out
}

/// A body whose answer is an aggregate: it is written into the storage the
/// caller gave, and the function answers nothing.
fn aggregate_body(e: &mut Emit, b: &ast::Block, owner: &str) {
    aggregate_block(e, b, "%sret", owner);
    if e.stuck {
        return;
    }
    e.insts.push("    ret".to_string());
}



/// `match e { … }` (§5.4): the discriminant once, a three-way test per arm,
/// and a slot the arms agree to leave the answer in.
///
/// With a destination there is no such slot: an aggregate has no value, it
/// **is** its storage (TIR §3), so each arm writes the storage it was given
/// and the join has nothing to load. One lowering either way.
fn match_expr(
    e: &mut Emit,
    scrutinee: &ast::Expr,
    arms: &Vec<ast::Arm>,
    want: &str,
    dest: &str,
    answer: &str,
) -> Value {
            let base = match scrutinee {
                ast::Expr::Name(n) => {
                    let at = local_at(e, n);
                    if at < 0 {
                        e.stuck = true;
                        return unknown_value();
                    }
                    e.locals[at].slot.to_string()
                }
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let owner = match scrutinee {
                ast::Expr::Name(n) => {
                    let at = local_at(e, n);
                    e.locals[at].ty.to_string()
                }
                _ => "".to_string(),
            };
            let which = def_at(&e.defs, &owner);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(&owner));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let tag = match &l.tag {
                layout::Tag::Direct(width, at) => {
                    if width == 1 {
                        "t9".to_string()
                    } else {
                        "t27".to_string()
                    }
                }
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let d = fresh(e, "d");
            let mut read: String = Vec::new();
            read.push_str("    ");
            read.push_str(&d);
            read.push_str(" = load ");
            read.push_str(&tag);
            read.push_str(" ");
            read.push_str(&base);
            e.insts.push(read);
            let join = label(e, "match.join");

            let mut held: String = Vec::new();
            let mut ty: String = Vec::new();
            let mut a: taddr = 0;
            while a < arms.len() {
                let arm_at = label(e, "arm");
                let next_at = label(e, "arm.next");
                let index = arm_variant(e, which, &arms[a]);
                if index < 0 {
                    e.stuck = true;
                    return unknown_value();
                }
                let c = fresh(e, "c");
                let mut test: String = Vec::new();
                test.push_str("    ");
                test.push_str(&c);
                test.push_str(" = cmp ");
                test.push_str(&tag);
                test.push_str(" ");
                test.push_str(&d);
                test.push_str(", const ");
                test.push_str(&tag);
                test.push_str(" ");
                push_int(&mut test, l.discriminants[index]);
                e.insts.push(test);
                let mut br: String = Vec::new();
                br.push_str("    br3 ");
                br.push_str(&c);
                br.push_str(", ");
                br.push_str(&next_at);
                br.push_str(", ");
                br.push_str(&arm_at);
                br.push_str(", ");
                br.push_str(&next_at);
                e.insts.push(br);

                start(e, &arm_at);
                let mark = e.locals.len();
                bind_payload(e, which, index, &base, &l, &arms[a]);
                if e.stuck {
                    return unknown_value();
                }
                if dest.len() > 0 {
                    aggregate_tail(e, &arms[a].body, dest, answer);
                } else {
                    let v = value(e, &arms[a].body, want);
                    if e.stuck {
                        return unknown_value();
                    }
                    if held.len() == 0 {
                        ty = v.ty.to_string();
                        held = slot_for(e, "tmp", &ty);
                    }
                    store_into(e, &ty, &v.text, &held);
                }
                if e.stuck {
                    return unknown_value();
                }
                jump(e, &join);
                forget(e, mark);
                start(e, &next_at);
                a += 1;
            }
            // Exhaustiveness was checked, so control cannot arrive here in a
            // well-typed program — but TIR wants a terminator.
            e.insts.push("    trap F_TRAP".to_string());
            e.done = true;

            start(e, &join);
            if dest.len() > 0 {
                return Value { text: dest.to_string(), ty: answer.to_string() };
            }
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&held);
            e.insts.push(line);
            Value { text: name, ty: ty }
}

/// `if c { … } else { … }` as a value (§5.3).
///
/// With a destination it is not a value at all: an aggregate has none, it
/// **is** its storage (TIR §3), so where it is going is handed to each arm
/// and there is nothing to join. One lowering either way, because two would
/// be two things to keep in step.
fn if_expr(
    e: &mut Emit,
    c: &ast::Expr,
    t: &ast::Block,
    o: &Option<Box<ast::Expr>>,
    want: &str,
    dest: &str,
    owner: &str,
) -> Value {
            let cond = value(e, c, "t1");
            if e.stuck {
                return unknown_value();
            }
            let then_at = label(e, "then");
            let else_at = label(e, "else");
            let join_at = label(e, "join");
            let mut br: String = Vec::new();
            br.push_str("    br2 ");
            br.push_str(&cond.text);
            br.push_str(", ");
            br.push_str(&then_at);
            br.push_str(", ");
            br.push_str(&else_at);
            e.insts.push(br);

            start(e, &then_at);
            if dest.len() > 0 {
                aggregate_block(e, t, dest, owner);
                if e.stuck {
                    return unknown_value();
                }
                jump(e, &join_at);
                start(e, &else_at);
                match o {
                    Option::Some(x) => {
                        aggregate_tail(e, x, dest, owner);
                        if e.stuck {
                            return unknown_value();
                        }
                    }
                    // An `if` with no `else` has no value, and an aggregate
                    // is a value (§5.3).
                    Option::None => {
                        e.stuck = true;
                        return unknown_value();
                    }
                }
                jump(e, &join_at);
                start(e, &join_at);
                return Value { text: dest.to_string(), ty: owner.to_string() };
            }
            let a = branch_block(e, t, want);
            if e.stuck {
                return unknown_value();
            }
            let ty = a.ty.to_string();
            // The slot is made where the first arm has its answer ready,
            // which is what decides the number it gets.
            let held = slot_for(e, "tmp", &ty);
            store_into(e, &ty, &a.text, &held);
            jump(e, &join_at);

            start(e, &else_at);
            match o {
                Option::Some(x) => {
                    let b = value(e, x, &ty);
                    if e.stuck {
                        return unknown_value();
                    }
                    store_into(e, &ty, &b.text, &held);
                }
                Option::None => {}
            }
            jump(e, &join_at);

            start(e, &join_at);
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&held);
            e.insts.push(line);
            Value { text: name, ty: ty }
}

/// A block whose value is an aggregate: its statements, then its tail
/// written where the value is going.
fn aggregate_block(e: &mut Emit, b: &ast::Block, dest: &str, owner: &str) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], "");
        if e.stuck {
            return;
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => aggregate_tail(e, x, dest, owner),
        Option::None => e.stuck = true,
    }
}

/// An expression whose value is an aggregate, written into the storage it
/// is going into rather than into a temporary that is then copied.
///
/// An aggregate has no value in TIR — it **is** its storage (TIR §3) — so
/// where it is going has to be known before it is computed. An `if` does
/// not join two aggregates, because there is nothing to join: it hands the
/// destination to each of its arms, and both write the same storage.
fn aggregate_tail(e: &mut Emit, x: &ast::Expr, dest: &str, owner: &str) {
    match x {
        // Built where it is wanted, rather than built and copied.
        ast::Expr::Aggregate(path, fields) => {
            let made = aggregate_type(e, path, owner, fields);
            if made.len() == 0 {
                e.stuck = true;
                return;
            }
            let variant = variant_of(path);
            fill(e, dest, &made, &variant, fields);
        }
        ast::Expr::Nested(held) => aggregate_block(e, &*held, dest, owner),
        ast::Expr::If(c, t, o) => {
            if_expr(e, c, t, o, "", dest, owner);
        }
        ast::Expr::Match(scrutinee, arms) => {
            match_expr(e, scrutinee, arms, "", dest, owner);
        }
        // A call answers into storage the caller provides (TIR §3), and in
        // tail position that storage is `%sret` itself: what the callee
        // wrote is already where this function's answer goes, so there is
        // nothing to copy.
        ast::Expr::Call(callee, args) => {
            let held = local_at(e, callee);
            let fam = family_at(e, callee);
            let big = returned_aggregate(e, callee);
            // A closure, a family, and anything answering with something
            // other than what this function does are all other questions,
            // and are refused rather than copied through a temporary that
            // the other implementation does not make.
            if held >= 0 || fam >= 0 || !big.same(owner) {
                e.stuck = true;
                return;
            }
            let v = aggregate_call(e, callee, &big, dest, "", args);
            let _ = v;
        }
        // A *method* in tail position is the same fact and is refused: the
        // receiver is worked out inside `value`, which has no destination
        // to be told about, and copying through a temporary would be text
        // the other implementation does not write.
        ast::Expr::Method(recv, name, args) => {
            e.stuck = true;
        }
        _ => {
            let v = value(e, x, owner);
            if e.stuck {
                return;
            }
            copy_between(e, &v.text, dest, owner);
        }
    }
}

/// Write an aggregate's fields into storage that is already there.
fn fill(
    e: &mut Emit,
    dest: &str,
    path: &str,
    variant: &str,
    fields: &Vec<ast::Field>,
) {
    let which = def_at(&e.defs, path);
    if which < 0 {
        e.stuck = true;
        return;
    }
    if variant.len() > 0 {
        fill_variant(e, dest, which, variant, fields);
        return;
    }
    let self_ty = ast::Ty::Name(one_name(path));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return;
        }
    };
    let mut i: taddr = 0;
    while i < fields.len() {
        let index = field_at(e, which, &fields[i].name);
        if index < 0 {
            e.stuck = true;
            return;
        }
        // A field that is itself an aggregate has no value to store: it
        // is built where it can be and copied into place field by field.
        let held = name_head(&e.defs[which].fields[index]);
        if def_at(&e.defs, &held) >= 0 {
            let v = value(e, &fields[i].value, &held);
            if e.stuck {
                return;
            }
            let at = offset_of(e, dest, l.offsets[index]);
            if !copy_fields(e, &v.text, &at, &held) {
                e.stuck = true;
                return;
            }
            i += 1;
            continue;
        }
        let ty = field_tir(&e.defs[which].fields[index]);
        // A type TIR has no spelling for is not one this writes down: a
        // reference to something unsized is two words and not one, and
        // `store ?` is not TIR (TIR §1).
        if ty.same("?") {
            e.stuck = true;
            return;
        }
        // The value first, then where it goes: that order is what decides
        // the numbers, and the numbers are what the comparison is on.
        let v = value(e, &fields[i].value, &ty);
        if e.stuck {
            return;
        }
        let at = offset_of(e, dest, l.offsets[index]);
        store_into(e, &ty, &v.text, &at);
        i += 1;
    }
}

/// One variant of an enum, written into storage that is already there
/// (§3.3): its payload where the layout puts *that variant's* fields, and
/// then the tag that says which variant it is.
///
/// The payload first and the tag after it, which is what decides the
/// numbers — and nothing else is written, because the trytes a variant
/// does not use are trytes nothing reads.
fn fill_variant(
    e: &mut Emit,
    dest: &str,
    which: taddr,
    variant: &str,
    fields: &Vec<ast::Field>,
) {
    let owner = e.defs[which].name.to_string();
    let self_ty = ast::Ty::Name(one_name(&owner));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return;
        }
    };
    let index = named_variant(&e.defs[which], variant);
    if index < 0 || fields.len() != e.defs[which].counts[index] {
        e.stuck = true;
        return;
    }
    let start = variant_start(&e.defs[which], index);
    let mut i: taddr = 0;
    while i < fields.len() {
        let held = name_head(&e.defs[which].fields[start + i]);
        let inner = def_at(&e.defs, &held);
        if inner >= 0 {
            let v = value(e, &fields[i].value, &held);
            if e.stuck {
                return;
            }
            let at = offset_of(e, dest, l.variant_offsets[index][i]);
            if !copy_fields(e, &v.text, &at, &held) {
                e.stuck = true;
                return;
            }
            i += 1;
            continue;
        }
        let ty = field_tir(&e.defs[which].fields[start + i]);
        if ty.same("?") {
            e.stuck = true;
            return;
        }
        let v = value(e, &fields[i].value, &ty);
        if e.stuck {
            return;
        }
        let at = offset_of(e, dest, l.variant_offsets[index][i]);
        store_into(e, &ty, &v.text, &at);
        i += 1;
    }
    // Which variant it is. A niche-encoded enum says so by writing a value
    // the payload could not have had (§6), and working out which value that
    // is is not something this does yet — so it is refused, on the side
    // that builds one as it already is on the side that reads one.
    match &l.tag {
        layout::Tag::Direct(width, at) => {
            let ty = if width == 1 {
                "t9".to_string()
            } else {
                "t27".to_string()
            };
            let spot = offset_of(e, dest, at);
            let mut held: String = Vec::new();
            held.push_str("const ");
            held.push_str(&ty);
            held.push_str(" ");
            push_int(&mut held, l.discriminants[index]);
            store_into(e, &ty, &held, &spot);
        }
        layout::Tag::TritShaped => {
            let mut held: String = Vec::new();
            held.push_str("const t1 ");
            push_int(&mut held, l.discriminants[index]);
            store_into(e, "t1", &held, dest);
        }
        _ => {
            e.stuck = true;
        }
    }
}

/// Copy one aggregate into another, field by field.
fn copy_between(e: &mut Emit, from: &str, to: &str, owner: &str) {
    if !copy_fields(e, from, to, owner) {
        e.stuck = true;
    }
}

/// One aggregate copied into another, field by field — and a field that is
/// itself an aggregate by *its* fields, which is the whole of what makes a
/// nested one work.
///
/// The offsets are taken from the pointer to the field and not recomputed
/// from the base, so `w.p.b` is `offset (offset %w, 3), 3`. That is one
/// instruction more than it needs to be and it is what the other
/// implementation emits, and equality is on the text.
fn copy_fields(e: &mut Emit, from: &str, to: &str, owner: &str) -> bool {
    let which = def_at(&e.defs, owner);
    if which < 0 {
        return false;
    }
    let self_ty = ast::Ty::Name(one_name(owner));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    if e.defs[which].is_enum {
        // An enum has no one set of fields — which set it has depends on
        // which variant it holds — so what is copied is its *storage*: a
        // word at a time, and a tryte for what is left. An enum has no
        // `offsets` at all, so a copy that read them would copy nothing and
        // say it had.
        let mut at_off: taddr = 0;
        while at_off < l.size {
            let ty = if l.size - at_off >= 3 {
                "t27".to_string()
            } else {
                "t9".to_string()
            };
            // Read before the destination is named: an enum is copied as
            // storage and a struct field by field, and the two orders are
            // what they are.
            let src = offset_of(e, from, at_off);
            let v = fresh(e, "v");
            let mut load: String = Vec::new();
            load.push_str("    ");
            load.push_str(&v);
            load.push_str(" = load ");
            let shown = tir_of(&ty);
            load.push_str(&shown);
            load.push_str(" ");
            load.push_str(&src);
            e.insts.push(load);
            let dst = offset_of(e, to, at_off);
            store_into(e, &ty, &v, &dst);
            let wide = tir_of(&ty);
            at_off = at_off + (trytes(&wide) as taddr);
        }
        return true;
    }
    let mut i: taddr = 0;
    while i < l.offsets.len() {
        let held = name_head(&e.defs[which].fields[i]);
        let inner = def_at(&e.defs, &held);
        let src = offset_of(e, from, l.offsets[i]);
        let dst = offset_of(e, to, l.offsets[i]);
        if inner >= 0 {
            if !copy_fields(e, &src, &dst, &held) {
                return false;
            }
            i += 1;
            continue;
        }
        let ty = field_tir(&e.defs[which].fields[i]);
        if ty.same("?") {
            return false;
        }
        // A loaded address is named as one: `%p`, not `%v`. The prefix is
        // in the text and the text is what agrees.
        let prefix = if ty.same("ptr") {
            "p".to_string()
        } else {
            "v".to_string()
        };
        let v = fresh(e, &prefix);
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&v);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        store_into(e, &ty, &v, &dst);
        i += 1;
    }
    true
}

/// A block written as a branch's arm: its statements, then its value.
fn branch_block(e: &mut Emit, b: &ast::Block, want: &str) -> Value {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], want);
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => value(e, x, want),
        Option::None => {
            e.stuck = true;
            unknown_value()
        }
    }
}

/// `if c { … } else { … }` where nothing wants its value (§5.3).
///
/// The blocks are the same three, in the same order, and what is missing is
/// the slot: there is nothing to store and nothing to load back. An arm
/// that has already left does not jump to the join as well, which is the
/// whole of the difference a `return` inside one makes.
fn if_statement(
    e: &mut Emit,
    c: &ast::Expr,
    t: &ast::Block,
    o: &Option<Box<ast::Expr>>,
    ret: &str,
) {
    let cond = value(e, c, "t1");
    if e.stuck {
        return;
    }
    let then_at = label(e, "then");
    let else_at = label(e, "else");
    let join_at = label(e, "join");
    let mut br: String = Vec::new();
    br.push_str("    br2 ");
    br.push_str(&cond.text);
    br.push_str(", ");
    br.push_str(&then_at);
    br.push_str(", ");
    br.push_str(&else_at);
    e.insts.push(br);

    start(e, &then_at);
    statements(e, t, ret);
    if e.stuck {
        return;
    }
    if !e.done {
        jump(e, &join_at);
    }

    start(e, &else_at);
    match o {
        Option::Some(x) => {
            match x {
                ast::Expr::Nested(b) => statements(e, &*b, ret),
                // `else if` is a statement of the same shape one deeper.
                ast::Expr::If(c2, t2, o2) => if_statement(e, c2, t2, o2, ret),
                _ => {
                    e.stuck = true;
                }
            }
            if e.stuck {
                return;
            }
        }
        Option::None => {}
    }
    if !e.done {
        jump(e, &join_at);
    }

    start(e, &join_at);
}

/// The statements of a block and nothing else.
///
/// What an `if` in statement position has in its arms, where `branch_block`
/// wants a value. A tail here has no value either — the arm is a statement
/// and so is everything in it — so it is lowered as one.
fn statements(e: &mut Emit, b: &ast::Block, ret: &str) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], ret);
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => {
            // An arm of a statement `if` has no value either, so its last
            // expression is a statement as well — a `while`, or a call
            // that answers with nothing (§5.1).
            let held = ast::Stmt::Do(ast::copy_expr(x));
            stmt(e, &held, ret);
        }
        Option::None => {}
    }
}

/// The operation `x op= e` performs, or nothing for an operator that is not
/// one of them.
///
/// Everything but the trailing `=`, and then only where that names one of
/// Ch. 1's operations: `==` and `!=` are spelled the same way from here and
/// are not assignments at all.
fn compound(op: &str) -> String {
    if op.len() < 2 || op[op.len() - 1] != '=' {
        return "".to_string();
    }
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < op.len() - 1 {
        out.push(op[i]);
        i += 1;
    }
    let held = arith(&out);
    if held.same("?") {
        return "".to_string();
    }
    out
}

/// Which variant an arm names, or −1.
fn arm_variant(e: &Emit, which: taddr, arm: &ast::Arm) -> taddr {
    if arm.patterns.len() != 1 {
        return 0 - 1;
    }
    let name = match &arm.patterns[0] {
        ast::Pattern::Aggregate(path, fields) => last_segment(path),
        _ => return 0 - 1,
    };
    let mut i: taddr = 0;
    while i < e.defs[which].field_names.len() {
        if e.defs[which].field_names[i].same(&name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The last segment of a written path: `K::A` names `A`.
fn last_segment(path: &str) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < path.len() {
        if path[i] == ':' && i + 1 < path.len() && path[i + 1] == ':' {
            out = Vec::new();
            i += 2;
        } else {
            out.push(path[i]);
            i += 1;
        }
    }
    out
}

/// What an arm's pattern binds: a copy of each payload field, in storage of
/// its own, which is what an arm's binding is when the scrutinee is a place
/// it does not own (Ch. 3 §1.3).
fn bind_payload(
    e: &mut Emit,
    which: taddr,
    index: taddr,
    base: &str,
    l: &layout::Layout,
    arm: &ast::Arm,
) {
    let fields = match &arm.patterns[0] {
        ast::Pattern::Aggregate(path, fs) => fs,
        _ => return,
    };
    // Where this variant's payload begins, and which of the definition's
    // flat field list it is.
    let mut first: taddr = 0;
    let mut v: taddr = 0;
    while v < index {
        first = first + e.defs[which].counts[v];
        v += 1;
    }
    let mut i: taddr = 0;
    while i < fields.len() {
        let name = match &fields[i].pat {
            ast::Pattern::Bind(n) => n.to_string(),
            _ => {
                e.stuck = true;
                return;
            }
        };
        let ty = field_tir(&e.defs[which].fields[first + i]);
        if ty.same("?") {
            e.stuck = true;
            return;
        }
        let at = l.variant_offsets[index][i];
        let src = offset_of(e, base, at);
        let got = fresh(e, "v");
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&got);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        let slot = slot_for(e, &name, &ty);
        store_into(e, &ty, &got, &slot);
        i += 1;
    }
}

/// Forget the locals bound since a mark: an arm is a scope (Ch. 3 §1.4).
fn forget(e: &mut Emit, mark: taddr) {
    while e.locals.len() > mark {
        e.locals.pop();
    }
}

/// Call the destructor of everything this scope owns, innermost first.
fn drop_all(e: &mut Emit) {
    let mut i = e.owned.len();
    while i > 0 {
        i -= 1;
        let mut line: String = Vec::new();
        line.push_str("    call @drop.");
        line.push_str(&e.owned[i].ty);
        line.push_str("(");
        line.push_str(&e.owned[i].slot);
        line.push_str(")");
        e.insts.push(line);
    }
}

/// Whether a list holds this exact name.
fn holds_name(names: &Vec<String>, name: &str) -> bool {
    let mut i: taddr = 0;
    while i < names.len() {
        if names[i].same(name) {
            return true;
        }
        i += 1;
    }
    false
}

/// Whether a value's storage is a **temporary**: storage made for this value
/// and named by nothing else.
///
/// It is what tells a binding whether it may take that storage over. Every
/// aggregate this builds with nowhere to put it goes in a `%tmp.slot.N`, so
/// the name is the whole of the answer — and a local, a parameter, a field
/// or what a reference points at is not one.
fn is_temporary(text: &str) -> bool {
    let head = "%tmp.slot.";
    if text.len() <= head.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < head.len() {
        if text[i] != head[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// Give a name a different one, wherever it was written.
///
/// The only name a lowering ever changes its mind about: an aggregate is
/// built in a temporary and a binding adopts it, so what was `%agg.3`
/// becomes `%p.slot.8` in the slot that declares it and in every
/// instruction that touched it.
fn rename(e: &mut Emit, from: &str, to: &str) {
    let mut i: taddr = 0;
    while i < e.slots.len() {
        let fixed = replaced(&e.slots[i], from, to);
        e.slots[i] = fixed;
        i += 1;
    }
    let mut k: taddr = 0;
    while k < e.insts.len() {
        let fixed = replaced(&e.insts[k], from, to);
        e.insts[k] = fixed;
        k += 1;
    }
    let mut b: taddr = 0;
    while b < e.blocks.len() {
        let mut j: taddr = 0;
        while j < e.blocks[b].insts.len() {
            let fixed = replaced(&e.blocks[b].insts[j], from, to);
            e.blocks[b].insts[j] = fixed;
            j += 1;
        }
        b += 1;
    }
}

/// One string with every occurrence of another put differently.
fn replaced(line: &str, from: &str, to: &str) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < line.len() {
        if at_here(line, i, from) {
            out.push_str(to);
            i += from.len();
        } else {
            out.push(line[i]);
            i += 1;
        }
    }
    out
}

/// Whether `what` is written at this position.
fn at_here(line: &str, at: taddr, what: &str) -> bool {
    if at + what.len() > line.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < what.len() {
        if line[at + i] != what[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// `store TY value, slot`.
///
/// TIR stores a *value*, and an aggregate is not one — it **is** its
/// storage (TIR §3). So a store whose type is not one TIR spells is a store
/// this cannot write, and saying so here catches every place that would
/// otherwise write it down: the join of an `if` whose arms are aggregates,
/// a field whose type is a reference to something unsized, and whatever
/// else has not been reached yet.
fn store_into(e: &mut Emit, ty: &str, what: &str, where_: &str) {
    let shown = tir_of(ty);
    if !shown.same("t1") && !shown.same("t9") && !shown.same("t27")
        && !shown.same("ptr")
    {
        e.stuck = true;
        return;
    }
    let mut line: String = Vec::new();
    line.push_str("    store ");
    line.push_str(&shown);
    line.push_str(" ");
    line.push_str(what);
    line.push_str(", ");
    line.push_str(where_);
    e.insts.push(line);
}

/// `impl Drop for T` — the destructor, which is a function named after the
/// type it is written on (Ch. 3 §1.4).
///
/// Its `self` is owned, so it takes the flag an owned local takes, and it
/// takes it *before* the value arrives: what the flag says is whether the
/// fields are still there, and they are from the moment the function is
/// entered.
pub fn destructor(
    f: &ast::Fn,
    owner: &str,
    cx: Cx,
    work: &mut Work,
    out: &mut String,
) -> bool {
    let mut e = Emit {
        slots: Vec::new(),
        insts: Vec::new(),
        locals: Vec::new(),
        next: 1,
        stuck: false,
        sigs: cx.sigs,
        done: false,
        params: cx.params,
        label: "^entry:".to_string(),
        blocks: Vec::new(),
        defs: cx.defs,
        drops: cx.drops,
        owned: Vec::new(),
        self_ty: owner.to_string(),
        // A destructor is reached by dropping and not by calling, so no
        // instantiation can be asked for from here: a generic call inside
        // one is refused rather than emitted under a name nothing queued.
        families: Vec::new(),
        jobs: Vec::new(),
        tyvars: Vec::new(),
        key: Vec::new(),
        tyfams: cx.tyfams,
        rets: cx.rets,
        instances: Vec::new(),
        making: Vec::new(),
        closed: Vec::new(),
        closures_made: 0,
        owner_name: "".to_string(),
        strings: ast::copy_names(&work.strings),
    };
    settle(&mut e);
    let at = def_at(&e.defs, owner);
    if at < 0 {
        return false;
    }
    let self_ty = ast::Ty::Name(one_name(owner));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    let mut slot: String = Vec::new();
    slot.push_str("%self.slot.");
    push_int(&mut slot, e.next);
    e.next = e.next + 1;
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    let flag = fresh(&mut e, "self.owns");
    let mut held: String = Vec::new();
    held.push_str("    ");
    held.push_str(&flag);
    held.push_str(" = slot tryte[1]");
    e.slots.push(held);
    store_into(&mut e, "t1", "const t1 1", &flag);
    e.locals.push(Slot {
        name: "self".to_string(),
        slot: slot.to_string(),
        ty: owner.to_string(),
    });
    let mut i: taddr = 0;
    while i < l.offsets.len() {
        let ty = field_tir(&e.defs[at].fields[i]);
        if ty.same("?") {
            return false;
        }
        let src = offset_of(&mut e, "%self", l.offsets[i]);
        let dst = offset_of(&mut e, &slot, l.offsets[i]);
        let v = fresh(&mut e, "v");
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&v);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        store_into(&mut e, &ty, &v, &dst);
        i += 1;
    }

    let body = match &f.body {
        Option::Some(b) => b,
        Option::None => return false,
    };
    let mut k: taddr = 0;
    while k < body.stmts.len() {
        stmt(&mut e, &body.stmts[k], "");
        k += 1;
    }
    match &body.tail {
        Option::Some(x) => return false,
        Option::None => {}
    }
    e.insts.push("    ret".to_string());
    if e.stuck {
        return false;
    }
    // A string a destructor writes down is a string like any other. Being
    // reached by dropping rather than by calling is what stops it asking
    // for an *instantiation* above; a literal is not one, and a global it
    // named and nobody defined would be a module that is not a program.
    let mut t = work.strings.len();
    while t < e.strings.len() {
        work.strings.push(e.strings[t].to_string());
        t += 1;
    }

    start(&mut e, "^");
    out.push_str("fn @drop.");
    out.push_str(owner);
    out.push_str("(%self: ptr) {\n");
    let mut n: taddr = 0;
    while n < e.blocks.len() {
        out.push_str(&e.blocks[n].label);
        out.push_str("\n");
        if n == 0 {
            let mut j: taddr = 0;
            while j < e.slots.len() {
                out.push_str(&e.slots[j]);
                out.push_str("\n");
                j += 1;
            }
        }
        let mut m: taddr = 0;
        while m < e.blocks[n].insts.len() {
            out.push_str(&e.blocks[n].insts[m]);
            out.push_str("\n");
            m += 1;
        }
        n += 1;
    }
    out.push_str("}\n");
    true
}

/// A function's body: its statements, then what it answers with.
fn block(e: &mut Emit, b: &ast::Block, ret: &str, unit: bool) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], ret);
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => {
            // A function that answers with nothing has a tail that is a
            // **statement**: a `while`, or a call to something that answers
            // with nothing (§5.1). There is no value to read and none to
            // write after the `ret`, and the only thing that says so is the
            // answer this function was written with.
            if unit {
                let held = ast::Stmt::Do(ast::copy_expr(x));
                stmt(e, &held, ret);
                if e.stuck {
                    return;
                }
                if !e.done {
                    e.insts.push("    ret".to_string());
                }
                return;
            }
            let v = value(e, x, ret);
            if e.stuck {
                return;
            }
            // The value first and the drops after it: what is answered is
            // read while it is still there (Ch. 3 §1.4).
            drop_all(e);
            let mut line: String = Vec::new();
            line.push_str("    ret ");
            line.push_str(&v.text);
            e.insts.push(line);
        }
        Option::None => {
            // A block that already left does not leave twice.
            if !e.done {
                e.insts.push("    ret".to_string());
            }
        }
    }
}

fn stmt(e: &mut Emit, s: &ast::Stmt, ret: &str) {
    match s {
        ast::Stmt::Let(mutable, name, written, v) => {
            // What the binding was written as, which is what an aggregate
            // with nothing to infer from is told by (Ch. 4 §2.3).
            let hint = match written {
                Option::Some(t) => {
                    let tyvars = ast::copy_names(&e.tyvars);
                    let key = ast::copy_names(&e.key);
                    let held = subst_ty(e, &tyvars, &key, t);
                    let named = nominal(e, &held);
                    if def_at(&e.defs, &named) >= 0 {
                        named
                    } else {
                        tir_ty_at(&e.tyvars, &e.key, t)
                    }
                }
                Option::None => "".to_string(),
            };
            let val = value(e, v, &hint);
            if e.stuck {
                return;
            }
            // The slot is made *after* the value is ready, which is what
            // decides the number it gets.
            let ty = match written {
                Option::Some(t) => tir_ty_at(&e.tyvars, &e.key, t),
                Option::None => val.ty.to_string(),
            };
            // A written type that names an aggregate says which one, and a
            // value that turned out to be another is not this binding's:
            // `let a: Option<t9> = Option::Some(7)` is a t9 to Ch. 4 §2.3
            // and a t27 to a lowering that reads the literal alone, so it
            // is refused rather than bound at the wrong width.
            if def_at(&e.defs, &hint) >= 0 && !hint.same(&val.ty) {
                e.stuck = true;
                return;
            }
            let which = def_at(&e.defs, &val.ty);
            if which >= 0 {
                let owns = holds_name(&e.drops, &val.ty);
                // Somebody else's storage is **copied** out of: `let q = p`
                // leaves `p` naming what it named, so `q` is storage of its
                // own and the fields cross one at a time (Ch. 3 §1.1).
                // Renaming it would leave the older name pointing at a slot
                // that no longer exists.
                if !is_temporary(&val.text) {
                    // A move out of a *named* place has to record that the
                    // place no longer owns what it held, and nothing here
                    // can say so — so a type with a destructor is refused
                    // rather than dropped twice (Ch. 3 §1.4).
                    if owns {
                        e.stuck = true;
                        return;
                    }
                    let slot = slot_for(e, name, &val.ty);
                    copy_between(e, &val.text, &slot, &val.ty);
                    return;
                }
                // The temporary *is* the binding's storage: it was made for
                // this value and nothing else names it, so it is renamed
                // rather than copied out of.
                let mut prefix: String = Vec::new();
                prefix.push_str(name);
                prefix.push_str(".slot");
                let slot = fresh(e, &prefix);
                rename(e, &val.text, &slot);
                let kept = slot.to_string();
                e.locals.push(Slot {
                    name: name.to_string(),
                    slot: slot,
                    ty: val.ty.to_string(),
                });
                // A local whose type has a destructor is dropped when its
                // scope ends unless it was moved out of, and a flag is what
                // says which — a branch may decide (Ch. 3 §1.4).
                if owns {
                    let mut prefix: String = Vec::new();
                    prefix.push_str(name);
                    prefix.push_str(".owns");
                    let flag = fresh(e, &prefix);
                    let mut line: String = Vec::new();
                    line.push_str("    ");
                    line.push_str(&flag);
                    line.push_str(" = slot tryte[1]");
                    e.slots.push(line);
                    store_into(e, "t1", "const t1 1", &flag);
                    e.owned.push(Slot {
                        name: name.to_string(),
                        slot: kept,
                        ty: val.ty.to_string(),
                    });
                }
                return;
            }
            // A binding to nothing is not a binding: `let x = f();` where
            // `f` answers with the unit has no value to store (§5.1).
            if ty.same("?") || answers_nothing(&ty) {
                e.stuck = true;
                return;
            }
            let slot = slot_for(e, name, &ty);
            let mut line: String = Vec::new();
            line.push_str("    store ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&val.text);
            line.push_str(", ");
            line.push_str(&slot);
            e.insts.push(line);
        }
        // `let (a, b) = e;` is `let #patN = e;` and then one `let` per
        // element reading a field of it (§5.2). The whole is bound first,
        // under a name nobody can write, so nothing below the parser learns
        // a new shape and the ownership rules need no case of their own —
        // moving out of `#patN.0` leaves `#patN.1` usable, which Ch. 3 §1.3
        // already says.
        ast::Stmt::LetPattern(name, pat, v) => {
            let whole = ast::Stmt::Let(
                false,
                name.to_string(),
                Option::None,
                ast::copy_expr(v),
            );
            stmt(e, &whole, ret);
            if e.stuck {
                return;
            }
            // Only a tuple of plain names. A struct pattern binds by field
            // name and a nested one binds through another pattern; both are
            // taken apart by machinery this does not have, and are refused
            // rather than read positionally.
            match pat {
                ast::Pattern::Tuple(parts) => {
                    let mut i: taddr = 0;
                    while i < parts.len() {
                        let each = match &parts[i] {
                            ast::Pattern::Bind(n) => n.to_string(),
                            _ => "".to_string(),
                        };
                        if each.len() == 0 {
                            e.stuck = true;
                            return;
                        }
                        let mut which: String = Vec::new();
                        push_int(&mut which, i as t27);
                        let base = ast::Expr::Name(name.to_string());
                        let field = ast::Expr::Field(Box::new(base), which);
                        let made =
                            ast::Stmt::Let(false, each, Option::None, field);
                        stmt(e, &made, ret);
                        if e.stuck {
                            return;
                        }
                        i += 1;
                    }
                }
                _ => {
                    e.stuck = true;
                    return;
                }
            }
        }
        ast::Stmt::Do(x) => {
            match x {
                // `while c { … }` — the body is lowered first and the head
                // after it, so the head is the block jumped *back* to and
                // the body is printed before it (§5.3).
                ast::Expr::While(c, b) => {
                    let head = label(e, "while");
                    let body = label(e, "body");
                    let done = label(e, "done");
                    jump(e, &head);
                    start(e, &body);
                    let mut i: taddr = 0;
                    while i < b.stmts.len() {
                        stmt(e, &b.stmts[i], ret);
                        i += 1;
                    }
                    jump(e, &head);
                    start(e, &head);
                    let cond = value(e, c, "t1");
                    if e.stuck {
                        return;
                    }
                    let mut br: String = Vec::new();
                    br.push_str("    br2 ");
                    br.push_str(&cond.text);
                    br.push_str(", ");
                    br.push_str(&body);
                    br.push_str(", ");
                    br.push_str(&done);
                    e.insts.push(br);
                    start(e, &done);
                }
                // `if c { … }` as a statement: the same three blocks a
                // value's `if` has (§5.3) and no storage to join in, since
                // a statement has no value to agree about. It is written
                // here and not in `value` for the reason `while` is — an
                // arm may `return`, and what this function answers with is
                // a thing statements are handed and expressions are not.
                ast::Expr::If(c, t, o) => {
                    if_statement(e, c, t, o, ret);
                }
                // `return e;` as a statement is the whole of what follows.
                ast::Expr::Return(v) => {
                    match v {
                        Option::Some(inner) => {
                            let val = value(e, inner, ret);
                            if e.stuck {
                                return;
                            }
                            let mut line: String = Vec::new();
                            line.push_str("    ret ");
                            line.push_str(&val.text);
                            e.insts.push(line);
                            e.done = true;
                        }
                        Option::None => {
                            e.insts.push("    ret".to_string());
                            e.done = true;
                        }
                    }
                }
                _ => {
                    let v = value(e, x, "");
                    let _ = v;
                }
            }
        }
        _ => {
            e.stuck = true;
        }
    }
}

/// What an expression is, as a TIR value.
fn value(e: &mut Emit, x: &ast::Expr, want: &str) -> Value {
    match x {
        // A literal takes its width from what is around it (Ch. 0 §5.2),
        // and is a word where nothing says.
        ast::Expr::Int(v) => {
            let ty = if want.len() > 0 && !want.same("?") {
                want.to_string()
            } else {
                "t27".to_string()
            };
            let mut out: String = Vec::new();
            out.push_str("const ");
            let shown = tir_of(&ty);
            out.push_str(&shown);
            out.push_str(" ");
            push_int(&mut out, v);
            Value { text: out, ty: ty }
        }
        ast::Expr::Bool(b) => {
            let mut out: String = Vec::new();
            out.push_str("const t1 ");
            if b {
                out.push_str("1");
            } else {
                out.push_str("0");
            }
            Value { text: out, ty: "bool".to_string() }
        }
        ast::Expr::Trit(v) => {
            let mut out: String = Vec::new();
            out.push_str("const t1 ");
            push_int(&mut out, v);
            Value { text: out, ty: "trit".to_string() }
        }
        ast::Expr::Char(v) => {
            let mut out: String = Vec::new();
            out.push_str("const t27 ");
            push_int(&mut out, v);
            Value { text: out, ty: "char".to_string() }
        }
        ast::Expr::Group(inner) => value(e, inner, want),
        // `e as T` — narrower is a `trunc` and wider is a `widen`; the same
        // width is no instruction at all (§2.6).
        ast::Expr::Cast(a, t) => {
            let to = tir_ty_at(&e.tyvars, &e.key, t);
            if to.same("?") {
                e.stuck = true;
                return unknown_value();
            }
            let from = value(e, a, "");
            if e.stuck {
                return unknown_value();
            }
            // A cast between two names TIR spells the same way is no
            // instruction at all: `t27 as taddr` is a word either way.
            let to_wide = tir_of(&to);
            let from_wide = tir_of(&from.ty);
            if to_wide.same(&from_wide) {
                return Value { text: from.text, ty: to };
            }
            let word = if trytes(&to_wide) < trytes(&from_wide) {
                "trunc".to_string()
            } else {
                "widen".to_string()
            };
            let prefix = if word.same("trunc") {
                "t".to_string()
            } else {
                "w".to_string()
            };
            let name = fresh(e, &prefix);
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = ");
            line.push_str(&word);
            line.push_str(" ");
            let shown_from = tir_of(&from.ty);
            line.push_str(&shown_from);
            line.push_str(" ");
            line.push_str(&from.text);
            line.push_str(" -> ");
            line.push_str(&to_wide);
            e.insts.push(line);
            Value { text: name, ty: to }
        }
        // `-x` is one instruction and needs no flavor: the range is
        // symmetric, so `MIN == -MAX` and there is nothing for a negation
        // to overflow (Ch. 1 §4). Which is the radix deciding, and one of
        // the few places this language is shorter than a binary one.
        ast::Expr::Unary(op, a) => {
            if op.same("-") {
                let inner = value(e, a, want);
                if e.stuck {
                    return unknown_value();
                }
                let held = fresh(e, "n");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&held);
                line.push_str(" = neg ");
                let shown = tir_of(&inner.ty);
                line.push_str(&shown);
                line.push_str(" ");
                line.push_str(&inner.text);
                e.insts.push(line);
                return Value { text: held, ty: inner.ty };
            }
            // `!b` is `1 - b` at one trit wide, and wrapping because there
            // is nothing for it to overflow (Ch. 1 §6).
            if !op.same("!") {
                e.stuck = true;
                return unknown_value();
            }
            let inner = value(e, a, "t1");
            if e.stuck {
                return unknown_value();
            }
            let name = fresh(e, "n");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = sub.wrap t1 const t1 1, ");
            line.push_str(&inner.text);
            e.insts.push(line);
            Value { text: name, ty: "bool".to_string() }
        }
        ast::Expr::Name(n) => {
            let at = local_at(e, n);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let ty = e.locals[at].ty.to_string();
            let slot = e.locals[at].slot.to_string();
            // An aggregate's value *is* its storage: it is too big to carry
            // and there is nothing to load it into (TIR §3).
            if def_at(&e.defs, &ty) >= 0 {
                return Value { text: slot, ty: ty };
            }
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&slot);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        ast::Expr::Binary(op, a, b) => {
            if op.same("&&") || op.same("||") {
                return short_circuit(e, op, a, b);
            }
            // A comparison is one `cmp`, which answers a trit, and then a
            // choice of what that trit means (Ch. 1 §4). `<=>` *is* the
            // trit and needs no choosing, which is the whole point of
            // having a three-way comparison at all.
            let arms = choice(op);
            // And a comparison answers `bool` whatever it compares, so what
            // is *around* it says nothing about how wide its operands are:
            // a literal on either side is a word unless the other side says
            // otherwise (Ch. 0 §5.2). Handing the want down made `1 != 2`
            // inside an `if` a comparison of two trits.
            let inner = if arms.len() > 0 || op.same("<=>") {
                "".to_string()
            } else {
                want.to_string()
            };
            let left = value(e, a, &inner);
            let right = value(e, b, &left.ty);
            if e.stuck {
                return unknown_value();
            }
            if arms.len() > 0 || op.same("<=>") {
                let ty = left.ty.to_string();
                // `cmp` compares *scalars*. On a type the program defines,
                // `==` is a call to what `derive(Eq)` wrote (Ch. 4 §6), and
                // a `cmp` on two addresses would be comparing the addresses
                // — which is Ch. 3 §2.3's refusal, silently taken.
                if def_at(&e.defs, &ty) >= 0 {
                    e.stuck = true;
                    return unknown_value();
                }
                let c = fresh(e, "c");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&c);
                line.push_str(" = cmp ");
                let shown = tir_of(&ty);
                line.push_str(&shown);
                line.push_str(" ");
                line.push_str(&left.text);
                line.push_str(", ");
                line.push_str(&right.text);
                e.insts.push(line);
                if op.same("<=>") {
                    return Value { text: c, ty: "trit".to_string() };
                }
                let b = fresh(e, "b");
                let mut pick: String = Vec::new();
                pick.push_str("    ");
                pick.push_str(&b);
                pick.push_str(" = select3 ");
                pick.push_str(&c);
                pick.push_str(", t1 const t1 ");
                pick.push(arms[0]);
                pick.push_str(", const t1 ");
                pick.push(arms[1]);
                pick.push_str(", const t1 ");
                pick.push(arms[2]);
                e.insts.push(pick);
                return Value { text: b, ty: "bool".to_string() };
            }
            let word = arith(op);
            if word.same("?") {
                e.stuck = true;
                return unknown_value();
            }
            let ty = left.ty.to_string();
            let name = fresh(e, "a");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = ");
            line.push_str(&word);
            line.push_str(" ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&left.text);
            line.push_str(", ");
            line.push_str(&right.text);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        // `if c { … } else { … }` — the condition, a two-way branch, and a
        // slot the two arms agree to leave the answer in (§5.3).
        // A block written as an expression is its statements and then its
        // value (§5.1) — which is what an `else` arm is.
        ast::Expr::Nested(b) => branch_block(e, b, want),
        ast::Expr::If(c, t, o) => {
            let none: String = Vec::new();
            if_expr(e, c, t, o, want, &none, "")
        }
        // `p.x` — the field's offset from Ch. 2, and a load (§4).
        ast::Expr::Field(base, field) => {
            // Where the thing this reads a field of *is*. A field of a
            // field asks the same question one layer down, which is the
            // whole of what makes `d.p.x` work.
            let held = place(e, base);
            if e.stuck {
                return unknown_value();
            }
            let owner = held.ty.to_string();
            let slot = held.text.to_string();
            let which = def_at(&e.defs, &owner);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let index = field_at(e, which, field);
            if index < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(&owner));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let ty = field_tir(&e.defs[which].fields[index]);
            // A field that is a reference answers with *what kind* of
            // reference, because that is what a dereference of it needs.
            let named = ref_name(&e.defs[which].fields[index]);
            let answers = if named.len() > 0 {
                named
            } else {
                ty.to_string()
            };
            let src = offset_of(e, &slot, l.offsets[index]);
            // A field that is itself an aggregate has no value to load: it
            // **is** the storage at that offset (TIR §3).
            let inner = name_head(&e.defs[which].fields[index]);
            if def_at(&e.defs, &inner) >= 0 {
                return Value { text: src, ty: inner };
            }
            let v = fresh(e, "v");
            let mut load: String = Vec::new();
            load.push_str("    ");
            load.push_str(&v);
            load.push_str(" = load ");
            let shown = tir_of(&ty);
            load.push_str(&shown);
            load.push_str(" ");
            load.push_str(&src);
            e.insts.push(load);
            Value { text: v, ty: answers }
        }
        // `*r` — what the reference points at (Ch. 3 §2.2). TIR spells
        // every reference `ptr`, so the *name* the emitter carries is what
        // says how wide the thing at the other end is.
        // `&x` — the address of a local, which is the slot it already has.
        // Nothing is emitted: a slot *is* an address (TIR §3), and what the
        // borrow adds is a name for what it points at.
        ast::Expr::Borrow(inner, mutable) => {
            let held = match inner {
                ast::Expr::Name(n) => n.to_string(),
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let at = local_at(e, &held);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let owner = e.locals[at].ty.to_string();
            // A reference to a reference is two loads and one name, and this
            // does not reach it.
            if owner.same("ptr") || referent_name(&owner).len() > 0 {
                e.stuck = true;
                return unknown_value();
            }
            // `&a` where a `&dyn Trait` is wanted is not one address but
            // two: where the object is, and where the table of its type's
            // methods is (Ch. 4 §3.2). The borrow is still no instruction —
            // a slot *is* an address — and what is built is the pair.
            let object = referent_name(want);
            let named = dyn_trait(&object);
            if named.len() > 0 {
                return coerce(e, at, &object, &named);
            }
            let mut out: String = Vec::new();
            out.push('&');
            out.push_str(&owner);
            Value { text: e.locals[at].slot.to_string(), ty: out }
        }
        ast::Expr::Deref(a) => {
            let held = value(e, &*a, "");
            if e.stuck {
                return unknown_value();
            }
            let inner = referent_name(&held.ty);
            if inner.len() == 0 {
                e.stuck = true;
                return unknown_value();
            }
            // An aggregate at the other end *is* its storage, so the
            // address is the value and there is nothing to load (TIR §3).
            if def_at(&e.defs, &inner) >= 0 {
                return Value { text: held.text, ty: inner };
            }
            if scalar_named(&inner).same("?") {
                e.stuck = true;
                return unknown_value();
            }
            let v = fresh(e, "v");
            let mut load: String = Vec::new();
            load.push_str("    ");
            load.push_str(&v);
            load.push_str(" = load ");
            let shown = tir_of(&inner);
            load.push_str(&shown);
            load.push_str(" ");
            load.push_str(&held.text);
            e.insts.push(load);
            Value { text: v, ty: inner }
        }
        // An aggregate with nowhere to go is built in a temporary, which a
        // `let` then *renames* rather than copying out of — which is what
        // makes `let p = P { … }` cost nothing (Ch. 3 §1.1).
        // `|x: t27| x + 1` — a function written where a value goes. What
        // it *is* here is a struct of the addresses of the places it names
        // from around it (Ch. 4 §4.4); the body becomes a function of its
        // own, which the driver emits after this one.
        ast::Expr::Closure(params, ret, body) => {
            let mut bound: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < params.len() {
                bound.push(params[i].name.to_string());
                i += 1;
            }
            let mut free: Vec<String> = Vec::new();
            free_names(&*body, &mut bound, &mut free);
            let mut captures: Vec<Slot> = Vec::new();
            let mut k: taddr = 0;
            while k < free.len() {
                let at = local_at(e, &free[k]);
                if at >= 0 {
                    captures.push(Slot {
                        name: e.locals[at].name.to_string(),
                        slot: e.locals[at].slot.to_string(),
                        ty: e.locals[at].ty.to_string(),
                    });
                }
                k += 1;
            }
            e.closures_made = e.closures_made + 1;
            let mut name: String = Vec::new();
            name.push_str(&e.owner_name);
            name.push_str(".closure");
            push_int(&mut name, e.closures_made);
            let mut ps: Vec<ast::Named> = Vec::new();
            let mut j: taddr = 0;
            while j < params.len() {
                ps.push(ast::Named {
                    name: params[j].name.to_string(),
                    ty: ast::copy_ty(&params[j].ty),
                });
                j += 1;
            }
            let mut answer: Option<ast::Ty> = Option::None;
            match ret {
                Option::Some(r) => answer = Option::Some(ast::copy_ty(r)),
                // Nothing wrote what it answers with, so it is read off the
                // body with the parameters in scope (Ch. 4 §4.1). They are
                // put there as *names* and no storage: nothing is emitted
                // for a question.
                Option::None => {
                    let mark = e.locals.len();
                    let mut m: taddr = 0;
                    while m < params.len() {
                        e.locals.push(Slot {
                            name: params[m].name.to_string(),
                            slot: "".to_string(),
                            ty: tir_ty(&params[m].ty),
                        });
                        m += 1;
                    }
                    let guessed = guess_ty(e, &*body);
                    forget(e, mark);
                    if guessed.len() == 0 {
                        e.stuck = true;
                        return unknown_value();
                    }
                    answer = Option::Some(ast::Ty::Name(one_name(&guessed)));
                }
            }
            let made = Closed {
                name: name.to_string(),
                params: ps,
                ret: answer,
                captures: captures,
                body: ast::copy_expr(&*body),
            };
            note_closure(e, &made);
            let which = def_at(&e.defs, &name);
            let self_ty = ast::Ty::Name(one_name(&name));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let slot = slot_for(e, "tmp", &name);
            let mut c: taddr = 0;
            while c < made.captures.len() {
                let at = offset_of(e, &slot, l.offsets[c]);
                let from = made.captures[c].slot.to_string();
                store_into(e, "ptr", &from, &at);
                c += 1;
            }
            e.closed.push(made);
            Value { text: slot, ty: name }
        }
        ast::Expr::Aggregate(path, fields) => {
            let made = aggregate_type(e, path, want, fields);
            if made.len() == 0 {
                e.stuck = true;
                return unknown_value();
            }
            let variant = variant_of(path);
            let path = &made;
            let which = def_at(&e.defs, path);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(path));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            // Storage for a value with nowhere else to be. Named as a
            // temporary and not as an aggregate, because a `let` renames it
            // to the binding's and everything else leaves it as it is —
            // which is where the name shows.
            let held = fresh(e, "tmp.slot");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&held);
            line.push_str(" = slot tryte[");
            push_int(&mut line, l.size as t27);
            line.push_str("]");
            e.slots.push(line);
            fill(e, &held, path, &variant, fields);
            if e.stuck {
                return unknown_value();
            }
            Value { text: held, ty: path.to_string() }
        }
        // `"abc"` — the characters go in a global and the two words that
        // reach them go in a temporary here (Ch. 2 §4).
        ast::Expr::Str(text) => text_value(e, text),
        // `s[i]` — where the elements are, how many there are, and two
        // three-way tests before any arithmetic (Ch. 3 §3.2).
        ast::Expr::Index(base, at) => index_value(e, base, at),
        // `(a, b)` (Ch. 2 §2).
        ast::Expr::Tuple(items) => tuple_value(e, items, want),
        // `[a, b, c]` and `[v; n]` (Ch. 2 §3).
        ast::Expr::Array(items) => array_value(e, items, want),
        ast::Expr::Repeat(v, count) => repeat_value(e, v, count, want),
        // `match e { … }` — the discriminant once, then a three-way test per
        // arm, and a slot the arms agree to leave the answer in (§5.4).
        ast::Expr::Match(scrutinee, arms) => {
            let none: String = Vec::new();
            match_expr(e, scrutinee, arms, want, &none, "")
        }
        ast::Expr::Assign(op, target, v) => {
            // `d[i] = x` — where the element is, bounds tests and all, and
            // then the value into it. The place first and the value after
            // it, which is the order it is written in.
            match target {
                ast::Expr::Index(base, at) => {
                    if !op.same("=") {
                        e.stuck = true;
                        return unknown_value();
                    }
                    let held = index_place(e, base, at);
                    if e.stuck {
                        return unknown_value();
                    }
                    let val = value(e, v, &held.ty);
                    if e.stuck {
                        return unknown_value();
                    }
                    if def_at(&e.defs, &held.ty) >= 0 {
                        copy_between(e, &val.text, &held.text, &held.ty);
                    } else {
                        store_into(e, &held.ty, &val.text, &held.text);
                    }
                    return Value { text: "".to_string(), ty: "".to_string() };
                }
                _ => {}
            }
            let name = match target {
                ast::Expr::Name(n) => n.to_string(),
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let at = local_at(e, &name);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let ty = e.locals[at].ty.to_string();
            let slot = e.locals[at].slot.to_string();
            // `x += e` **is** `x = x + e`, and is lowered by being written
            // that way: the same load of `x`, the same arithmetic, the same
            // store back. Two lowerings would be two things to keep in step
            // over an operator that is defined as the one it is spelled
            // with (Ch. 0 §5.5).
            let val = if op.same("=") {
                value(e, v, &ty)
            } else {
                let base = compound(op);
                if base.len() == 0 {
                    e.stuck = true;
                    return unknown_value();
                }
                let held = ast::Expr::Binary(
                    base,
                    Box::new(ast::copy_expr(target)),
                    Box::new(ast::copy_expr(v)),
                );
                value(e, &held, &ty)
            };
            if e.stuck {
                return unknown_value();
            }
            store_into(e, &ty, &val.text, &slot);
            Value { text: "".to_string(), ty: "".to_string() }
        }
        // `x.m(a)` — the receiver is the first argument, as an address,
        // and the function is named after the type it is written on.
        ast::Expr::Method(recv, name, args) => {
            let missing: taddr = 0 - 1;
            let at = match recv {
                ast::Expr::Name(n) => local_at(e, n),
                _ => missing,
            };
            // A receiver that is not a name is a **place**: `b.a.get()`
            // asks where `b.a` is and hands that address over. Walking into
            // a place loads `%p` and not `%v`, because what is loaded is a
            // step on the way to the object rather than the object itself
            // — and `place` has already done any reading-through, so only
            // the plain name below still has one to do (G9.94).
            //
            // What it *is* is answered before it is lowered, because a call
            // whose answer is an aggregate takes the storage for it first
            // and that decides the numbers (TIR §3). A name costs nothing
            // to read, so only the other kind waits.
            let mut owner = if at < 0 {
                guess_ty(e, recv)
            } else {
                e.locals[at].ty.to_string()
            };
            if owner.len() == 0 {
                e.stuck = true;
                return unknown_value();
            }
            let mut slot = if at < 0 {
                "".to_string()
            } else {
                e.locals[at].slot.to_string()
            };
            // A receiver that is itself a reference holds the *address* of
            // the object, so what a method is given is what the slot holds
            // and not the slot: `self.area()` inside a `&self` method reads
            // through `self` exactly as `self.field` does (Ch. 3 §2.2).
            let points_at = referent_name(&owner);
            if at >= 0 && (owner.same("ptr") || points_at.len() > 0) {
                owner = if points_at.len() > 0 {
                    points_at
                } else {
                    e.self_ty.to_string()
                };
                let held = fresh(e, "v");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&held);
                line.push_str(" = load ptr ");
                line.push_str(&slot);
                e.insts.push(line);
                slot = held;
            }
            // A method through a trait object is the one call in this
            // language that is not to a name: the receiver's two words say
            // where the object is and where its table is, and the table
            // says which function (Ch. 4 §3.3).
            let named = dyn_trait(&owner);
            if named.len() > 0 {
                slot = receiver_at(e, at, recv, &slot, "");
                if e.stuck {
                    return unknown_value();
                }
                return dyn_call(e, &owner, &named, &slot, name, args);
            }
            // The other fat reference answers one of its methods out of
            // itself: `s.len()` is the second of the two words and no call
            // at all. Everything else `str` has is a function written on
            // `impl str` and named after it, and what it is given is the
            // two words — which is what the slot already holds.
            let text = str_name();
            if owner.same(&text) {
                if name.same("len") && args.len() == 0 {
                    slot = receiver_at(e, at, recv, &slot, "");
                    if e.stuck {
                        return unknown_value();
                    }
                    return str_len(e, &slot);
                }
                owner = "str".to_string();
            }
            let mut full: String = Vec::new();
            full.push_str(&owner);
            full.push_str(".");
            full.push_str(name);
            // What the method was written to take. A receiver is `ptr`
            // where it is a reference and the type itself where it is by
            // value, and a scalar taken by value is *loaded* — what is
            // handed over is the value and not where it is (Ch. 3 §2.2).
            // Where the answer is an aggregate the load waits: the storage
            // is what the function is for and is taken first (TIR §3).
            let receiver = param_type(e, &full, 0);
            let scalar = scalar_named(&receiver);
            let by_value = if scalar.same("?") {
                "".to_string()
            } else {
                receiver.to_string()
            };
            // A generic method is a family like any other; what tells it
            // from a free one is that its receiver is already an argument.
            // Where the receiver is an *instantiation*, the family is the
            // one written on the type it instantiates — `Pair.first`, not
            // `Pair.t27.first` — and its own key starts with the
            // receiver's (Ch. 4 §2.5).
            let inst = inst_at(e, &owner);
            let base = if inst < 0 {
                owner.to_string()
            } else {
                e.instances[inst].base.to_string()
            };
            let none: Vec<String> = Vec::new();
            let given = if inst < 0 {
                none
            } else {
                ast::copy_names(&e.instances[inst].key)
            };
            let mut under: String = Vec::new();
            under.push_str(&base);
            under.push_str(".");
            under.push_str(name);
            let fam = family_at(e, &under);
            if fam >= 0 {
                slot = receiver_at(e, at, recv, &slot, &by_value);
                if e.stuck {
                    return unknown_value();
                }
                return generic_call(e, fam, &under, &slot, &given, args);
            }
            // The storage a call answers into, taken before the receiver is
            // evaluated: `%sret` is what the function is *for* (TIR §3).
            let big = returned_aggregate(e, &full);
            let into = if big.len() > 0 {
                slot_for(e, "tmp", &big)
            } else {
                "".to_string()
            };
            slot = receiver_at(e, at, recv, &slot, &by_value);
            if e.stuck {
                return unknown_value();
            }
            if big.len() > 0 {
                return aggregate_call(e, &full, &big, &into, &slot, args);
            }
            let mut texts: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = param_type(e, &full, i + 1);
                let v = value(e, &args[i], &each);
                if e.stuck {
                    return unknown_value();
                }
                texts.push(v.text);
                i += 1;
            }
            let ty = call_type(e, &full);
            if e.stuck {
                return unknown_value();
            }
            // A method that answers nothing is a call with no result to
            // name and no arrow to write (TIR §3.7).
            let none = answers_nothing(&ty);
            let out = if none {
                "".to_string()
            } else {
                fresh(e, "r")
            };
            let mut line: String = Vec::new();
            line.push_str("    ");
            if !none {
                line.push_str(&out);
                line.push_str(" = ");
            }
            line.push_str("call @");
            line.push_str(&full);
            line.push_str("(");
            line.push_str(&slot);
            let mut k: taddr = 0;
            while k < texts.len() {
                line.push_str(", ");
                line.push_str(&texts[k]);
                k += 1;
            }
            line.push_str(")");
            if !none {
                line.push_str(" -> ");
                let shown = tir_of(&ty);
                line.push_str(&shown);
            }
            e.insts.push(line);
            Value { text: out, ty: ty }
        }
        // `g(x)` where `g` is a closure: what it calls is the `call` of
        // whatever type the closure turned out to be, and the closure
        // itself is its first argument (Ch. 4 §4.2).
        ast::Expr::CallExpr(callee, args) => {
            let missing: taddr = 0 - 1;
            let at = match callee {
                ast::Expr::Name(n) => local_at(e, n),
                _ => missing,
            };
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            closure_call(e, at, args)
        }
        ast::Expr::Call(callee, args) => {
            // `g(x)` where `g` is a *local* is a closure call written the
            // way any call is written; only a name that is not a local can
            // be a function a linker resolves (Ch. 4 §4.2).
            let held = local_at(e, callee);
            if held >= 0 {
                return closure_call(e, held, args);
            }
            // A call to a generic function names an instantiation and not
            // the family, and which one it names is read off the arguments
            // (Ch. 4 §2.3).
            let fam = family_at(e, callee);
            if fam >= 0 {
                let none: Vec<String> = Vec::new();
                return generic_call(e, fam, callee, "", &none, args);
            }
            // A call whose answer is an aggregate is given the storage for
            // it, and the storage is taken before the arguments are — which
            // is what decides the numbers (TIR §3).
            let big = returned_aggregate(e, callee);
            if big.len() > 0 {
                let into = slot_for(e, "tmp", &big);
                return aggregate_call(e, callee, &big, &into, "", args);
            }
            let mut texts: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = param_type(e, callee, i);
                let v = value(e, &args[i], &each);
                if e.stuck {
                    return unknown_value();
                }
                texts.push(v.text);
                i += 1;
            }
            let ty = call_type(e, callee);
            // A function that answers nothing is a call with no result to
            // name and no arrow to write (TIR §3.7).
            let none = answers_nothing(&ty);
            let name = if none {
                "".to_string()
            } else {
                fresh(e, "r")
            };
            let mut line: String = Vec::new();
            line.push_str("    ");
            if !none {
                line.push_str(&name);
                line.push_str(" = ");
            }
            line.push_str("call @");
            line.push_str(callee);
            line.push_str("(");
            let mut k: taddr = 0;
            while k < texts.len() {
                if k > 0 {
                    line.push_str(", ");
                }
                line.push_str(&texts[k]);
                k += 1;
            }
            line.push_str(")");
            if !none {
                line.push_str(" -> ");
                let shown = tir_of(&ty);
                line.push_str(&shown);
            }
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        _ => {
            e.stuck = true;
            unknown_value()
        }
    }
}

/// Where a place is, and what is there: the **storage** an expression names
/// rather than the value in it.
///
/// A field is read from a place and is itself one, so this is the question
/// `b.p.x` asks twice — and the inner offset is taken from the pointer to
/// the outer field rather than recomputed from the base, which is the rule
/// `copy_fields` already follows and the text `trustc` already emits.
fn place(e: &mut Emit, x: &ast::Expr) -> Value {
    match x {
        ast::Expr::Name(n) => {
            let at = local_at(e, n);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let mut owner = e.locals[at].ty.to_string();
            let mut slot = e.locals[at].slot.to_string();
            // A local holding an *address* is read through: the address
            // first, and then what it points at. Which type that is comes
            // from the name where there is one — `&P` says P — and from the
            // receiver where there is not, because `self` is the parameter
            // whose type the impl says rather than the parameter list.
            let points_at = referent_name(&owner);
            if owner.same("ptr") || points_at.len() > 0 {
                owner = if points_at.len() > 0 {
                    points_at
                } else {
                    e.self_ty.to_string()
                };
                let p = fresh(e, "p");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&p);
                line.push_str(" = load ptr ");
                line.push_str(&slot);
                e.insts.push(line);
                slot = p;
            }
            Value { text: slot, ty: owner }
        }
        ast::Expr::Field(base, field) => {
            let held = place(e, base);
            if e.stuck {
                return unknown_value();
            }
            let which = def_at(&e.defs, &held.ty);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let index = field_at(e, which, field);
            if index < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(&held.ty));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            // Only an aggregate field is a place this can go on from: a
            // scalar is a value and a reference is one address more.
            let inner = name_head(&e.defs[which].fields[index]);
            if def_at(&e.defs, &inner) < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let src = offset_of(e, &held.text, l.offsets[index]);
            Value { text: src, ty: inner }
        }
        // A literal has no place until it is given one, and giving it one is
        // exactly what building the two words does. `"one".len()` is the
        // whole of what needs this.
        ast::Expr::Str(text) => text_value(e, text),
        // `g[i][0]`, and `s[i].to_utf8()` — an **element** is a place
        // whatever it holds. A field is not: a scalar field is read where
        // it is and there is nothing to go on to, but an element's address
        // is what the bounds tests were for, and a receiver taken by value
        // is loaded out of it by whoever wanted the value.
        ast::Expr::Index(base, at) => index_place(e, base, at),
        _ => {
            e.stuck = true;
            unknown_value()
        }
    }
}

/// `&Concrete` where a `&dyn Trait` is wanted: the two words of a fat
/// reference, in a temporary of their own (Ch. 4 §3.2).
///
/// The address is the local's slot, which is already what it is. The table
/// is `@vt.<Type>.<Trait>`, and naming it is the whole of what asks for it:
/// the tables are read back out of the finished text, in the order they
/// first appear there.
fn coerce(e: &mut Emit, at: taddr, object: &str, named: &str) -> Value {
    let owner = e.locals[at].ty.to_string();
    let slot = e.locals[at].slot.to_string();
    // A table holds a type's size and its methods, so a receiver that is
    // not a type the file defines is not one a table can be built for —
    // and neither is a trait object, which has already forgotten which.
    if def_at(&e.defs, &owner) < 0 || dyn_trait(&owner).len() > 0 {
        e.stuck = true;
        return unknown_value();
    }
    let self_ty = ast::Ty::Name(one_name(object));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let held = fresh(e, "tmp.slot");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&held);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    store_into(e, "ptr", &slot, &held);
    let where_ = offset_of(e, &held, l.offsets[1]);
    let mut table: String = Vec::new();
    table.push_str("@vt.");
    table.push_str(&owner);
    table.push_str(".");
    table.push_str(named);
    store_into(e, "ptr", &table, &where_);
    Value { text: held, ty: object.to_string() }
}

/// `x.m(a)` where `x` is a trait object: the data address, then the table's,
/// then the entry at `9 + 3 × index`, and a call to *that* (Ch. 4 §3.3).
///
/// Three words come before the methods — the type's size, its alignment and
/// its destructor — because freeing what a `Box<dyn Trait>` points at needs
/// them, and a slot added afterwards would move every index.
fn dyn_call(
    e: &mut Emit,
    object: &str,
    named: &str,
    slot: &str,
    name: &str,
    args: &Vec<ast::Expr>,
) -> Value {
    let table = vtable_name(named);
    let which = def_at(&e.defs, &table);
    if which < 0 {
        e.stuck = true;
        return unknown_value();
    }
    // Which entry it is, asked of the table's *shape* — whose fields are
    // the trait's methods under their own names, so this is the same
    // question a field read asks and the same answer.
    let index = field_at(e, which, name);
    if index < 0 {
        e.stuck = true;
        return unknown_value();
    }
    let self_ty = ast::Ty::Name(one_name(object));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return unknown_value();
        }
    };
    let mut full: String = Vec::new();
    full.push_str(object);
    full.push_str(".");
    full.push_str(name);
    // What a call through a table answers with is what the *trait* said,
    // and a trait that said something this cannot spell — an aggregate, or
    // a method with parameters of its own — has said `?` and is refused.
    let ty = call_type(e, &full);
    if e.stuck {
        return unknown_value();
    }
    let data = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&data);
    line.push_str(" = load ptr ");
    line.push_str(slot);
    e.insts.push(line);
    let held = offset_of(e, slot, l.offsets[1]);
    let vtable = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&vtable);
    line.push_str(" = load ptr ");
    line.push_str(&held);
    e.insts.push(line);
    let entry = offset_of(e, &vtable, 9 + 3 * index);
    let what = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&what);
    line.push_str(" = load ptr ");
    line.push_str(&entry);
    e.insts.push(line);
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        let each = param_type(e, &full, i + 1);
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        i += 1;
    }
    let out = fresh(e, "r");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&out);
    line.push_str(" = call ");
    line.push_str(&what);
    line.push_str("(");
    line.push_str(&data);
    let mut k: taddr = 0;
    while k < texts.len() {
        line.push_str(", ");
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(") -> ");
    let shown = tir_of(&ty);
    line.push_str(&shown);
    e.insts.push(line);
    Value { text: out, ty: ty }
}

/// The nominal types the file defines, as the layout engine reads them.
///
/// A generic type is not among them: it is one type per instantiation
/// (Ch. 4 §2.5), and none of them is called what is written. It is a
/// *family*, and `instantiate` makes its members as they are asked for.
pub fn definitions(items: &Vec<ast::Item>) -> Vec<layout::Def> {
    let fams = type_families(items);
    let mut out: Vec<layout::Def> = Vec::new();
    let mut i: taddr = 0;
    while i < fams.len() {
        if fams[i].tyvars.len() == 0 {
            out.push(copy_def(&fams[i].def));
        }
        i += 1;
    }
    // Every tuple any *signature* mentions, as a definition. A tuple has
    // no name for a caller to look up, so an argument written `(1, 2)`
    // could only take its element types from the parameter's type — and
    // reading that needs the shape to be here before the call is lowered.
    // A body's own tuples are made where they are named, by `nominal`.
    let mut f: taddr = 0;
    while f < items.len() {
        match &items[f].what {
            ast::What::Function(held) => note_signature(held, &mut out),
            ast::What::Impl(gs, tr, ty, fns) => {
                let mut k: taddr = 0;
                while k < fns.len() {
                    note_signature(&fns[k], &mut out);
                    k += 1;
                }
            }
            ast::What::Trait(n, params, supers, assoc, fns) => {
                let mut k: taddr = 0;
                while k < fns.len() {
                    note_signature(&fns[k], &mut out);
                    k += 1;
                }
            }
            ast::What::Struct(name, gs, fields) => {
                let mut k: taddr = 0;
                while k < fields.len() {
                    note_tuples(&fields[k].ty, &mut out);
                    k += 1;
                }
            }
            _ => {}
        }
        f += 1;
    }
    // And one nobody wrote that is not per anything: what a `&str` is, which
    // is the address of the characters and how many of them there are
    // (Ch. 2 §4). It is a definition for the same reason the two below are —
    // TIR has no name for a pair — and it is here whether or not the file
    // mentions text, because nothing about it is read off the program.
    let mut two: Vec<ast::Ty> = Vec::new();
    let mut named: Vec<String> = Vec::new();
    let held = ast::Ty::Name(one_name("char"));
    two.push(ast::Ty::Ref(Box::new(held), false));
    named.push("data".to_string());
    two.push(ast::Ty::Name(one_name("taddr")));
    named.push("len".to_string());
    out.push(layout::Def {
        name: str_name(),
        is_enum: false,
        linear: false,
        fields: two,
        field_names: named,
        counts: Vec::new(),
        discriminants: Vec::new(),
    });
    // And two nobody wrote, per trait (Ch. 4 §3.1). `dyn.<Trait>` is what a
    // reference to a trait object *is* — the data address and the table's,
    // which is the storage a parameter is copied into and any two fields to
    // everything that reads it. `vtable.<Trait>` is the table's own shape,
    // one field per method under the method's name, which is the only thing
    // that says `twice` is the second entry.
    let mut t: taddr = 0;
    while t < items.len() {
        match &items[t].what {
            ast::What::Trait(n, params, supers, assoc, fns) => {
                let mut two: Vec<ast::Ty> = Vec::new();
                let mut named: Vec<String> = Vec::new();
                let held = ast::Ty::Name(one_name("t27"));
                two.push(ast::Ty::Ref(Box::new(held), false));
                named.push("data".to_string());
                two.push(ast::Ty::Name(one_name("taddr")));
                named.push("vtable".to_string());
                out.push(layout::Def {
                    name: dyn_name(n),
                    is_enum: false,
                    linear: false,
                    fields: two,
                    field_names: named,
                    counts: Vec::new(),
                    discriminants: Vec::new(),
                });
                let mut slots: Vec<ast::Ty> = Vec::new();
                let mut methods: Vec<String> = Vec::new();
                let mut k: taddr = 0;
                while k < fns.len() {
                    slots.push(ast::Ty::Name(one_name("taddr")));
                    methods.push(fns[k].name.to_string());
                    k += 1;
                }
                out.push(layout::Def {
                    name: vtable_name(n),
                    is_enum: false,
                    linear: false,
                    fields: slots,
                    field_names: methods,
                    counts: Vec::new(),
                    discriminants: Vec::new(),
                });
            }
            _ => {}
        }
        t += 1;
    }
    out
}

/// Every tuple a function's signature mentions, as a definition.
fn note_signature(f: &ast::Fn, out: &mut Vec<layout::Def>) {
    let mut i: taddr = 0;
    while i < f.params.len() {
        note_tuples(&f.params[i].ty, out);
        i += 1;
    }
    note_tuples(&f.ret, out);
}

/// Every tuple written inside this type, as a definition, innermost first.
fn note_tuples(t: &ast::Ty, out: &mut Vec<layout::Def>) {
    match t {
        ast::Ty::Tuple(args) => {
            let mut i: taddr = 0;
            while i < args.len() {
                note_tuples(&args[i], out);
                i += 1;
            }
            let full = written_tuple(t);
            if full.len() == 0 || def_at(out, &full) >= 0 {
                return;
            }
            let mut fields: Vec<ast::Ty> = Vec::new();
            let mut names: Vec<String> = Vec::new();
            let mut k: taddr = 0;
            while k < args.len() {
                let each = written_element(&args[k]);
                fields.push(ast::Ty::Name(one_name(&each)));
                let mut which: String = Vec::new();
                push_int(&mut which, k as t27);
                names.push(which);
                k += 1;
            }
            out.push(layout::Def {
                name: full,
                is_enum: false,
                linear: false,
                fields: fields,
                field_names: names,
                counts: Vec::new(),
                discriminants: Vec::new(),
            });
        }
        ast::Ty::Ref(held, m) => note_tuples(&*held, out),
        ast::Ty::Array(held, len) => note_tuples(&*held, out),
        _ => {}
    }
}

/// Every struct and enum of the file, with the parameters each was written
/// with — none for most of them, which is what makes those types as they
/// stand and the rest families.
pub fn type_families(items: &Vec<ast::Item>) -> Vec<TyFamily> {
    let mut out: Vec<TyFamily> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Struct(name, gs, fields) => {
                let mut tys: Vec<ast::Ty> = Vec::new();
                let mut names: Vec<String> = Vec::new();
                let mut k: taddr = 0;
                while k < fields.len() {
                    names.push(fields[k].name.to_string());
                    tys.push(ast::copy_ty(&fields[k].ty));
                    k += 1;
                }
                out.push(TyFamily {
                    name: name.to_string(),
                    tyvars: generic_names(gs),
                    def: layout::Def {
                        name: name.to_string(),
                        is_enum: false,
                        linear: items[i].linear,
                        fields: tys,
                        field_names: names,
                        counts: Vec::new(),
                        discriminants: Vec::new(),
                    },
                });
            }
            ast::What::Enum(name, gs, variants) => {
                let mut tys: Vec<ast::Ty> = Vec::new();
                let mut counts: Vec<taddr> = Vec::new();
                let mut discs: Vec<t27> = Vec::new();
                let mut names: Vec<String> = Vec::new();
                let mut next: t27 = 0;
                let mut v: taddr = 0;
                while v < variants.len() {
                    let mut n: taddr = 0;
                    let mut k: taddr = 0;
                    while k < variants[v].fields.len() {
                        tys.push(ast::copy_ty(&variants[v].fields[k]));
                        n += 1;
                        k += 1;
                    }
                    names.push(variants[v].name.to_string());
                    counts.push(n);
                    discs.push(next);
                    next = next + 1;
                    v += 1;
                }
                out.push(TyFamily {
                    name: name.to_string(),
                    tyvars: generic_names(gs),
                    def: layout::Def {
                        name: name.to_string(),
                        is_enum: true,
                        linear: items[i].linear,
                        fields: tys,
                        field_names: names,
                        counts: counts,
                        discriminants: discs,
                    },
                });
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// One method a type gets from a trait rather than from its own `impl`:
/// the trait wrote a body and the impl did not override it (Ch. 4 §1.7).
///
/// It is a function of the type, named after the type, and there is one per
/// implementing type — `Re.twice` and `Sq.twice` are two functions from one
/// body, which is monomorphization by another name.
pub struct Given {
    pub owner: String,
    pub trait_name: String,
    pub name: String,
}

/// Every method every type in the file is given by a trait.
pub fn givens(items: &Vec<ast::Item>) -> Vec<Given> {
    let mut out: Vec<Given> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                let named = match tr {
                    Option::Some(t) => written_head(t),
                    Option::None => "".to_string(),
                };
                // An impl with parameters of its own is one impl per
                // instantiation of the type, and what a *trait* gives it is
                // not something this reaches yet.
                if named.len() > 0 && plain_impl(gs) {
                    let owner = written_head(ty);
                    let at = trait_at(items, &named);
                    if at >= 0 {
                        match &items[at].what {
                            ast::What::Trait(n, params, supers, assoc, tfns) => {
                                let mut k: taddr = 0;
                                while k < tfns.len() {
                                    let mut has_body = false;
                                    match &tfns[k].body {
                                        Option::Some(b) => has_body = true,
                                        Option::None => {}
                                    }
                                    if has_body && named_fn(fns, &tfns[k].name) < 0 {
                                        out.push(Given {
                                            owner: owner.to_string(),
                                            trait_name: named.to_string(),
                                            name: tfns[k].name.to_string(),
                                        });
                                    }
                                    k += 1;
                                }
                            }
                            _ => {}
                        }
                    }
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// Which item is the trait of that name, or −1.
fn trait_at(items: &Vec<ast::Item>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Trait(n, params, supers, assoc, fns) => {
                if n.same(name) {
                    return i;
                }
            }
            _ => {}
        }
        i += 1;
    }
    0 - 1
}

/// Which of these functions is called this, or −1.
fn named_fn(fns: &Vec<ast::Fn>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < fns.len() {
        if fns[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// What every function answers with, as it was written.
pub fn returns(items: &Vec<ast::Item>) -> Vec<RetTy> {
    let mut out: Vec<RetTy> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                out.push(RetTy { name: f.name.to_string(), ty: ast::copy_ty(&f.ret) });
            }
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    out.push(RetTy { name: full, ty: ast::copy_ty(&fns[k].ret) });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    let given = givens(items);
    let mut g: taddr = 0;
    while g < given.len() {
        let at = trait_at(items, &given[g].trait_name);
        match &items[at].what {
            ast::What::Trait(n, params, supers, assoc, tfns) => {
                let k = named_fn(tfns, &given[g].name);
                if k >= 0 {
                    out.push(RetTy {
                        name: given_name(&given[g]),
                        ty: ast::copy_ty(&tfns[k].ret),
                    });
                }
            }
            _ => {}
        }
        g += 1;
    }
    out
}

/// The name a given method is known by: the type's, not the trait's
/// (Ch. 4 §1.2).
pub fn given_name(g: &Given) -> String {
    let mut out: String = Vec::new();
    out.push_str(&g.owner);
    out.push_str(".");
    out.push_str(&g.name);
    out
}

/// The aggregate a call answers with, made if this is the first ask — or
/// nothing where the answer is not one.
///
/// This is where a call learns it has to provide storage: TIR answers with
/// a value or with nothing, and a value that big is not one (TIR §3).
fn returned_aggregate(e: &mut Emit, name: &str) -> String {
    let mut i: taddr = 0;
    while i < e.rets.len() {
        if e.rets[i].name.same(name) {
            let written = ast::copy_ty(&e.rets[i].ty);
            let none: Vec<String> = Vec::new();
            let empty: Vec<String> = Vec::new();
            let made = subst_ty(e, &none, &empty, &written);
            let full = nominal(e, &made);
            if full.len() > 0 && def_at(&e.defs, &full) >= 0 {
                return full;
            }
            return "".to_string();
        }
        i += 1;
    }
    "".to_string()
}

/// Which type a literal `Pair { … }` builds: the member of the family its
/// fields say it is (Ch. 4 §2.3), made if this is the first ask.
///
/// A type written with no parameters is a family of one and is its own
/// answer, which is every aggregate that was written before this.
fn aggregate_type(
    e: &mut Emit,
    path: &str,
    want: &str,
    fields: &Vec<ast::Field>,
) -> String {
    let head = type_path(path);
    if def_at(&e.defs, &head) >= 0 {
        return head;
    }
    // A variant with no payload says nothing about the arguments — nothing
    // is written for them to be read off. What says is where the value is
    // going: `let a: Opt<t27> = Opt::None` is Ch. 4 §2.3 inferring from the
    // binding, and that is the one direction this can follow.
    let told = inst_at(e, want);
    if told >= 0 && e.instances[told].base.same(&head) {
        return want.to_string();
    }
    let at = tyfamily_at(e, &head);
    if at < 0 {
        return "".to_string();
    }
    let declared = written_fields(e, at, path, fields);
    if declared.len() != fields.len() {
        return "".to_string();
    }
    let mut key: Vec<String> = Vec::new();
    let mut t: taddr = 0;
    while t < e.tyfams[at].tyvars.len() {
        let each = e.tyfams[at].tyvars[t].to_string();
        let mut found: String = Vec::new();
        let mut clash = false;
        let mut i: taddr = 0;
        while i < fields.len() {
            if declared[i].same(&each) {
                let got = guess_ty(e, &fields[i].value);
                if got.len() == 0 {
                    clash = true;
                } else if found.len() == 0 {
                    found = got;
                } else if !found.same(&got) {
                    clash = true;
                }
            }
            i += 1;
        }
        if clash || found.len() == 0 {
            return "".to_string();
        }
        key.push(found);
        t += 1;
    }
    instantiate(e, &head, &key)
}

/// The declared type of each field a literal writes, in the order it writes
/// them — a struct's by name, a variant's by position, since a payload has
/// no names to be written under (§3.3).
fn written_fields(
    e: &Emit,
    at: taddr,
    path: &str,
    fields: &Vec<ast::Field>,
) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let variant = variant_of(path);
    if variant.len() > 0 {
        let index = named_variant(&e.tyfams[at].def, &variant);
        if index < 0 {
            return out;
        }
        let start = variant_start(&e.tyfams[at].def, index);
        let mut i: taddr = 0;
        while i < fields.len() && i < e.tyfams[at].def.counts[index] {
            out.push(name_head(&e.tyfams[at].def.fields[start + i]));
            i += 1;
        }
        return out;
    }
    let mut i: taddr = 0;
    while i < fields.len() {
        let mut k: taddr = 0;
        while k < e.tyfams[at].def.field_names.len() {
            if e.tyfams[at].def.field_names[k].same(&fields[i].name) {
                out.push(name_head(&e.tyfams[at].def.fields[k]));
            }
            k += 1;
        }
        i += 1;
    }
    out
}

/// `E::B` names the variant `B`; a name with no `::` names no variant.
fn variant_of(path: &str) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    let mut at: taddr = 0 - 1;
    while i + 1 < path.len() {
        if path[i] == ':' && path[i + 1] == ':' {
            at = i;
        }
        i += 1;
    }
    if at < 0 {
        return out;
    }
    let mut k = at + 2;
    while k < path.len() {
        out.push(path[k]);
        k += 1;
    }
    out
}

/// And the type it is a variant of, which is the whole of a name with no
/// `::` in it. A module is written with `.` by the time this reads one
/// (Ch. 6 §4), so a `::` here is a variant and nothing else.
fn type_path(path: &str) -> String {
    let mut i: taddr = 0;
    let mut at: taddr = 0 - 1;
    while i + 1 < path.len() {
        if path[i] == ':' && path[i + 1] == ':' {
            at = i;
        }
        i += 1;
    }
    if at < 0 {
        return path.to_string();
    }
    let mut out: String = Vec::new();
    let mut k: taddr = 0;
    while k < at {
        out.push(path[k]);
        k += 1;
    }
    out
}

/// Which variant of a definition is called this, or −1.
fn named_variant(d: &layout::Def, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < d.field_names.len() {
        if d.field_names[i].same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Where a variant's payload types begin in the flat list of them all.
fn variant_start(d: &layout::Def, index: taddr) -> taddr {
    let mut out: taddr = 0;
    let mut i: taddr = 0;
    while i < index {
        out = out + d.counts[i];
        i += 1;
    }
    out
}

/// What type an expression will turn out to be, without lowering it.
///
/// Only asked where a *type argument* has to be worked out before the
/// values that decide it are emitted, and answered only for the shapes
/// where the answer needs nothing but the expression: a literal is what
/// §5.2 says a literal is, and a name is what it was bound as. Anything
/// else answers nothing, and nothing is what refuses the instantiation.
fn guess_ty(e: &mut Emit, x: &ast::Expr) -> String {
    match x {
        ast::Expr::Int(v) => "t27".to_string(),
        ast::Expr::Bool(b) => "bool".to_string(),
        ast::Expr::Trit(v) => "trit".to_string(),
        ast::Expr::Char(v) => "char".to_string(),
        ast::Expr::Group(inner) => guess_ty(e, inner),
        // A literal has no place until it is given one, and what it *is* is
        // known without giving it one.
        ast::Expr::Str(text) => str_name(),
        // An element and a field, worked out **without emitting anything**:
        // a call whose answer is an aggregate takes the storage for it
        // before the receiver is evaluated, so what the receiver *is* has
        // to be answerable before it is lowered (TIR §3).
        ast::Expr::Index(base, at) => {
            let held = guess_ty(e, base);
            let owner = pointee(e, &held);
            let text = str_name();
            if owner.same(&text) {
                return "char".to_string();
            }
            let which = def_at(&e.defs, &owner);
            if which < 0 || !is_array(&owner) {
                return "".to_string();
            }
            name_head(&e.defs[which].fields[0])
        }
        ast::Expr::Field(base, field) => {
            let held = guess_ty(e, base);
            let owner = pointee(e, &held);
            let which = def_at(&e.defs, &owner);
            if which < 0 {
                return "".to_string();
            }
            let index = field_at(e, which, field);
            if index < 0 {
                return "".to_string();
            }
            let named = ref_name(&e.defs[which].fields[index]);
            if named.len() > 0 {
                return named;
            }
            name_head(&e.defs[which].fields[index])
        }
        ast::Expr::Cast(a, t) => tir_ty_at(&e.tyvars, &e.key, t),
        // Arithmetic answers with what it was given and a comparison with a
        // `bool`, which is Ch. 1 §5 either way.
        ast::Expr::Binary(op, a, b) => {
            if op.same("==") || op.same("!=") || op.same("<") || op.same(">")
                || op.same("<=") || op.same(">=") || op.same("&&") || op.same("||")
            {
                return "bool".to_string();
            }
            if op.same("<=>") {
                return "trit".to_string();
            }
            let left = guess_ty(e, &*a);
            if left.len() > 0 {
                return left;
            }
            guess_ty(e, &*b)
        }
        ast::Expr::Name(n) => {
            let at = local_at(e, n);
            if at < 0 {
                "".to_string()
            } else {
                e.locals[at].ty.to_string()
            }
        }
        // A call answers with what its signature says, which is a fact
        // about the file and needs nothing lowered. A call to a *generic*
        // function answers with whatever that call works out, which is not
        // one of those.
        ast::Expr::Call(callee, args) => {
            if family_at(e, callee) >= 0 {
                return "".to_string();
            }
            let big = returned_aggregate(e, callee);
            if big.len() > 0 {
                return big;
            }
            let mut i: taddr = 0;
            while i < e.sigs.len() {
                if e.sigs[i].name.same(callee) {
                    let ret = e.sigs[i].ret.to_string();
                    if ret.same("?") {
                        return "".to_string();
                    }
                    return ret;
                }
                i += 1;
            }
            "".to_string()
        }
        _ => "".to_string(),
    }
}

/// A definition, copied. `defs` grows as instantiations are asked for, and
/// what a family is made of has to survive being read more than once.
fn copy_def(d: &layout::Def) -> layout::Def {
    let mut tys: Vec<ast::Ty> = Vec::new();
    let mut i: taddr = 0;
    while i < d.fields.len() {
        tys.push(ast::copy_ty(&d.fields[i]));
        i += 1;
    }
    let mut counts: Vec<taddr> = Vec::new();
    let mut k: taddr = 0;
    while k < d.counts.len() {
        counts.push(d.counts[k]);
        k += 1;
    }
    let mut discs: Vec<t27> = Vec::new();
    let mut j: taddr = 0;
    while j < d.discriminants.len() {
        discs.push(d.discriminants[j]);
        j += 1;
    }
    layout::Def {
        name: d.name.to_string(),
        is_enum: d.is_enum,
        linear: d.linear,
        fields: tys,
        field_names: ast::copy_names(&d.field_names),
        counts: counts,
        discriminants: discs,
    }
}

/// The names an expression uses that nothing inside it bound.
///
/// In the order they are first used, because that is the order a closure's
/// captures are laid out in and the order is in the text (Ch. 4 §4.4).
fn free_names(x: &ast::Expr, bound: &mut Vec<String>, out: &mut Vec<String>) {
    match x {
        ast::Expr::Name(n) => {
            if !holds_name(bound, n) && !holds_name(out, n) {
                out.push(n.to_string());
            }
        }
        ast::Expr::Binary(op, a, b) => {
            free_names(&*a, bound, out);
            free_names(&*b, bound, out);
        }
        ast::Expr::Unary(op, a) => free_names(&*a, bound, out),
        ast::Expr::Call(f, args) => free_in_all(args, bound, out),
        ast::Expr::CallExpr(callee, args) => {
            free_names(&*callee, bound, out);
            free_in_all(args, bound, out);
        }
        ast::Expr::Closure(params, ret, body) => {
            let mark = bound.len();
            let mut i: taddr = 0;
            while i < params.len() {
                bound.push(params[i].name.to_string());
                i += 1;
            }
            free_names(&*body, bound, out);
            forget_names(bound, mark);
        }
        ast::Expr::Array(items) => free_in_all(items, bound, out),
        ast::Expr::Tuple(items) => free_in_all(items, bound, out),
        ast::Expr::Repeat(v, n) => {
            free_names(&*v, bound, out);
            free_names(&*n, bound, out);
        }
        ast::Expr::Aggregate(path, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                free_names(&fields[i].value, bound, out);
                i += 1;
            }
        }
        ast::Expr::Borrow(a, m) => free_names(&*a, bound, out),
        ast::Expr::Deref(a) => free_names(&*a, bound, out),
        ast::Expr::Index(a, at) => {
            free_names(&*a, bound, out);
            free_names(&*at, bound, out);
        }
        ast::Expr::Cast(a, t) => free_names(&*a, bound, out),
        ast::Expr::Try(a) => free_names(&*a, bound, out),
        ast::Expr::Group(a) => free_names(&*a, bound, out),
        ast::Expr::Field(a, name) => free_names(&*a, bound, out),
        ast::Expr::Method(recv, name, args) => {
            free_names(&*recv, bound, out);
            free_in_all(args, bound, out);
        }
        ast::Expr::Assign(op, target, v) => {
            free_names(&*target, bound, out);
            free_names(&*v, bound, out);
        }
        ast::Expr::Nested(b) => free_in_block(&*b, bound, out),
        ast::Expr::If(c, t, o) => {
            free_names(&*c, bound, out);
            free_in_block(&*t, bound, out);
            match o {
                Option::Some(held) => free_names(&*held, bound, out),
                Option::None => {}
            }
        }
        ast::Expr::For(name, over, body) => {
            free_names(&*over, bound, out);
            let mark = bound.len();
            bound.push(name.to_string());
            free_in_block(&*body, bound, out);
            forget_names(bound, mark);
        }
        ast::Expr::While(c, body) => {
            free_names(&*c, bound, out);
            free_in_block(&*body, bound, out);
        }
        ast::Expr::Loop(body) => free_in_block(&*body, bound, out),
        ast::Expr::Match(scrutinee, arms) => {
            free_names(&*scrutinee, bound, out);
            let mut i: taddr = 0;
            while i < arms.len() {
                let mark = bound.len();
                let mut k: taddr = 0;
                while k < arms[i].patterns.len() {
                    bind_names(&arms[i].patterns[k], bound);
                    k += 1;
                }
                match &arms[i].guard {
                    Option::Some(g) => free_names(g, bound, out),
                    Option::None => {}
                }
                free_names(&arms[i].body, bound, out);
                forget_names(bound, mark);
                i += 1;
            }
        }
        ast::Expr::Return(v) => free_in_option(v, bound, out),
        ast::Expr::Break(v) => free_in_option(v, bound, out),
        _ => {}
    }
}

fn free_in_all(items: &Vec<ast::Expr>, bound: &mut Vec<String>, out: &mut Vec<String>) {
    let mut i: taddr = 0;
    while i < items.len() {
        free_names(&items[i], bound, out);
        i += 1;
    }
}

fn free_in_option(
    v: &Option<Box<ast::Expr>>,
    bound: &mut Vec<String>,
    out: &mut Vec<String>,
) {
    match v {
        Option::Some(x) => free_names(&*x, bound, out),
        Option::None => {}
    }
}

fn free_in_block(b: &ast::Block, bound: &mut Vec<String>, out: &mut Vec<String>) {
    let mark = bound.len();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, v) => {
                free_names(v, bound, out);
                bound.push(name.to_string());
            }
            ast::Stmt::LetPattern(name, p, v) => {
                free_names(v, bound, out);
                bind_names(p, bound);
            }
            ast::Stmt::Do(v) => free_names(v, bound, out),
        }
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => free_names(&*x, bound, out),
        Option::None => {}
    }
    forget_names(bound, mark);
}

/// What a pattern binds, added to what is bound.
fn bind_names(p: &ast::Pattern, bound: &mut Vec<String>) {
    match p {
        ast::Pattern::Bind(n) => bound.push(n.to_string()),
        ast::Pattern::Tuple(items) => {
            let mut i: taddr = 0;
            while i < items.len() {
                bind_names(&items[i], bound);
                i += 1;
            }
        }
        ast::Pattern::Aggregate(path, fields) => {
            let mut i: taddr = 0;
            while i < fields.len() {
                bind_names(&fields[i].pat, bound);
                i += 1;
            }
        }
        _ => {}
    }
}

/// Forget what a scope bound, which is what leaving one is.
fn forget_names(bound: &mut Vec<String>, mark: taddr) {
    while bound.len() > mark {
        match bound.pop() {
            Option::Some(n) => {}
            Option::None => return,
        }
    }
}

/// The closures, copied. A `&mut Work` is not a `Vec<Closed>` and the
/// emitter holds its own, which it hands back the new part of when it is
/// done — exactly as it does with the instantiations it asked for.
fn copy_closed(from: &Vec<Closed>) -> Vec<Closed> {
    let mut out: Vec<Closed> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(one_closed(&from[i]));
        i += 1;
    }
    out
}

fn one_closed(c: &Closed) -> Closed {
    let mut params: Vec<ast::Named> = Vec::new();
    let mut i: taddr = 0;
    while i < c.params.len() {
        params.push(ast::Named {
            name: c.params[i].name.to_string(),
            ty: ast::copy_ty(&c.params[i].ty),
        });
        i += 1;
    }
    let mut captures: Vec<Slot> = Vec::new();
    let mut k: taddr = 0;
    while k < c.captures.len() {
        captures.push(Slot {
            name: c.captures[k].name.to_string(),
            slot: c.captures[k].slot.to_string(),
            ty: c.captures[k].ty.to_string(),
        });
        k += 1;
    }
    let mut ret: Option<ast::Ty> = Option::None;
    match &c.ret {
        Option::Some(r) => ret = Option::Some(ast::copy_ty(r)),
        Option::None => {}
    }
    Closed {
        name: c.name.to_string(),
        params: params,
        ret: ret,
        captures: captures,
        body: ast::copy_expr(&c.body),
    }
}

/// A closure's body, as the function it becomes: `<name>.call`, taking the
/// closure itself by reference and then what was written (Ch. 4 §4.1).
///
/// A captured name is read *through* `self`, which is what `rewrite` does —
/// so the body below is the body above with `k` become `(*self.k)`, and
/// every other rule about fields and references applies to it unchanged.
fn call_of(c: &Closed) -> ast::Fn {
    let mut params: Vec<ast::Param> = Vec::new();
    let held = ast::Ty::Name(one_name(&c.name));
    params.push(ast::Param {
        name: "self".to_string(),
        ty: ast::Ty::Ref(Box::new(held), false),
    });
    let mut i: taddr = 0;
    while i < c.params.len() {
        params.push(ast::Param {
            name: c.params[i].name.to_string(),
            ty: ast::copy_ty(&c.params[i].ty),
        });
        i += 1;
    }
    let mut ret = ast::Ty::Unit;
    match &c.ret {
        Option::Some(r) => ret = ast::copy_ty(r),
        Option::None => {}
    }
    let mut names: Vec<String> = Vec::new();
    let mut k: taddr = 0;
    while k < c.captures.len() {
        names.push(c.captures[k].name.to_string());
        k += 1;
    }
    let mut bound: Vec<String> = Vec::new();
    let body = through_self(&c.body, &names, &mut bound);
    let mut name: String = Vec::new();
    name.push_str(&c.name);
    name.push_str(".call");
    ast::Fn {
        name: name,
        generics: Vec::new(),
        requires: Vec::new(),
        params: params,
        ret: ret,
        body: Option::Some(ast::Block {
            stmts: Vec::new(),
            tail: Option::Some(Box::new(body)),
        }),
    }
}

/// The same expression with every captured name read through `self`.
///
/// A capture is a field of the closure holding an address, so `k` becomes
/// `(*self.k)` and every other rule about fields and references applies to
/// it unchanged (Ch. 4 §4.4). A name the body *binds* is not a capture, so
/// what is bound is tracked as the rewrite walks: a `let k` inside shadows
/// the capture from there on, exactly as it shadows anything else.
fn through_self(x: &ast::Expr, captured: &Vec<String>, bound: &mut Vec<String>) -> ast::Expr {
    match x {
        ast::Expr::Name(n) => {
            if holds_name(captured, n) && !holds_name(bound, n) {
                let base = ast::Expr::Name("self".to_string());
                let field = ast::Expr::Field(Box::new(base), n.to_string());
                return ast::Expr::Deref(Box::new(field));
            }
            ast::Expr::Name(n.to_string())
        }
        ast::Expr::Binary(op, a, b) => ast::Expr::Binary(
            op.to_string(),
            Box::new(through_self(&*a, captured, bound)),
            Box::new(through_self(&*b, captured, bound)),
        ),
        ast::Expr::Unary(op, a) => {
            ast::Expr::Unary(op.to_string(), Box::new(through_self(&*a, captured, bound)))
        }
        ast::Expr::Call(f, args) => {
            ast::Expr::Call(f.to_string(), through_all(args, captured, bound))
        }
        ast::Expr::CallExpr(callee, args) => ast::Expr::CallExpr(
            Box::new(through_self(&*callee, captured, bound)),
            through_all(args, captured, bound),
        ),
        ast::Expr::Method(recv, name, args) => ast::Expr::Method(
            Box::new(through_self(&*recv, captured, bound)),
            name.to_string(),
            through_all(args, captured, bound),
        ),
        ast::Expr::Cast(a, t) => ast::Expr::Cast(
            Box::new(through_self(&*a, captured, bound)),
            ast::copy_ty(t),
        ),
        ast::Expr::Group(a) => {
            ast::Expr::Group(Box::new(through_self(&*a, captured, bound)))
        }
        ast::Expr::Field(a, name) => ast::Expr::Field(
            Box::new(through_self(&*a, captured, bound)),
            name.to_string(),
        ),
        ast::Expr::Borrow(a, m) => {
            ast::Expr::Borrow(Box::new(through_self(&*a, captured, bound)), m)
        }
        ast::Expr::Deref(a) => {
            ast::Expr::Deref(Box::new(through_self(&*a, captured, bound)))
        }
        ast::Expr::Try(a) => {
            ast::Expr::Try(Box::new(through_self(&*a, captured, bound)))
        }
        ast::Expr::Index(a, at) => ast::Expr::Index(
            Box::new(through_self(&*a, captured, bound)),
            Box::new(through_self(&*at, captured, bound)),
        ),
        ast::Expr::Assign(op, target, v) => ast::Expr::Assign(
            op.to_string(),
            Box::new(through_self(&*target, captured, bound)),
            Box::new(through_self(&*v, captured, bound)),
        ),
        ast::Expr::Array(items) => ast::Expr::Array(through_all(items, captured, bound)),
        ast::Expr::Tuple(items) => ast::Expr::Tuple(through_all(items, captured, bound)),
        ast::Expr::Repeat(v, n) => ast::Expr::Repeat(
            Box::new(through_self(&*v, captured, bound)),
            Box::new(through_self(&*n, captured, bound)),
        ),
        ast::Expr::Aggregate(path, fields) => {
            let mut out: Vec<ast::Field> = Vec::new();
            let mut i: taddr = 0;
            while i < fields.len() {
                out.push(ast::Field {
                    name: fields[i].name.to_string(),
                    value: through_self(&fields[i].value, captured, bound),
                });
                i += 1;
            }
            ast::Expr::Aggregate(path.to_string(), out)
        }
        ast::Expr::Nested(b) => {
            ast::Expr::Nested(Box::new(through_block(&*b, captured, bound)))
        }
        ast::Expr::If(c, t, o) => {
            let cond = through_self(&*c, captured, bound);
            let then = through_block(&*t, captured, bound);
            let mut other: Option<Box<ast::Expr>> = Option::None;
            match o {
                Option::Some(held) => {
                    other = Option::Some(Box::new(through_self(&*held, captured, bound)));
                }
                Option::None => {}
            }
            ast::Expr::If(Box::new(cond), Box::new(then), other)
        }
        ast::Expr::While(c, body) => ast::Expr::While(
            Box::new(through_self(&*c, captured, bound)),
            Box::new(through_block(&*body, captured, bound)),
        ),
        ast::Expr::Loop(body) => {
            ast::Expr::Loop(Box::new(through_block(&*body, captured, bound)))
        }
        ast::Expr::For(name, over, body) => {
            let held = through_self(&*over, captured, bound);
            let mark = bound.len();
            bound.push(name.to_string());
            let inner = through_block(&*body, captured, bound);
            forget_names(bound, mark);
            ast::Expr::For(name.to_string(), Box::new(held), Box::new(inner))
        }
        ast::Expr::Match(scrutinee, arms) => {
            let held = through_self(&*scrutinee, captured, bound);
            let mut out: Vec<ast::Arm> = Vec::new();
            let mut i: taddr = 0;
            while i < arms.len() {
                let mark = bound.len();
                let mut k: taddr = 0;
                while k < arms[i].patterns.len() {
                    bind_names(&arms[i].patterns[k], bound);
                    k += 1;
                }
                let mut guard: Option<ast::Expr> = Option::None;
                match &arms[i].guard {
                    Option::Some(g) => guard = Option::Some(through_self(g, captured, bound)),
                    Option::None => {}
                }
                out.push(ast::Arm {
                    patterns: copy_patterns_here(&arms[i].patterns),
                    guard: guard,
                    body: through_self(&arms[i].body, captured, bound),
                });
                forget_names(bound, mark);
                i += 1;
            }
            ast::Expr::Match(Box::new(held), out)
        }
        ast::Expr::Return(v) => ast::Expr::Return(through_option(v, captured, bound)),
        ast::Expr::Break(v) => ast::Expr::Break(through_option(v, captured, bound)),
        // A closure inside a closure captures from *its* enclosing one,
        // which is a question this does not ask yet: it is copied as it
        // stands and refused where it is used.
        _ => ast::copy_expr(x),
    }
}

fn through_all(
    items: &Vec<ast::Expr>,
    captured: &Vec<String>,
    bound: &mut Vec<String>,
) -> Vec<ast::Expr> {
    let mut out: Vec<ast::Expr> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        out.push(through_self(&items[i], captured, bound));
        i += 1;
    }
    out
}

fn through_option(
    v: &Option<Box<ast::Expr>>,
    captured: &Vec<String>,
    bound: &mut Vec<String>,
) -> Option<Box<ast::Expr>> {
    match v {
        Option::Some(x) => Option::Some(Box::new(through_self(&*x, captured, bound))),
        Option::None => Option::None,
    }
}

fn through_block(
    b: &ast::Block,
    captured: &Vec<String>,
    bound: &mut Vec<String>,
) -> ast::Block {
    let mark = bound.len();
    let mut stmts: Vec<ast::Stmt> = Vec::new();
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        match &b.stmts[i] {
            ast::Stmt::Let(mutable, name, written, v) => {
                let held = through_self(v, captured, bound);
                let mut ty: Option<ast::Ty> = Option::None;
                match written {
                    Option::Some(t) => ty = Option::Some(ast::copy_ty(t)),
                    Option::None => {}
                }
                bound.push(name.to_string());
                stmts.push(ast::Stmt::Let(mutable, name.to_string(), ty, held));
            }
            ast::Stmt::LetPattern(name, p, v) => {
                let made = through_self(v, captured, bound);
                bind_names(p, bound);
                stmts.push(ast::Stmt::LetPattern(
                    name.to_string(),
                    copy_pattern_here(p),
                    made,
                ));
            }
            ast::Stmt::Do(v) => stmts.push(ast::Stmt::Do(through_self(v, captured, bound))),
        }
        i += 1;
    }
    let tail = through_option(&b.tail, captured, bound);
    forget_names(bound, mark);
    ast::Block { stmts: stmts, tail: tail }
}

/// A pattern, copied. A rewrite of an expression still needs it, because a
/// pattern binds and does not read: there is nothing in one to rewrite.
fn copy_pattern_here(p: &ast::Pattern) -> ast::Pattern {
    match p {
        ast::Pattern::Wild => ast::Pattern::Wild,
        ast::Pattern::Bind(n) => ast::Pattern::Bind(n.to_string()),
        ast::Pattern::Int(v) => ast::Pattern::Int(v),
        ast::Pattern::Bool(b) => ast::Pattern::Bool(b),
        ast::Pattern::Tuple(items) => ast::Pattern::Tuple(copy_patterns_here(items)),
        ast::Pattern::Aggregate(path, fields) => {
            let mut out: Vec<ast::PatField> = Vec::new();
            let mut i: taddr = 0;
            while i < fields.len() {
                out.push(ast::PatField {
                    name: fields[i].name.to_string(),
                    pat: copy_pattern_here(&fields[i].pat),
                });
                i += 1;
            }
            ast::Pattern::Aggregate(path.to_string(), out)
        }
    }
}

fn copy_patterns_here(from: &Vec<ast::Pattern>) -> Vec<ast::Pattern> {
    let mut out: Vec<ast::Pattern> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(copy_pattern_here(&from[i]));
        i += 1;
    }
    out
}

/// Which closure to emit next: the one found most recently that has not
/// been emitted yet.
fn last_undone(closed: &Vec<Closed>, done: &Vec<String>) -> taddr {
    let mut i = closed.len();
    while i > 0 {
        i -= 1;
        if !holds_name(done, &closed[i].name) {
            return i as taddr;
        }
    }
    0 - 1
}

/// What the rest of a lowering has to know about a closure: that its type
/// is a type, and that its `call` is a function.
///
/// Said in one place because it is said in two — when the closure is found,
/// and when a *later* function is lowered and has to know about one found
/// earlier. Two copies would be two things to keep in step (G9.61).
fn note_closure(e: &mut Emit, c: &Closed) {
    let made = closure_def(c);
    if def_at(&e.defs, &made.name) < 0 {
        e.defs.push(made);
    }
    let mut full: String = Vec::new();
    full.push_str(&c.name);
    full.push_str(".call");
    if named_sig(&e.sigs, &full) >= 0 {
        return;
    }
    let mut answers = "?".to_string();
    match &c.ret {
        Option::Some(r) => answers = tir_ty(r),
        Option::None => {}
    }
    let mut all: String = Vec::new();
    all.push_str("ptr");
    let mut j: taddr = 0;
    while j < c.params.len() {
        all.push(',');
        let each = tir_ty(&c.params[j].ty);
        all.push_str(&each);
        j += 1;
    }
    e.sigs.push(Sig { name: full.to_string(), ret: answers });
    e.params.push(Sig { name: full, ret: all });
}

/// Which signature is called this, or −1.
fn named_sig(sigs: &Vec<Sig>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < sigs.len() {
        if sigs[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// A closure's *type*: a field per capture, each holding an address
/// (Ch. 4 §4.4). A closure that captures nothing is a type with no fields,
/// which is a tryte because storage is never nothing.
fn closure_def(c: &Closed) -> layout::Def {
    let mut fields: Vec<ast::Ty> = Vec::new();
    let mut names: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < c.captures.len() {
        names.push(c.captures[i].name.to_string());
        let held = ast::Ty::Name(one_name(&c.captures[i].ty));
        fields.push(ast::Ty::Ref(Box::new(held), false));
        i += 1;
    }
    layout::Def {
        name: c.name.to_string(),
        is_enum: false,
        linear: false,
        fields: fields,
        field_names: names,
        counts: Vec::new(),
        discriminants: Vec::new(),
    }
}

/// Which family of types is called this, or −1.
fn tyfamily_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.tyfams.len() {
        if e.tyfams[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The nominal type a written type denotes, making it if this is the first
/// place that asked — or nothing for a type that names none.
///
/// `Pair<t27>` is `Pair.t27`, one type, laid out from `Pair`'s fields read
/// with `t27` for `T`. The name is Ch. 6 §4's, the same one a
/// monomorphized function gets, and for the same reason: TIR admits a `.`
/// in an identifier and not a `<`.
fn nominal(e: &mut Emit, t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        // `Self` is the type the impl is written on, and inside an
        // instantiation that is the instantiation (Ch. 4 §1.2) — which is
        // what a `fn unwrap_or(self, …)` is given.
        ast::Ty::SelfTy => e.self_ty.to_string(),
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            let mut key: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = nominal(e, &args[i]);
                if each.len() == 0 {
                    return "".to_string();
                }
                key.push(each);
                i += 1;
            }
            instantiate(e, &head, &key)
        }
        // `(A, B)` is a definition of two fields under the names `0` and
        // `1`, made where the type is first named.
        ast::Ty::Tuple(args) => {
            let mut elems: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = nominal(e, &args[i]);
                if each.len() == 0 {
                    return "".to_string();
                }
                elems.push(each);
                i += 1;
            }
            tuple_def(e, &elems)
        }
        // `[T; N]` is a definition of N fields, made where it is first
        // named. A length written as a `const` is a *value* and not a thing
        // this can look up (Ch. 4 §2.4), so it is refused.
        ast::Ty::Array(held, len) => {
            let n = layout::written_length(len);
            if n < 0 {
                return "".to_string();
            }
            let inner = nominal(e, &*held);
            if inner.len() == 0 {
                return "".to_string();
            }
            array_def(e, &inner, n)
        }
        _ => "".to_string(),
    }
}

/// The definition an array type has, made if it is not there already.
///
/// `linear` because an array's layout is the one no `repr` may choose
/// (Ch. 2 §3): the elements in order, and the arithmetic indexing does is
/// the layout rather than a consequence of it.
fn array_def(e: &mut Emit, elem: &str, n: taddr) -> String {
    let full = array_name(elem, n);
    if def_at(&e.defs, &full) >= 0 {
        return full;
    }
    if n < 0 {
        return "".to_string();
    }
    let mut fields: Vec<ast::Ty> = Vec::new();
    let mut names: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < n {
        fields.push(ast::Ty::Name(one_name(elem)));
        let mut each: String = Vec::new();
        push_int(&mut each, i as t27);
        names.push(each);
        i += 1;
    }
    e.defs.push(layout::Def {
        name: full.to_string(),
        is_enum: false,
        linear: true,
        fields: fields,
        field_names: names,
        counts: Vec::new(),
        discriminants: Vec::new(),
    });
    full
}

/// The definition a tuple type has, made if it is not there already.
///
/// Not `linear`: a tuple is `repr(lang)` and there is no other kind (Ch. 2
/// §2), so its fields are permuted by alignment like any other product's —
/// and `.0` is a field name here, which is what makes positional access the
/// same code as any other field read.
fn tuple_def(e: &mut Emit, elems: &Vec<String>) -> String {
    if elems.len() == 0 {
        return "".to_string();
    }
    let full = tuple_name(elems);
    if def_at(&e.defs, &full) >= 0 {
        return full;
    }
    let mut fields: Vec<ast::Ty> = Vec::new();
    let mut names: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < elems.len() {
        if elems[i].len() == 0 {
            return "".to_string();
        }
        fields.push(ast::Ty::Name(one_name(&elems[i])));
        let mut each: String = Vec::new();
        push_int(&mut each, i as t27);
        names.push(each);
        i += 1;
    }
    e.defs.push(layout::Def {
        name: full.to_string(),
        is_enum: false,
        linear: false,
        fields: fields,
        field_names: names,
        counts: Vec::new(),
        discriminants: Vec::new(),
    });
    full
}

/// One member of a family of types, made if it is not there already, and
/// answered with the name it is known by — or nothing where there is no
/// such family, the key does not fit it, or it reaches itself.
fn instantiate(e: &mut Emit, head: &str, key: &Vec<String>) -> String {
    let full = mangled(head, key);
    if def_at(&e.defs, &full) >= 0 {
        return full;
    }
    let at = tyfamily_at(e, head);
    if at < 0 {
        return "".to_string();
    }
    if e.tyfams[at].tyvars.len() != key.len() || key.len() == 0 {
        return "".to_string();
    }
    // A type that reaches itself without an indirection has no size (Ch. 2
    // §8), and one that reaches itself *through* an indirection is a size
    // the reference already has — so neither needs reading twice.
    if holds_name(&e.making, &full) {
        return "".to_string();
    }
    e.making.push(full.to_string());
    let tyvars = ast::copy_names(&e.tyfams[at].tyvars);
    let source = copy_def(&e.tyfams[at].def);
    let mut fields: Vec<ast::Ty> = Vec::new();
    let mut i: taddr = 0;
    while i < source.fields.len() {
        fields.push(subst_ty(e, &tyvars, key, &source.fields[i]));
        i += 1;
    }
    let mut made = copy_def(&source);
    made.name = full.to_string();
    made.fields = fields;
    e.defs.push(made);
    e.instances.push(Inst {
        full: full.to_string(),
        base: head.to_string(),
        key: ast::copy_names(key),
    });
    full
}

/// Read every definition's fields once more, now that instantiating is
/// possible.
///
/// A field written `Pair<t27>` is the type `Pair.t27`, and Ch. 2 lays out a
/// type and not a family — so until this has run, a struct with a generic
/// field has no layout and every use of it is refused. It runs once per
/// function because that is where the table it needs lives.
fn settle(e: &mut Emit) {
    let mut out: Vec<layout::Def> = Vec::new();
    let none: Vec<String> = Vec::new();
    let empty: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < e.defs.len() {
        let source = copy_def(&e.defs[i]);
        let mut fields: Vec<ast::Ty> = Vec::new();
        let mut k: taddr = 0;
        while k < source.fields.len() {
            fields.push(subst_ty(e, &none, &empty, &source.fields[k]));
            k += 1;
        }
        let mut made = copy_def(&source);
        made.fields = fields;
        out.push(made);
        i += 1;
    }
    e.defs = out;
}

/// Which instantiation of a type this name is, or −1.
fn inst_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.instances.len() {
        if e.instances[i].full.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// A written type read under a key: a parameter stands for what the
/// instantiation put there, and an application becomes the one name its
/// member is known by (Ch. 4 §2.5).
///
/// A type it cannot make is left as it was written, which is a type the
/// layout engine says it does not lay out — so a use of it is refused
/// rather than laid out as something else.
fn subst_ty(
    e: &mut Emit,
    tyvars: &Vec<String>,
    key: &Vec<String>,
    t: &ast::Ty,
) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => {
            let written = joined(segments);
            let n = subst(tyvars, key, &written);
            ast::Ty::Name(one_name(&n))
        }
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            let mut inner: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = subst_ty(e, tyvars, key, &args[i]);
                let name = nominal(e, &each);
                if name.len() == 0 {
                    return ast::copy_ty(t);
                }
                inner.push(name);
                i += 1;
            }
            let full = instantiate(e, &head, &inner);
            if full.len() == 0 {
                return ast::copy_ty(t);
            }
            ast::Ty::Name(one_name(&full))
        }
        ast::Ty::Ref(held, m) => ast::Ty::Ref(Box::new(subst_ty(e, tyvars, key, held)), m),
        ast::Ty::Slice(held) => ast::Ty::Slice(Box::new(subst_ty(e, tyvars, key, held))),
        ast::Ty::Array(held, len) => {
            ast::Ty::Array(Box::new(subst_ty(e, tyvars, key, held)), len.to_string())
        }
        ast::Ty::Tuple(args) => {
            let mut out: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                out.push(subst_ty(e, tyvars, key, &args[i]));
                i += 1;
            }
            ast::Ty::Tuple(out)
        }
        ast::Ty::Unit => ast::Ty::Unit,
        ast::Ty::SelfTy => ast::Ty::SelfTy,
        // Nothing inside a closure type names a type parameter that this
        // reads: it is copied as it was written, and refused where it is
        // used.
        _ => ast::copy_ty(t),
    }
}



/// Which types have a destructor: the ones an `impl Drop` is written for
/// (Ch. 3 §1.4). A type containing one has a destructor too, and that is
/// not read here yet.
pub fn destructors(items: &Vec<ast::Item>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                match tr {
                    Option::Some(t) => {
                        let name = head_of(t);
                        if name.same("Drop") {
                            out.push(head_of(ty));
                        }
                    }
                    Option::None => {}
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// The parameter types of every function, as one comma-joined string each.
pub fn parameters(items: &Vec<ast::Item>) -> Vec<Sig> {
    let mut out: Vec<Sig> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                out.push(Sig {
                    name: f.name.to_string(),
                    ret: written_types(&f.params),
                });
            }
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut all: String = Vec::new();
                    let mut j: taddr = 0;
                    while j < fns[k].params.len() {
                        if j > 0 {
                            all.push(',');
                        }
                        let each = if fns[k].params[j].name.same("self") {
                            // A receiver is `ptr` where it is a reference,
                            // and the type it is *of* where the method
                            // takes it by value — which on a scalar is the
                            // difference between an address and a value.
                            if is_reference(&fns[k].params[j].ty) {
                                "ptr".to_string()
                            } else {
                                owner.to_string()
                            }
                        } else {
                            param_name(&fns[k].params[j].ty)
                        };
                        all.push_str(&each);
                        j += 1;
                    }
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    out.push(Sig { name: full, ret: all });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    let given = givens(items);
    let mut g: taddr = 0;
    while g < given.len() {
        let at = trait_at(items, &given[g].trait_name);
        match &items[at].what {
            ast::What::Trait(n, params, supers, assoc, tfns) => {
                let k = named_fn(tfns, &given[g].name);
                if k >= 0 {
                    out.push(Sig {
                        name: given_name(&given[g]),
                        ret: written_types(&tfns[k].params),
                    });
                }
            }
            _ => {}
        }
        g += 1;
    }
    // And what a *trait* promises, under the name a trait object has. A
    // call through a table names no function, and still has to know what
    // comes back and what goes in (Ch. 4 §3.3).
    let mut t: taddr = 0;
    while t < items.len() {
        match &items[t].what {
            ast::What::Trait(n, params, supers, assoc, fns) => {
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    let held = dyn_name(n);
                    full.push_str(&held);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    let all = written_types(&fns[k].params);
                    out.push(Sig { name: full, ret: all });
                    k += 1;
                }
            }
            _ => {}
        }
        t += 1;
    }
    out
}

/// The TIR name of each parameter's type, `,`-joined, with a receiver as
/// the address it is.
fn written_types(params: &Vec<ast::Param>) -> String {
    let mut all: String = Vec::new();
    let mut j: taddr = 0;
    while j < params.len() {
        if j > 0 {
            all.push(',');
        }
        let each = if params[j].name.same("self") {
            "ptr".to_string()
        } else {
            param_name(&params[j].ty)
        };
        all.push_str(&each);
        j += 1;
    }
    all
}

pub fn signatures(items: &Vec<ast::Item>) -> Vec<Sig> {
    let mut out: Vec<Sig> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                // A generic function is not one function: it is one per
                // instantiation (Ch. 4 §2.5), and none of them is named by
                // the name written here. Until this lowers them, a call to
                // one has no answer and says so.
                let ret = if f.generics.len() > 0 {
                    "?".to_string()
                } else {
                    written_answer(&f.ret)
                };
                out.push(Sig { name: f.name.to_string(), ret: ret });
            }
            // A method is reached through its receiver, so the receiver's
            // name is half of its own (Ch. 4 §1.2).
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    // A generic method is no more one function than a
                    // generic function is, and neither is any method of an
                    // impl with parameters of its own: the name written
                    // here is not the name a call to it uses.
                    let ret = if fns[k].generics.len() > 0 || !plain_impl(gs) {
                        "?".to_string()
                    } else {
                        written_answer(&fns[k].ret)
                    };
                    out.push(Sig { name: full, ret: ret });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    // And what a trait gave a type, under the type's name.
    let given = givens(items);
    let mut g: taddr = 0;
    while g < given.len() {
        let at = trait_at(items, &given[g].trait_name);
        match &items[at].what {
            ast::What::Trait(n, params, supers, assoc, tfns) => {
                let k = named_fn(tfns, &given[g].name);
                if k >= 0 {
                    let ret = if tfns[k].generics.len() > 0 {
                        "?".to_string()
                    } else {
                        written_answer(&tfns[k].ret)
                    };
                    out.push(Sig { name: given_name(&given[g]), ret: ret });
                }
            }
            _ => {}
        }
        g += 1;
    }
    // And what a *trait* promises, under the name a trait object has. A
    // call through a table names no function, and still has to know what
    // comes back and what goes in (Ch. 4 §3.3).
    let mut t: taddr = 0;
    while t < items.len() {
        match &items[t].what {
            ast::What::Trait(n, params, supers, assoc, fns) => {
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    let held = dyn_name(n);
                    full.push_str(&held);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    let ret = if fns[k].generics.len() > 0 {
                        "?".to_string()
                    } else {
                        written_answer(&fns[k].ret)
                    };
                    out.push(Sig { name: full, ret: ret });
                    k += 1;
                }
            }
            _ => {}
        }
        t += 1;
    }
    out
}

/// What the parameter at this position of that function is.
fn param_type(e: &Emit, name: &str, at: taddr) -> String {
    let mut i: taddr = 0;
    while i < e.params.len() {
        if e.params[i].name.same(name) {
            let parts = split_types(&e.params[i].ret);
            if at < parts.len() {
                return parts[at].to_string();
            }
            return "".to_string();
        }
        i += 1;
    }
    "".to_string()
}

/// The parameter types of a signature, which are kept as one string with
/// `,` between them so that a `Sig` needs no second list.
fn split_types(all: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut cur: String = Vec::new();
    let mut i: taddr = 0;
    while i < all.len() {
        if all[i] == ',' {
            out.push(cur);
            cur = Vec::new();
        } else {
            cur.push(all[i]);
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn call_type(e: &mut Emit, name: &str) -> String {
    let mut i: taddr = 0;
    while i < e.sigs.len() {
        if e.sigs[i].name.same(name) {
            let ret = e.sigs[i].ret.to_string();
            if ret.same("?") {
                e.stuck = true;
            }
            return ret;
        }
        i += 1;
    }
    e.stuck = true;
    "?".to_string()
}

/// What a name that reaches through a reference is *of*.
///
/// The referent where the name says so — `&P` says `P` — the impl's own
/// type where the name is a bare `ptr`, and itself where it is neither. It
/// is what `place` walks, and what anything working out a type without
/// emitting has to agree with.
fn pointee(e: &Emit, owner: &str) -> String {
    let points_at = referent_name(owner);
    if points_at.len() > 0 {
        return points_at;
    }
    if owner.same("ptr") {
        return e.self_ty.to_string();
    }
    owner.to_string()
}

/// The receiver a call is given, lowered where it was waiting.
///
/// A name was read when the type was; anything else is a place and is
/// walked now, after the storage an aggregate answer needs has been taken.
/// A receiver the method takes **by value** is then loaded out of wherever
/// it turned out to be (Ch. 3 §2.2).
fn receiver_at(
    e: &mut Emit,
    at: taddr,
    recv: &ast::Expr,
    held: &str,
    by_value: &str,
) -> String {
    let mut out = held.to_string();
    if at < 0 {
        let found = place(e, recv);
        if e.stuck {
            return out;
        }
        out = found.text;
    }
    if by_value.len() > 0 {
        return loaded(e, by_value, &out);
    }
    out
}

/// The value at an address, loaded, and the name it was given.
fn loaded(e: &mut Emit, ty: &str, from: &str) -> String {
    let held = fresh(e, "v");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&held);
    line.push_str(" = load ");
    let shown = tir_of(ty);
    line.push_str(&shown);
    line.push_str(" ");
    line.push_str(from);
    e.insts.push(line);
    held
}

fn unknown_value() -> Value {
    Value { text: "?".to_string(), ty: "?".to_string() }
}

/// Everything about a file that a lowering reads, gathered once.
pub fn context(items: &Vec<ast::Item>) -> Cx {
    Cx {
        closed: Vec::new(),
        sigs: signatures(items),
        params: parameters(items),
        defs: definitions(items),
        drops: destructors(items),
        families: families(items),
        tyfams: type_families(items),
        rets: returns(items),
    }
}

/// The generic functions of the file (Ch. 4 §2.5).
///
/// A function with a `const` parameter is left out: a key here is type
/// arguments and nothing else, and a family whose members are told apart by
/// a *value* would need a key that could say so. Leaving it out means every
/// call to one is refused, which is the honest answer until it can be said.
pub fn families(items: &Vec<ast::Item>) -> Vec<Family> {
    let mut out: Vec<Family> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                if is_family(f, 0) {
                    out.push(Family {
                        name: f.name.to_string(),
                        tyvars: all_tyvars(f),
                        from_self: 0,
                        params: written_params(f),
                        ret: name_head(&f.ret),
                    });
                }
            }
            // A generic *method* is a family too, under the name a call to
            // it uses (Ch. 4 §1.2) — and so is every method of an `impl`
            // with parameters of its own, because those are decided by the
            // receiver and the method is one function per instantiation of
            // it just the same.
            ast::What::Impl(gs, tr, ty, fns) => {
                let named = match tr {
                    Option::Some(t) => written_head(t),
                    Option::None => "".to_string(),
                };
                let outer = self_parameters(gs, ty);
                if !named.same("Drop") {
                    let owner = written_head(ty);
                    let mut k: taddr = 0;
                    while k < fns.len() {
                        if is_family(&fns[k], outer.len()) {
                            let mut full: String = Vec::new();
                            full.push_str(&owner);
                            full.push_str(".");
                            full.push_str(&fns[k].name);
                            let mut tyvars = ast::copy_names(&outer);
                            let own = all_tyvars(&fns[k]);
                            let mut g: taddr = 0;
                            while g < own.len() {
                                tyvars.push(own[g].to_string());
                                g += 1;
                            }
                            out.push(Family {
                                name: full,
                                tyvars: tyvars,
                                from_self: outer.len() as taddr,
                                params: written_params(&fns[k]),
                                ret: name_head(&fns[k].ret),
                            });
                        }
                        k += 1;
                    }
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// Whether an `impl`'s methods are functions this can emit at all.
///
/// An `impl` with parameters of its own is one impl per instantiation of the
/// type it is written on, and its methods are named after that
/// instantiation — `@Pair.size.t27`, not `@Pair.size` (Ch. 6 §4). Nothing
/// here instantiates a *type* yet, so those methods are left out rather than
/// emitted under a name no call uses.
pub fn plain_impl(gs: &Vec<ast::Generic>) -> bool {
    gs.len() == 0
}

/// The parameters an `impl`'s *self type* binds, in the order the receiver's
/// instantiation gives them — or none where the two are not written to
/// match.
///
/// `impl<T> Pair<T>` binds `T` to whatever the receiver's first argument
/// turned out to be, and that is only readable off the receiver where the
/// self type is the impl's parameters, in order, and nothing else.
/// `impl<A, B> Either<B, A>` is not, and its methods are left out rather
/// than instantiated at the wrong argument.
fn self_parameters(gs: &Vec<ast::Generic>, ty: &ast::Ty) -> Vec<String> {
    let none: Vec<String> = Vec::new();
    if gs.len() == 0 {
        return none;
    }
    let want = generic_names(gs);
    match ty {
        ast::Ty::App(segments, args) => {
            if args.len() != want.len() {
                return none;
            }
            let mut i: taddr = 0;
            while i < args.len() {
                let each = name_head(&args[i]);
                if !each.same(&want[i]) {
                    return none;
                }
                i += 1;
            }
            want
        }
        _ => none,
    }
}

/// Whether this function is a family: all of whose type parameters are
/// types, with a body to read again under a key, and with at least one
/// parameter to read it under — its own, or the receiver's.
fn is_family(f: &ast::Fn, outer: taddr) -> bool {
    if all_tyvars(f).len() + outer == 0 {
        return false;
    }
    let mut g: taddr = 0;
    while g < f.generics.len() {
        match &f.generics[g] {
            ast::Generic::Type(n, bounds) => {}
            ast::Generic::Const(n, ty) => return false,
        }
        g += 1;
    }
    match &f.body {
        Option::Some(b) => true,
        Option::None => false,
    }
}

/// The written head of each parameter's type, `,`-joined — without the
/// receiver, which is not something a call writes and so is not something
/// a call can infer from.
fn written_params(f: &ast::Fn) -> String {
    let mut all: String = Vec::new();
    let mut k: taddr = 0;
    let mut first = true;
    while k < f.params.len() {
        if !f.params[k].name.same("self") {
            if !first {
                all.push(',');
            }
            first = false;
            let held = param_written(f, k);
            let each = name_head(&held);
            all.push_str(&each);
        }
        k += 1;
    }
    all
}

/// The head of a written type, but only where the type *is* a name: a
/// `Vec<T>` and a `&T` are not their heads, and answering with one would be
/// answering a question that was not asked.
fn name_head(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        _ => "".to_string(),
    }
}

/// The type a parameter has once an anonymous one has a name.
///
/// `impl Fn(A) -> R` in argument position is a type parameter that was not
/// written (Ch. 4 §2.2, §4.1): naming it is the whole of the desugaring,
/// and it is what lets a closure argument monomorphize like any other.
fn param_written(f: &ast::Fn, at: taddr) -> ast::Ty {
    let mut n: taddr = 0;
    let mut i: taddr = 0;
    while i < f.params.len() {
        let anonymous = match &f.params[i].ty {
            ast::Ty::ImplFn(kind, args, ret) => true,
            _ => false,
        };
        if i == at {
            if anonymous {
                let mut name: String = Vec::new();
                name.push_str("#F");
                push_int(&mut name, n as t27);
                return ast::Ty::Name(one_name(&name));
            }
            return ast::copy_ty(&f.params[i].ty);
        }
        if anonymous {
            n += 1;
        }
        i += 1;
    }
    ast::Ty::Unit
}

/// The names of the parameters a function is read under: the ones it wrote,
/// and then one per `impl Fn` it takes.
pub fn all_tyvars(f: &ast::Fn) -> Vec<String> {
    let mut out = generic_names(&f.generics);
    let mut n: taddr = 0;
    let mut i: taddr = 0;
    while i < f.params.len() {
        match &f.params[i].ty {
            ast::Ty::ImplFn(kind, args, ret) => {
                let mut name: String = Vec::new();
                name.push_str("#F");
                push_int(&mut name, n as t27);
                out.push(name);
                n += 1;
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// The names a function's generic parameters were written with, in
/// declaration order.
pub fn generic_names(gs: &Vec<ast::Generic>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < gs.len() {
        match &gs[i] {
            ast::Generic::Type(n, bounds) => out.push(n.to_string()),
            ast::Generic::Const(n, ty) => out.push(n.to_string()),
        }
        i += 1;
    }
    out
}

/// Whether a name is a type this can instantiate at: one TIR spells, or one
/// the program defines and Ch. 2 has laid out.
fn known_type(e: &Emit, name: &str) -> bool {
    if !scalar_named(name).same("?") {
        return true;
    }
    def_at(&e.defs, name) >= 0
}

/// Which family is called this, or −1.
fn family_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.families.len() {
        if e.families[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// A call to a generic function: which instantiation it means, worked out
/// from what the arguments turned out to be (Ch. 4 §2.3), and queued if this
/// is the first call that means it.
fn generic_call(
    e: &mut Emit,
    fam: taddr,
    callee: &str,
    recv: &str,
    given: &Vec<String>,
    args: &Vec<ast::Expr>,
) -> Value {
    // A method's receiver is its first argument and is not written as one,
    // so it is not among the declared types and infers nothing — except
    // for the parameters it *is* the answer to, which arrive as `given`.
    let skip: taddr = if recv.len() > 0 { 1 } else { 0 };
    if given.len() != e.families[fam].from_self {
        e.stuck = true;
        return unknown_value();
    }
    let front = ast::copy_names(&e.families[fam].tyvars);
    let declared = split_types(&e.families[fam].params);
    if declared.len() != args.len() {
        e.stuck = true;
        return unknown_value();
    }
    let mut texts: Vec<String> = Vec::new();
    let mut kinds: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        // A parameter the receiver already decided is written for at that
        // type, so a literal there takes its width from it and not from
        // §5.2's default.
        let told = subst(&front, given, &declared[i]);
        let each = if told.same(&declared[i]) {
            param_type(e, callee, i + skip)
        } else {
            told
        };
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        kinds.push(v.ty);
        i += 1;
    }
    // The key: each type parameter, in declaration order, is whatever the
    // argument written where it was named turned out to be. A parameter
    // named nowhere is a parameter the arguments cannot say anything about,
    // and a key that is not a type TIR can spell is not one this emits.
    let mut key: Vec<String> = ast::copy_names(given);
    let mut t: taddr = key.len();
    while t < e.families[fam].tyvars.len() {
        let each = e.families[fam].tyvars[t].to_string();
        let mut found: String = Vec::new();
        let mut clash = false;
        let mut k: taddr = 0;
        while k < declared.len() {
            if declared[k].same(&each) {
                if found.len() == 0 {
                    found = kinds[k].to_string();
                } else if !found.same(&kinds[k]) {
                    // Two arguments written where one type parameter was
                    // named, and not the same type: no key is the right
                    // one, and Ch. 4 §2.3 is what refuses it.
                    clash = true;
                }
            }
            k += 1;
        }
        // A type argument TIR spells, or one the program defines: a
        // `sum<T: Area>(x: T)` is instantiated at `Sq` as much as at `t27`,
        // and what tells the two apart at the call is nothing — an
        // aggregate arrives as a pointer either way (TIR §3).
        if clash || !known_type(e, &found) {
            e.stuck = true;
            return unknown_value();
        }
        key.push(found);
        t += 1;
    }
    let ret = subst(&e.families[fam].tyvars, &key, &e.families[fam].ret);
    if scalar_named(&ret).same("?") {
        e.stuck = true;
        return unknown_value();
    }
    let full = mangled(callee, &key);
    queue(e, callee, &key);
    let name = fresh(e, "r");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&name);
    line.push_str(" = call @");
    line.push_str(&full);
    line.push_str("(");
    if recv.len() > 0 {
        line.push_str(recv);
    }
    let mut k: taddr = 0;
    while k < texts.len() {
        if k > 0 || recv.len() > 0 {
            line.push_str(", ");
        }
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(") -> ");
    let shown = tir_of(&ret);
    line.push_str(&shown);
    e.insts.push(line);
    Value { text: name, ty: ret }
}

/// A call to a closure: what it calls is the `call` of whatever type the
/// closure turned out to be, and the closure itself is its first argument
/// (Ch. 4 §4.2).
fn closure_call(e: &mut Emit, at: taddr, args: &Vec<ast::Expr>) -> Value {
    let owner = e.locals[at].ty.to_string();
    let slot = e.locals[at].slot.to_string();
    let mut full: String = Vec::new();
    full.push_str(&owner);
    full.push_str(".call");
    let none: Vec<String> = Vec::new();
    let fam = family_at(e, &full);
    if fam >= 0 {
        return generic_call(e, fam, &full, &slot, &none, args);
    }
    let big = returned_aggregate(e, &full);
    if big.len() > 0 {
        let into = slot_for(e, "tmp", &big);
        return aggregate_call(e, &full, &big, &into, &slot, args);
    }
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        let each = param_type(e, &full, i + 1);
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        i += 1;
    }
    let ty = call_type(e, &full);
    if e.stuck {
        return unknown_value();
    }
    let name = fresh(e, "r");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&name);
    line.push_str(" = call @");
    line.push_str(&full);
    line.push_str("(");
    line.push_str(&slot);
    let mut k: taddr = 0;
    while k < texts.len() {
        line.push_str(", ");
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(") -> ");
    let shown = tir_of(&ty);
    line.push_str(&shown);
    e.insts.push(line);
    Value { text: name, ty: ty }
}

/// A call that answers with an aggregate: the caller makes the storage, the
/// call is given it as its first argument, and the value *is* that storage
/// (TIR §3).
fn aggregate_call(
    e: &mut Emit,
    callee: &str,
    owner: &str,
    held: &str,
    recv: &str,
    args: &Vec<ast::Expr>,
) -> Value {
    let skip: taddr = if recv.len() > 0 { 1 } else { 0 };
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        let each = param_type(e, callee, i + skip);
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        i += 1;
    }
    let mut line: String = Vec::new();
    line.push_str("    call @");
    line.push_str(callee);
    line.push_str("(");
    // The storage first and the receiver after it: `%sret` is what the
    // function is for, and the receiver is its first ordinary argument.
    line.push_str(held);
    if recv.len() > 0 {
        line.push_str(", ");
        line.push_str(recv);
    }
    let mut k: taddr = 0;
    while k < texts.len() {
        line.push_str(", ");
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(")");
    e.insts.push(line);
    Value { text: held.to_string(), ty: owner.to_string() }
}

/// Ask for an instantiation, unless it has been asked for already. The list
/// is append-only for that reason: what makes the queue drain is that a key
/// is queued once and no second call can queue it again.
fn queue(e: &mut Emit, name: &str, key: &Vec<String>) {
    let full = mangled(name, key);
    let mut i: taddr = 0;
    while i < e.jobs.len() {
        let each = mangled(&e.jobs[i].name, &e.jobs[i].key);
        if each.same(&full) {
            return;
        }
        i += 1;
    }
    e.jobs.push(Job { name: name.to_string(), key: ast::copy_names(key) });
}

/// The jobs, copied. A `&mut Vec<Job>` is not a `Vec<Job>` and the emitter
/// holds its own, which it hands back the new part of when it is done.
fn copy_jobs(from: &Vec<Job>) -> Vec<Job> {
    let mut out: Vec<Job> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(Job {
            name: from[i].name.to_string(),
            key: ast::copy_names(&from[i].key),
        });
        i += 1;
    }
    out
}

/// Which queued instantiation to emit next: the one asked for most recently
/// that has not been emitted yet.
///
/// Most recently, not first: the queue is a stack, and a body that asks for
/// an instantiation of its own is emitted before whatever was waiting behind
/// it. Both implementations drain theirs that way, and the order is visible
/// in the text, so it is part of what agrees.
fn pending_at(jobs: &Vec<Job>, done: &Vec<String>) -> taddr {
    let mut i = jobs.len();
    while i > 0 {
        i -= 1;
        let full = mangled(&jobs[i].name, &jobs[i].key);
        if !holds_name(done, &full) {
            return i as taddr;
        }
    }
    0 - 1
}

/// Every function a file contains, in the order TIR prints them and cut
/// down to what `main` reaches.
///
/// One copy for a file and for a whole program both: a module is a list of
/// items whatever produced it (Ch. 6 §4), and two drivers that emitted it
/// twice would be two things to keep in step. `bootstrap/build.tr` not
/// pruning while `bootstrap/program.tr` did was exactly that.
pub fn module(items: &Vec<ast::Item>) -> Vec<Made> {
    let mut out: Vec<Made> = Vec::new();
    let mut work = Work {
        jobs: Vec::new(),
        closed: Vec::new(),
        strings: Vec::new(),
    };
    // Ordinary functions first, then the impls, then the instantiations of
    // Ch. 4 §2.5 — a call is what asks for one, so they are known last.
    let mut k: taddr = 0;
    while k < items.len() {
        match &items[k].what {
            ast::What::Function(f) => {
                let mut text: String = Vec::new();
                let mut cx = context(items);
                cx.closed = copy_closed(&work.closed);
                if function(
                    f, cx, "".to_string(), Vec::new(),
                    Vec::new(), &mut work, &mut text)
                {
                    out.push(Made { name: f.name.to_string(), text: text });
                }
            }
            _ => {}
        }
        k += 1;
    }
    // Each impl, and then what the *trait* gave it. A method the trait wrote
    // and the impl did not is a function of the type (Ch. 4 §1.7), and it
    // belongs beside the ones the impl did write: emitting every impl and
    // then every given puts `Sq.plus` after `Re.area`, which is the same
    // program in a different order — and the order is the text (G9.92).
    let given = givens(items);
    let mut d: taddr = 0;
    while d < items.len() {
        match &items[d].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let named = match tr {
                    Option::Some(t) => written_head(t),
                    Option::None => "".to_string(),
                };
                let mut m: taddr = 0;
                while m < fns.len() {
                    let mut text: String = Vec::new();
                    // `Drop` is the one impl whose method becomes a
                    // function named after the *type* and not after the
                    // method (Ch. 3 §1.4). An impl with parameters of its
                    // own has no method that is one function, so what is
                    // written here is none of them.
                    let made = if !plain_impl(gs) {
                        false
                    } else if named.same("Drop") {
                        destructor(&fns[m], &owner, context(items), &mut work, &mut text)
                    } else {
                        function(
                            &fns[m], context(items), owner.to_string(),
                            Vec::new(), Vec::new(), &mut work, &mut text)
                    };
                    if made {
                        let mut full: String = Vec::new();
                        if named.same("Drop") {
                            full.push_str("drop.");
                            full.push_str(&owner);
                        } else {
                            full.push_str(&owner);
                            full.push_str(".");
                            full.push_str(&fns[m].name);
                        }
                        out.push(Made { name: full, text: text });
                    }
                    m += 1;
                }
                let mut g: taddr = 0;
                while g < given.len() {
                    if !given[g].owner.same(&owner)
                        || !given[g].trait_name.same(&named)
                    {
                        g += 1;
                        continue;
                    }
                    let at = trait_at(items, &given[g].trait_name);
                    let mut text: String = Vec::new();
                    let mut made = false;
                    let mine = given[g].owner.to_string();
                    match &items[at].what {
                        ast::What::Trait(n, params, supers, assoc, tfns) => {
                            let k = named_fn(tfns, &given[g].name);
                            if k >= 0 {
                                made = function(
                                    &tfns[k], context(items), mine,
                                    Vec::new(), Vec::new(),
                                    &mut work, &mut text);
                            }
                        }
                        _ => {}
                    }
                    if made {
                        let full = given_name(&given[g]);
                        out.push(Made { name: full, text: text });
                    }
                    g += 1;
                }
            }
            _ => {}
        }
        d += 1;
    }

    // A closure's body is a function of its own, and it is emitted before
    // the instantiations because it is what one of them is instantiated
    // *at* (Ch. 4 §4.1).
    // The most recently found first, which is what a stack gives back and
    // what the other implementation drains — the same question G9.58 asked
    // about instantiations, and the same answer.
    let mut done: Vec<String> = Vec::new();
    loop {
        let c = last_undone(&work.closed, &done);
        if c < 0 {
            break;
        }
        let held = call_of(&work.closed[c]);
        done.push(work.closed[c].name.to_string());
        let mut text: String = Vec::new();
        let mut cx = context(items);
        cx.closed = copy_closed(&work.closed);
        if function(&held, cx, "".to_string(), Vec::new(), Vec::new(), &mut work, &mut text) {
            out.push(Made { name: held.name.to_string(), text: text });
        }
    }

    let extra = instantiations(items, &mut work);
    let mut z: taddr = 0;
    while z < extra.len() {
        out.push(Made {
            name: extra[z].name.to_string(),
            text: extra[z].text.to_string(),
        });
        z += 1;
    }

    // The tables the coercions asked for. Nothing recorded them while they
    // were lowered: a coercion writes `@vt.<Type>.<Trait>` and *that* is
    // the record, so they are read back out of the finished text in the
    // order they first appear — which is the order they were lowered,
    // because functions are emitted in source order. TIR prints globals
    // before functions, so they go to the front (Ch. 4 §3.3).
    let mut all = tables(items, &out);
    // And then the strings, which is the order TIR prints the two in. A
    // table is read back out of the finished text because its name says
    // which type and which trait; a string's does not, so this is the one
    // thing the emitters had to be asked to remember.
    let mut z: taddr = 0;
    while z < work.strings.len() {
        all.push(Made {
            name: string_symbol(z),
            text: one_string(&work.strings[z], z),
        });
        z += 1;
    }
    // And then the declarations, which is where TIR prints them: after
    // everything the module *defines* that is not code, and before the code
    // (TIR §1).
    let decls = declarations(items);
    let mut d: taddr = 0;
    while d < decls.len() {
        all.push(Made {
            name: decls[d].name.to_string(),
            text: decls[d].text.to_string(),
        });
        d += 1;
    }
    let mut t: taddr = 0;
    while t < out.len() {
        all.push(Made {
            name: out[t].name.to_string(),
            text: out[t].text.to_string(),
        });
        t += 1;
    }
    let out = all;

    let live = reachable(&out);
    let mut kept: Vec<Made> = Vec::new();
    let mut n: taddr = 0;
    while n < out.len() {
        if holds_name(&live, &out[n].name) {
            kept.push(Made {
                name: out[n].name.to_string(),
                text: out[n].text.to_string(),
            });
        }
        n += 1;
    }
    // A call to a function this did not emit is a program this did not
    // compile. Leaving out what has not been reached is only honest while
    // nothing *kept* needs it — and a closure whose body was refused is
    // exactly the case where something did (Ch. 4 §4.1).
    let mut i: taddr = 0;
    while i < kept.len() {
        let calls = callees(&kept[i].text);
        let mut c: taddr = 0;
        while c < calls.len() {
            if made_at(&kept, &calls[c]) < 0 {
                let none: Vec<Made> = Vec::new();
                return none;
            }
            c += 1;
        }
        i += 1;
    }
    kept
}

/// A function with no body, as TIR's declaration form: the header a
/// definition would print, and then nothing (TIR §1).
///
/// It is the whole of how this language reaches something it did not
/// compile — there is no `extern` and no linkage attribute, because a name
/// to call and what goes in the registers is all TIR needs to make the
/// call. What is on the other side is the target's business: a
/// memory-mapped character port (ISA §2.2), an allocator (Ch. 5 §2.1),
/// neither of them a thing TIR can name.
///
/// A parameter or an answer TIR has no name for is refused rather than
/// declared as something else, because a declaration is a promise about a
/// calling convention and a wrong one is not caught anywhere.
fn declaration(f: &ast::Fn) -> String {
    if f.generics.len() > 0 {
        return "".to_string();
    }
    let mut out: String = Vec::new();
    out.push_str("fn @");
    out.push_str(&f.name);
    out.push_str("(");
    let mut i: taddr = 0;
    while i < f.params.len() {
        if i > 0 {
            out.push_str(", ");
        }
        let ty = tir_ty(&f.params[i].ty);
        if ty.same("?") {
            return "".to_string();
        }
        out.push_str("%");
        out.push_str(&f.params[i].name);
        out.push_str(": ");
        let shown = tir_of(&ty);
        out.push_str(&shown);
        i += 1;
    }
    out.push_str(")");
    let answer = written_answer(&f.ret);
    if !answers_nothing(&answer) {
        if answer.same("?") {
            return "".to_string();
        }
        out.push_str(" -> ");
        let shown = tir_of(&answer);
        out.push_str(&shown);
    }
    out.push_str("\n");
    out
}

/// Every declaration the file makes, in the order they were written.
fn declarations(items: &Vec<ast::Item>) -> Vec<Made> {
    let mut out: Vec<Made> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                match &f.body {
                    Option::Some(b) => {}
                    Option::None => {
                        let text = declaration(f);
                        if text.len() > 0 {
                            out.push(Made {
                                name: f.name.to_string(),
                                text: text,
                            });
                        }
                    }
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// The tables the module needs, in the order they were first named.
///
/// A coercion asks for one by writing `@vt.<Type>.<Trait>`, so the finished
/// functions are the record of which were asked for — and reading it back
/// is what keeps `Cx` from having to carry a list nothing else wants
/// (Ch. 4 §3.3).
fn tables(items: &Vec<ast::Item>, made: &Vec<Made>) -> Vec<Made> {
    let mut names: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < made.len() {
        let used = callees(&made[i].text);
        let mut k: taddr = 0;
        while k < used.len() {
            if is_table(&used[k]) && !holds_name(&names, &used[k]) {
                names.push(used[k].to_string());
            }
            k += 1;
        }
        i += 1;
    }
    let defs = definitions(items);
    let drops = destructors(items);
    let mut out: Vec<Made> = Vec::new();
    let mut n: taddr = 0;
    while n < names.len() {
        let text = one_table(items, &defs, &drops, &names[n]);
        // A table this cannot build is left out, and the module is then
        // refused whole: something kept names it, and a name nothing
        // defines is not a program (docs/ddc.md §4).
        if text.len() > 0 {
            out.push(Made { name: names[n].to_string(), text: text });
        }
        n += 1;
    }
    out
}

/// Whether a name is a table's.
fn is_table(name: &str) -> bool {
    let head = "vt.";
    if name.len() <= head.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < head.len() {
        if name[i] != head[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// The type a table's name is for: everything between `vt.` and the last
/// `.`, since an instantiation's own name holds dots and the trait's does
/// not (Ch. 6 §4).
fn table_owner(symbol: &str) -> String {
    let mut cut: taddr = 0 - 1;
    let mut i: taddr = 0;
    while i < symbol.len() {
        if symbol[i] == '.' {
            cut = i;
        }
        i += 1;
    }
    let mut out: String = Vec::new();
    if cut < 3 {
        return out;
    }
    let mut k: taddr = 3;
    while k < cut {
        out.push(symbol[k]);
        k += 1;
    }
    out
}

/// The trait a table's name is of.
fn table_trait(symbol: &str) -> String {
    let mut cut: taddr = 0 - 1;
    let mut i: taddr = 0;
    while i < symbol.len() {
        if symbol[i] == '.' {
            cut = i;
        }
        i += 1;
    }
    let mut out: String = Vec::new();
    if cut < 3 {
        return out;
    }
    let mut k = cut + 1;
    while k < symbol.len() {
        out.push(symbol[k]);
        k += 1;
    }
    out
}

/// One table, as the global TIR prints it (Ch. 4 §3.3).
///
/// Three words — the type's size, its alignment, a slot for its destructor
/// — and then one address per method **in the trait's declaration order**,
/// provided bodies included. They are written as trytes, so a number is
/// itself and two zeros, and an address is the one item that is three.
///
/// `size` and `align` are there for a `Box<dyn Trait>` that has to free
/// what it points at, and adding a slot later would move every index — so
/// they are in the table before anything needs them.
fn one_table(
    items: &Vec<ast::Item>,
    defs: &Vec<layout::Def>,
    drops: &Vec<String>,
    symbol: &str,
) -> String {
    let owner = table_owner(symbol);
    let named = table_trait(symbol);
    if owner.len() == 0 || named.len() == 0 {
        return "".to_string();
    }
    let at = trait_at(items, &named);
    if at < 0 {
        return "".to_string();
    }
    let self_ty = ast::Ty::Name(one_name(&owner));
    let l = match layout::of(defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return "".to_string(),
    };
    // A word is three trytes and a tryte holds −9841 … +9841 (Ch. 1 §2),
    // so a size that does not fit the first of them is not `n, 0, 0`.
    if l.size > 9841 || l.align > 9841 {
        return "".to_string();
    }
    // The third word is the type's destructor, and a **zero** there is a
    // claim that it has none — which Ch. 3 §1.2 makes about what a type
    // *holds* and not only about what it wrote. What this can answer is
    // which types wrote an `impl Drop`, so anything it cannot see through
    // is refused rather than called destructor-less.
    if owns_drop(defs, drops, &owner, 0) {
        return "".to_string();
    }
    match &items[at].what {
        ast::What::Trait(n, params, supers, assoc, fns) => {
            // A supertrait's methods come first in a table (Ch. 4 §3.3) and
            // this does not read them, so a trait that has one is refused.
            if supers.len() > 0 {
                return "".to_string();
            }
            let mut k: taddr = 0;
            while k < fns.len() {
                // Ch. 4 §3.4: a method a trait object cannot call is a
                // method a table has no address to put.
                if fns[k].generics.len() > 0 {
                    return "".to_string();
                }
                if fns[k].params.len() == 0 {
                    return "".to_string();
                }
                if !fns[k].params[0].name.same("self") {
                    return "".to_string();
                }
                k += 1;
            }
            let mut out: String = Vec::new();
            out.push_str("global @");
            out.push_str(symbol);
            out.push_str(" : tryte[");
            push_int(&mut out, 9 + 3 * (fns.len() as t27));
            out.push_str("] = [");
            push_int(&mut out, l.size as t27);
            out.push_str(", 0, 0, ");
            push_int(&mut out, l.align as t27);
            out.push_str(", 0, 0, 0, 0, 0");
            let mut k: taddr = 0;
            while k < fns.len() {
                out.push_str(", addr @");
                out.push_str(&owner);
                out.push_str(".");
                out.push_str(&fns[k].name);
                k += 1;
            }
            out.push_str("]\n");
            out
        }
        _ => "".to_string(),
    }
}

/// Whether anything runs when a value of this type dies — or whether this
/// cannot say, which is the same answer to everyone who has to be sure.
///
/// Ch. 3 §1.2: a type owns a destructor when it wrote one or when it holds
/// something that did. A reference owns nothing; a scalar owns nothing; and
/// a field whose type has no name here is not answered for.
fn owns_drop(
    defs: &Vec<layout::Def>,
    drops: &Vec<String>,
    name: &str,
    depth: taddr,
) -> bool {
    if depth > 16 {
        return true;
    }
    if holds_name(drops, name) {
        return true;
    }
    let at = def_at(defs, name);
    if at < 0 {
        return scalar_named(name).same("?");
    }
    let mut i: taddr = 0;
    while i < defs[at].fields.len() {
        let held = field_tir(&defs[at].fields[i]);
        if !held.same("ptr") {
            let inner = name_head(&defs[at].fields[i]);
            if inner.len() == 0 {
                return true;
            }
            if owns_drop(defs, drops, &inner, depth + 1) {
                return true;
            }
        }
        i += 1;
    }
    false
}

/// Which functions a program contains: the ones `main` reaches, or all of
/// them where there is no `main` and every function is its own root.
///
/// A function nothing calls is a function the program does not contain, and
/// the two implementations have to agree about which those are — so this is
/// asked of one file the same way it is asked of a whole program.
pub fn reachable(made: &Vec<Made>) -> Vec<String> {
    let mut live: Vec<String> = Vec::new();
    let mut queue: Vec<String> = Vec::new();
    let mut has_main = false;
    let mut i: taddr = 0;
    while i < made.len() {
        if made[i].name.same("main") {
            has_main = true;
        }
        i += 1;
    }
    if has_main {
        queue.push("main".to_string());
    } else {
        let mut k: taddr = 0;
        while k < made.len() {
            queue.push(made[k].name.to_string());
            k += 1;
        }
    }
    loop {
        match queue.pop() {
            Option::Some(name) => {
                if !holds_name(&live, &name) {
                    let at = made_at(made, &name);
                    live.push(name);
                    if at >= 0 {
                        let calls = callees(&made[at].text);
                        let mut c: taddr = 0;
                        while c < calls.len() {
                            queue.push(calls[c].to_string());
                            c += 1;
                        }
                    }
                }
            }
            Option::None => return live,
        }
    }
}

/// Which emitted function is called that, or −1.
fn made_at(made: &Vec<Made>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < made.len() {
        if made[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Every `@name` a function's text mentions.
///
/// Read back out of what was written rather than collected while writing:
/// what a function needs is what its text says it needs, and a second list
/// would be a second thing to keep right.
///
/// Every `@` and not only a call's, because **a table is a use**: `@Re.twice`
/// is in the module because a vtable holds its address and not because
/// anything calls it (Ch. 4 §3.3), and a coercion names the table the same
/// silent way. A function's own header names itself, which is a use that
/// asks for nothing.
pub fn callees(text: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < text.len() {
        if text[i] != '@' {
            i += 1;
            continue;
        }
        let mut name: String = Vec::new();
        let mut j = i + 1;
        while j < text.len() && in_name(text[j]) {
            name.push(text[j]);
            j += 1;
        }
        if name.len() > 0 {
            out.push(name);
        }
        i = j;
    }
    out
}

/// Whether a character can be part of the name after an `@` (TIR §1).
fn in_name(c: char) -> bool {
    if c >= 'a' && c <= 'z' {
        return true;
    }
    if c >= 'A' && c <= 'Z' {
        return true;
    }
    if c >= '0' && c <= '9' {
        return true;
    }
    c == '.' || c == '_' || c == '#'
}

/// Every instantiation the queue asks for, drained: the members of each
/// family that this program contains (Ch. 4 §2.5).
///
/// It runs after the ordinary functions and the impls, because that is when
/// what a program asks for is known — a call is the only thing that asks.
pub fn instantiations(items: &Vec<ast::Item>, work: &mut Work) -> Vec<Made> {
    let mut made: Vec<Made> = Vec::new();
    let mut done: Vec<String> = Vec::new();
    loop {
        let at = pending_at(&work.jobs, &done);
        if at < 0 {
            return made;
        }
        let name = work.jobs[at].name.to_string();
        let key = ast::copy_names(&work.jobs[at].key);
        let full = mangled(&name, &key);
        done.push(full.to_string());
        let mut text: String = Vec::new();
        let mut ok = false;
        let mut i: taddr = 0;
        while i < items.len() {
            match &items[i].what {
                ast::What::Function(f) => {
                    if !ok && f.name.same(&name) && is_family(f, 0) {
                        let mut cx = context(items);
                        cx.closed = copy_closed(&work.closed);
                        ok = function(
                            f, cx, "".to_string(), Vec::new(),
                            ast::copy_names(&key), work, &mut text);
                    }
                }
                ast::What::Impl(gs, tr, ty, fns) => {
                    let outer = self_parameters(gs, ty);
                    let owner = if gs.len() == outer.len() {
                        written_head(ty)
                    } else {
                        "".to_string()
                    };
                    let mut k: taddr = 0;
                    while k < fns.len() {
                        let mut m: String = Vec::new();
                        m.push_str(&owner);
                        m.push_str(".");
                        m.push_str(&fns[k].name);
                        if !ok && m.same(&name) && is_family(&fns[k], outer.len()) {
                            let mut cx = context(items);
                            cx.closed = copy_closed(&work.closed);
                            ok = function(
                                &fns[k], cx, owner.to_string(),
                                ast::copy_names(&outer), ast::copy_names(&key),
                                work, &mut text);
                        }
                        k += 1;
                    }
                }
                _ => {}
            }
            i += 1;
        }
        if ok {
            made.push(Made { name: full, text: text });
        }
    }
}

/// `&&` and `||` do not evaluate the second side unless they must (§2.3):
/// the answer starts as the first side, and the second is reached only where
/// it can change it.
fn short_circuit(e: &mut Emit, op: &str, a: &ast::Expr, b: &ast::Expr) -> Value {
            let first = value(e, a, "t1");
            if e.stuck {
                return unknown_value();
            }
            let held = slot_for(e, "tmp", "t1");
            store_into(e, "t1", &first.text, &held);
            let rhs = label(e, "sc.rhs");
            let join = label(e, "sc.join");
            let short = label(e, "sc.short");
            let mut br: String = Vec::new();
            br.push_str("    br2 ");
            br.push_str(&first.text);
            br.push_str(", ");
            if op.same("&&") {
                br.push_str(&rhs);
                br.push_str(", ");
                br.push_str(&short);
            } else {
                br.push_str(&short);
                br.push_str(", ");
                br.push_str(&rhs);
            }
            e.insts.push(br);
            start(e, &short);
            jump(e, &join);
            start(e, &rhs);
            let second = value(e, b, "t1");
            if e.stuck {
                return unknown_value();
            }
            store_into(e, "t1", &second.text, &held);
            jump(e, &join);
            start(e, &join);
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load t1 ");
            line.push_str(&held);
            e.insts.push(line);
            return Value { text: name, ty: "bool".to_string() };
}

/// The TIR instruction for an operator, or `?` for one not lowered yet.
///
/// Ch. 1 §5: the trapping flavour is what a written `+` means, since an
/// overflow that wraps silently is the thing the chapter refuses.
/// What a comparison's trit means, as the three values `select3` picks
/// between: less, equal, greater (Ch. 1 §4). Empty for an operator that is
/// not a comparison.
fn choice(op: &str) -> Vec<char> {
    let mut out: Vec<char> = Vec::new();
    if op.same("<") {
        out.push('1');
        out.push('0');
        out.push('0');
    } else if op.same(">") {
        out.push('0');
        out.push('0');
        out.push('1');
    } else if op.same("==") {
        out.push('0');
        out.push('1');
        out.push('0');
    } else if op.same("!=") {
        out.push('1');
        out.push('0');
        out.push('1');
    } else if op.same("<=") {
        out.push('1');
        out.push('1');
        out.push('0');
    } else if op.same(">=") {
        out.push('0');
        out.push('1');
        out.push('1');
    }
    out
}

fn arith(op: &str) -> String {
    if op.same("+") {
        "add.trap".to_string()
    } else if op.same("-") {
        "sub.trap".to_string()
    } else if op.same("*") {
        "mul.trap".to_string()
    } else if op.same("/") {
        // Division rounds to nearest with ties away from zero and cannot
        // overflow, since `MIN == -MAX` (Ch. 1 §4): there is no flavour to
        // choose and nothing to trap on.
        "div".to_string()
    } else if op.same("%") {
        "rem".to_string()
    } else if op.same("<<") {
        "shl.trap".to_string()
    } else if op.same(">>") {
        // An exact division by a power of three, with no tie case, so it
        // needs no rounding fixup and cannot overflow either.
        "shr".to_string()
    } else {
        "?".to_string()
    }
}

fn joined(segments: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < segments.len() {
        if i > 0 {
            out.push_str("::");
        }
        out.push_str(&segments[i]);
        i += 1;
    }
    out
}

/// A number, written out. `/` and `%` are symmetric (Ch. 1 §4), so the
/// correction is written here as it is everywhere else.
fn push_int(out: &mut String, v: t27) {
    let mut n = v;
    if n < 0 {
        out.push('-');
        n = 0 - n;
    }
    if n == 0 {
        out.push('0');
        return;
    }
    let mut digits: Vec<char> = Vec::new();
    while n > 0 {
        let d = n % 10;
        let fixed = if d < 0 { d + 10 } else { d };
        digits.push(char::try_from(48 + fixed).unwrap());
        n = (n - fixed) / 10;
    }
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(digits[i]);
    }
}


