// TIR, in Trust: the module a program lowers to (TIR §1).
//
// The first slice of the compiler's *back* half, and the one that makes
// `stage1` exist (docs/ddc.md §4). It answers with the same canonical text
// `trustc build` prints — names included, `%v.3` and `%a.5` as much as the
// instructions, because equality is on the text and a comparison that
// normalized the names away could not see two implementations emitting
// different code.
//
// What it lowers so far: a function's parameters, a `let` of a scalar, the
// arithmetic of Ch. 1, a call, a `return`, and a tail. Not yet: control
// flow, comparisons, aggregates, and the drops Ch. 3 §1.4 puts at the end
// of a scope — in that order, which is the order the corpus grew.

use ast;
use ast::Ty;
use layout;

/// The signatures of the file, so a call knows what it answers with. Set
/// before any function is lowered, since a call may name one written later.
pub struct Sig {
    pub name: String,
    pub ret: String,
}

/// A generic function as it was written, so a call can work out which
/// instantiation it means (Ch. 4 §2.5).
///
/// What is written is not one function; it is a family, and what a program
/// contains is one member of it per distinct set of type arguments. Nothing
/// here is the family's body: a member is made by reading the same source
/// again under a key.
pub struct Family {
    pub name: String,
    /// Its type parameters, in declaration order — which is the order a key
    /// is in, and the only thing that makes a key readable back.
    pub tyvars: Vec<String>,
    /// How many of them the *receiver* decides. A method of an
    /// `impl<T> Pair<T>` is a family whose first parameter is not written
    /// anywhere a call can see: it is whatever the receiver turned out to
    /// be, so it is read off the receiver's own instantiation and the rest
    /// are inferred from the arguments as usual.
    pub from_self: taddr,
    /// The written head of each parameter's type, `,`-joined: a type
    /// parameter's own name wherever that is what was written.
    pub params: String,
    /// The written head of what it answers with.
    pub ret: String,
}

/// One instantiation waiting to be emitted: the family it comes from and
/// the type arguments, in declaration order (Ch. 4 §2.7).
pub struct Job {
    pub name: String,
    pub key: Vec<String>,
}

/// What a mangled name was made from.
///
/// `Holder.Pair.t27` cannot be read back into a head and its arguments —
/// the dots do not say where one stops — so what made it is remembered
/// rather than parsed. A method of a parameterized impl needs exactly that
/// reading: which instantiation its receiver is.
pub struct Inst {
    pub full: String,
    pub base: String,
    pub key: Vec<String>,
}

/// What a function answers with, as it was written.
///
/// `sigs` carries the name TIR gives an answer and has none for an
/// aggregate, because TIR does not answer with one — it is written into
/// storage the caller provides (TIR §3). So the caller needs the type
/// itself, to know how much storage that is.
pub struct RetTy {
    pub name: String,
    pub ty: ast::Ty,
}

/// A generic type as it was written (Ch. 4 §2.5).
///
/// A type with parameters is not a type; it is one type per instantiation,
/// and none of them is called what is written. Its fields still name its
/// parameters here, because what makes a member of the family is reading
/// them again under a key. A type written with no parameters is a family of
/// one and is its own member, which is what `definitions` takes out.
pub struct TyFamily {
    pub name: String,
    pub tyvars: Vec<String>,
    pub def: layout::Def,
}

/// One function that was emitted: the name TIR knows it by, and its text.
pub struct Made {
    pub name: String,
    pub text: String,
}

/// What a function is lowered against: everything about the file that is not
/// the function itself.
///
/// One value rather than five parameters, because they always travel
/// together and because a function is given at most eight things (Ch. 5).
pub struct Cx {
    pub sigs: Vec<Sig>,
    pub params: Vec<Sig>,
    pub defs: Vec<layout::Def>,
    pub drops: Vec<String>,
    pub families: Vec<Family>,
    pub tyfams: Vec<TyFamily>,
    pub rets: Vec<RetTy>,
}

/// One local: the name it was written with, its slot, and its type.
pub struct Slot {
    pub name: String,
    pub slot: String,
    pub ty: String,
}

/// One basic block: its label, and what runs in it (TIR §2).
pub struct Chunk {
    pub label: String,
    pub insts: Vec<String>,
}

/// A function being emitted.
///
/// Slots are kept apart from instructions because TIR prints them first,
/// whatever order they were made in — a slot is storage and storage has no
/// place in the order of what runs.
///
/// Finished blocks are kept in the order they were *finished*, which is not
/// the order they run in: a `while`'s body is lowered before its head, so
/// the body is printed first and jumped over. Both implementations have to
/// agree about that order, since equality is on the text.
pub struct Emit {
    pub slots: Vec<String>,
    pub insts: Vec<String>,
    pub label: String,
    pub blocks: Vec<Chunk>,
    pub locals: Vec<Slot>,
    /// One counter for slots and values both, which is what makes two
    /// implementations that agree about the order agree about the names.
    pub next: t27,
    /// Whether anything could not be lowered, in which case nothing is
    /// printed for this function rather than something wrong.
    pub stuck: bool,
    /// What every function in the file answers with: a call is the one
    /// thing a function cannot work out from itself.
    pub sigs: Vec<Sig>,
    /// Whether the block being lowered has already left, in which case
    /// nothing after it is reached and no `ret` is added at its end.
    pub done: bool,
    /// What the parameters of each function are, so an argument knows what
    /// width a literal written for it should be.
    pub params: Vec<Sig>,
    /// The nominal types the file defines, for the offsets Ch. 2 gives
    /// them. It is the same engine `bootstrap/sizes.tr` is held to.
    pub defs: Vec<layout::Def>,
    /// Which types have a destructor, by name (Ch. 3 §1.4).
    pub drops: Vec<String>,
    /// The locals this scope is responsible for dropping, innermost last.
    pub owned: Vec<Slot>,
    /// The type an `impl`'s `self` points at, for a field read through it.
    pub self_ty: String,
    /// The generic functions of the file, so a call to one can work out
    /// which instantiation it means (Ch. 4 §2.5).
    pub families: Vec<Family>,
    /// Every instantiation asked for so far, in the order it was first
    /// asked for. Append-only: a key that has been asked for once is never
    /// asked for again, which is what makes the queue drain.
    pub jobs: Vec<Job>,
    /// The type parameters of the function being emitted, and what this
    /// instantiation puts for them — so that a type written in the *body*
    /// is read under the key too, and not only the signature.
    pub tyvars: Vec<String>,
    pub key: Vec<String>,
    /// The generic types of the file. `defs` holds the members that have
    /// been asked for; this holds what the rest are made from.
    pub tyfams: Vec<TyFamily>,
    /// What each function answers with, as written, for the storage a
    /// caller has to provide when the answer is an aggregate.
    pub rets: Vec<RetTy>,
    /// Every instantiation of a type made so far, with what it was made
    /// from — the reading a mangled name cannot be parsed back into.
    pub instances: Vec<Inst>,
    /// The instantiations being made right now, so that a type reaching
    /// itself is refused rather than read for ever. Nothing is taken off
    /// it: by the time one finishes, its name is in `defs`, and that is
    /// what every later ask finds first.
    pub making: Vec<String>,
}

/// A value in TIR: either a name or a constant, as it is written.
pub struct Value {
    pub text: String,
    pub ty: String,
}

/// The name a written type has, which is what the emitter carries.
///
/// The *written* one, not TIR's: `trit` and `bool` are both one trit wide
/// and a monomorphization has to tell them apart — `id.trit` is not
/// `id.t1` (Ch. 6 §4). What TIR calls it is asked for where TIR is written,
/// by `tir_of`, so there is one truth and it is this one.
pub fn tir_ty(t: &ast::Ty) -> String {
    let none: Vec<String> = Vec::new();
    let empty: Vec<String> = Vec::new();
    tir_ty_at(&none, &empty, t)
}

/// The same, read under a key: a type parameter stands for whatever the
/// instantiation put there (Ch. 4 §2.5), and everything else is itself.
pub fn tir_ty_at(tyvars: &Vec<String>, key: &Vec<String>, t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => {
            let written = joined(segments);
            let n = subst(tyvars, key, &written);
            scalar_named(&n)
        }
        _ => "?".to_string(),
    }
}

/// A name TIR has a spelling for, or `?` for one it does not.
pub fn scalar_named(n: &str) -> String {
    if n.same("t9") || n.same("bool") || n.same("trit") || n.same("t27")
        || n.same("taddr") || n.same("char")
    {
        n.to_string()
    } else {
        "?".to_string()
    }
}

/// What a name stands for under a key: the type argument written for it
/// where it is a type parameter, and itself where it is not.
pub fn subst(tyvars: &Vec<String>, key: &Vec<String>, name: &str) -> String {
    let mut i: taddr = 0;
    while i < tyvars.len() && i < key.len() {
        if tyvars[i].same(name) {
            return key[i].to_string();
        }
        i += 1;
    }
    name.to_string()
}

/// The name an instantiation is known by: the family's, with its type
/// arguments after it, which is the same `.` `drop.Buffer` already uses
/// (Ch. 6 §4).
pub fn mangled(name: &str, key: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    out.push_str(name);
    let mut i: taddr = 0;
    while i < key.len() {
        out.push_str(".");
        out.push_str(&key[i]);
        i += 1;
    }
    out
}

/// What TIR calls a type of this name (§1). A `bool` and a `trit` are both
/// one trit wide, and `taddr` and `char` are words.
pub fn tir_of(name: &str) -> String {
    if name.same("t9") {
        "t9".to_string()
    } else if name.same("bool") || name.same("trit") {
        "t1".to_string()
    } else if name.same("t27") || name.same("taddr") || name.same("char") {
        "t27".to_string()
    } else {
        name.to_string()
    }
}

/// Whether a written type is a reference (Ch. 3 §2.1).
pub fn is_reference(t: &ast::Ty) -> bool {
    match t {
        ast::Ty::Ref(inner, m) => true,
        _ => false,
    }
}

/// How many trytes a TIR type takes (Ch. 2 §1).
pub fn trytes(ty: &str) -> t27 {
    if ty.same("t9") || ty.same("t1") {
        1
    } else {
        3
    }
}

/// A fresh label, `^<prefix>.<n>`, and the counter moves on.
fn label(e: &mut Emit, prefix: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("^");
    out.push_str(prefix);
    out.push_str(".");
    push_int(&mut out, e.next);
    e.next = e.next + 1;
    out
}

/// End the block being emitted and start another.
fn start(e: &mut Emit, name: &str) {
    let mut held: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < e.insts.len() {
        held.push(e.insts[i].to_string());
        i += 1;
    }
    e.blocks.push(Chunk { label: e.label.to_string(), insts: held });
    e.insts = Vec::new();
    let mut open: String = Vec::new();
    open.push_str(name);
    open.push_str(":");
    e.label = open;
    e.done = false;
}

/// `br ^somewhere`.
fn jump(e: &mut Emit, to: &str) {
    let mut line: String = Vec::new();
    line.push_str("    br ");
    line.push_str(to);
    e.insts.push(line);
    e.done = true;
}

/// A fresh name, `%<prefix>.<n>`, and the counter moves on.
fn fresh(e: &mut Emit, prefix: &str) -> String {
    let mut out: String = Vec::new();
    out.push_str("%");
    out.push_str(prefix);
    out.push_str(".");
    push_int(&mut out, e.next);
    e.next = e.next + 1;
    out
}

/// A slot for a local, made where the value that fills it is ready.
fn slot_for(e: &mut Emit, name: &str, ty: &str) -> String {
    let mut prefix: String = Vec::new();
    prefix.push_str(name);
    prefix.push_str(".slot");
    let slot = fresh(e, &prefix);
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    let wide = tir_of(ty);
    let size = sized(e, &wide);
    push_int(&mut line, size);
    line.push_str("]");
    e.slots.push(line);
    e.locals.push(Slot {
        name: name.to_string(),
        slot: slot.to_string(),
        ty: ty.to_string(),
    });
    slot
}

/// How many trytes storage of this type takes: Ch. 2's answer where the
/// type is one the program defines, and TIR's where it is a scalar.
fn sized(e: &Emit, ty: &str) -> t27 {
    let at = def_at(&e.defs, ty);
    if at < 0 {
        return trytes(ty);
    }
    let self_ty = ast::Ty::Name(one_name(ty));
    match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(l) => l.size as t27,
        Result::Err(why) => trytes(ty),
    }
}

/// Which local is called this, or −1.
fn local_at(e: &Emit, name: &str) -> taddr {
    let mut i = e.locals.len();
    while i > 0 {
        i -= 1;
        if e.locals[i].name.same(name) {
            return i as taddr;
        }
    }
    0 - 1
}

/// One function, as the text TIR prints it, or nothing when something in it
/// is not lowered yet.
pub fn function(
    f: &ast::Fn,
    cx: Cx,
    owner: String,
    outer: Vec<String>,
    key: Vec<String>,
    queued: &mut Vec<Job>,
    out: &mut String,
) -> bool {
    // A generic function is one function per instantiation and none of them
    // is the one that was written (Ch. 4 §2.5): emitting it as written would
    // be emitting a function no program calls under a name no call uses. A
    // *key* is what says this reading is an instantiation — the type
    // arguments, in declaration order — so what is refused here is a family
    // read without one, and a key that does not fit the family it is for.
    // The receiver's parameters come first: a method of an
    // `impl<T> Pair<T>` is read under `T` and then under its own.
    let mut tyvars = copy_names(&outer);
    let own = generic_names(&f.generics);
    let mut g: taddr = 0;
    while g < own.len() {
        tyvars.push(own[g].to_string());
        g += 1;
    }
    if tyvars.len() != key.len() {
        return false;
    }
    let mut e = Emit {
        slots: Vec::new(),
        insts: Vec::new(),
        locals: Vec::new(),
        next: 1,
        stuck: false,
        sigs: cx.sigs,
        done: false,
        params: cx.params,
        label: "^entry:".to_string(),
        blocks: Vec::new(),
        defs: cx.defs,
        drops: cx.drops,
        owned: Vec::new(),
        self_ty: owner.to_string(),
        families: cx.families,
        jobs: copy_jobs(queued),
        tyvars: copy_names(&tyvars),
        key: copy_names(&key),
        tyfams: cx.tyfams,
        rets: cx.rets,
        instances: Vec::new(),
        making: Vec::new(),
    };

    settle(&mut e);

    // What `self` points at is the receiver's *instantiation*, not the
    // family: `&self` in an `impl<T> Pair<T>` reads the fields of the
    // `Pair.t27` this one is for.
    if outer.len() > 0 {
        let mut mine: Vec<String> = Vec::new();
        let mut o: taddr = 0;
        while o < outer.len() {
            mine.push(key[o].to_string());
            o += 1;
        }
        let held = instantiate(&mut e, &owner, &mine);
        if held.len() == 0 {
            return false;
        }
        e.self_ty = held;
    }

    // A parameter arrives as a value and is given storage at once, so that
    // everything below reads it the same way a local is read.
    let mut header: String = Vec::new();
    header.push_str("fn @");
    if owner.len() > 0 {
        header.push_str(&owner);
        header.push_str(".");
    }
    header.push_str(&f.name);
    // An instantiation carries its type arguments in its name, which is the
    // whole of what tells `id.trit` from `id.t27` (Ch. 6 §4).
    let mut g: taddr = 0;
    while g < key.len() {
        header.push_str(".");
        header.push_str(&key[g]);
        g += 1;
    }
    header.push_str("(");
    // A function whose answer is an aggregate is given the storage for it,
    // because a value that big is not carried in a register (TIR §3).
    // An application is a type once it is instantiated (Ch. 4 §2.5), so
    // asking what the answer *is* is what makes `Pair<t27>` exist.
    let written = subst_ty(&mut e, &tyvars, &key, &f.ret);
    let answer = nominal(&mut e, &written);
    let sret = def_at(&e.defs, &answer) >= 0;
    if sret {
        header.push_str("%sret: ptr");
    }
    let mut i: taddr = 0;
    while i < f.params.len() {
        if i > 0 || sret {
            header.push_str(", ");
        }
        let ty = tir_ty_at(&tyvars, &key, &f.params[i].ty);
        let name = f.params[i].name.to_string();
        // `&self` is a reference and stays one: what a method is given is an
        // address, and reading through it is a load and then the field's own
        // (Ch. 3 §2.2). An aggregate *value* is copied in; an address is not.
        if name.same("self") && is_reference(&f.params[i].ty) {
            header.push_str("%self: ptr");
            let slot = slot_for(&mut e, "self", "ptr");
            let mut store: String = Vec::new();
            store.push_str("    store ptr %self, ");
            store.push_str(&slot);
            e.insts.push(store);
            i += 1;
            continue;
        }
        if ty.same("?") {
            // An aggregate arrives as a pointer and is copied into storage
            // of its own on entry, field by field: what a function is given
            // is the caller's and what it holds is its own (Ch. 3 §1.1).
            let written = subst_ty(&mut e, &tyvars, &key, &f.params[i].ty);
            let owner = nominal(&mut e, &written);
            let at = def_at(&e.defs, &owner);
            if at < 0 {
                return false;
            }
            header.push_str("%");
            header.push_str(&name);
            header.push_str(": ptr");
            let copied = copy_in(&mut e, &name, at);
            if !copied {
                return false;
            }
            i += 1;
            continue;
        }
        header.push_str("%");
        header.push_str(&name);
        header.push_str(": ");
        let shown = tir_of(&ty);
        header.push_str(&shown);
        let slot = slot_for(&mut e, &name, &ty);
        let mut store: String = Vec::new();
        store.push_str("    store ");
        let shown = tir_of(&ty);
        store.push_str(&shown);
        store.push_str(" %");
        store.push_str(&name);
        store.push_str(", ");
        store.push_str(&slot);
        e.insts.push(store);
        i += 1;
    }
    header.push_str(")");
    let ret = tir_ty_at(&tyvars, &key, &f.ret);
    let unit = match &f.ret {
        ast::Ty::Unit => true,
        _ => sret,
    };
    if !unit {
        if ret.same("?") {
            return false;
        }
        header.push_str(" -> ");
        let shown_ret = tir_of(&ret);
        header.push_str(&shown_ret);
    }
    header.push_str(" {");

    let body = match &f.body {
        Option::Some(b) => b,
        Option::None => return false,
    };
    if sret {
        aggregate_body(&mut e, body, &answer);
    } else {
        block(&mut e, body, &ret, unit);
    }
    if e.stuck {
        return false;
    }

    // What this function asked for, handed back to the queue the caller
    // drains. Only from here: a function that was not emitted is not in the
    // program, and what it would have asked for is not either.
    let mut q = queued.len();
    while q < e.jobs.len() {
        queued.push(Job {
            name: e.jobs[q].name.to_string(),
            key: copy_names(&e.jobs[q].key),
        });
        q += 1;
    }

    start(&mut e, "^");
    out.push_str(&header);
    out.push_str("\n");
    let mut n: taddr = 0;
    while n < e.blocks.len() {
        out.push_str(&e.blocks[n].label);
        out.push_str("\n");
        // Every slot of the function belongs to its entry block: storage is
        // named where it is declared and used wherever it is (TIR §2).
        if n == 0 {
            let mut k: taddr = 0;
            while k < e.slots.len() {
                out.push_str(&e.slots[k]);
                out.push_str("\n");
                k += 1;
            }
        }
        let mut j: taddr = 0;
        while j < e.blocks[n].insts.len() {
            out.push_str(&e.blocks[n].insts[j]);
            out.push_str("\n");
            j += 1;
        }
        n += 1;
    }
    out.push_str("}\n");
    true
}

/// Which field of that definition is called this, or −1. A struct's fields
/// are in declaration order and its `counts` are empty, which is what tells
/// one from an enum here.
fn field_at(e: &Emit, which: taddr, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.defs[which].field_names.len() {
        if e.defs[which].field_names[i].same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Which definition is called this, or −1.
fn def_at(defs: &Vec<layout::Def>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < defs.len() {
        if defs[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The head of a written type, or nothing for one that has no name.
pub fn written_head(t: &ast::Ty) -> String {
    head_of(t)
}

fn head_of(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        ast::Ty::App(segments, args) => joined(segments),
        _ => "".to_string(),
    }
}

/// `%p.N = offset %base, const t27 <at>` — or the base itself at zero,
/// since an offset of nothing is the thing itself.
fn offset_of(e: &mut Emit, base: &str, at: taddr) -> String {
    if at == 0 {
        return base.to_string();
    }
    let name = fresh(e, "p");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&name);
    line.push_str(" = offset ");
    line.push_str(base);
    line.push_str(", const t27 ");
    push_int(&mut line, at as t27);
    e.insts.push(line);
    name
}

/// Copy an aggregate parameter into storage of its own, field by field.
fn copy_in(e: &mut Emit, name: &str, at: taddr) -> bool {
    let self_ty = ast::Ty::Name(one_name(&e.defs[at].name));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    let mut slot: String = Vec::new();
    slot.push_str("%");
    slot.push_str(name);
    slot.push_str(".slot.");
    push_int(&mut slot, e.next);
    e.next = e.next + 1;
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    e.locals.push(Slot {
        name: name.to_string(),
        slot: slot.to_string(),
        ty: e.defs[at].name.to_string(),
    });

    let mut from: String = Vec::new();
    from.push_str("%");
    from.push_str(name);
    if e.defs[at].is_enum {
        // An enum has no one set of fields, so what is copied is its
        // storage: a word at a time, and a tryte for what is left.
        let mut at_off: taddr = 0;
        while at_off < l.size {
            let ty = if l.size - at_off >= 3 {
                "t27".to_string()
            } else {
                "t9".to_string()
            };
            // Read before the destination is named: an enum is copied as
            // storage and a struct field by field, and the two orders are
            // what they are.
            let src = offset_of(e, &from, at_off);
            let v = fresh(e, "v");
            let mut load: String = Vec::new();
            load.push_str("    ");
            load.push_str(&v);
            load.push_str(" = load ");
            let shown = tir_of(&ty);
            load.push_str(&shown);
            load.push_str(" ");
            load.push_str(&src);
            e.insts.push(load);
            let dst = offset_of(e, &slot, at_off);
            store_into(e, &ty, &v, &dst);
            let wide = tir_of(&ty);
            at_off = at_off + (trytes(&wide) as taddr);
        }
        return true;
    }
    let owner = e.defs[at].name.to_string();
    copy_fields(e, &from, &slot, &owner)
}

fn one_name(name: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    out.push(name.to_string());
    out
}

/// A body whose answer is an aggregate: it is written into the storage the
/// caller gave, and the function answers nothing.
fn aggregate_body(e: &mut Emit, b: &ast::Block, owner: &str) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], "");
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => {
            match x {
                // Built where it is wanted, rather than built and copied.
                ast::Expr::Aggregate(path, fields) => {
                    let made = aggregate_type(e, path, fields);
                    if made.len() == 0 {
                        e.stuck = true;
                        return;
                    }
                    fill(e, "%sret", &made, fields);
                }
                _ => {
                    let v = value(e, x, "");
                    if e.stuck {
                        return;
                    }
                    copy_between(e, &v.text, "%sret", owner);
                }
            }
            e.insts.push("    ret".to_string());
        }
        Option::None => {
            e.stuck = true;
        }
    }
}

/// Write an aggregate's fields into storage that is already there.
fn fill(e: &mut Emit, dest: &str, path: &str, fields: &Vec<ast::Field>) {
    let which = def_at(&e.defs, path);
    if which < 0 {
        e.stuck = true;
        return;
    }
    let self_ty = ast::Ty::Name(one_name(path));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => {
            e.stuck = true;
            return;
        }
    };
    let mut i: taddr = 0;
    while i < fields.len() {
        let index = field_at(e, which, &fields[i].name);
        if index < 0 {
            e.stuck = true;
            return;
        }
        // A field that is itself an aggregate has no value to store: it
        // is built where it can be and copied into place field by field.
        let held = name_head(&e.defs[which].fields[index]);
        if def_at(&e.defs, &held) >= 0 {
            let v = value(e, &fields[i].value, &held);
            if e.stuck {
                return;
            }
            let at = offset_of(e, dest, l.offsets[index]);
            if !copy_fields(e, &v.text, &at, &held) {
                e.stuck = true;
                return;
            }
            i += 1;
            continue;
        }
        let ty = tir_ty(&e.defs[which].fields[index]);
        // The value first, then where it goes: that order is what decides
        // the numbers, and the numbers are what the comparison is on.
        let v = value(e, &fields[i].value, &ty);
        if e.stuck {
            return;
        }
        let at = offset_of(e, dest, l.offsets[index]);
        store_into(e, &ty, &v.text, &at);
        i += 1;
    }
}

/// Copy one aggregate into another, field by field.
fn copy_between(e: &mut Emit, from: &str, to: &str, owner: &str) {
    if !copy_fields(e, from, to, owner) {
        e.stuck = true;
    }
}

/// One aggregate copied into another, field by field — and a field that is
/// itself an aggregate by *its* fields, which is the whole of what makes a
/// nested one work.
///
/// The offsets are taken from the pointer to the field and not recomputed
/// from the base, so `w.p.b` is `offset (offset %w, 3), 3`. That is one
/// instruction more than it needs to be and it is what the other
/// implementation emits, and equality is on the text.
fn copy_fields(e: &mut Emit, from: &str, to: &str, owner: &str) -> bool {
    let which = def_at(&e.defs, owner);
    if which < 0 {
        return false;
    }
    let self_ty = ast::Ty::Name(one_name(owner));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    let mut i: taddr = 0;
    while i < l.offsets.len() {
        let held = name_head(&e.defs[which].fields[i]);
        let inner = def_at(&e.defs, &held);
        let src = offset_of(e, from, l.offsets[i]);
        let dst = offset_of(e, to, l.offsets[i]);
        if inner >= 0 {
            if !copy_fields(e, &src, &dst, &held) {
                return false;
            }
            i += 1;
            continue;
        }
        let ty = tir_ty(&e.defs[which].fields[i]);
        if ty.same("?") {
            return false;
        }
        let v = fresh(e, "v");
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&v);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        store_into(e, &ty, &v, &dst);
        i += 1;
    }
    true
}

/// A block written as a branch's arm: its statements, then its value.
fn branch_block(e: &mut Emit, b: &ast::Block, want: &str) -> Value {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], want);
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => value(e, x, want),
        Option::None => {
            e.stuck = true;
            unknown_value()
        }
    }
}

/// Which variant an arm names, or −1.
fn arm_variant(e: &Emit, which: taddr, arm: &ast::Arm) -> taddr {
    if arm.patterns.len() != 1 {
        return 0 - 1;
    }
    let name = match &arm.patterns[0] {
        ast::Pattern::Aggregate(path, fields) => last_segment(path),
        _ => return 0 - 1,
    };
    let mut i: taddr = 0;
    while i < e.defs[which].field_names.len() {
        if e.defs[which].field_names[i].same(&name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The last segment of a written path: `K::A` names `A`.
fn last_segment(path: &str) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < path.len() {
        if path[i] == ':' && i + 1 < path.len() && path[i + 1] == ':' {
            out = Vec::new();
            i += 2;
        } else {
            out.push(path[i]);
            i += 1;
        }
    }
    out
}

/// What an arm's pattern binds: a copy of each payload field, in storage of
/// its own, which is what an arm's binding is when the scrutinee is a place
/// it does not own (Ch. 3 §1.3).
fn bind_payload(
    e: &mut Emit,
    which: taddr,
    index: taddr,
    base: &str,
    l: &layout::Layout,
    arm: &ast::Arm,
) {
    let fields = match &arm.patterns[0] {
        ast::Pattern::Aggregate(path, fs) => fs,
        _ => return,
    };
    // Where this variant's payload begins, and which of the definition's
    // flat field list it is.
    let mut first: taddr = 0;
    let mut v: taddr = 0;
    while v < index {
        first = first + e.defs[which].counts[v];
        v += 1;
    }
    let mut i: taddr = 0;
    while i < fields.len() {
        let name = match &fields[i].pat {
            ast::Pattern::Bind(n) => n.to_string(),
            _ => {
                e.stuck = true;
                return;
            }
        };
        let ty = tir_ty(&e.defs[which].fields[first + i]);
        if ty.same("?") {
            e.stuck = true;
            return;
        }
        let at = l.variant_offsets[index][i];
        let src = offset_of(e, base, at);
        let got = fresh(e, "v");
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&got);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        let slot = slot_for(e, &name, &ty);
        store_into(e, &ty, &got, &slot);
        i += 1;
    }
}

/// Forget the locals bound since a mark: an arm is a scope (Ch. 3 §1.4).
fn forget(e: &mut Emit, mark: taddr) {
    while e.locals.len() > mark {
        e.locals.pop();
    }
}

/// Call the destructor of everything this scope owns, innermost first.
fn drop_all(e: &mut Emit) {
    let mut i = e.owned.len();
    while i > 0 {
        i -= 1;
        let mut line: String = Vec::new();
        line.push_str("    call @drop.");
        line.push_str(&e.owned[i].ty);
        line.push_str("(");
        line.push_str(&e.owned[i].slot);
        line.push_str(")");
        e.insts.push(line);
    }
}

/// Whether a list holds this exact name.
fn holds_name(names: &Vec<String>, name: &str) -> bool {
    let mut i: taddr = 0;
    while i < names.len() {
        if names[i].same(name) {
            return true;
        }
        i += 1;
    }
    false
}

/// Give a name a different one, wherever it was written.
///
/// The only name a lowering ever changes its mind about: an aggregate is
/// built in a temporary and a binding adopts it, so what was `%agg.3`
/// becomes `%p.slot.8` in the slot that declares it and in every
/// instruction that touched it.
fn rename(e: &mut Emit, from: &str, to: &str) {
    let mut i: taddr = 0;
    while i < e.slots.len() {
        let fixed = replaced(&e.slots[i], from, to);
        e.slots[i] = fixed;
        i += 1;
    }
    let mut k: taddr = 0;
    while k < e.insts.len() {
        let fixed = replaced(&e.insts[k], from, to);
        e.insts[k] = fixed;
        k += 1;
    }
    let mut b: taddr = 0;
    while b < e.blocks.len() {
        let mut j: taddr = 0;
        while j < e.blocks[b].insts.len() {
            let fixed = replaced(&e.blocks[b].insts[j], from, to);
            e.blocks[b].insts[j] = fixed;
            j += 1;
        }
        b += 1;
    }
}

/// One string with every occurrence of another put differently.
fn replaced(line: &str, from: &str, to: &str) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < line.len() {
        if at_here(line, i, from) {
            out.push_str(to);
            i += from.len();
        } else {
            out.push(line[i]);
            i += 1;
        }
    }
    out
}

/// Whether `what` is written at this position.
fn at_here(line: &str, at: taddr, what: &str) -> bool {
    if at + what.len() > line.len() {
        return false;
    }
    let mut i: taddr = 0;
    while i < what.len() {
        if line[at + i] != what[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// `store TY value, slot`.
fn store_into(e: &mut Emit, ty: &str, what: &str, where_: &str) {
    let mut line: String = Vec::new();
    line.push_str("    store ");
    let shown = tir_of(ty);
    line.push_str(&shown);
    line.push_str(" ");
    line.push_str(what);
    line.push_str(", ");
    line.push_str(where_);
    e.insts.push(line);
}

/// `impl Drop for T` — the destructor, which is a function named after the
/// type it is written on (Ch. 3 §1.4).
///
/// Its `self` is owned, so it takes the flag an owned local takes, and it
/// takes it *before* the value arrives: what the flag says is whether the
/// fields are still there, and they are from the moment the function is
/// entered.
pub fn destructor(
    f: &ast::Fn,
    owner: &str,
    cx: Cx,
    out: &mut String,
) -> bool {
    let mut e = Emit {
        slots: Vec::new(),
        insts: Vec::new(),
        locals: Vec::new(),
        next: 1,
        stuck: false,
        sigs: cx.sigs,
        done: false,
        params: cx.params,
        label: "^entry:".to_string(),
        blocks: Vec::new(),
        defs: cx.defs,
        drops: cx.drops,
        owned: Vec::new(),
        self_ty: owner.to_string(),
        // A destructor is reached by dropping and not by calling, so no
        // instantiation can be asked for from here: a generic call inside
        // one is refused rather than emitted under a name nothing queued.
        families: Vec::new(),
        jobs: Vec::new(),
        tyvars: Vec::new(),
        key: Vec::new(),
        tyfams: cx.tyfams,
        rets: cx.rets,
        instances: Vec::new(),
        making: Vec::new(),
    };
    settle(&mut e);
    let at = def_at(&e.defs, owner);
    if at < 0 {
        return false;
    }
    let self_ty = ast::Ty::Name(one_name(owner));
    let l = match layout::of(&e.defs, &self_ty, 0) {
        Result::Ok(x) => x,
        Result::Err(why) => return false,
    };
    let mut slot: String = Vec::new();
    slot.push_str("%self.slot.");
    push_int(&mut slot, e.next);
    e.next = e.next + 1;
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&slot);
    line.push_str(" = slot tryte[");
    push_int(&mut line, l.size as t27);
    line.push_str("]");
    e.slots.push(line);
    let flag = fresh(&mut e, "self.owns");
    let mut held: String = Vec::new();
    held.push_str("    ");
    held.push_str(&flag);
    held.push_str(" = slot tryte[1]");
    e.slots.push(held);
    store_into(&mut e, "t1", "const t1 1", &flag);
    e.locals.push(Slot {
        name: "self".to_string(),
        slot: slot.to_string(),
        ty: owner.to_string(),
    });
    let mut i: taddr = 0;
    while i < l.offsets.len() {
        let ty = tir_ty(&e.defs[at].fields[i]);
        if ty.same("?") {
            return false;
        }
        let src = offset_of(&mut e, "%self", l.offsets[i]);
        let dst = offset_of(&mut e, &slot, l.offsets[i]);
        let v = fresh(&mut e, "v");
        let mut load: String = Vec::new();
        load.push_str("    ");
        load.push_str(&v);
        load.push_str(" = load ");
        let shown = tir_of(&ty);
        load.push_str(&shown);
        load.push_str(" ");
        load.push_str(&src);
        e.insts.push(load);
        store_into(&mut e, &ty, &v, &dst);
        i += 1;
    }

    let body = match &f.body {
        Option::Some(b) => b,
        Option::None => return false,
    };
    let mut k: taddr = 0;
    while k < body.stmts.len() {
        stmt(&mut e, &body.stmts[k], "");
        k += 1;
    }
    match &body.tail {
        Option::Some(x) => return false,
        Option::None => {}
    }
    e.insts.push("    ret".to_string());
    if e.stuck {
        return false;
    }

    start(&mut e, "^");
    out.push_str("fn @drop.");
    out.push_str(owner);
    out.push_str("(%self: ptr) {\n");
    let mut n: taddr = 0;
    while n < e.blocks.len() {
        out.push_str(&e.blocks[n].label);
        out.push_str("\n");
        if n == 0 {
            let mut j: taddr = 0;
            while j < e.slots.len() {
                out.push_str(&e.slots[j]);
                out.push_str("\n");
                j += 1;
            }
        }
        let mut m: taddr = 0;
        while m < e.blocks[n].insts.len() {
            out.push_str(&e.blocks[n].insts[m]);
            out.push_str("\n");
            m += 1;
        }
        n += 1;
    }
    out.push_str("}\n");
    true
}

/// A function's body: its statements, then what it answers with.
fn block(e: &mut Emit, b: &ast::Block, ret: &str, unit: bool) {
    let mut i: taddr = 0;
    while i < b.stmts.len() {
        stmt(e, &b.stmts[i], ret);
        i += 1;
    }
    match &b.tail {
        Option::Some(x) => {
            let v = value(e, x, ret);
            if e.stuck {
                return;
            }
            // The value first and the drops after it: what is answered is
            // read while it is still there (Ch. 3 §1.4).
            drop_all(e);
            let mut line: String = Vec::new();
            line.push_str("    ret ");
            line.push_str(&v.text);
            e.insts.push(line);
        }
        Option::None => {
            // A block that already left does not leave twice.
            if !e.done {
                e.insts.push("    ret".to_string());
            }
        }
    }
}

fn stmt(e: &mut Emit, s: &ast::Stmt, ret: &str) {
    match s {
        ast::Stmt::Let(mutable, name, written, v) => {
            let hint = match written {
                Option::Some(t) => tir_ty_at(&e.tyvars, &e.key, t),
                Option::None => "".to_string(),
            };
            let val = value(e, v, &hint);
            if e.stuck {
                return;
            }
            // The slot is made *after* the value is ready, which is what
            // decides the number it gets.
            let ty = match written {
                Option::Some(t) => tir_ty_at(&e.tyvars, &e.key, t),
                Option::None => val.ty.to_string(),
            };
            if ty.same("?") {
                e.stuck = true;
                return;
            }
            let which = def_at(&e.defs, &val.ty);
            if which >= 0 {
                let owns = holds_name(&e.drops, &val.ty);
                // The temporary *is* the binding's storage: it was made for
                // this value and nothing else names it, so it is renamed
                // rather than copied out of.
                let mut prefix: String = Vec::new();
                prefix.push_str(name);
                prefix.push_str(".slot");
                let slot = fresh(e, &prefix);
                rename(e, &val.text, &slot);
                let kept = slot.to_string();
                e.locals.push(Slot {
                    name: name.to_string(),
                    slot: slot,
                    ty: val.ty.to_string(),
                });
                // A local whose type has a destructor is dropped when its
                // scope ends unless it was moved out of, and a flag is what
                // says which — a branch may decide (Ch. 3 §1.4).
                if owns {
                    let mut prefix: String = Vec::new();
                    prefix.push_str(name);
                    prefix.push_str(".owns");
                    let flag = fresh(e, &prefix);
                    let mut line: String = Vec::new();
                    line.push_str("    ");
                    line.push_str(&flag);
                    line.push_str(" = slot tryte[1]");
                    e.slots.push(line);
                    store_into(e, "t1", "const t1 1", &flag);
                    e.owned.push(Slot {
                        name: name.to_string(),
                        slot: kept,
                        ty: val.ty.to_string(),
                    });
                }
                return;
            }
            let slot = slot_for(e, name, &ty);
            let mut line: String = Vec::new();
            line.push_str("    store ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&val.text);
            line.push_str(", ");
            line.push_str(&slot);
            e.insts.push(line);
        }
        ast::Stmt::Do(x) => {
            match x {
                // `while c { … }` — the body is lowered first and the head
                // after it, so the head is the block jumped *back* to and
                // the body is printed before it (§5.3).
                ast::Expr::While(c, b) => {
                    let head = label(e, "while");
                    let body = label(e, "body");
                    let done = label(e, "done");
                    jump(e, &head);
                    start(e, &body);
                    let mut i: taddr = 0;
                    while i < b.stmts.len() {
                        stmt(e, &b.stmts[i], ret);
                        i += 1;
                    }
                    jump(e, &head);
                    start(e, &head);
                    let cond = value(e, c, "t1");
                    if e.stuck {
                        return;
                    }
                    let mut br: String = Vec::new();
                    br.push_str("    br2 ");
                    br.push_str(&cond.text);
                    br.push_str(", ");
                    br.push_str(&body);
                    br.push_str(", ");
                    br.push_str(&done);
                    e.insts.push(br);
                    start(e, &done);
                }
                // `return e;` as a statement is the whole of what follows.
                ast::Expr::Return(v) => {
                    match v {
                        Option::Some(inner) => {
                            let val = value(e, inner, ret);
                            if e.stuck {
                                return;
                            }
                            let mut line: String = Vec::new();
                            line.push_str("    ret ");
                            line.push_str(&val.text);
                            e.insts.push(line);
                            e.done = true;
                        }
                        Option::None => {
                            e.insts.push("    ret".to_string());
                            e.done = true;
                        }
                    }
                }
                _ => {
                    let v = value(e, x, "");
                    let _ = v;
                }
            }
        }
        _ => {
            e.stuck = true;
        }
    }
}

/// What an expression is, as a TIR value.
fn value(e: &mut Emit, x: &ast::Expr, want: &str) -> Value {
    match x {
        // A literal takes its width from what is around it (Ch. 0 §5.2),
        // and is a word where nothing says.
        ast::Expr::Int(v) => {
            let ty = if want.len() > 0 && !want.same("?") {
                want.to_string()
            } else {
                "t27".to_string()
            };
            let mut out: String = Vec::new();
            out.push_str("const ");
            let shown = tir_of(&ty);
            out.push_str(&shown);
            out.push_str(" ");
            push_int(&mut out, v);
            Value { text: out, ty: ty }
        }
        ast::Expr::Bool(b) => {
            let mut out: String = Vec::new();
            out.push_str("const t1 ");
            if b {
                out.push_str("1");
            } else {
                out.push_str("0");
            }
            Value { text: out, ty: "bool".to_string() }
        }
        ast::Expr::Trit(v) => {
            let mut out: String = Vec::new();
            out.push_str("const t1 ");
            push_int(&mut out, v);
            Value { text: out, ty: "trit".to_string() }
        }
        ast::Expr::Char(v) => {
            let mut out: String = Vec::new();
            out.push_str("const t27 ");
            push_int(&mut out, v);
            Value { text: out, ty: "char".to_string() }
        }
        ast::Expr::Group(inner) => value(e, inner, want),
        // `e as T` — narrower is a `trunc` and wider is a `widen`; the same
        // width is no instruction at all (§2.6).
        ast::Expr::Cast(a, t) => {
            let to = tir_ty_at(&e.tyvars, &e.key, t);
            if to.same("?") {
                e.stuck = true;
                return unknown_value();
            }
            let from = value(e, a, "");
            if e.stuck {
                return unknown_value();
            }
            // A cast between two names TIR spells the same way is no
            // instruction at all: `t27 as taddr` is a word either way.
            let to_wide = tir_of(&to);
            let from_wide = tir_of(&from.ty);
            if to_wide.same(&from_wide) {
                return Value { text: from.text, ty: to };
            }
            let word = if trytes(&to_wide) < trytes(&from_wide) {
                "trunc".to_string()
            } else {
                "widen".to_string()
            };
            let prefix = if word.same("trunc") {
                "t".to_string()
            } else {
                "w".to_string()
            };
            let name = fresh(e, &prefix);
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = ");
            line.push_str(&word);
            line.push_str(" ");
            let shown_from = tir_of(&from.ty);
            line.push_str(&shown_from);
            line.push_str(" ");
            line.push_str(&from.text);
            line.push_str(" -> ");
            line.push_str(&to_wide);
            e.insts.push(line);
            Value { text: name, ty: to }
        }
        // `!b` is `1 - b` at one trit wide, and wrapping because there is
        // nothing for it to overflow (Ch. 1 §6).
        ast::Expr::Unary(op, a) => {
            if !op.same("!") {
                e.stuck = true;
                return unknown_value();
            }
            let inner = value(e, a, "t1");
            if e.stuck {
                return unknown_value();
            }
            let name = fresh(e, "n");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = sub.wrap t1 const t1 1, ");
            line.push_str(&inner.text);
            e.insts.push(line);
            Value { text: name, ty: "bool".to_string() }
        }
        // `!b` is `1 - b` at one trit wide, and wrapping because there is
        // nothing for it to overflow (Ch. 1 §6).
        ast::Expr::Unary(op, a) => {
            if !op.same("!") {
                e.stuck = true;
                return unknown_value();
            }
            let inner = value(e, a, "t1");
            if e.stuck {
                return unknown_value();
            }
            let name = fresh(e, "n");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = sub.wrap t1 const t1 1, ");
            line.push_str(&inner.text);
            e.insts.push(line);
            Value { text: name, ty: "bool".to_string() }
        }
        ast::Expr::Name(n) => {
            let at = local_at(e, n);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let ty = e.locals[at].ty.to_string();
            let slot = e.locals[at].slot.to_string();
            // An aggregate's value *is* its storage: it is too big to carry
            // and there is nothing to load it into (TIR §3).
            if def_at(&e.defs, &ty) >= 0 {
                return Value { text: slot, ty: ty };
            }
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&slot);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        ast::Expr::Binary(op, a, b) => {
            if op.same("&&") || op.same("||") {
                return short_circuit(e, op, a, b);
            }
            let left = value(e, a, want);
            let right = value(e, b, &left.ty);
            if e.stuck {
                return unknown_value();
            }
            // A comparison is one `cmp`, which answers a trit, and then a
            // choice of what that trit means (Ch. 1 §4). `<=>` *is* the
            // trit and needs no choosing, which is the whole point of
            // having a three-way comparison at all.
            let arms = choice(op);
            if arms.len() > 0 || op.same("<=>") {
                let ty = left.ty.to_string();
                // `cmp` compares *scalars*. On a type the program defines,
                // `==` is a call to what `derive(Eq)` wrote (Ch. 4 §6), and
                // a `cmp` on two addresses would be comparing the addresses
                // — which is Ch. 3 §2.3's refusal, silently taken.
                if def_at(&e.defs, &ty) >= 0 {
                    e.stuck = true;
                    return unknown_value();
                }
                let c = fresh(e, "c");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&c);
                line.push_str(" = cmp ");
                let shown = tir_of(&ty);
                line.push_str(&shown);
                line.push_str(" ");
                line.push_str(&left.text);
                line.push_str(", ");
                line.push_str(&right.text);
                e.insts.push(line);
                if op.same("<=>") {
                    return Value { text: c, ty: "trit".to_string() };
                }
                let b = fresh(e, "b");
                let mut pick: String = Vec::new();
                pick.push_str("    ");
                pick.push_str(&b);
                pick.push_str(" = select3 ");
                pick.push_str(&c);
                pick.push_str(", t1 const t1 ");
                pick.push(arms[0]);
                pick.push_str(", const t1 ");
                pick.push(arms[1]);
                pick.push_str(", const t1 ");
                pick.push(arms[2]);
                e.insts.push(pick);
                return Value { text: b, ty: "bool".to_string() };
            }
            let word = arith(op);
            if word.same("?") {
                e.stuck = true;
                return unknown_value();
            }
            let ty = left.ty.to_string();
            let name = fresh(e, "a");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = ");
            line.push_str(&word);
            line.push_str(" ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&left.text);
            line.push_str(", ");
            line.push_str(&right.text);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        // `if c { … } else { … }` — the condition, a two-way branch, and a
        // slot the two arms agree to leave the answer in (§5.3).
        // A block written as an expression is its statements and then its
        // value (§5.1) — which is what an `else` arm is.
        ast::Expr::Nested(b) => branch_block(e, b, want),
        ast::Expr::If(c, t, o) => {
            let cond = value(e, c, "t1");
            if e.stuck {
                return unknown_value();
            }
            let then_at = label(e, "then");
            let else_at = label(e, "else");
            let join_at = label(e, "join");
            let mut br: String = Vec::new();
            br.push_str("    br2 ");
            br.push_str(&cond.text);
            br.push_str(", ");
            br.push_str(&then_at);
            br.push_str(", ");
            br.push_str(&else_at);
            e.insts.push(br);

            start(e, &then_at);
            let a = branch_block(e, t, want);
            if e.stuck {
                return unknown_value();
            }
            let ty = a.ty.to_string();
            // The slot is made where the first arm has its answer ready,
            // which is what decides the number it gets.
            let held = slot_for(e, "tmp", &ty);
            store_into(e, &ty, &a.text, &held);
            jump(e, &join_at);

            start(e, &else_at);
            match o {
                Option::Some(x) => {
                    let b = value(e, x, &ty);
                    if e.stuck {
                        return unknown_value();
                    }
                    store_into(e, &ty, &b.text, &held);
                }
                Option::None => {}
            }
            jump(e, &join_at);

            start(e, &join_at);
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&held);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        // `p.x` — the field's offset from Ch. 2, and a load (§4).
        ast::Expr::Field(base, field) => {
            let name = match base {
                ast::Expr::Name(n) => n.to_string(),
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let at = local_at(e, &name);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let mut owner = e.locals[at].ty.to_string();
            let mut slot = e.locals[at].slot.to_string();
            // A local holding an *address* is read through: the address
            // first, and then what it points at.
            if owner.same("ptr") {
                owner = e.self_ty.to_string();
                let p = fresh(e, "p");
                let mut line: String = Vec::new();
                line.push_str("    ");
                line.push_str(&p);
                line.push_str(" = load ptr ");
                line.push_str(&slot);
                e.insts.push(line);
                slot = p;
            }
            let which = def_at(&e.defs, &owner);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let index = field_at(e, which, field);
            if index < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(&owner));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let ty = tir_ty(&e.defs[which].fields[index]);
            let src = offset_of(e, &slot, l.offsets[index]);
            let v = fresh(e, "v");
            let mut load: String = Vec::new();
            load.push_str("    ");
            load.push_str(&v);
            load.push_str(" = load ");
            let shown = tir_of(&ty);
            load.push_str(&shown);
            load.push_str(" ");
            load.push_str(&src);
            e.insts.push(load);
            Value { text: v, ty: ty }
        }
        // An aggregate with nowhere to go is built in a temporary, which a
        // `let` then *renames* rather than copying out of — which is what
        // makes `let p = P { … }` cost nothing (Ch. 3 §1.1).
        ast::Expr::Aggregate(path, fields) => {
            let made = aggregate_type(e, path, fields);
            if made.len() == 0 {
                e.stuck = true;
                return unknown_value();
            }
            let path = &made;
            let which = def_at(&e.defs, path);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(path));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            // Storage for a value with nowhere else to be. Named as a
            // temporary and not as an aggregate, because a `let` renames it
            // to the binding's and everything else leaves it as it is —
            // which is where the name shows.
            let held = fresh(e, "tmp.slot");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&held);
            line.push_str(" = slot tryte[");
            push_int(&mut line, l.size as t27);
            line.push_str("]");
            e.slots.push(line);
            fill(e, &held, path, fields);
            if e.stuck {
                return unknown_value();
            }
            Value { text: held, ty: path.to_string() }
        }
        // `match e { … }` — the discriminant once, then a three-way test per
        // arm, and a slot the arms agree to leave the answer in (§5.4).
        ast::Expr::Match(scrutinee, arms) => {
            let base = match scrutinee {
                ast::Expr::Name(n) => {
                    let at = local_at(e, n);
                    if at < 0 {
                        e.stuck = true;
                        return unknown_value();
                    }
                    e.locals[at].slot.to_string()
                }
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let owner = match scrutinee {
                ast::Expr::Name(n) => {
                    let at = local_at(e, n);
                    e.locals[at].ty.to_string()
                }
                _ => "".to_string(),
            };
            let which = def_at(&e.defs, &owner);
            if which < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let self_ty = ast::Ty::Name(one_name(&owner));
            let l = match layout::of(&e.defs, &self_ty, 0) {
                Result::Ok(x) => x,
                Result::Err(why) => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let tag = match &l.tag {
                layout::Tag::Direct(width, at) => {
                    if width == 1 {
                        "t9".to_string()
                    } else {
                        "t27".to_string()
                    }
                }
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let d = fresh(e, "d");
            let mut read: String = Vec::new();
            read.push_str("    ");
            read.push_str(&d);
            read.push_str(" = load ");
            read.push_str(&tag);
            read.push_str(" ");
            read.push_str(&base);
            e.insts.push(read);
            let join = label(e, "match.join");

            let mut held: String = Vec::new();
            let mut ty: String = Vec::new();
            let mut a: taddr = 0;
            while a < arms.len() {
                let arm_at = label(e, "arm");
                let next_at = label(e, "arm.next");
                let index = arm_variant(e, which, &arms[a]);
                if index < 0 {
                    e.stuck = true;
                    return unknown_value();
                }
                let c = fresh(e, "c");
                let mut test: String = Vec::new();
                test.push_str("    ");
                test.push_str(&c);
                test.push_str(" = cmp ");
                test.push_str(&tag);
                test.push_str(" ");
                test.push_str(&d);
                test.push_str(", const ");
                test.push_str(&tag);
                test.push_str(" ");
                push_int(&mut test, l.discriminants[index]);
                e.insts.push(test);
                let mut br: String = Vec::new();
                br.push_str("    br3 ");
                br.push_str(&c);
                br.push_str(", ");
                br.push_str(&next_at);
                br.push_str(", ");
                br.push_str(&arm_at);
                br.push_str(", ");
                br.push_str(&next_at);
                e.insts.push(br);

                start(e, &arm_at);
                let mark = e.locals.len();
                bind_payload(e, which, index, &base, &l, &arms[a]);
                if e.stuck {
                    return unknown_value();
                }
                let v = value(e, &arms[a].body, want);
                if e.stuck {
                    return unknown_value();
                }
                if held.len() == 0 {
                    ty = v.ty.to_string();
                    held = slot_for(e, "tmp", &ty);
                }
                store_into(e, &ty, &v.text, &held);
                jump(e, &join);
                forget(e, mark);
                start(e, &next_at);
                a += 1;
            }
            // Exhaustiveness was checked, so control cannot arrive here in a
            // well-typed program — but TIR wants a terminator.
            e.insts.push("    trap F_TRAP".to_string());
            e.done = true;

            start(e, &join);
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            line.push_str(" ");
            line.push_str(&held);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        ast::Expr::Assign(op, target, v) => {
            if !op.same("=") {
                e.stuck = true;
                return unknown_value();
            }
            let name = match target {
                ast::Expr::Name(n) => n.to_string(),
                _ => {
                    e.stuck = true;
                    return unknown_value();
                }
            };
            let at = local_at(e, &name);
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let ty = e.locals[at].ty.to_string();
            let slot = e.locals[at].slot.to_string();
            let val = value(e, v, &ty);
            if e.stuck {
                return unknown_value();
            }
            store_into(e, &ty, &val.text, &slot);
            Value { text: "".to_string(), ty: "".to_string() }
        }
        // `x.m(a)` — the receiver is the first argument, as an address,
        // and the function is named after the type it is written on.
        ast::Expr::Method(recv, name, args) => {
            let missing: taddr = 0 - 1;
            let at = match recv {
                ast::Expr::Name(n) => local_at(e, n),
                _ => missing,
            };
            if at < 0 {
                e.stuck = true;
                return unknown_value();
            }
            let mut owner = e.locals[at].ty.to_string();
            let slot = e.locals[at].slot.to_string();
            if owner.same("ptr") {
                owner = e.self_ty.to_string();
            }
            let mut full: String = Vec::new();
            full.push_str(&owner);
            full.push_str(".");
            full.push_str(name);
            // A generic method is a family like any other; what tells it
            // from a free one is that its receiver is already an argument.
            // Where the receiver is an *instantiation*, the family is the
            // one written on the type it instantiates — `Pair.first`, not
            // `Pair.t27.first` — and its own key starts with the
            // receiver's (Ch. 4 §2.5).
            let inst = inst_at(e, &owner);
            let base = if inst < 0 {
                owner.to_string()
            } else {
                e.instances[inst].base.to_string()
            };
            let none: Vec<String> = Vec::new();
            let given = if inst < 0 {
                none
            } else {
                copy_names(&e.instances[inst].key)
            };
            let mut under: String = Vec::new();
            under.push_str(&base);
            under.push_str(".");
            under.push_str(name);
            let fam = family_at(e, &under);
            if fam >= 0 {
                return generic_call(e, fam, &under, &slot, &given, args);
            }
            let big = returned_aggregate(e, &full);
            if big.len() > 0 {
                return aggregate_call(e, &full, &big, &slot, args);
            }
            let mut texts: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = param_type(e, &full, i + 1);
                let v = value(e, &args[i], &each);
                if e.stuck {
                    return unknown_value();
                }
                texts.push(v.text);
                i += 1;
            }
            let ty = call_type(e, &full);
            if e.stuck {
                return unknown_value();
            }
            let out = fresh(e, "r");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&out);
            line.push_str(" = call @");
            line.push_str(&full);
            line.push_str("(");
            line.push_str(&slot);
            let mut k: taddr = 0;
            while k < texts.len() {
                line.push_str(", ");
                line.push_str(&texts[k]);
                k += 1;
            }
            line.push_str(") -> ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            e.insts.push(line);
            Value { text: out, ty: ty }
        }
        ast::Expr::Call(callee, args) => {
            // A call to a generic function names an instantiation and not
            // the family, and which one it names is read off the arguments
            // (Ch. 4 §2.3).
            let fam = family_at(e, callee);
            if fam >= 0 {
                let none: Vec<String> = Vec::new();
                return generic_call(e, fam, callee, "", &none, args);
            }
            // A call whose answer is an aggregate is given the storage for
            // it, and the storage is taken before the arguments are — which
            // is what decides the numbers (TIR §3).
            let big = returned_aggregate(e, callee);
            if big.len() > 0 {
                return aggregate_call(e, callee, &big, "", args);
            }
            let mut texts: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = param_type(e, callee, i);
                let v = value(e, &args[i], &each);
                if e.stuck {
                    return unknown_value();
                }
                texts.push(v.text);
                i += 1;
            }
            let ty = call_type(e, callee);
            let name = fresh(e, "r");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = call @");
            line.push_str(callee);
            line.push_str("(");
            let mut k: taddr = 0;
            while k < texts.len() {
                if k > 0 {
                    line.push_str(", ");
                }
                line.push_str(&texts[k]);
                k += 1;
            }
            line.push_str(") -> ");
            let shown = tir_of(&ty);
            line.push_str(&shown);
            e.insts.push(line);
            Value { text: name, ty: ty }
        }
        _ => {
            e.stuck = true;
            unknown_value()
        }
    }
}

/// The nominal types the file defines, as the layout engine reads them.
///
/// A generic type is not among them: it is one type per instantiation
/// (Ch. 4 §2.5), and none of them is called what is written. It is a
/// *family*, and `instantiate` makes its members as they are asked for.
pub fn definitions(items: &Vec<ast::Item>) -> Vec<layout::Def> {
    let fams = type_families(items);
    let mut out: Vec<layout::Def> = Vec::new();
    let mut i: taddr = 0;
    while i < fams.len() {
        if fams[i].tyvars.len() == 0 {
            out.push(copy_def(&fams[i].def));
        }
        i += 1;
    }
    out
}

/// Every struct and enum of the file, with the parameters each was written
/// with — none for most of them, which is what makes those types as they
/// stand and the rest families.
pub fn type_families(items: &Vec<ast::Item>) -> Vec<TyFamily> {
    let mut out: Vec<TyFamily> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Struct(name, gs, fields) => {
                let mut tys: Vec<ast::Ty> = Vec::new();
                let mut names: Vec<String> = Vec::new();
                let mut k: taddr = 0;
                while k < fields.len() {
                    names.push(fields[k].name.to_string());
                    tys.push(copy_ty(&fields[k].ty));
                    k += 1;
                }
                out.push(TyFamily {
                    name: name.to_string(),
                    tyvars: generic_names(gs),
                    def: layout::Def {
                        name: name.to_string(),
                        is_enum: false,
                        linear: items[i].linear,
                        fields: tys,
                        field_names: names,
                        counts: Vec::new(),
                        discriminants: Vec::new(),
                    },
                });
            }
            ast::What::Enum(name, gs, variants) => {
                let mut tys: Vec<ast::Ty> = Vec::new();
                let mut counts: Vec<taddr> = Vec::new();
                let mut discs: Vec<t27> = Vec::new();
                let mut names: Vec<String> = Vec::new();
                let mut next: t27 = 0;
                let mut v: taddr = 0;
                while v < variants.len() {
                    let mut n: taddr = 0;
                    let mut k: taddr = 0;
                    while k < variants[v].fields.len() {
                        tys.push(copy_ty(&variants[v].fields[k]));
                        n += 1;
                        k += 1;
                    }
                    names.push(variants[v].name.to_string());
                    counts.push(n);
                    discs.push(next);
                    next = next + 1;
                    v += 1;
                }
                out.push(TyFamily {
                    name: name.to_string(),
                    tyvars: generic_names(gs),
                    def: layout::Def {
                        name: name.to_string(),
                        is_enum: true,
                        linear: items[i].linear,
                        fields: tys,
                        field_names: names,
                        counts: counts,
                        discriminants: discs,
                    },
                });
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// What every function answers with, as it was written.
pub fn returns(items: &Vec<ast::Item>) -> Vec<RetTy> {
    let mut out: Vec<RetTy> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                out.push(RetTy { name: f.name.to_string(), ty: copy_ty(&f.ret) });
            }
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    out.push(RetTy { name: full, ty: copy_ty(&fns[k].ret) });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// The aggregate a call answers with, made if this is the first ask — or
/// nothing where the answer is not one.
///
/// This is where a call learns it has to provide storage: TIR answers with
/// a value or with nothing, and a value that big is not one (TIR §3).
fn returned_aggregate(e: &mut Emit, name: &str) -> String {
    let mut i: taddr = 0;
    while i < e.rets.len() {
        if e.rets[i].name.same(name) {
            let written = copy_ty(&e.rets[i].ty);
            let none: Vec<String> = Vec::new();
            let empty: Vec<String> = Vec::new();
            let made = subst_ty(e, &none, &empty, &written);
            let full = nominal(e, &made);
            if full.len() > 0 && def_at(&e.defs, &full) >= 0 {
                return full;
            }
            return "".to_string();
        }
        i += 1;
    }
    "".to_string()
}

/// Which type a literal `Pair { … }` builds: the member of the family its
/// fields say it is (Ch. 4 §2.3), made if this is the first ask.
///
/// A type written with no parameters is a family of one and is its own
/// answer, which is every aggregate that was written before this.
fn aggregate_type(e: &mut Emit, path: &str, fields: &Vec<ast::Field>) -> String {
    if def_at(&e.defs, path) >= 0 {
        return path.to_string();
    }
    let at = tyfamily_at(e, path);
    if at < 0 {
        return "".to_string();
    }
    let mut key: Vec<String> = Vec::new();
    let mut t: taddr = 0;
    while t < e.tyfams[at].tyvars.len() {
        let each = e.tyfams[at].tyvars[t].to_string();
        let mut found: String = Vec::new();
        let mut clash = false;
        let mut i: taddr = 0;
        while i < fields.len() {
            let which = tyfield_at(e, at, &fields[i].name);
            if which >= 0 {
                let declared = name_head(&e.tyfams[at].def.fields[which]);
                if declared.same(&each) {
                    let got = guess_ty(e, &fields[i].value);
                    if got.len() == 0 {
                        clash = true;
                    } else if found.len() == 0 {
                        found = got;
                    } else if !found.same(&got) {
                        clash = true;
                    }
                }
            }
            i += 1;
        }
        if clash || found.len() == 0 {
            return "".to_string();
        }
        key.push(found);
        t += 1;
    }
    instantiate(e, path, &key)
}

/// Which field of a family is called this, or −1.
fn tyfield_at(e: &Emit, at: taddr, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.tyfams[at].def.field_names.len() {
        if e.tyfams[at].def.field_names[i].same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// What type an expression will turn out to be, without lowering it.
///
/// Only asked where a *type argument* has to be worked out before the
/// values that decide it are emitted, and answered only for the shapes
/// where the answer needs nothing but the expression: a literal is what
/// §5.2 says a literal is, and a name is what it was bound as. Anything
/// else answers nothing, and nothing is what refuses the instantiation.
fn guess_ty(e: &mut Emit, x: &ast::Expr) -> String {
    match x {
        ast::Expr::Int(v) => "t27".to_string(),
        ast::Expr::Bool(b) => "bool".to_string(),
        ast::Expr::Trit(v) => "trit".to_string(),
        ast::Expr::Char(v) => "char".to_string(),
        ast::Expr::Group(inner) => guess_ty(e, inner),
        ast::Expr::Name(n) => {
            let at = local_at(e, n);
            if at < 0 {
                "".to_string()
            } else {
                e.locals[at].ty.to_string()
            }
        }
        // A call answers with what its signature says, which is a fact
        // about the file and needs nothing lowered. A call to a *generic*
        // function answers with whatever that call works out, which is not
        // one of those.
        ast::Expr::Call(callee, args) => {
            if family_at(e, callee) >= 0 {
                return "".to_string();
            }
            let big = returned_aggregate(e, callee);
            if big.len() > 0 {
                return big;
            }
            let mut i: taddr = 0;
            while i < e.sigs.len() {
                if e.sigs[i].name.same(callee) {
                    let ret = e.sigs[i].ret.to_string();
                    if ret.same("?") {
                        return "".to_string();
                    }
                    return ret;
                }
                i += 1;
            }
            "".to_string()
        }
        _ => "".to_string(),
    }
}

/// A definition, copied. `defs` grows as instantiations are asked for, and
/// what a family is made of has to survive being read more than once.
fn copy_def(d: &layout::Def) -> layout::Def {
    let mut tys: Vec<ast::Ty> = Vec::new();
    let mut i: taddr = 0;
    while i < d.fields.len() {
        tys.push(copy_ty(&d.fields[i]));
        i += 1;
    }
    let mut counts: Vec<taddr> = Vec::new();
    let mut k: taddr = 0;
    while k < d.counts.len() {
        counts.push(d.counts[k]);
        k += 1;
    }
    let mut discs: Vec<t27> = Vec::new();
    let mut j: taddr = 0;
    while j < d.discriminants.len() {
        discs.push(d.discriminants[j]);
        j += 1;
    }
    layout::Def {
        name: d.name.to_string(),
        is_enum: d.is_enum,
        linear: d.linear,
        fields: tys,
        field_names: copy_names(&d.field_names),
        counts: counts,
        discriminants: discs,
    }
}

/// Which family of types is called this, or −1.
fn tyfamily_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.tyfams.len() {
        if e.tyfams[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// The nominal type a written type denotes, making it if this is the first
/// place that asked — or nothing for a type that names none.
///
/// `Pair<t27>` is `Pair.t27`, one type, laid out from `Pair`'s fields read
/// with `t27` for `T`. The name is Ch. 6 §4's, the same one a
/// monomorphized function gets, and for the same reason: TIR admits a `.`
/// in an identifier and not a `<`.
fn nominal(e: &mut Emit, t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            let mut key: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = nominal(e, &args[i]);
                if each.len() == 0 {
                    return "".to_string();
                }
                key.push(each);
                i += 1;
            }
            instantiate(e, &head, &key)
        }
        _ => "".to_string(),
    }
}

/// One member of a family of types, made if it is not there already, and
/// answered with the name it is known by — or nothing where there is no
/// such family, the key does not fit it, or it reaches itself.
fn instantiate(e: &mut Emit, head: &str, key: &Vec<String>) -> String {
    let full = mangled(head, key);
    if def_at(&e.defs, &full) >= 0 {
        return full;
    }
    let at = tyfamily_at(e, head);
    if at < 0 {
        return "".to_string();
    }
    if e.tyfams[at].tyvars.len() != key.len() || key.len() == 0 {
        return "".to_string();
    }
    // A type that reaches itself without an indirection has no size (Ch. 2
    // §8), and one that reaches itself *through* an indirection is a size
    // the reference already has — so neither needs reading twice.
    if holds_name(&e.making, &full) {
        return "".to_string();
    }
    e.making.push(full.to_string());
    let tyvars = copy_names(&e.tyfams[at].tyvars);
    let source = copy_def(&e.tyfams[at].def);
    let mut fields: Vec<ast::Ty> = Vec::new();
    let mut i: taddr = 0;
    while i < source.fields.len() {
        fields.push(subst_ty(e, &tyvars, key, &source.fields[i]));
        i += 1;
    }
    let mut made = copy_def(&source);
    made.name = full.to_string();
    made.fields = fields;
    e.defs.push(made);
    e.instances.push(Inst {
        full: full.to_string(),
        base: head.to_string(),
        key: copy_names(key),
    });
    full
}

/// Read every definition's fields once more, now that instantiating is
/// possible.
///
/// A field written `Pair<t27>` is the type `Pair.t27`, and Ch. 2 lays out a
/// type and not a family — so until this has run, a struct with a generic
/// field has no layout and every use of it is refused. It runs once per
/// function because that is where the table it needs lives.
fn settle(e: &mut Emit) {
    let mut out: Vec<layout::Def> = Vec::new();
    let none: Vec<String> = Vec::new();
    let empty: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < e.defs.len() {
        let source = copy_def(&e.defs[i]);
        let mut fields: Vec<ast::Ty> = Vec::new();
        let mut k: taddr = 0;
        while k < source.fields.len() {
            fields.push(subst_ty(e, &none, &empty, &source.fields[k]));
            k += 1;
        }
        let mut made = copy_def(&source);
        made.fields = fields;
        out.push(made);
        i += 1;
    }
    e.defs = out;
}

/// Which instantiation of a type this name is, or −1.
fn inst_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.instances.len() {
        if e.instances[i].full.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// A written type read under a key: a parameter stands for what the
/// instantiation put there, and an application becomes the one name its
/// member is known by (Ch. 4 §2.5).
///
/// A type it cannot make is left as it was written, which is a type the
/// layout engine says it does not lay out — so a use of it is refused
/// rather than laid out as something else.
fn subst_ty(
    e: &mut Emit,
    tyvars: &Vec<String>,
    key: &Vec<String>,
    t: &ast::Ty,
) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => {
            let written = joined(segments);
            let n = subst(tyvars, key, &written);
            ast::Ty::Name(one_name(&n))
        }
        ast::Ty::App(segments, args) => {
            let head = joined(segments);
            let mut inner: Vec<String> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                let each = subst_ty(e, tyvars, key, &args[i]);
                let name = nominal(e, &each);
                if name.len() == 0 {
                    return copy_ty(t);
                }
                inner.push(name);
                i += 1;
            }
            let full = instantiate(e, &head, &inner);
            if full.len() == 0 {
                return copy_ty(t);
            }
            ast::Ty::Name(one_name(&full))
        }
        ast::Ty::Ref(held, m) => ast::Ty::Ref(Box::new(subst_ty(e, tyvars, key, held)), m),
        ast::Ty::Slice(held) => ast::Ty::Slice(Box::new(subst_ty(e, tyvars, key, held))),
        ast::Ty::Unit => ast::Ty::Unit,
        ast::Ty::SelfTy => ast::Ty::SelfTy,
    }
}

/// A type, copied. There is no `Clone` here and a type is a tree.
fn copy_ty(t: &ast::Ty) -> ast::Ty {
    match t {
        ast::Ty::Name(segments) => ast::Ty::Name(copy_names(segments)),
        ast::Ty::App(segments, args) => {
            let mut out: Vec<ast::Ty> = Vec::new();
            let mut i: taddr = 0;
            while i < args.len() {
                out.push(copy_ty(&args[i]));
                i += 1;
            }
            ast::Ty::App(copy_names(segments), out)
        }
        ast::Ty::Ref(inner, m) => ast::Ty::Ref(Box::new(copy_ty(inner)), m),
        ast::Ty::Slice(inner) => ast::Ty::Slice(Box::new(copy_ty(inner))),
        ast::Ty::Unit => ast::Ty::Unit,
        ast::Ty::SelfTy => ast::Ty::SelfTy,
    }
}

fn copy_names(from: &Vec<String>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(from[i].to_string());
        i += 1;
    }
    out
}

/// Which types have a destructor: the ones an `impl Drop` is written for
/// (Ch. 3 §1.4). A type containing one has a destructor too, and that is
/// not read here yet.
pub fn destructors(items: &Vec<ast::Item>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                match tr {
                    Option::Some(t) => {
                        let name = head_of(t);
                        if name.same("Drop") {
                            out.push(head_of(ty));
                        }
                    }
                    Option::None => {}
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// The parameter types of every function, as one comma-joined string each.
pub fn parameters(items: &Vec<ast::Item>) -> Vec<Sig> {
    let mut out: Vec<Sig> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                let mut all: String = Vec::new();
                let mut k: taddr = 0;
                while k < f.params.len() {
                    if k > 0 {
                        all.push(',');
                    }
                    let each = tir_ty(&f.params[k].ty);
                    all.push_str(&each);
                    k += 1;
                }
                out.push(Sig { name: f.name.to_string(), ret: all });
            }
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut all: String = Vec::new();
                    let mut j: taddr = 0;
                    while j < fns[k].params.len() {
                        if j > 0 {
                            all.push(',');
                        }
                        let each = if fns[k].params[j].name.same("self") {
                            "ptr".to_string()
                        } else {
                            tir_ty(&fns[k].params[j].ty)
                        };
                        all.push_str(&each);
                        j += 1;
                    }
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    out.push(Sig { name: full, ret: all });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

pub fn signatures(items: &Vec<ast::Item>) -> Vec<Sig> {
    let mut out: Vec<Sig> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                // A generic function is not one function: it is one per
                // instantiation (Ch. 4 §2.5), and none of them is named by
                // the name written here. Until this lowers them, a call to
                // one has no answer and says so.
                let ret = if f.generics.len() > 0 {
                    "?".to_string()
                } else {
                    tir_ty(&f.ret)
                };
                out.push(Sig { name: f.name.to_string(), ret: ret });
            }
            // A method is reached through its receiver, so the receiver's
            // name is half of its own (Ch. 4 §1.2).
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let mut k: taddr = 0;
                while k < fns.len() {
                    let mut full: String = Vec::new();
                    full.push_str(&owner);
                    full.push_str(".");
                    full.push_str(&fns[k].name);
                    // A generic method is no more one function than a
                    // generic function is, and neither is any method of an
                    // impl with parameters of its own: the name written
                    // here is not the name a call to it uses.
                    let ret = if fns[k].generics.len() > 0 || !plain_impl(gs) {
                        "?".to_string()
                    } else {
                        tir_ty(&fns[k].ret)
                    };
                    out.push(Sig { name: full, ret: ret });
                    k += 1;
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// What the parameter at this position of that function is.
fn param_type(e: &Emit, name: &str, at: taddr) -> String {
    let mut i: taddr = 0;
    while i < e.params.len() {
        if e.params[i].name.same(name) {
            let parts = split_types(&e.params[i].ret);
            if at < parts.len() {
                return parts[at].to_string();
            }
            return "".to_string();
        }
        i += 1;
    }
    "".to_string()
}

/// The parameter types of a signature, which are kept as one string with
/// `,` between them so that a `Sig` needs no second list.
fn split_types(all: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut cur: String = Vec::new();
    let mut i: taddr = 0;
    while i < all.len() {
        if all[i] == ',' {
            out.push(cur);
            cur = Vec::new();
        } else {
            cur.push(all[i]);
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn call_type(e: &mut Emit, name: &str) -> String {
    let mut i: taddr = 0;
    while i < e.sigs.len() {
        if e.sigs[i].name.same(name) {
            let ret = e.sigs[i].ret.to_string();
            if ret.same("?") {
                e.stuck = true;
            }
            return ret;
        }
        i += 1;
    }
    e.stuck = true;
    "?".to_string()
}

fn unknown_value() -> Value {
    Value { text: "?".to_string(), ty: "?".to_string() }
}

/// Everything about a file that a lowering reads, gathered once.
pub fn context(items: &Vec<ast::Item>) -> Cx {
    Cx {
        sigs: signatures(items),
        params: parameters(items),
        defs: definitions(items),
        drops: destructors(items),
        families: families(items),
        tyfams: type_families(items),
        rets: returns(items),
    }
}

/// The generic functions of the file (Ch. 4 §2.5).
///
/// A function with a `const` parameter is left out: a key here is type
/// arguments and nothing else, and a family whose members are told apart by
/// a *value* would need a key that could say so. Leaving it out means every
/// call to one is refused, which is the honest answer until it can be said.
pub fn families(items: &Vec<ast::Item>) -> Vec<Family> {
    let mut out: Vec<Family> = Vec::new();
    let mut i: taddr = 0;
    while i < items.len() {
        match &items[i].what {
            ast::What::Function(f) => {
                if is_family(f, 0) {
                    out.push(Family {
                        name: f.name.to_string(),
                        tyvars: generic_names(&f.generics),
                        from_self: 0,
                        params: written_params(&f.params),
                        ret: name_head(&f.ret),
                    });
                }
            }
            // A generic *method* is a family too, under the name a call to
            // it uses (Ch. 4 §1.2) — and so is every method of an `impl`
            // with parameters of its own, because those are decided by the
            // receiver and the method is one function per instantiation of
            // it just the same.
            ast::What::Impl(gs, tr, ty, fns) => {
                let named = match tr {
                    Option::Some(t) => written_head(t),
                    Option::None => "".to_string(),
                };
                let outer = self_parameters(gs, ty);
                if !named.same("Drop") {
                    let owner = written_head(ty);
                    let mut k: taddr = 0;
                    while k < fns.len() {
                        if is_family(&fns[k], outer.len()) {
                            let mut full: String = Vec::new();
                            full.push_str(&owner);
                            full.push_str(".");
                            full.push_str(&fns[k].name);
                            let mut tyvars = copy_names(&outer);
                            let own = generic_names(&fns[k].generics);
                            let mut g: taddr = 0;
                            while g < own.len() {
                                tyvars.push(own[g].to_string());
                                g += 1;
                            }
                            out.push(Family {
                                name: full,
                                tyvars: tyvars,
                                from_self: outer.len() as taddr,
                                params: written_params(&fns[k].params),
                                ret: name_head(&fns[k].ret),
                            });
                        }
                        k += 1;
                    }
                }
            }
            _ => {}
        }
        i += 1;
    }
    out
}

/// Whether an `impl`'s methods are functions this can emit at all.
///
/// An `impl` with parameters of its own is one impl per instantiation of the
/// type it is written on, and its methods are named after that
/// instantiation — `@Pair.size.t27`, not `@Pair.size` (Ch. 6 §4). Nothing
/// here instantiates a *type* yet, so those methods are left out rather than
/// emitted under a name no call uses.
pub fn plain_impl(gs: &Vec<ast::Generic>) -> bool {
    gs.len() == 0
}

/// The parameters an `impl`'s *self type* binds, in the order the receiver's
/// instantiation gives them — or none where the two are not written to
/// match.
///
/// `impl<T> Pair<T>` binds `T` to whatever the receiver's first argument
/// turned out to be, and that is only readable off the receiver where the
/// self type is the impl's parameters, in order, and nothing else.
/// `impl<A, B> Either<B, A>` is not, and its methods are left out rather
/// than instantiated at the wrong argument.
fn self_parameters(gs: &Vec<ast::Generic>, ty: &ast::Ty) -> Vec<String> {
    let none: Vec<String> = Vec::new();
    if gs.len() == 0 {
        return none;
    }
    let want = generic_names(gs);
    match ty {
        ast::Ty::App(segments, args) => {
            if args.len() != want.len() {
                return none;
            }
            let mut i: taddr = 0;
            while i < args.len() {
                let each = name_head(&args[i]);
                if !each.same(&want[i]) {
                    return none;
                }
                i += 1;
            }
            want
        }
        _ => none,
    }
}

/// Whether this function is a family: all of whose type parameters are
/// types, with a body to read again under a key, and with at least one
/// parameter to read it under — its own, or the receiver's.
fn is_family(f: &ast::Fn, outer: taddr) -> bool {
    if f.generics.len() + outer == 0 {
        return false;
    }
    let mut g: taddr = 0;
    while g < f.generics.len() {
        match &f.generics[g] {
            ast::Generic::Type(n, bounds) => {}
            ast::Generic::Const(n, ty) => return false,
        }
        g += 1;
    }
    match &f.body {
        Option::Some(b) => true,
        Option::None => false,
    }
}

/// The written head of each parameter's type, `,`-joined — without the
/// receiver, which is not something a call writes and so is not something
/// a call can infer from.
fn written_params(params: &Vec<ast::Param>) -> String {
    let mut all: String = Vec::new();
    let mut k: taddr = 0;
    let mut first = true;
    while k < params.len() {
        if !params[k].name.same("self") {
            if !first {
                all.push(',');
            }
            first = false;
            let each = name_head(&params[k].ty);
            all.push_str(&each);
        }
        k += 1;
    }
    all
}

/// The head of a written type, but only where the type *is* a name: a
/// `Vec<T>` and a `&T` are not their heads, and answering with one would be
/// answering a question that was not asked.
fn name_head(t: &ast::Ty) -> String {
    match t {
        ast::Ty::Name(segments) => joined(segments),
        _ => "".to_string(),
    }
}

/// The names a function's generic parameters were written with, in
/// declaration order.
pub fn generic_names(gs: &Vec<ast::Generic>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < gs.len() {
        match &gs[i] {
            ast::Generic::Type(n, bounds) => out.push(n.to_string()),
            ast::Generic::Const(n, ty) => out.push(n.to_string()),
        }
        i += 1;
    }
    out
}

/// Which family is called this, or −1.
fn family_at(e: &Emit, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < e.families.len() {
        if e.families[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// A call to a generic function: which instantiation it means, worked out
/// from what the arguments turned out to be (Ch. 4 §2.3), and queued if this
/// is the first call that means it.
fn generic_call(
    e: &mut Emit,
    fam: taddr,
    callee: &str,
    recv: &str,
    given: &Vec<String>,
    args: &Vec<ast::Expr>,
) -> Value {
    // A method's receiver is its first argument and is not written as one,
    // so it is not among the declared types and infers nothing — except
    // for the parameters it *is* the answer to, which arrive as `given`.
    let skip: taddr = if recv.len() > 0 { 1 } else { 0 };
    if given.len() != e.families[fam].from_self {
        e.stuck = true;
        return unknown_value();
    }
    let front = copy_names(&e.families[fam].tyvars);
    let declared = split_types(&e.families[fam].params);
    if declared.len() != args.len() {
        e.stuck = true;
        return unknown_value();
    }
    let mut texts: Vec<String> = Vec::new();
    let mut kinds: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        // A parameter the receiver already decided is written for at that
        // type, so a literal there takes its width from it and not from
        // §5.2's default.
        let told = subst(&front, given, &declared[i]);
        let each = if told.same(&declared[i]) {
            param_type(e, callee, i + skip)
        } else {
            told
        };
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        kinds.push(v.ty);
        i += 1;
    }
    // The key: each type parameter, in declaration order, is whatever the
    // argument written where it was named turned out to be. A parameter
    // named nowhere is a parameter the arguments cannot say anything about,
    // and a key that is not a type TIR can spell is not one this emits.
    let mut key: Vec<String> = copy_names(given);
    let mut t: taddr = key.len();
    while t < e.families[fam].tyvars.len() {
        let each = e.families[fam].tyvars[t].to_string();
        let mut found: String = Vec::new();
        let mut clash = false;
        let mut k: taddr = 0;
        while k < declared.len() {
            if declared[k].same(&each) {
                if found.len() == 0 {
                    found = kinds[k].to_string();
                } else if !found.same(&kinds[k]) {
                    // Two arguments written where one type parameter was
                    // named, and not the same type: no key is the right
                    // one, and Ch. 4 §2.3 is what refuses it.
                    clash = true;
                }
            }
            k += 1;
        }
        if clash || scalar_named(&found).same("?") {
            e.stuck = true;
            return unknown_value();
        }
        key.push(found);
        t += 1;
    }
    let ret = subst(&e.families[fam].tyvars, &key, &e.families[fam].ret);
    if scalar_named(&ret).same("?") {
        e.stuck = true;
        return unknown_value();
    }
    let full = mangled(callee, &key);
    queue(e, callee, &key);
    let name = fresh(e, "r");
    let mut line: String = Vec::new();
    line.push_str("    ");
    line.push_str(&name);
    line.push_str(" = call @");
    line.push_str(&full);
    line.push_str("(");
    if recv.len() > 0 {
        line.push_str(recv);
    }
    let mut k: taddr = 0;
    while k < texts.len() {
        if k > 0 || recv.len() > 0 {
            line.push_str(", ");
        }
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(") -> ");
    let shown = tir_of(&ret);
    line.push_str(&shown);
    e.insts.push(line);
    Value { text: name, ty: ret }
}

/// A call that answers with an aggregate: the caller makes the storage, the
/// call is given it as its first argument, and the value *is* that storage
/// (TIR §3).
fn aggregate_call(
    e: &mut Emit,
    callee: &str,
    owner: &str,
    recv: &str,
    args: &Vec<ast::Expr>,
) -> Value {
    let skip: taddr = if recv.len() > 0 { 1 } else { 0 };
    let held = slot_for(e, "tmp", owner);
    let mut texts: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < args.len() {
        let each = param_type(e, callee, i + skip);
        let v = value(e, &args[i], &each);
        if e.stuck {
            return unknown_value();
        }
        texts.push(v.text);
        i += 1;
    }
    let mut line: String = Vec::new();
    line.push_str("    call @");
    line.push_str(callee);
    line.push_str("(");
    // The storage first and the receiver after it: `%sret` is what the
    // function is for, and the receiver is its first ordinary argument.
    line.push_str(&held);
    if recv.len() > 0 {
        line.push_str(", ");
        line.push_str(recv);
    }
    let mut k: taddr = 0;
    while k < texts.len() {
        line.push_str(", ");
        line.push_str(&texts[k]);
        k += 1;
    }
    line.push_str(")");
    e.insts.push(line);
    Value { text: held, ty: owner.to_string() }
}

/// Ask for an instantiation, unless it has been asked for already. The list
/// is append-only for that reason: what makes the queue drain is that a key
/// is queued once and no second call can queue it again.
fn queue(e: &mut Emit, name: &str, key: &Vec<String>) {
    let full = mangled(name, key);
    let mut i: taddr = 0;
    while i < e.jobs.len() {
        let each = mangled(&e.jobs[i].name, &e.jobs[i].key);
        if each.same(&full) {
            return;
        }
        i += 1;
    }
    e.jobs.push(Job { name: name.to_string(), key: copy_names(key) });
}

/// The jobs, copied. A `&mut Vec<Job>` is not a `Vec<Job>` and the emitter
/// holds its own, which it hands back the new part of when it is done.
fn copy_jobs(from: &Vec<Job>) -> Vec<Job> {
    let mut out: Vec<Job> = Vec::new();
    let mut i: taddr = 0;
    while i < from.len() {
        out.push(Job {
            name: from[i].name.to_string(),
            key: copy_names(&from[i].key),
        });
        i += 1;
    }
    out
}

/// Which queued instantiation to emit next: the one asked for most recently
/// that has not been emitted yet.
///
/// Most recently, not first: the queue is a stack, and a body that asks for
/// an instantiation of its own is emitted before whatever was waiting behind
/// it. Both implementations drain theirs that way, and the order is visible
/// in the text, so it is part of what agrees.
fn pending_at(jobs: &Vec<Job>, done: &Vec<String>) -> taddr {
    let mut i = jobs.len();
    while i > 0 {
        i -= 1;
        let full = mangled(&jobs[i].name, &jobs[i].key);
        if !holds_name(done, &full) {
            return i as taddr;
        }
    }
    0 - 1
}

/// Every function a file contains, in the order TIR prints them and cut
/// down to what `main` reaches.
///
/// One copy for a file and for a whole program both: a module is a list of
/// items whatever produced it (Ch. 6 §4), and two drivers that emitted it
/// twice would be two things to keep in step. `bootstrap/build.tr` not
/// pruning while `bootstrap/program.tr` did was exactly that.
pub fn module(items: &Vec<ast::Item>) -> Vec<Made> {
    let mut out: Vec<Made> = Vec::new();
    let mut queued: Vec<Job> = Vec::new();
    // Ordinary functions first, then the impls, then the instantiations of
    // Ch. 4 §2.5 — a call is what asks for one, so they are known last.
    let mut k: taddr = 0;
    while k < items.len() {
        match &items[k].what {
            ast::What::Function(f) => {
                let mut text: String = Vec::new();
                if function(
                    f, context(items), "".to_string(), Vec::new(),
                    Vec::new(), &mut queued, &mut text)
                {
                    out.push(Made { name: f.name.to_string(), text: text });
                }
            }
            _ => {}
        }
        k += 1;
    }
    let mut d: taddr = 0;
    while d < items.len() {
        match &items[d].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = written_head(ty);
                let named = match tr {
                    Option::Some(t) => written_head(t),
                    Option::None => "".to_string(),
                };
                let mut m: taddr = 0;
                while m < fns.len() {
                    let mut text: String = Vec::new();
                    // `Drop` is the one impl whose method becomes a
                    // function named after the *type* and not after the
                    // method (Ch. 3 §1.4). An impl with parameters of its
                    // own has no method that is one function, so what is
                    // written here is none of them.
                    let made = if !plain_impl(gs) {
                        false
                    } else if named.same("Drop") {
                        destructor(&fns[m], &owner, context(items), &mut text)
                    } else {
                        function(
                            &fns[m], context(items), owner.to_string(),
                            Vec::new(), Vec::new(), &mut queued, &mut text)
                    };
                    if made {
                        let mut full: String = Vec::new();
                        if named.same("Drop") {
                            full.push_str("drop.");
                            full.push_str(&owner);
                        } else {
                            full.push_str(&owner);
                            full.push_str(".");
                            full.push_str(&fns[m].name);
                        }
                        out.push(Made { name: full, text: text });
                    }
                    m += 1;
                }
            }
            _ => {}
        }
        d += 1;
    }
    let extra = instantiations(items, &mut queued);
    let mut z: taddr = 0;
    while z < extra.len() {
        out.push(Made {
            name: extra[z].name.to_string(),
            text: extra[z].text.to_string(),
        });
        z += 1;
    }

    let live = reachable(&out);
    let mut kept: Vec<Made> = Vec::new();
    let mut n: taddr = 0;
    while n < out.len() {
        if holds_name(&live, &out[n].name) {
            kept.push(Made {
                name: out[n].name.to_string(),
                text: out[n].text.to_string(),
            });
        }
        n += 1;
    }
    kept
}

/// Which functions a program contains: the ones `main` reaches, or all of
/// them where there is no `main` and every function is its own root.
///
/// A function nothing calls is a function the program does not contain, and
/// the two implementations have to agree about which those are — so this is
/// asked of one file the same way it is asked of a whole program.
pub fn reachable(made: &Vec<Made>) -> Vec<String> {
    let mut live: Vec<String> = Vec::new();
    let mut queue: Vec<String> = Vec::new();
    let mut has_main = false;
    let mut i: taddr = 0;
    while i < made.len() {
        if made[i].name.same("main") {
            has_main = true;
        }
        i += 1;
    }
    if has_main {
        queue.push("main".to_string());
    } else {
        let mut k: taddr = 0;
        while k < made.len() {
            queue.push(made[k].name.to_string());
            k += 1;
        }
    }
    loop {
        match queue.pop() {
            Option::Some(name) => {
                if !holds_name(&live, &name) {
                    let at = made_at(made, &name);
                    live.push(name);
                    if at >= 0 {
                        let calls = callees(&made[at].text);
                        let mut c: taddr = 0;
                        while c < calls.len() {
                            queue.push(calls[c].to_string());
                            c += 1;
                        }
                    }
                }
            }
            Option::None => return live,
        }
    }
}

/// Which emitted function is called that, or −1.
fn made_at(made: &Vec<Made>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < made.len() {
        if made[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Every `call @name` in a function's text.
///
/// Read back out of what was written rather than collected while writing:
/// what a function calls is what its text says it calls, and a second list
/// would be a second thing to keep right.
pub fn callees(text: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    let want = "call @";
    while i + want.len() < text.len() {
        let mut hit = true;
        let mut k: taddr = 0;
        while k < want.len() {
            if text[i + k] != want[k] {
                hit = false;
            }
            k += 1;
        }
        if hit {
            let mut name: String = Vec::new();
            let mut j = i + want.len();
            while j < text.len() && text[j] != '(' {
                name.push(text[j]);
                j += 1;
            }
            out.push(name);
            i = j;
        } else {
            i += 1;
        }
    }
    out
}

/// Every instantiation the queue asks for, drained: the members of each
/// family that this program contains (Ch. 4 §2.5).
///
/// It runs after the ordinary functions and the impls, because that is when
/// what a program asks for is known — a call is the only thing that asks.
pub fn instantiations(items: &Vec<ast::Item>, queued: &mut Vec<Job>) -> Vec<Made> {
    let mut made: Vec<Made> = Vec::new();
    let mut done: Vec<String> = Vec::new();
    loop {
        let at = pending_at(queued, &done);
        if at < 0 {
            return made;
        }
        let name = queued[at].name.to_string();
        let key = copy_names(&queued[at].key);
        let full = mangled(&name, &key);
        done.push(full.to_string());
        let mut text: String = Vec::new();
        let mut ok = false;
        let mut i: taddr = 0;
        while i < items.len() {
            match &items[i].what {
                ast::What::Function(f) => {
                    if !ok && f.name.same(&name) && f.generics.len() > 0 {
                        ok = function(
                            f, context(items), "".to_string(), Vec::new(),
                            copy_names(&key), queued, &mut text);
                    }
                }
                ast::What::Impl(gs, tr, ty, fns) => {
                    let outer = self_parameters(gs, ty);
                    let owner = if gs.len() == outer.len() {
                        written_head(ty)
                    } else {
                        "".to_string()
                    };
                    let mut k: taddr = 0;
                    while k < fns.len() {
                        let mut m: String = Vec::new();
                        m.push_str(&owner);
                        m.push_str(".");
                        m.push_str(&fns[k].name);
                        if !ok && m.same(&name) && is_family(&fns[k], outer.len()) {
                            ok = function(
                                &fns[k], context(items), owner.to_string(),
                                copy_names(&outer), copy_names(&key),
                                queued, &mut text);
                        }
                        k += 1;
                    }
                }
                _ => {}
            }
            i += 1;
        }
        if ok {
            made.push(Made { name: full, text: text });
        }
    }
}

/// `&&` and `||` do not evaluate the second side unless they must (§2.3):
/// the answer starts as the first side, and the second is reached only where
/// it can change it.
fn short_circuit(e: &mut Emit, op: &str, a: &ast::Expr, b: &ast::Expr) -> Value {
            let first = value(e, a, "t1");
            if e.stuck {
                return unknown_value();
            }
            let held = slot_for(e, "tmp", "t1");
            store_into(e, "t1", &first.text, &held);
            let rhs = label(e, "sc.rhs");
            let join = label(e, "sc.join");
            let short = label(e, "sc.short");
            let mut br: String = Vec::new();
            br.push_str("    br2 ");
            br.push_str(&first.text);
            br.push_str(", ");
            if op.same("&&") {
                br.push_str(&rhs);
                br.push_str(", ");
                br.push_str(&short);
            } else {
                br.push_str(&short);
                br.push_str(", ");
                br.push_str(&rhs);
            }
            e.insts.push(br);
            start(e, &short);
            jump(e, &join);
            start(e, &rhs);
            let second = value(e, b, "t1");
            if e.stuck {
                return unknown_value();
            }
            store_into(e, "t1", &second.text, &held);
            jump(e, &join);
            start(e, &join);
            let name = fresh(e, "v");
            let mut line: String = Vec::new();
            line.push_str("    ");
            line.push_str(&name);
            line.push_str(" = load t1 ");
            line.push_str(&held);
            e.insts.push(line);
            return Value { text: name, ty: "bool".to_string() };
}

/// The TIR instruction for an operator, or `?` for one not lowered yet.
///
/// Ch. 1 §5: the trapping flavour is what a written `+` means, since an
/// overflow that wraps silently is the thing the chapter refuses.
/// What a comparison's trit means, as the three values `select3` picks
/// between: less, equal, greater (Ch. 1 §4). Empty for an operator that is
/// not a comparison.
fn choice(op: &str) -> Vec<char> {
    let mut out: Vec<char> = Vec::new();
    if op.same("<") {
        out.push('1');
        out.push('0');
        out.push('0');
    } else if op.same(">") {
        out.push('0');
        out.push('0');
        out.push('1');
    } else if op.same("==") {
        out.push('0');
        out.push('1');
        out.push('0');
    } else if op.same("!=") {
        out.push('1');
        out.push('0');
        out.push('1');
    } else if op.same("<=") {
        out.push('1');
        out.push('1');
        out.push('0');
    } else if op.same(">=") {
        out.push('0');
        out.push('1');
        out.push('1');
    }
    out
}

fn arith(op: &str) -> String {
    if op.same("+") {
        "add.trap".to_string()
    } else if op.same("-") {
        "sub.trap".to_string()
    } else if op.same("*") {
        "mul.trap".to_string()
    } else if op.same("/") {
        // Division rounds to nearest with ties away from zero and cannot
        // overflow, since `MIN == -MAX` (Ch. 1 §4): there is no flavour to
        // choose and nothing to trap on.
        "div".to_string()
    } else if op.same("%") {
        "rem".to_string()
    } else if op.same("<<") {
        "shl.trap".to_string()
    } else if op.same(">>") {
        // An exact division by a power of three, with no tie case, so it
        // needs no rounding fixup and cannot overflow either.
        "shr".to_string()
    } else {
        "?".to_string()
    }
}

fn joined(segments: &Vec<String>) -> String {
    let mut out: String = Vec::new();
    let mut i: taddr = 0;
    while i < segments.len() {
        if i > 0 {
            out.push_str("::");
        }
        out.push_str(&segments[i]);
        i += 1;
    }
    out
}

/// A number, written out. `/` and `%` are symmetric (Ch. 1 §4), so the
/// correction is written here as it is everywhere else.
fn push_int(out: &mut String, v: t27) {
    let mut n = v;
    if n < 0 {
        out.push('-');
        n = 0 - n;
    }
    if n == 0 {
        out.push('0');
        return;
    }
    let mut digits: Vec<char> = Vec::new();
    while n > 0 {
        let d = n % 10;
        let fixed = if d < 0 { d + 10 } else { d };
        digits.push(char::try_from(48 + fixed).unwrap());
        n = (n - fixed) / 10;
    }
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(digits[i]);
    }
}
