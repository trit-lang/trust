// A whole program as TIR, from a bundle on stdin.
//
//     trust bundle <root.tr> | trust run bootstrap/program.tr
//
// `bootstrap/build.tr` lowers one file; this lowers a *program*, which is a
// tree of them (Ch. 6 §1). The three passes of §4 run first, so what reaches
// the lowering is one flat list of items whose names are their paths — which
// is what the rest of a compiler has always been handed.
//
// What is emitted is then cut down to what `main` reaches. A function nothing
// calls is a function this program does not contain, and the two
// implementations have to agree about which those are.

mod ast;
mod bundle;
mod input;
mod layout;
mod lex;
mod lower;
mod parse;
mod resolve;

fn main() -> t27 {
    let src = input::read_all();
    let mods = bundle::split(&src);
    let mut w = resolve::World { modules: Vec::new(), defined: Vec::new(), sources: Vec::new() };
    let mut files: Vec<Vec<ast::Item>> = Vec::new();

    // The prelude arrives under a name no module path can be, because it is
    // not a module and has no path (Ch. 6 §3.3). Its items are the root's,
    // and an item the *program* defines replaces one of the same name —
    // everywhere, which is what §3.3 means by shadowing.
    let mut prelude: Vec<ast::Item> = Vec::new();
    let mut defined: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < mods.len() {
        if !mods[i].path.same("#prelude") {
            let mut p = parse::Parser {
                src: mods[i].text.to_string(),
                at: 0,
                no_struct: false,
                counter: 0,
            };
            match parse::file(&mut p) {
                Result::Ok(items) => {
                    let mut k: taddr = 0;
                    while k < items.len() {
                        match ast::defines(&items[k].what) {
                            Option::Some(n) => defined.push(n),
                            Option::None => {}
                        }
                        k += 1;
                    }
                }
                Result::Err(err) => {}
            }
        }
        i += 1;
    }
    let mut i: taddr = 0;
    while i < mods.len() {
        if mods[i].path.same("#prelude") {
            let mut p = parse::Parser {
                src: mods[i].text.to_string(),
                at: 0,
                no_struct: false,
                counter: 0,
            };
            match parse::file(&mut p) {
                Result::Ok(items) => {
                    for item in items {
                        let keep = match ast::defines(&item.what) {
                            Option::Some(n) => !resolve::holds(&defined, &n),
                            Option::None => true,
                        };
                        if keep {
                            resolve::gather(&mut w, "", &item);
                            prelude.push(item);
                        }
                    }
                }
                Result::Err(err) => {}
            }
            i += 1;
            continue;
        }
        let here = resolve::plain(&mods[i].path);
        w.sources.push(here.to_string());
        files.push(read(&mods[i], &mut w, &here));
        i += 1;
    }

    // Passes two and three, a module at a time, into one list — the
    // prelude's first, since that is where the merge puts them.
    let mut items: Vec<ast::Item> = Vec::new();
    let root = resolve::scope_of(&w, "", &prelude);
    let mut here_at = resolve::At {
        here: "".to_string(),
        scope: root,
        locals: Vec::new(),
    };
    for item in prelude {
        let word = ast::kind(&item.what);
        if !word.same("mod") && !word.same("use") {
            items.push(resolve::rewrite(&w, &mut here_at, item));
        }
    }
    // `w.sources` and not `mods`: the prelude is a section of the bundle
    // and not a module of the program, so it was skipped when the modules
    // were read and the two lists no longer line up. They did before the
    // prelude was handed over, which is why nothing said so.
    let mut f: taddr = 0;
    for each in files {
        let here = w.sources[f].to_string();
        let scope = resolve::scope_of(&w, &here, &each);
        let mut at = resolve::At { here: here, scope: scope, locals: Vec::new() };
        for item in each {
            let word = ast::kind(&item.what);
            if !word.same("mod") && !word.same("use") {
                items.push(resolve::rewrite(&w, &mut at, item));
            }
        }
        f += 1;
    }

    println("tir 0.1 target \"tritium\"");

    let made = lower::module(&items);
    let mut n: taddr = 0;
    while n < made.len() {
        println("");
        print(&made[n].text);
        n += 1;
    }
    0
}

/// One module, parsed, with what it defines added to the world.
fn read(m: &bundle::Module, w: &mut resolve::World, here: &str) -> Vec<ast::Item> {
    let mut p = parse::Parser { src: m.text.to_string(), at: 0, no_struct: false, counter: 0 };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut k: taddr = 0;
            while k < items.len() {
                resolve::gather(w, here, &items[k]);
                k += 1;
            }
            items
        }
        Result::Err(err) => {
            print("error ");
            print(&m.path);
            print(" ");
            print_int(err.at as t27);
            println("");
            let empty: Vec<ast::Item> = Vec::new();
            empty
        }
    }
}
