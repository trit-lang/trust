// A whole program as TIR, from a bundle on stdin.
//
//     trust bundle <root.tr> | trust run bootstrap/program.tr
//
// `bootstrap/build.tr` lowers one file; this lowers a *program*, which is a
// tree of them (Ch. 6 §1). The three passes of §4 run first, so what reaches
// the lowering is one flat list of items whose names are their paths — which
// is what the rest of a compiler has always been handed.
//
// What is emitted is then cut down to what `main` reaches. A function nothing
// calls is a function this program does not contain, and the two
// implementations have to agree about which those are.

mod ast;
mod bundle;
mod input;
mod layout;
mod lex;
mod lower;
mod parse;
mod resolve;

/// One function, emitted: its name, its text, and what it calls.
pub struct Emitted {
    pub name: String,
    pub text: String,
    pub calls: Vec<String>,
}

fn main() -> t27 {
    let src = input::read_all();
    let mods = bundle::split(&src);
    let mut w = resolve::World { modules: Vec::new(), defined: Vec::new(), sources: Vec::new() };
    let mut files: Vec<Vec<ast::Item>> = Vec::new();

    // The prelude arrives under a name no module path can be, because it is
    // not a module and has no path (Ch. 6 §3.3). Its items are the root's,
    // and an item the *program* defines replaces one of the same name —
    // everywhere, which is what §3.3 means by shadowing.
    let mut prelude: Vec<ast::Item> = Vec::new();
    let mut defined: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    while i < mods.len() {
        if !mods[i].path.same("#prelude") {
            let mut p = parse::Parser {
                src: mods[i].text.to_string(),
                at: 0,
                no_struct: false,
            };
            match parse::file(&mut p) {
                Result::Ok(items) => {
                    let mut k: taddr = 0;
                    while k < items.len() {
                        match ast::defines(&items[k].what) {
                            Option::Some(n) => defined.push(n),
                            Option::None => {}
                        }
                        k += 1;
                    }
                }
                Result::Err(err) => {}
            }
        }
        i += 1;
    }
    let mut i: taddr = 0;
    while i < mods.len() {
        if mods[i].path.same("#prelude") {
            let mut p = parse::Parser {
                src: mods[i].text.to_string(),
                at: 0,
                no_struct: false,
            };
            match parse::file(&mut p) {
                Result::Ok(items) => {
                    for item in items {
                        let keep = match ast::defines(&item.what) {
                            Option::Some(n) => !resolve::holds(&defined, &n),
                            Option::None => true,
                        };
                        if keep {
                            resolve::gather(&mut w, "", &item);
                            prelude.push(item);
                        }
                    }
                }
                Result::Err(err) => {}
            }
            i += 1;
            continue;
        }
        let here = resolve::plain(&mods[i].path);
        w.sources.push(here.to_string());
        files.push(read(&mods[i], &mut w, &here));
        i += 1;
    }

    // Passes two and three, a module at a time, into one list — the
    // prelude's first, since that is where the merge puts them.
    let mut items: Vec<ast::Item> = Vec::new();
    let root = resolve::scope_of(&w, "", &prelude);
    let mut here_at = resolve::At {
        here: "".to_string(),
        scope: root,
        locals: Vec::new(),
    };
    for item in prelude {
        let word = ast::kind(&item.what);
        if !word.same("mod") && !word.same("use") {
            items.push(resolve::rewrite(&w, &mut here_at, item));
        }
    }
    let mut f: taddr = 0;
    for each in files {
        let here = resolve::plain(&mods[f].path);
        let scope = resolve::scope_of(&w, &here, &each);
        let mut at = resolve::At { here: here, scope: scope, locals: Vec::new() };
        for item in each {
            let word = ast::kind(&item.what);
            if !word.same("mod") && !word.same("use") {
                items.push(resolve::rewrite(&w, &mut at, item));
            }
        }
        f += 1;
    }

    println("tir 0.1 target \"tritium\"");

    let mut out: Vec<Emitted> = Vec::new();
    let mut k: taddr = 0;
    while k < items.len() {
        match &items[k].what {
            ast::What::Function(fun) => {
                let sigs = lower::signatures(&items);
                let params = lower::parameters(&items);
                let defs = lower::definitions(&items);
                let drops = lower::destructors(&items);
                let mut text: String = Vec::new();
                if lower::function(fun, sigs, params, defs, drops, "".to_string(), &mut text) {
                    let calls = callees(&text);
                    out.push(Emitted { name: fun.name.to_string(), text: text, calls: calls });
                }
            }
            _ => {}
        }
        k += 1;
    }
    let mut d: taddr = 0;
    while d < items.len() {
        match &items[d].what {
            ast::What::Impl(gs, tr, ty, fns) => {
                let owner = lower::written_head(ty);
                let named = match tr {
                    Option::Some(t) => lower::written_head(t),
                    Option::None => "".to_string(),
                };
                let mut m: taddr = 0;
                while m < fns.len() {
                    let sigs = lower::signatures(&items);
                    let params = lower::parameters(&items);
                    let defs = lower::definitions(&items);
                    let drops = lower::destructors(&items);
                    let mut text: String = Vec::new();
                    // `Drop` is the one impl whose method becomes a function
                    // named after the *type* and not after the method.
                    let made = if named.same("Drop") {
                        lower::destructor(
                            &fns[m], &owner, sigs, params, defs, drops, &mut text)
                    } else {
                        lower::function(
                            &fns[m], sigs, params, defs, drops,
                            owner.to_string(), &mut text)
                    };
                    if made {
                        let mut full: String = Vec::new();
                        if named.same("Drop") {
                            full.push_str("drop.");
                            full.push_str(&owner);
                        } else {
                            full.push_str(&owner);
                            full.push_str(".");
                            full.push_str(&fns[m].name);
                        }
                        let calls = callees(&text);
                        out.push(Emitted { name: full, text: text, calls: calls });
                    }
                    m += 1;
                }
            }
            _ => {}
        }
        d += 1;
    }

    let live = reachable(&out);
    let mut n: taddr = 0;
    while n < out.len() {
        if resolve::holds(&live, &out[n].name) {
            println("");
            print(&out[n].text);
        }
        n += 1;
    }
    0
}

/// Which functions this program contains: the ones `main` reaches, or all of
/// them where there is no `main` and every function is its own root.
fn reachable(out: &Vec<Emitted>) -> Vec<String> {
    let mut live: Vec<String> = Vec::new();
    let mut queue: Vec<String> = Vec::new();
    let mut has_main = false;
    let mut i: taddr = 0;
    while i < out.len() {
        if out[i].name.same("main") {
            has_main = true;
        }
        i += 1;
    }
    if has_main {
        queue.push("main".to_string());
    } else {
        let mut k: taddr = 0;
        while k < out.len() {
            queue.push(out[k].name.to_string());
            k += 1;
        }
    }
    loop {
        match queue.pop() {
            Option::Some(name) => {
                if !resolve::holds(&live, &name) {
                    let at = named_at(out, &name);
                    live.push(name);
                    if at >= 0 {
                        let mut c: taddr = 0;
                        while c < out[at].calls.len() {
                            queue.push(out[at].calls[c].to_string());
                            c += 1;
                        }
                    }
                }
            }
            Option::None => return live,
        }
    }
}

/// Which emitted function is called that, or −1.
fn named_at(out: &Vec<Emitted>, name: &str) -> taddr {
    let mut i: taddr = 0;
    while i < out.len() {
        if out[i].name.same(name) {
            return i;
        }
        i += 1;
    }
    0 - 1
}

/// Every `call @name` in a function's text.
///
/// Read back out of what was written rather than collected while writing:
/// what a function calls is what its text says it calls, and a second list
/// would be a second thing to keep right.
fn callees(text: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: taddr = 0;
    let want = "call @";
    while i + want.len() < text.len() {
        let mut hit = true;
        let mut k: taddr = 0;
        while k < want.len() {
            if text[i + k] != want[k] {
                hit = false;
            }
            k += 1;
        }
        if hit {
            let mut name: String = Vec::new();
            let mut j = i + want.len();
            while j < text.len() && text[j] != '(' {
                name.push(text[j]);
                j += 1;
            }
            out.push(name);
            i = j;
        } else {
            i += 1;
        }
    }
    out
}

/// One module, parsed, with what it defines added to the world.
fn read(m: &bundle::Module, w: &mut resolve::World, here: &str) -> Vec<ast::Item> {
    let mut p = parse::Parser { src: m.text.to_string(), at: 0, no_struct: false };
    match parse::file(&mut p) {
        Result::Ok(items) => {
            let mut k: taddr = 0;
            while k < items.len() {
                resolve::gather(w, here, &items[k]);
                k += 1;
            }
            items
        }
        Result::Err(err) => {
            print("error ");
            print(&m.path);
            print(" ");
            print_int(err.at as t27);
            println("");
            let empty: Vec<ast::Item> = Vec::new();
            empty
        }
    }
}
