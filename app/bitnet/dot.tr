// dot.tr — the scalar kernel the device will replace.
//
// Two functions, one walk:
//
//   dot    — k lanes of the formula in plan/vdot-device.md:
//            Σ_{i<k} trit(W + ⌊i/9⌋, i mod 9)·a_i
//   matvec — `dot` row after row, which is what a linear layer is
//
// The device's contract, kept here so the swap is a swap:
//
// - **Weights are trytes**, nine trits each, read low trit first (`trit at
//   position i mod 9` is the low trit after i divisions — see pack.tr).
// - **Activations are trytes**, one element each, |a| ≤ 9841.
// - **The sum is exact, then wrapped once** into the word. This accumulator
//   is a word, and |Σ| ≤ K·9841 is exact inside it for any K under
//   3.87·10^8 — the plan's own bound — so the wrap is a no-op at every size
//   this program runs, and the reason is stated rather than assumed.
//
// And the ternary contract, which is the whole reason this workload is the
// reason for the machine: a lane is `acc += a`, `acc -= a` or nothing. No
// multiply anywhere below, because {−1, 0, +1} times an integer is
// add/subtract/skip. When the device lands, the per-lane cost visible to
// the ISA is 4 retired instructions per *row*; today it is the loop below,
// and the difference between those two numbers is what the bench is for.

// The dot of one row of packed weights (starting at tryte `from`) against k
// activations. k is the lane count — the device's K, and the number V_LANES
// will count by, whether a lane's trit was zero or not.
pub fn dot(w: &Vec<t27>, from: taddr, a: &Vec<t27>, k: taddr) -> t27 {
    let mut acc: t27 = 0;
    let mut i: taddr = 0;
    let mut cell_i = from;
    // The cell read is *inside* the lane bound: a row that ends on its last
    // trit must not load the tryte after it, or the last row of the matrix
    // reads off the end of the weights.
    while i < k {
        let mut cell = w[cell_i];
        let mut j: taddr = 0;
        while j < 9 && i < k {
            let t = cell % 3;
            cell = cell / 3;
            if t == 1 {
                acc += a[i];
            } else {
                if t == 0 - 1 {
                    acc -= a[i];
                }
            }
            i += 1;
            j += 1;
        }
        cell_i += 1;
    }
    acc
}

// rows·cols weights, packed row-major with cols a multiple of nine (every
// size this program runs is), against a cols-vector. The answer is rows
// cell-dots. `cols / 9` is exact, so the row starts are whole trytes and no
// row straddles one — the partial-tryte case the device answers with
// i mod 9 never arises here.
pub fn matvec(w: &Vec<t27>, a: &Vec<t27>, rows: taddr, cols: taddr) -> Vec<t27> {
    let mut out: Vec<t27> = Vec::new();
    out.reserve(rows);
    let row_cells = cols / 9;
    let mut r: taddr = 0;
    while r < rows {
        out.push(dot(w, r * row_cells, a, cols));
        r += 1;
    }
    out
}

#[test]
fn a_dot_by_hand_is_the_dot_by_kernel() {
    // Weights [1, −1, 0, 1], activations [10, 20, 30, 40]:
    // 1·10 − 1·20 + 0·30 + 1·40 = 30, and the expected sum is computed with
    // the '*' the kernel never uses, so the two are not the same code.
    let mut trits: Vec<t27> = Vec::new();
    trits.push(1);
    trits.push(0 - 1);
    trits.push(0);
    trits.push(1);
    let w = pack::pack_trits(&trits);
    let mut a: Vec<t27> = Vec::new();
    a.push(10);
    a.push(20);
    a.push(30);
    a.push(40);
    if dot(&w, 0, &a, 4) != 10 - 20 + 40 { trap(); }
}

#[test]
fn all_plus_ones_is_a_plain_sum_and_all_minus_ones_its_negation() {
    let mut trits: Vec<t27> = Vec::new();
    let mut a: Vec<t27> = Vec::new();
    let mut i: taddr = 0;
    while i < 18 {
        trits.push(1);
        a.push(5);
        i += 1;
    }
    let w = pack::pack_trits(&trits);
    if dot(&w, 0, &a, 18) != 90 { trap(); }
    let mut n: taddr = 0;
    while n < 18 {
        trits[n] = 0 - 1;
        n += 1;
    }
    let w2 = pack::pack_trits(&trits);
    if dot(&w2, 0, &a, 18) != 0 - 90 { trap(); }
}

#[test]
fn a_matvec_rows_each_row_against_the_same_vector() {
    // Two rows of nine: row 0 is all +1 (sum 45), row 1 all −1 (−45).
    let mut trits: Vec<t27> = Vec::new();
    let mut a: Vec<t27> = Vec::new();
    let mut i: taddr = 0;
    while i < 18 {
        if i < 9 { trits.push(1); } else { trits.push(0 - 1); }
        i += 1;
    }
    let mut j: taddr = 0;
    while j < 9 {
        a.push(5);
        j += 1;
    }
    let w = pack::pack_trits(&trits);
    let y = matvec(&w, &a, 2, 9);
    if y.len() != 2 { trap(); }
    if y[0] != 45 { trap(); }
    if y[1] != 0 - 45 { trap(); }
}
