// ttt — noughts and crosses, played in trits, against a deterministic O.
//
//     printf '5\n1\n3\n' | trust run app/ttt/main.tr
//
// The board is nine trits, because the game is three-valued at every level:
// a cell is `1t` (X), `-1t` (O) or `0t` (empty); a line is won when its
// three cells sum to **+3** or **−3** — the winning condition is one
// comparison, not a table, and it never needs to know which mark is which
// player. This is the shape of logic the machine's ALU speaks natively
// (AM §3.4): three-way, with zero in the middle.
//
// What is decided here:
//
// - The human is **X** and moves first; the machine is **O** and answers
//   deterministically: win if it can, block a win if it must, then centre,
//   first free corner, first free side. Determinism is the point — the same
//   moves always get the same game, so a whole game can be a test the way
//   bitnet's forward pass is.
// - Cells are named `1` … `9` in reading order, because that is how the
//   keypad under a hand is laid out. A bad line (a letter, a 0, a taken
//   cell) is an `error:` line and the question is asked again — a shaky
//   hand is not a halted machine, recalc's rule.
// - `q` resigns the current game; after a result a bare line starts the
//   next. EOF is the way out entirely, the port's own answer (ISA §2.2).

fn getchar() -> t9;             // declared here, defined in runtime.t27

// The eight lines, as index triples of the 3 × 3 board. Written where they
// are used because the table is data every reader already knows.
fn line(k: taddr, which: taddr) -> taddr {
    // which: 0,1,2 = rows; 3,4,5 = columns; 6,7 = the diagonals; k = cell
    if which < 3 { return which * 3 + k; }
    if which < 6 { return k * 3 + (which - 3); }
    if which == 6 { return k * 4; }         // 0, 4, 8
    2 + k * 2                               // 2, 4, 6
}

// The sum of line `which`, x3-and-plain. A win reads ±3 straight off.
fn line_sum(b: &[trit], which: taddr) -> t27 {
    (b[line(0, which)] as t27) + (b[line(1, which)] as t27) + (b[line(2, which)] as t27)
}

// +1 if X has won, −1 if O has, 0 otherwise.
fn winner(b: &[trit]) -> t27 {
    let mut w: taddr = 0;
    while w < 8 {
        let s = line_sum(b, w);
        if s == 3 { return 1; }
        if s == 0 - 3 { return 0 - 1; }
        w += 1;
    }
    0
}

fn full(b: &[trit]) -> bool {
    let mut i: taddr = 0;
    while i < 9 {
        if b[i] == 0t { return false; }
        i += 1;
    }
    true
}

// The empty cell completing a line that holds two of `mark` — the machine's
// one look ahead, used for its own wins and for blocks alike.
fn find_line(b: &[trit], mark: trit) -> Option<taddr> {
    let mut w: taddr = 0;
    while w < 8 {
        let mut seen: t27 = 0;
        let mut empty: taddr = 9;
        let mut k: taddr = 0;
        while k < 3 {
            let idx = line(k, w);
            if b[idx] == mark { seen += 1; }
            if b[idx] == 0t { empty = idx; }
            k += 1;
        }
        if seen == 2 && empty != 9 { return Option::Some(empty); }
        w += 1;
    }
    Option::None
}

// The policy, in the order the header states it.
fn machine_move(b: &[trit]) -> taddr {
    match find_line(b, -1t) {           // take the win
        Option::Some(i) => { return i; },
        Option::None => {},
    }
    match find_line(b, 1t) {            // block the loss
        Option::Some(i) => { return i; },
        Option::None => {},
    }
    if b[4] == 0t { return 4; }         // centre
    if b[0] == 0t { return 0; }         // corners
    if b[2] == 0t { return 2; }
    if b[6] == 0t { return 6; }
    if b[8] == 0t { return 8; }
    let mut i: taddr = 0;               // sides
    while i < 9 {
        if b[i] == 0t { return i; }
        i += 1;
    }
    0                                   // unreachable: called on open boards
}

fn print_board(b: &[trit]) {
    let mut r: taddr = 0;
    while r < 3 {
        let mut row: Vec<char> = Vec::new();
        let mut c: taddr = 0;
        while c < 3 {
            let v = b[r * 3 + c];
            if v == 1t { row.push('X'); }
            if v == 0t { row.push('.'); }
            if v == -1t { row.push('O'); }
            row.push(' ');
            c += 1;
        }
        print(&row);
        println("");
        r += 1;
    }
    println("");
}

// A line is a cell name `1` … `9`, read as an index — or nothing.
fn parse_move(line: &Vec<char>) -> Option<taddr> {
    if line.len() != 1 { return Option::None; }
    let c = line[0];
    if c < '1' || c > '9' { return Option::None; }
    Option::Some(((c as t27) - 49) as taddr)
}

fn trim(s: &Vec<char>) -> Vec<char> {
    let mut lo: taddr = 0;
    while lo < s.len() {
        if s[lo] != ' ' { break; }
        lo += 1;
    }
    let mut hi: taddr = s.len();
    while hi > lo {
        if s[hi - 1] != ' ' { break; }
        hi -= 1;
    }
    let mut out: Vec<char> = Vec::new();
    let mut i = lo;
    while i < hi {
        out.push(s[i]);
        i += 1;
    }
    out
}

// One line of input, or `None` when the port said *closed* (ISA §2.2).
fn read_line() -> Option<Vec<char>> {
    let mut line: Vec<char> = Vec::new();
    let mut saw_any = false;
    loop {
        let c = getchar() as t27;
        if c == 0 - 2 {
            if saw_any { return Option::Some(line); }
            return Option::None;
        }
        if c >= 0 {
            if c == 10 { return Option::Some(line); }
            saw_any = true;
            line.push(char::try_from(c).unwrap());
        }
    }
}

// One whole game. `false` means the stream is done with us.
fn play() -> bool {
    let mut b: [trit; 9] = [0t; 9];
    print_board(&b);
    loop {
        // X, the human.
        let mut placed = false;
        while !placed {
            print("move? ");
            match read_line() {
                Option::None => { return false; },
                Option::Some(raw) => {
                    let line = trim(&raw);
                    if line.len() == 1 && line[0] == 'q' {
                        println("resigned");
                        return true;
                    }
                    match parse_move(&line) {
                        Option::Some(at) => {
                            if b[at] != 0t {
                                println("error: that cell is taken");
                            } else {
                                b[at] = 1t;
                                placed = true;
                            }
                        },
                        Option::None => println("error: a cell is 1 to 9"),
                    }
                },
            }
        }
        print_board(&b);
        if winner(&b) == 1 {
            println("X wins");
            return true;
        }
        if full(&b) {
            println("draw");
            return true;
        }
        // O, the machine.
        let at = machine_move(&b);
        b[at] = -1t;
        print("O plays ");
        println_int((at + 1) as t27);
        print_board(&b);
        if winner(&b) == 0 - 1 {
            println("O wins");
            return true;
        }
        if full(&b) {
            println("draw");
            return true;
        }
    }
}

fn main() -> t27 {
    let mut again = true;
    while again {
        again = play();
    }
    0
}

#[test]
fn lines_sum_to_their_verdict() {
    let mut b: [trit; 9] = [0t; 9];
    if winner(&b) != 0 { trap(); }
    b[0] = 1t; b[1] = 1t; b[2] = 1t;        // top row for X
    if winner(&b) != 1 { trap(); }
    let mut c: [trit; 9] = [0t; 9];
    c[2] = -1t; c[4] = -1t; c[6] = -1t;     // anti-diagonal for O
    if winner(&c) != 0 - 1 { trap(); }
    let mut d: [trit; 9] = [0t; 9];
    d[1] = -1t; d[4] = -1t; d[7] = -1t;     // middle column for O
    if winner(&d) != 0 - 1 { trap(); }
}

#[test]
fn taken_lines_are_found_for_both_ends() {
    let mut b: [trit; 9] = [0t; 9];
    b[3] = 1t; b[4] = 1t;                   // X threatens at 5
    match find_line(&b, 1t) {
        Option::Some(i) => { if i != 5 { trap(); } },
        Option::None => { trap(); },
    }
    match find_line(&b, -1t) {
        Option::Some(_) => { trap(); },     // O holds nothing yet
        Option::None => {},
    }
    b[6] = -1t; b[7] = -1t;                 // O threatens at 8
    match find_line(&b, -1t) {
        Option::Some(i) => { if i != 8 { trap(); } },
        Option::None => { trap(); },
    }
}

#[test]
fn the_policy_wins_then_blocks_then_prefers_the_centre() {
    // Empty board → centre.
    let b0: [trit; 9] = [0t; 9];
    if machine_move(&b0) != 4 { trap(); }

    // O at 0 and 1, X scattered → O takes 2 and the game.
    let mut b1: [trit; 9] = [0t; 9];
    b1[0] = -1t; b1[1] = -1t; b1[4] = 1t; b1[8] = 1t;
    if machine_move(&b1) != 2 { trap(); }

    // X at 6 and 7, O harmless → O blocks at 8.
    let mut b2: [trit; 9] = [0t; 9];
    b2[6] = 1t; b2[7] = 1t; b2[4] = -1t;
    if machine_move(&b2) != 8 { trap(); }

    // Centre taken with no lines → first corner.
    let mut b3: [trit; 9] = [0t; 9];
    b3[4] = 1t;
    if machine_move(&b3) != 0 { trap(); }
}

#[test]
fn a_scripted_game_plays_out_as_recorded() {
    // X: 1, then 2. O centres, then must block at 3. X takes corner 7; O
    // blocks the 1-4-7 line at 4. X takes 5; the board is X at 1,2,5,7 —
    // no line — and O at 3,4 — and… the record below is the policy's,
    // move for move, and that is the point of pinning it.
    let mut b: [trit; 9] = [0t; 9];
    b[0] = 1t;                              // X plays 1
    let m1 = machine_move(&b);
    if m1 != 4 { trap(); }                  // O takes centre
    b[4] = -1t;
    b[1] = 1t;                              // X plays 2
    let m2 = machine_move(&b);
    if m2 != 2 { trap(); }                  // O blocks at 3
    b[2] = -1t;
    b[6] = 1t;                              // X plays 7
    let m3 = machine_move(&b);
    if m3 != 3 { trap(); }                  // O blocks the 1-4-7 line at 4
    b[3] = -1t;
    if winner(&b) != 0 { trap(); }
}

#[test]
fn moves_parse_only_as_cell_names() {
    let five = "5".to_string();
    match parse_move(&five) {
        Option::Some(i) => { if i != 4 { trap(); } },
        Option::None => { trap(); },
    }
    let ten = "10".to_string();
    if parse_move(&ten).is_some() { trap(); }
    let zero = "0".to_string();
    if parse_move(&zero).is_some() { trap(); }
    let letter = "x".to_string();
    if parse_move(&letter).is_some() { trap(); }
    let padded = " 7 ".to_string();
    let p = trim(&padded);
    match parse_move(&p) {
        Option::Some(i) => { if i != 6 { trap(); } },
        Option::None => { trap(); },
    }
}
