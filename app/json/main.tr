// json — reads a JSON document off the stream, prints it back, canonical.
//
//     printf '{"a": [1, 2.5, true, null], "b": {"c": "x"}}' | trust run app/json/main.tr
//
// The parse is recursive descent over the whole stream. The print is *one*
// canonical form: two-space indentation, keys in the order the document
// named them, minimal escapes, numbers at the machine's honest precision.
// Running a document through twice is an identity — that is the whole
// contract, and the tests hold it.
//
// What is decided here:
//
// - **Numbers are fixed point at scale 3^11.** There is no floating point
//   on this machine (AM §7), so `0.1` is what 177 147 goes into oncely, not
//   what IEEE says. Integer parts beyond ~21 million are refused as
//   `bad number` (checked arithmetic, never a halt — recalc's rule);
//   fractions keep six decimal digits and truncate the rest, because the
//   scale holds about six. Exponents up to ±27 apply one step at a time,
//   each step checked, every rounding the machine's own.
// - **Objects keep their key order.** Ch. 5 §7 declines to sort anything,
//   and this app does not invent the missing sort: a document's order is
//   part of what it said, so the canonical print keeps it. (Nothing in the
//   output then depends on iteration order of any collection — the radix of
//   determinism, wordfreq's rule.)
// - **Errors carry a kind and a position**, printed as one line
//   (`error: bad escape at 17`). The parser's failures are values; nest
//   past 243 (3^5) levels and the answer is `too deep`, not a stack
//   against the heap.
// - **`\u` escapes may join into surrogates**: a high half must be followed
//   immediately by its low half and the pair becomes one `char`
//   (Ch. 5 §1.2), so `"\ud83d\ude00"` prints as 🙂. A lone surrogate is
//   `bad unicode`.

fn getchar() -> t9;             // declared here, defined in runtime.t27

const ONE: t27 = 177147;        // 3^11, the fixed-point unit
const DEPTH_MAX: t27 = 243;     // 3^5

enum Json {
    Null,
    Bool(bool),
    Num(t27),
    Str(Vec<char>),
    Arr(Vec<Json>),
    Obj(Vec<(Vec<char>, Json)>),
}

enum JsonErr {
    Eof(taddr),
    Unexpected(taddr),
    BadNumber(taddr),
    BadEscape(taddr),
    BadUnicode(taddr),
    Unterminated(taddr),
    TooDeep(taddr),
    Trailing(taddr),
}

// ------------------------------------------------------------- reading ---

fn skip_ws(s: &Vec<char>, at: &mut taddr) {
    while *at < s.len() {
        let c = s[*at];
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            *at += 1;
        } else {
            break;
        }
    }
}

// The four literal keywords, spelled out past the cursor when they are
// what is actually there.
fn keyword(s: &Vec<char>, at: &mut taddr, kw: &str) -> bool {
    let mut i: taddr = 0;
    while i < kw.len() {
        if *at + i >= s.len() { return false; }
        if s[*at + i] != kw[i] { return false; }
        i += 1;
    }
    *at += kw.len();
    true
}

fn hex4(s: &Vec<char>, at: &mut taddr) -> Result<t27, JsonErr> {
    if *at + 4 > s.len() { return Result::Err(JsonErr::Eof(*at)); }
    let mut v: t27 = 0;
    let mut k: taddr = 0;
    while k < 4 {
        let c = s[*at + k];
        let mut d: t27 = 0 - 1;
        if c >= '0' && c <= '9' { d = (c as t27) - 48; }
        if c >= 'a' && c <= 'f' { d = (c as t27) - 87; }
        if c >= 'A' && c <= 'F' { d = (c as t27) - 55; }
        if d < 0 { return Result::Err(JsonErr::BadUnicode(*at)); }
        v = v * 16 + d;
        k += 1;
    }
    *at += 4;
    Result::Ok(v)
}

fn parse_string(s: &Vec<char>, at: &mut taddr) -> Result<Vec<char>, JsonErr> {
    // The opening quote is already seen (that is how we got here).
    *at += 1;
    let mut out: Vec<char> = Vec::new();
    loop {
        if *at >= s.len() {
            return Result::Err(JsonErr::Unterminated(*at));
        }
        let c = s[*at];
        if c == '"' {
            *at += 1;
            return Result::Ok(out);
        }
        if c == '\\' {
            *at += 1;
            if *at >= s.len() { return Result::Err(JsonErr::Unterminated(*at)); }
            let e = s[*at];
            if e == '"' { out.push('"'); *at += 1; }
            else if e == '\\' { out.push('\\'); *at += 1; }
            else if e == '/' { out.push('/'); *at += 1; }
            else if e == 'b' { out.push('\u{8}'); *at += 1; }
            else if e == 'f' { out.push('\u{c}'); *at += 1; }
            else if e == 'n' { out.push('\n'); *at += 1; }
            else if e == 'r' { out.push('\r'); *at += 1; }
            else if e == 't' { out.push('\t'); *at += 1; }
            else if e == 'u' {
                *at += 1;
                let first = hex4(s, at)?;
                let mut scalar = first;
                if first >= 55296 && first <= 56319 {         // high half
                    if *at + 1 >= s.len() || s[*at] != '\\' || s[*at + 1] != 'u' {
                        return Result::Err(JsonErr::BadUnicode(*at));
                    }
                    *at += 2;
                    let second = hex4(s, at)?;
                    if second < 56320 || second > 57343 {
                        return Result::Err(JsonErr::BadUnicode(*at));
                    }
                    scalar = 65536 + (first - 55296) * 1024 + (second - 56320);
                } else {
                    if first >= 56320 && first <= 57343 {     // a low half, alone
                        return Result::Err(JsonErr::BadUnicode(*at));
                    }
                }
                match char::try_from(scalar) {
                    Option::Some(ch) => out.push(ch),
                    Option::None => { return Result::Err(JsonErr::BadUnicode(*at)); },
                }
            }
            else {
                return Result::Err(JsonErr::BadEscape(*at));
            }
        } else {
            out.push(c);
            *at += 1;
        }
    }
}

// Number: `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?` into fixed point.
// The rounding is the machine's at every step, and every multiply is
// checked rather than trapped (recalc's standing rule).
fn parse_number(s: &Vec<char>, at: &mut taddr) -> Result<t27, JsonErr> {
    let start = *at;
    let mut neg = false;
    if *at < s.len() && s[*at] == '-' {
        neg = true;
        *at += 1;
    }

    // Integer part: JSON's own leading-zero rule (0, or no leading zero).
    if *at >= s.len() || s[*at] < '0' || s[*at] > '9' {
        return Result::Err(JsonErr::BadNumber(start));
    }
    if s[*at] == '0' {
        *at += 1;
    } else {
        while *at < s.len() && s[*at] >= '0' && s[*at] <= '9' {
            *at += 1;
        }
    }
    let intdigits_end = *at;

    // Fraction part (required digits after the dot).
    let mut fracstart: taddr = *at;
    let mut fracend: taddr = *at;
    if *at < s.len() && s[*at] == '.' {
        *at += 1;
        fracstart = *at;
        if *at >= s.len() || s[*at] < '0' || s[*at] > '9' {
            return Result::Err(JsonErr::BadNumber(*at));
        }
        while *at < s.len() && s[*at] >= '0' && s[*at] <= '9' {
            *at += 1;
        }
        fracend = *at;
    }

    // Exponent part.
    let mut exp: t27 = 0;
    if *at < s.len() && (s[*at] == 'e' || s[*at] == 'E') {
        *at += 1;
        let mut eneg = false;
        if *at < s.len() && (s[*at] == '+' || s[*at] == '-') {
            eneg = s[*at] == '-';
            *at += 1;
        }
        if *at >= s.len() || s[*at] < '0' || s[*at] > '9' {
            return Result::Err(JsonErr::BadNumber(*at));
        }
        while *at < s.len() && s[*at] >= '0' && s[*at] <= '9' {
            if exp < 100 { exp = exp * 10 + (s[*at] as t27) - 48; }
            *at += 1;
        }
        if eneg { exp = 0 - exp; }
    }
    if exp > 27 || exp < 0 - 27 {
        return Result::Err(JsonErr::BadNumber(start));
    }

    // Assemble: the integer digits (scan only the ones before any dot),
    // checked into the fixed scale; then the first six fraction digits.
    let mut intv: t27 = 0;
    let mut i = start;
    if s[i] == '-' { i += 1; }
    while i < intdigits_end {
        let d = (s[i] as t27) - 48;
        match intv.checked_mul(10) {
            Option::Some(t) => { intv = t; },
            Option::None => { return Result::Err(JsonErr::BadNumber(start)); },
        }
        match intv.checked_add(d) {
            Option::Some(t) => { intv = t; },
            Option::None => { return Result::Err(JsonErr::BadNumber(start)); },
        }
        i += 1;
    }
    let mut v: t27 = match intv.checked_mul(ONE) {
        Option::Some(t) => t,
        Option::None => { return Result::Err(JsonErr::BadNumber(start)); },
    };

    if fracend > fracstart {
        let mut digits: Vec<t27> = Vec::new();
        let mut j = fracstart;
        while j < fracend {
            digits.push((s[j] as t27) - 48);
            j += 1;
        }
        // Six digits are what the scale holds; the rest *were read* (the
        // cursor passed them) and are truncated, not rounded — the cheap
        // deterministic answer, and worth a sentence so nobody fixes it.
        let mut use_n = digits.len();
        if use_n > 6 { use_n = 6; }
        let mut f: t27 = 0;
        let mut k: taddr = 0;
        while k < use_n {
            f = f * 10 + digits[k];
            k += 1;
        }
        let mut scale: t27 = 1;
        let mut m: taddr = 0;
        while m < use_n {
            scale = scale * 10;
            m += 1;
        }
        v += (f * ONE) / scale;
    }

    // Exponent: one decimal step at a time, each checked, each rounding
    // the machine's own (Ch. 1 §4).
    let mut e: t27 = 0;
    while e < exp {
        match v.checked_mul(10) {
            Option::Some(t) => { v = t; },
            Option::None => { return Result::Err(JsonErr::BadNumber(start)); },
        }
        e += 1;
    }
    while e < 0 - exp {
        v = v / 10;
        e += 1;
    }

    if neg { v = -v; }
    Result::Ok(v)
}

fn parse_value(s: &Vec<char>, at: &mut taddr, depth: t27) -> Result<Json, JsonErr> {
    if depth > DEPTH_MAX {
        return Result::Err(JsonErr::TooDeep(*at));
    }
    skip_ws(s, at);
    if *at >= s.len() {
        return Result::Err(JsonErr::Eof(*at));
    }
    let c = s[*at];
    if c == '{' {
        *at += 1;
        let mut members: Vec<(Vec<char>, Json)> = Vec::new();
        skip_ws(s, at);
        if *at < s.len() && s[*at] == '}' {
            *at += 1;
            return Result::Ok(Json::Obj(members));
        }
        loop {
            skip_ws(s, at);
            if *at >= s.len() { return Result::Err(JsonErr::Eof(*at)); }
            if s[*at] != '"' { return Result::Err(JsonErr::Unexpected(*at)); }
            let key = parse_string(s, at)?;
            skip_ws(s, at);
            if *at >= s.len() { return Result::Err(JsonErr::Eof(*at)); }
            if s[*at] != ':' { return Result::Err(JsonErr::Unexpected(*at)); }
            *at += 1;
            let v = parse_value(s, at, depth + 1)?;
            members.push((key.to_string(), v));
            skip_ws(s, at);
            if *at >= s.len() { return Result::Err(JsonErr::Eof(*at)); }
            if s[*at] == ',' {
                *at += 1;
            } else {
                if s[*at] == '}' {
                    *at += 1;
                    return Result::Ok(Json::Obj(members));
                }
                return Result::Err(JsonErr::Unexpected(*at));
            }
        }
    }
    if c == '[' {
        *at += 1;
        let mut items: Vec<Json> = Vec::new();
        skip_ws(s, at);
        if *at < s.len() && s[*at] == ']' {
            *at += 1;
            return Result::Ok(Json::Arr(items));
        }
        loop {
            let v = parse_value(s, at, depth + 1)?;
            items.push(v);
            skip_ws(s, at);
            if *at >= s.len() { return Result::Err(JsonErr::Eof(*at)); }
            if s[*at] == ',' {
                *at += 1;
            } else {
                if s[*at] == ']' {
                    *at += 1;
                    return Result::Ok(Json::Arr(items));
                }
                return Result::Err(JsonErr::Unexpected(*at));
            }
        }
    }
    if c == '"' {
        let text = parse_string(s, at)?;
        return Result::Ok(Json::Str(text));
    }
    if c == 't' {
        if keyword(s, at, "true") { return Result::Ok(Json::Bool(true)); }
        return Result::Err(JsonErr::Unexpected(*at));
    }
    if c == 'f' {
        if keyword(s, at, "false") { return Result::Ok(Json::Bool(false)); }
        return Result::Err(JsonErr::Unexpected(*at));
    }
    if c == 'n' {
        if keyword(s, at, "null") { return Result::Ok(Json::Null); }
        return Result::Err(JsonErr::Unexpected(*at));
    }
    if c == '-' || (c >= '0' && c <= '9') {
        let n = parse_number(s, at)?;
        return Result::Ok(Json::Num(n));
    }
    Result::Err(JsonErr::Unexpected(*at))
}

fn parse(s: &Vec<char>) -> Result<Json, JsonErr> {
    let mut at: taddr = 0;
    let v = parse_value(s, &mut at, 0)?;
    skip_ws(s, &mut at);
    if at < s.len() {
        return Result::Err(JsonErr::Trailing(at));
    }
    Result::Ok(v)
}

// ------------------------------------------------------------ printing ---

fn push_str(out: &mut Vec<char>, t: &str) {
    let mut i: taddr = 0;
    while i < t.len() {
        out.push(t[i]);
        i += 1;
    }
}

fn push_indent(out: &mut Vec<char>, depth: t27) {
    let mut i: t27 = 0;
    while i < depth {
        push_str(out, "  ");
        i += 1;
    }
}

// A decimal integer into the buffer, by hand: the digits are needed
// backwards-free so they can be pushed in order, and `%`-slicing is
// round-to-nearest (the trap the prelude's `floor_div` exists to close).
fn push_int(out: &mut Vec<char>, n: t27) {
    let mut digits: Vec<char> = Vec::new();
    let mut v = n;
    if v < 0 { v = -v; }
    loop {
        let d = floor_mod(v, 10);
        digits.push(char::try_from(d + 48).unwrap());
        v = floor_div(v, 10);
        if v == 0 { break; }
    }
    if n < 0 { out.push('-'); }
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        out.push(digits[i]);
    }
}

// A number at the fixed scale: an integer when it is one, else four decimal
// places rounded once (recalc's `print_fixed` arithmetic) with trailing
// zeros trimmed, so 1.5 prints as `1.5` and 0.1 prints as `0.1` — the
// shortest spelling the scale owns.
fn push_num(out: &mut Vec<char>, num: t27) {
    let mut n = num;
    let mut neg = false;
    if n < 0 {
        neg = true;
        n = -n;
    }
    let mut int_part = floor_div(n, ONE);
    let frac = n - int_part * ONE;          // 0 ≤ frac < ONE
    if frac == 0 {
        if neg { out.push('-'); }
        push_int(out, int_part);
        return;
    }
    let mut f4 = (frac * 10000) / ONE;      // round-to-nearest, once
    if f4 == 10000 {
        int_part += 1;
        f4 = 0;
    }
    if f4 == 0 {
        if neg { out.push('-'); }
        push_int(out, int_part);
        return;
    }
    if neg { out.push('-'); }
    push_int(out, int_part);
    out.push('.');
    let mut digits: Vec<t27> = Vec::new();
    digits.push(floor_div(f4, 1000));
    digits.push(floor_mod(floor_div(f4, 100), 10));
    digits.push(floor_mod(floor_div(f4, 10), 10));
    digits.push(floor_mod(f4, 10));
    let mut keep: taddr = 4;
    while keep > 1 {
        if digits[keep - 1] != 0 { break; }
        keep -= 1;
    }
    let mut i: taddr = 0;
    while i < keep {
        out.push(char::try_from(digits[i] + 48).unwrap());
        i += 1;
    }
}

// One hex digit. Only called for control characters (< 32), whose escapes
// the printer writes as `\u00XY` — so only two digits are ever wanted.
fn push_hex_digit(out: &mut Vec<char>, d: t27) {
    if d < 10 {
        out.push(char::try_from(d + 48).unwrap());
    } else {
        out.push(char::try_from(d + 87).unwrap());
    }
}

fn push_quoted(out: &mut Vec<char>, text: &Vec<char>) {
    out.push('"');
    let mut i: taddr = 0;
    while i < text.len() {
        let c = text[i];
        if c == '"' { push_str(out, "\\\""); }
        else if c == '\\' { push_str(out, "\\\\"); }
        else if c == '\n' { push_str(out, "\\n"); }
        else if c == '\r' { push_str(out, "\\r"); }
        else if c == '\t' { push_str(out, "\\t"); }
        else if (c as t27) < 32 {
            push_str(out, "\\u00");
            push_hex_digit(out, floor_div(c as t27, 16));
            push_hex_digit(out, floor_mod(c as t27, 16));
        } else {
            out.push(c);
        }
        i += 1;
    }
    out.push('"');
}

fn write_json(v: &Json, out: &mut Vec<char>, depth: t27) {
    match v {
        Json::Null => push_str(out, "null"),
        Json::Bool(b) => {
            if b { push_str(out, "true"); } else { push_str(out, "false"); }
        },
        Json::Num(n) => push_num(out, n),
        Json::Str(text) => push_quoted(out, text),
        Json::Arr(items) => {
            if items.len() == 0 {
                push_str(out, "[]");
                return;
            }
            push_str(out, "[\n");
            let mut i: taddr = 0;
            while i < items.len() {
                push_indent(out, depth + 1);
                write_json(&items[i], out, depth + 1);
                if i + 1 < items.len() { out.push(','); }
                out.push('\n');
                i += 1;
            }
            push_indent(out, depth);
            out.push(']');
        },
        Json::Obj(members) => {
            if members.len() == 0 {
                push_str(out, "{}");
                return;
            }
            push_str(out, "{\n");
            let mut i: taddr = 0;
            while i < members.len() {
                push_indent(out, depth + 1);
                let (k, mv) = &members[i];
                push_quoted(out, k);
                push_str(out, ": ");
                write_json(mv, out, depth + 1);
                if i + 1 < members.len() { out.push(','); }
                out.push('\n');
                i += 1;
            }
            push_indent(out, depth);
            out.push('}');
        },
    }
}

// --------------------------------------------------------------- main ---

fn report(e: JsonErr) {
    let (what, at) = match e {
        JsonErr::Eof(at) => ("the document ends early", at),
        JsonErr::Unexpected(at) => ("unexpected character", at),
        JsonErr::BadNumber(at) => ("bad number", at),
        JsonErr::BadEscape(at) => ("bad escape", at),
        JsonErr::BadUnicode(at) => ("bad unicode", at),
        JsonErr::Unterminated(at) => ("unterminated string", at),
        JsonErr::TooDeep(at) => ("too deep (past 243 levels)", at),
        JsonErr::Trailing(at) => ("content after the document", at),
    };
    print("error: ");
    print(what);
    print(" at ");
    println_int(at as t27);
}

fn read_all() -> Vec<char> {
    let mut s: Vec<char> = Vec::new();
    loop {
        let c = getchar() as t27;
        if c < 0 { break; }
        s.push(char::try_from(c).unwrap());
    }
    s
}

fn main() -> t27 {
    let s = read_all();
    match parse(&s) {
        Result::Ok(v) => {
            let mut out: Vec<char> = Vec::new();
            write_json(&v, &mut out, 0);
            print(&out);
            println("");
            0
        },
        Result::Err(e) => {
            report(e);
            1
        },
    }
}

// --------------------------------------------------------------- tests ---

// Parses, prints, and yields the canonical text — the three steps of main
// minus the port, so every test below is the whole program.
fn canon(text: &str) -> Vec<char> {
    let s = text.to_string();
    match parse(&s) {
        Result::Ok(v) => {
            let mut out: Vec<char> = Vec::new();
            write_json(&v, &mut out, 0);
            out
        },
        Result::Err(_) => { trap(); },
    }
}

fn fails(text: &str) -> bool {
    let s = text.to_string();
    match parse(&s) {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

#[test]
fn the_primitives_stand_alone() {
    let n = canon("null");
    if !n.same("null") { trap(); }
    let t = canon("true");
    if !t.same("true") { trap(); }
    let f = canon("  false  ");          // whitespace is not content
    if !f.same("false") { trap(); }
}

#[test]
fn numbers_print_in_their_shortest_form() {
    let a = canon("42");
    if !a.same("42") { trap(); }
    let b = canon("-3");
    if !b.same("-3") { trap(); }
    let c = canon("1.5000");
    if !c.same("1.5") { trap(); }
    let d = canon("1e3");
    if !d.same("1000") { trap(); }
    let e = canon("25e-2");
    if !e.same("0.25") { trap(); }
    let f = canon("-0.125");
    if !f.same("-0.125") { trap(); }
    let g = canon("0.00001");           // below the scale: truncates
    if !g.same("0") { trap(); }
    let h = canon("123.4567");
    if !h.same("123.4567") { trap(); }
}

#[test]
fn compound_documents_lay_out_canonically() {
    let doc = "{\"a\": [1, 2.5, true, null], \"b\": {\"c\": \"x\"}}";
    let want = "{\n  \"a\": [\n    1,\n    2.5,\n    true,\n    null\n  ],\n  \"b\": {\n    \"c\": \"x\"\n  }\n}";
    let got = canon(doc);
    if !got.same(want) { trap(); }
    let empty = canon("{\"x\": [], \"y\": {}}");
    if !empty.same("{\n  \"x\": [],\n  \"y\": {}\n}") { trap(); }
}

#[test]
fn canonical_is_a_fixpoint() {
    let once = canon("{\"k\": [1.5, {}, [true]]}");
    // And the canonical text parses to the same print — the identity the
    // header promises.
    let mut second: Vec<char> = Vec::new();
    match parse(&once) {
        Result::Ok(v) => write_json(&v, &mut second, 0),
        Result::Err(_) => { trap(); },
    }
    if !str_eq(&second, &once) { trap(); }
}

fn str_eq(a: &Vec<char>, b: &Vec<char>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: taddr = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    true
}

#[test]
fn escapes_both_directions() {
    let got = canon("\"a\\nb\\t\\\\c\\\"d\"");
    if !got.same("\"a\\nb\\t\\\\c\\\"d\"") { trap(); }
    // Control characters with no short escape go out as \u00XX.
    let ctrl = canon("\"\\u0001\"");
    if !ctrl.same("\"\\u0001\"") { trap(); }
    // BMP and astral both survive the round trip.
    let e = canon("\"\\u00e9\"");
    if !e.same("\"\u{e9}\"") { trap(); }
    let emoji = canon("\"\\ud83d\\ude00\"");
    if !emoji.same("\"\u{1f600}\"") { trap(); }
}

#[test]
fn error_cases_are_named() {
    if !fails("") { trap(); }                       // empty stream
    if !fails("tru") { trap(); }                    // half a keyword
    if !fails("{]") { trap(); }                     // wrong bracket
    if !fails("\"never closed") { trap(); }         // Unterminated
    if !fails("\"\\x\"") { trap(); }                // BadEscape
    if !fails("\"\\ud83d x\"") { trap(); }          // a surrogate left alone
    if !fails("1 2") { trap(); }                    // Trailing
    if !fails("01") { trap(); }                     // JSON's own zero rule
    if !fails("1.") { trap(); }                     // a dot needs digits
    if !fails("99999999999999999999") { trap(); }   // checked, not a halt
    if !fails("1e99") { trap(); }                   // beyond ±27
    if !fails("22000000") { trap(); }               // past the scaled word
}

#[test]
fn the_depth_fence_holds() {
    // 244 opens exceed the fence; 243 opens under it are a lot of JSON and
    // still an answer (an empty array at the bottom).
    let mut too: Vec<char> = Vec::new();
    let mut just: Vec<char> = Vec::new();
    let mut i: taddr = 0;
    while i < 244 { too.push('['); i += 1; }
    i = 0;
    while i < 243 {
        just.push('[');
        i += 1;
    }
    i = 0;
    while i < 243 { just.push(']'); i += 1; }
    match parse(&too) {
        Result::Ok(_) => { trap(); },
        Result::Err(e) => {
            match e {
                JsonErr::TooDeep(_) => {},
                _ => { trap(); },
            }
        },
    }
    match parse(&just) {
        Result::Ok(_) => {},
        Result::Err(_) => { trap(); },
    }
}
