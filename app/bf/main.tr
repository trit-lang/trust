// bf — a Brainfuck interpreter, bytes in and bytes out, on the one stream.
//
//     printf '++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.!\n' | trust run app/bf/main.tr
//
// The stream is the program, then a `!`, then the program's input, then
// EOF — the classic separator, and the only one that needs no quoting: `!`
// is not a command, so a program that uses it was writing comments, and the
// first one is where the program ends by definition.
//
// What is decided here, so the output says what it means:
//
// - **Cells are code units, 0 … 255, and wrap.** That is the classic byte
//   cell, and it keeps existing programs (the hello-world below included)
//   producing their classic output. The wrap is written out as two
//   comparisons rather than `% 256`, because `%` on this machine is
//   round-to-nearest and `255 + 1` would become **−1**, balanced and
//   useless (docs/status.md §9 lists the trap; life steps over the same
//   one for grid coordinates).
// - **The tape is 19 683 cells — 3^9 — and both ends are ends.** Walking
//   off either side stops the run with a named error rather than wrapping
//   onto the far edge, which is where garbage programs should end, loudly.
// - **`,` at end of input reads 0.** The other conventions (255, leave
//   unchanged) each break some corpus of programs; 0 is the one the
//   portable corpus is written against.
// - **Output and failure are not the same channel.** The interpreter core
//   collects the program's units and returns them with an `Option<BfErr>`,
//   so a failing program's error text never mixes with its bytes — main
//   prints one *or* the other. That is also what makes the core testable:
//   the whole interpreter minus the two port calls is one function.
// - **Loops are matched once, before running.** A `[` without its `]` is a
//   `BfErr` found before the first command executes, not a surprise thirty
//   million instructions in — and the jump table that matching builds is
//   what the run reads, so running back over mountains of unmatched
//   comments never happens either.

fn getchar() -> t9;             // declared here, defined in runtime.t27

const TAPE: taddr = 19683;      // 3^9 cells, addressed 0 … 19682

enum BfErr { UnmatchedBrackets, TapeLeft, TapeRight }

// The matching-bracket table, or which bracket was lonely. `jump[i]` for a
// bracket at i is the index of its partner; anything else is 0.
fn match_brackets(prog: &Vec<char>) -> Result<Vec<taddr>, BfErr> {
    let mut jump: Vec<taddr> = Vec::new();
    let mut i: taddr = 0;
    while i < prog.len() {
        jump.push(0);
        i += 1;
    }
    let mut stack: Vec<taddr> = Vec::new();
    let mut at: taddr = 0;
    while at < prog.len() {
        let c = prog[at];
        if c == '[' {
            stack.push(at);
        }
        if c == ']' {
            match stack.pop() {
                Option::Some(open) => {
                    jump[open] = at;
                    jump[at] = open;
                },
                Option::None => { return Result::Err(BfErr::UnmatchedBrackets); },
            }
        }
        at += 1;
    }
    if stack.len() > 0 { return Result::Err(BfErr::UnmatchedBrackets); }
    Result::Ok(jump)
}

// The interpreter: run `prog` reading `input`, return the units it printed
// and how it ended.
fn interpret(prog: &Vec<char>, input: &Vec<char>) -> (Vec<t27>, Option<BfErr>) {
    let mut out: Vec<t27> = Vec::new();

    let jump = match match_brackets(prog) {
        Result::Ok(j) => j,
        Result::Err(e) => { return (out, Option::Some(e)); },
    };

    let mut tape: Vec<t27> = Vec::new();
    let mut i: taddr = 0;
    while i < TAPE {
        tape.push(0);
        i += 1;
    }
    let mut ptr: taddr = 0;
    let mut src: taddr = 0;
    let mut ip: taddr = 0;
    while ip < prog.len() {
        let c = prog[ip];
        if c == '>' {
            if ptr + 1 >= TAPE { return (out, Option::Some(BfErr::TapeRight)); }
            ptr += 1;
        } else if c == '<' {
            if ptr == 0 { return (out, Option::Some(BfErr::TapeLeft)); }
            ptr -= 1;
        } else if c == '+' {
            let v = tape[ptr];
            if v == 255 { tape[ptr] = 0; } else { tape[ptr] = v + 1; }
        } else if c == '-' {
            let v = tape[ptr];
            if v == 0 { tape[ptr] = 255; } else { tape[ptr] = v - 1; }
        } else if c == '.' {
            out.push(tape[ptr]);
        } else if c == ',' {
            let mut v: t27 = 0;
            if src < input.len() {
                v = input[src] as t27;
                src += 1;
            }
            tape[ptr] = v;
        } else if c == '[' {
            if tape[ptr] == 0 { ip = jump[ip]; }
        } else if c == ']' {
            if tape[ptr] != 0 { ip = jump[ip]; }
        }
        ip += 1;
    }
    (out, Option::None)
}

// The stream split at its first `!`: before is the program, after is the
// program's input. No `!` means no input.
fn read_stream() -> (Vec<char>, Vec<char>) {
    let mut prog: Vec<char> = Vec::new();
    let mut input: Vec<char> = Vec::new();
    let mut past = false;
    loop {
        let c = getchar() as t27;
        if c < 0 { break; }             // −2 closed, −1 only pauses at EOF
        if c == 33 && !past {
            past = true;
        } else {
            if past {
                input.push(char::try_from(c).unwrap());
            } else {
                prog.push(char::try_from(c).unwrap());
            }
        }
    }
    (prog, input)
}

fn report(e: BfErr) {
    match e {
        BfErr::UnmatchedBrackets => println("error: a bracket has no partner"),
        BfErr::TapeLeft => println("error: walked off the left of the tape"),
        BfErr::TapeRight => println("error: walked off the right of the tape"),
    }
}

fn main() -> t27 {
    let (prog, input) = read_stream();
    let (out, err) = interpret(&prog, &input);
    match err {
        Option::Some(e) => {
            report(e);
            1
        },
        Option::None => {
            let mut i: taddr = 0;
            while i < out.len() {
                // The units go out as they came — the port carries UTF-8
                // code units (ISA §2.2), and 0 … 255 is its whole alphabet.
                putchar(out[i] as t9);
                i += 1;
            }
            0
        },
    }
}

#[test]
fn hello_world_says_itself() {
    // The classic hello-world — three nested loops, a subtraction loop, and
    // a punctuation walk, so it exercises every command but `,`.
    let prog = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.".to_string();
    let input = "".to_string();
    let (out, err) = interpret(&prog, &input);
    if err.is_some() { trap(); }
    let want = "Hello World!\n".to_string();
    if out.len() != want.len() { trap(); }
    let mut i: taddr = 0;
    while i < out.len() {
        if out[i] != (want[i] as t27) { trap(); }
        i += 1;
    }
}

#[test]
fn a_program_reads_its_input() {
    let prog = ",.,.".to_string();
    let input = "hi".to_string();
    let (out, err) = interpret(&prog, &input);
    if err.is_some() { trap(); }
    if out.len() != 2 { trap(); }
    if out[0] != 104 || out[1] != 105 { trap(); }   // h then i
}

#[test]
fn a_loop_runs_and_input_past_eof_is_zero() {
    let prog = ",[.-]".to_string();     // count down from the read unit
    let input = "\u{3}".to_string();
    let (out, err) = interpret(&prog, &input);
    if err.is_some() { trap(); }
    if out.len() != 3 { trap(); }
    if out[0] != 3 || out[1] != 2 || out[2] != 1 { trap(); }

    let prog2 = ",,.".to_string();      // second read is past the end
    let input2 = "A".to_string();
    let (out2, err2) = interpret(&prog2, &input2);
    if err2.is_some() { trap(); }
    if out2.len() != 1 { trap(); }
    if out2[0] != 0 { trap(); }
}

#[test]
fn cells_wrap_both_ways() {
    let prog = "-.".to_string();        // 0 − 1 wraps to 255
    let input = "".to_string();
    let (out, err) = interpret(&prog, &input);
    if err.is_some() { trap(); }
    if out.len() != 1 { trap(); }
    if out[0] != 255 { trap(); }
    let prog2 = "-+.".to_string();      // and back again
    let (out2, err2) = interpret(&prog2, &input);
    if err2.is_some() { trap(); }
    if out2[0] != 0 { trap(); }
}

#[test]
fn the_tape_and_the_brackets_have_ends() {
    let input = "".to_string();
    let left = "<".to_string();
    let (_out, err) = interpret(&left, &input);
    match err {
        Option::Some(BfErr::TapeLeft) => {},
        _ => { trap(); },
    }
    let lonely = "+++[".to_string();
    let (_out2, err2) = interpret(&lonely, &input);
    match err2 {
        Option::Some(BfErr::UnmatchedBrackets) => {},
        _ => { trap(); },
    }
    let reversed = "]".to_string();
    let (_out3, err3) = interpret(&reversed, &input);
    match err3 {
        Option::Some(BfErr::UnmatchedBrackets) => {},
        _ => { trap(); },
    }
}
