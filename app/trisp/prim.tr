// prim.tr — the native primitives: everything Scheme needs that has to
// touch the machine, the heap, or the port.
//
// Primitives are values (`Val::Prim(id)`) bound in the global frame by
// `install`. Three of them — `apply`, `eval`, `call/cc` — are bound here
// but *implemented* in eval.tr, because they move the machine's own
// registers; this file's `call` never sees their ids.
//
// What is decided here:
//
// - **Errors are values with the operation's name** ("car: not a pair"),
//   raised eagerly as SErr — the machine has no unwinding, and eval.tr's
//   spine carries them up.
// - **Arithmetic is checked t27.** Overflow is "integer overflow", never a
//   halt. `/` and inexact numbers do not exist: there is no floating point
//   on this machine (json's header made the same honesty choice), so `/` on
//   two integers is an error unless the division is exact — use `quotient`,
//   `remainder`, `modulo` for the three honest rounding modes.
// - **`quotient`/`remainder` truncate, `modulo` floors.** The machine's
//   own `/` rounds to *nearest*, so truncation is a correction step (the
//   comment at `tdiv`); flooring is the prelude's `floor_div`/`floor_mod`,
//   which exist for exactly this sign hazard (Ch. 1 §4).
// - **I/O is the port**, always: there is one input stream and one output
//   stream on this machine. R5RS's optional port arguments are accepted
//   nowhere — `(display x port)` is an arity error that says so.
// - **Strings are immutable once published** (val.tr), so there is no
//   `string-set!` here; `make-string`/`string-copy` build fresh cells.

use err::SErr;
use err::err;
use err::err_of;
use err::push_int;
use gc::mcons;
use gc::mstr;
use machine::Machine;
use read::number_token;
use read::read_datum;
use val::Heap;
use val::Val;
use val::equal;
use val::eq;
use val::write_to;

// The control trio's ids (eval.tr imports them).
pub const ID_APPLY: taddr = 133;
pub const ID_EVAL: taddr = 134;
pub const ID_CALLCC: taddr = 135;

const ID_CONS: taddr = 0;
const ID_CAR: taddr = 1;
const ID_CDR: taddr = 2;
const ID_SET_CAR: taddr = 3;
const ID_SET_CDR: taddr = 4;
const ID_PAIRP: taddr = 5;
// 6..33: the c[ad]+r compositions, listed with install.
const ID_CAAR: taddr = 6;
const ID_NULLP: taddr = 34;
const ID_LISTP: taddr = 35;
const ID_LIST: taddr = 36;
const ID_LENGTH: taddr = 37;
const ID_APPEND: taddr = 38;
const ID_REVERSE: taddr = 39;
const ID_LIST_TAIL: taddr = 40;
const ID_LIST_REF: taddr = 41;
const ID_MEMQ: taddr = 42;
const ID_MEMV: taddr = 43;
const ID_MEMBER: taddr = 44;
const ID_ASSQ: taddr = 45;
const ID_ASSV: taddr = 46;
const ID_ASSOC: taddr = 47;
const ID_EQP: taddr = 48;
const ID_EQVP: taddr = 49;
const ID_EQUALP: taddr = 50;
const ID_SYMBOLP: taddr = 51;
const ID_SYM2STR: taddr = 52;
const ID_STR2SYM: taddr = 53;
const ID_NUMBERP: taddr = 54;
const ID_INTEGERP: taddr = 55;
const ID_EXACTP: taddr = 56;
const ID_INEXACTP: taddr = 57;
const ID_ADD: taddr = 58;
const ID_SUB: taddr = 59;
const ID_MUL: taddr = 60;
const ID_DIV: taddr = 61;
const ID_QUOTIENT: taddr = 62;
const ID_REMAINDER: taddr = 63;
const ID_MODULO: taddr = 64;
const ID_NUMEQ: taddr = 65;
const ID_LT: taddr = 66;
const ID_GT: taddr = 67;
const ID_LE: taddr = 68;
const ID_GE: taddr = 69;
const ID_MAX: taddr = 70;
const ID_MIN: taddr = 71;
const ID_NUM2STR: taddr = 72;
const ID_STR2NUM: taddr = 73;
const ID_CHARP: taddr = 74;
const ID_CHAREQ: taddr = 75;
const ID_CHARLT: taddr = 76;
const ID_CHARGT: taddr = 77;
const ID_CHARLE: taddr = 78;
const ID_CHARGE: taddr = 79;
const ID_CHARCIEQ: taddr = 80;
const ID_CHARCILT: taddr = 81;
const ID_CHARCIGT: taddr = 82;
const ID_CHARCILE: taddr = 83;
const ID_CHARCIGE: taddr = 84;
const ID_CHARALPHAP: taddr = 85;
const ID_CHARNUMP: taddr = 86;
const ID_CHARWSP: taddr = 87;
const ID_CHARUPP: taddr = 88;
const ID_CHARLOWP: taddr = 89;
const ID_CHARUP: taddr = 90;
const ID_CHARDOWN: taddr = 91;
const ID_CHAR2INT: taddr = 92;
const ID_INT2CHAR: taddr = 93;
const ID_BOOLEANP: taddr = 94;
const ID_STRINGP: taddr = 95;
const ID_MAKE_STRING: taddr = 96;
const ID_STRING_LEN: taddr = 97;
const ID_STRING_REF: taddr = 98;
const ID_STRING_APPEND: taddr = 99;
const ID_SUBSTRING: taddr = 100;
const ID_STRING_COPY: taddr = 101;
const ID_STR2LIST: taddr = 102;
const ID_LIST2STR: taddr = 103;
const ID_STRINGEQ: taddr = 104;
const ID_STRINGLT: taddr = 105;
const ID_STRINGGT: taddr = 106;
const ID_STRINGCIEQ: taddr = 107;
const ID_STRINGCILT: taddr = 108;
const ID_STRINGCIGT: taddr = 109;
const ID_VECTORP: taddr = 110;
const ID_MAKE_VECTOR: taddr = 111;
const ID_VECTOR: taddr = 112;
const ID_VECTOR_LEN: taddr = 113;
const ID_VECTOR_REF: taddr = 114;
const ID_VECTOR_SET: taddr = 115;
const ID_VEC2LIST: taddr = 116;
const ID_LIST2VEC: taddr = 117;
const ID_VECTOR_FILL: taddr = 118;
const ID_PROCEDUREP: taddr = 119;
const ID_DISPLAY: taddr = 120;
const ID_WRITE: taddr = 121;
const ID_NEWLINE: taddr = 122;
const ID_READ: taddr = 123;
const ID_WRITE_CHAR: taddr = 124;
const ID_EOFP: taddr = 125;
const ID_CHARREADY: taddr = 126;
