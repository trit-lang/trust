// trisp — a Scheme for the balanced ternary machine.
//
//     trust run app/trisp/main.tr
//
// A REPL on the one stream this machine has: forms read from standard
// input, answers written one per line, errors reported and the machine
// carried on (recalc's rule — a typo ends a form, not the session). The
// dialect is a practical R5RS core: exact t27 integers (checked — overflow
// is an error, never a halt), proper tail calls, quasiquote, vectors,
// strings (immutable), the lets/cond/and/or family, first-class
// continuations, and a mark-sweep garbage collector whose census is a
// primitive of the language (`gc`, `gc-stats`). Plus two radices no other
// Scheme has: balanced ternary `0t1T0` and heptavintimal `0hJ`, because a
// Scheme on a ternary machine should read and write the machine's own
// numbers (reader details in read.tr's header).
//
// What is decided here (the tour of the modules):
//
// - **Errors are values** (`error: msg` lines), never traps (err.tr).
// - **One machine, one struct** — heap, symbols, reader, CEK registers —
//   threaded by &mut; restartable per test (machine.tr).
// - **The stack is data**, so tail calls are structural and `call/cc` is a
//   snapshot of a Vec (eval.tr).
// - **GC happens only at eval-loop boundaries**, where the registers are a
//   complete root set (gc.tr).
// - **The library is Scheme** (lib.tr), which makes it the evaluator's
//   biggest always-on test.
//
// Deliberate dialect lines, each argued in its module's header: only #f is
// false; strings immutable (no string-set!); no port objects — `display`
// and `read` always mean stdin/stdout; `/` insists on exactness (use
// quotient/remainder/modulo); no `defmacro`; case-sensitive symbols;
// depth fenced at 3^9 against the reader's recursion being the only
// native-stack recursion the interpreter allows itself.

mod err;
mod sym;
mod val;
mod read;
mod machine;
mod gc;
mod eval;
mod prim;
mod lib;

use err::SErr;
use eval::eval_top;
use eval::run;
use machine::Machine;
use read::read_datum;
use val::Val;
use val::write_to;

fn main() -> t27 {
    let mut m = Machine::port();
    prim::install(&mut m);
    match lib::load(&mut m) {
        Result::Ok(_) => {},
        Result::Err(e) => {
            print("error: ");
            print(&e.msg);
            print("\n");
            return 1;
        },
    }
    let mut out: Vec<char> = Vec::new();
    loop {
        if m.halted { break; }
        match read_datum(&mut m.rdr, &mut m.heap, &mut m.syms, 0) {
            Result::Ok(v) => {
                match v {
                    Option::Some(form) => {
                        match eval_top(&mut m, form) {
                            Result::Ok(_) => {
                                match m.val {
                                    Val::Unspec => {},
                                    _ => {
                                        write_to(&mut m.heap, &m.syms, m.val, false, &mut out);
                                        out.push('\n');
                                        print(&out);
                                        out.clear();
                                    },
                                }
                            },
                            Result::Err(e) => {
                                print("error: ");
                                print(&e.msg);
                                print("\n");
                            },
                        }
                    },
                    Option::None => { break; },
                }
            },
            Result::Err(e) => {
                print("error: ");
                print(&e.msg);
                print("\n");
            },
        }
    }
    m.exit_code
}

// -------------------------------------------------------------- tests ---
//
// The harness is json's: minus the port, so every test is the whole
// program. `run_program` runs a source text and answers its entire
// transcript — each top-level answer in write form, each error as its
// `error:` line, display output interleaved in order — and the tests pin
// transcripts verbatim.

fn run_program(text: &str) -> Vec<char> {
    let src = text.to_string();
    let mut m = Machine::from_str(&src);
    m.capturing = true;
    prim::install(&mut m);
    match lib::load(&mut m) {
        Result::Ok(_) => {},
        Result::Err(e) => {
            let mut out = "error: ".to_string();
            out.push_str(&e.msg);
            return out;
        },
    }
    loop {
        if m.halted { break; }
        match read_datum(&mut m.rdr, &mut m.heap, &mut m.syms, 0) {
            Result::Ok(v) => {
                match v {
                    Option::Some(form) => {
                        match eval_top(&mut m, form) {
                            Result::Ok(_) => {
                                match m.val {
                                    Val::Unspec => {},
                                    _ => {
                                        write_to(&mut m.heap, &m.syms, m.val, false, &mut m.capture);
                                        m.capture.push('\n');
                                    },
                                }
                            },
                            Result::Err(e) => {
                                m.capture.push_str("error: ");
                                m.capture.push_str(&e.msg);
                                m.capture.push('\n');
                            },
                        }
                    },
                    Option::None => { break; },
                }
            },
            Result::Err(e) => {
                m.capture.push_str("error: ");
                m.capture.push_str(&e.msg);
                m.capture.push('\n');
            },
        }
    }
    m.capture
}

// A transcript pin: got `cap`, want `text`.
fn check(cap: Vec<char>, text: &str) {
    if !cap.same(text) {
        println("--- transcript mismatch --- got:");
        print(&cap);
        println("--- wanted:");
        println(text);
        trap();
    }
}

#[test]
fn atoms_quote_and_arithmetic() {
    let cap = run_program("7 #t \"hi\" #\\a (quote (1 . 2)) '(a b) (+ 1 2 3) (- 10 3 2) (- 5) (* 2 3 4)")
        ;
    check(cap, "7\n#t\n\"hi\"\n#\\a\n(1 . 2)\n(a b)\n6\n5\n-5\n24\n");
}

#[test]
fn the_machines_own_radices_evaluate() {
    let cap = run_program("0t1T0 0hJ (+ 0t1T0 0h0J) (number->string 255 16) (number->string 6 3) (number->string -6 3) (number->string 6 27) (number->string -345 27) (string->number \"1T0\" 3) (string->number \"J\" 27) (string->number \"ff\" 16)");
    check(cap, "6\n6\n-339\n\"ff\"\n\"0t1T0\"\n\"0tT10\"\n\"0hJ\"\n\"0h0J\"\n6\n6\n255\n");
}

#[test]
fn closures_and_recursion() {
    let cap = run_program("(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 10) (define (adder n) (lambda (x) (+ x n))) (define add3 (adder 3)) (add3 4) ((lambda (x) (* x x)) 9)");
    check(cap, "3628800\n7\n81\n");
}

#[test]
fn tail_calls_are_constant_space() {
    // Forty thousand tail turns: the answer AND the proof — this completes
    // at all only if the kont stack stays flat, and at two mcons per turn
    // (~80k allocations) it crosses the 3^10 pace at turn ~29500, so a full
    // mark-sweep fires mid-run and the loop must survive it. 40000 turns
    // measures ≈1.2 ms/turn under the release compiler: about fifty
    // seconds of honest work, once, in the suite.
    let cap = run_program("(define (loop n) (if (= n 0) (quote done) (loop (- n 1)))) (loop 40000)");
    check(cap, "done\n");
}

#[test]
fn conditional_families() {
    let cap = run_program("(if #f 1 2) (if #t 1) (if #f 1) (cond (#f 1) ((+ 1 1)) (else 3)) (cond (#f 1)) (cond (#f 1) (2 => (lambda (x) (* x 10)))) (and 1 2 3) (and 1 #f 3) (or #f #f 7) (or 1 (/ 1 0)) (when #t 1 2 3) (when #f 1) (unless #f 9)");
    check(cap, "2\n1\n2\n20\n3\n#f\n7\n1\n3\n9\n");
}

#[test]
fn lets_in_all_their_scopes() {
    let cap = run_program("(let ((x 1) (y 2)) (+ x y)) (let* ((x 1) (y (+ x 1))) (+ x y)) (letrec ((ev (lambda (n) (if (= n 0) #t (od (- n 1))))) (od (lambda (n) (if (= n 0) #f (ev (- n 1)))))) (ev 10)) (let loop ((n 5) (acc 1)) (if (= n 0) acc (loop (- n 1) (* acc n))))");
    check(cap, "3\n3\n#t\n120\n");
}

#[test]
fn quasiquote_with_splicing() {
    let cap = run_program("(define x 3) `(a ,x ,(+ x 1)) `(1 ,@(list 2 3) 4) `(a . ,x) `(1 #(2 ,x) ,@'()) `(outer `(inner ,x ,,x))");
    check(cap, "(a 3 4)\n(1 2 3 4)\n(a . 3)\n(1 #(2 3))\n(outer (quasiquote (inner (unquote x) (unquote 3))))\n");
}

#[test]
fn side_effects_and_state() {
    let cap = run_program("(define c 0) (set! c 41) (+ c 1) (define p (cons 1 2)) (set-car! p 9) p (define v (make-vector 3 0)) (vector-set! v 1 5) v (vector-fill! v 7) v");
    check(cap, "42\n(9 . 2)\n#(0 5 0)\n#(7 7 7)\n");
}

#[test]
fn equality_predicates() {
    let cap = run_program("(eq? 'a 'a) (eq? (list 1) (list 1)) (equal? (list 1 (vector 2)) (list 1 (vector 2))) (equal? \"abc\" \"abc\") (eqv? 3 3) (eq? \"abc\" \"abc\")");
    check(cap, "#t\n#f\n#t\n#t\n#t\n#f\n");
}

#[test]
fn strings_and_chars() {
    let cap = run_program("(string-append \"ab\" \"cd\" \"ef\") (substring \"abcdef\" 1 4) (string-length \"abc\") (string-ref \"abc\" 1) (string->list \"ab\") (list->string '(#\\x #\\y)) (string=? \"a\" \"a\") (string<? \"ab\" \"ac\") (string-ci=? \"AB\" \"ab\") (char-upcase #\\a) (char->integer #\\A) (integer->char 97) (char-alphabetic? #\\9) (symbol->string 'hello) (string->symbol \"world\")");
    check(cap, "\"abcdef\"\n\"bcd\"\n3\n#\\b\n(#\\a #\\b)\n\"xy\"\n#t\n#t\n#t\n#\\A\n65\n#\\a\n#f\n\"hello\"\nworld\n");
}

#[test]
fn lists_thoroughly() {
    let cap = run_program("(list 1 2 3) (length '(1 2 3)) (append '(1) '(2 3) '() '(4)) (reverse '(1 2 3)) (list-ref '(a b c) 1) (list-tail '(a b c) 1) (memq 'b '(a b c)) (memq 'z '(a b c)) (assq 'b '((a . 1) (b . 2))) (assoc '(1) '(((1) . one))) (cadddr '(1 2 3 4)) (map1 (lambda (x) (* x x)) '(1 2 3)) (map + '(1 2) '(10 20)) (map + '(1 2 3) '(10 20 30) '(100 200 300)) (filter odd? '(1 2 3 4 5)) (fold-left cons '() '(1 2)) (fold-right cons '() '(1 2)) (list-sort < '(3 1 2)) (list-sort > '(3 1 2)) (iota 4) (iota 3 10) (list* 1 2 '(3))");
    check(cap, "(1 2 3)\n3\n(1 2 3 4)\n(3 2 1)\nb\n(b c)\n(b c)\n#f\n(b . 2)\n((1) . one)\n4\n(1 4 9)\n(11 22)\n(111 222 333)\n(1 3 5)\n((() . 1) . 2)\n(1 2)\n(1 2 3)\n(3 2 1)\n(0 1 2 3)\n(10 11 12)\n(1 2 3)\n");
}

#[test]
fn numbers_honestly() {
    let cap = run_program("(quotient 7 2) (quotient -7 2) (quotient 7 -2) (remainder 7 2) (remainder -7 2) (modulo 7 2) (modulo -7 2) (modulo 7 -2) (= 2 2 2) (< 1 2 3) (< 1 3 2) (max 3 1 4) (min 3 1 4) (gcd 32 -36) (lcm 4 6) (expt 2 10) (sgn -9) (even? -4) (odd? -3) (/ 10 2) (/ 10 3) (+ 3812798742493 1) (*) (max 1) (expt 2 -1) (abs -5) (string->number \"zzz\") (+)");
    check(cap, "3\n-3\n-3\n1\n-1\n1\n1\n-1\n#t\n#t\n#f\n4\n1\n4\n12\n1024\n-1\n#t\n#t\n5\nerror: /: not an exact division\nerror: integer overflow\n1\n1\nerror: expt: negative exponent\n5\n#f\n0\n");
}

#[test]
fn display_and_write_interleave() {
    let cap = run_program("(display \"hi\") (display #\\x) (newline) (write '(1 \"a\")) (display '(1 \"a\")) (newline) (write 0t1T0) (newline) (write-char #\\!) (newline) (newline)");
    check(cap, "hix\n(1 \"a\")(1 a)\n6\n!\n\n");
}

#[test]
fn read_pulls_data_after_the_form() {
    let cap = run_program("(display (read)) 42");
    check(cap, "42");
}

#[test]
fn read_at_eof_is_the_eof_object() {
    let cap = run_program("(read)");
    check(cap, "#<eof>\n");
}

#[test]
fn error_lines_name_and_recover() {
    let cap = run_program("(car 1) (+ 1 'a) (unknown-fn 1) (1 2) (if) (vector-ref (make-vector 1) 5) 42 (car 2) (lambda) (define) `(1 ,@(quote 5)) ,@(quote (1)) (string-ref \"ab\" 5) 43");
    check(cap, "error: car: not a pair\nerror: +: not a number\nerror: unbound symbol: unknown-fn\nerror: apply: not a procedure\nerror: if: wrong number of arguments\nerror: vector-ref: not a valid index\n42\nerror: car: not a pair\nerror: lambda: wrong number of arguments\nerror: define: wrong number of arguments\nerror: unquote-splicing: needs a list\nerror: unquote: outside quasiquote\nerror: string-ref: not a valid index\n43\n");
}

#[test]
fn the_reader_rejects_lone_dots_and_long_booleans() {
    // Reader errors are values with positions; a broken form ends at its
    // error and the next datum carries on. A `.` may only introduce a
    // dotted tail after a head element, and as a token of its own — (1 .x)
    // does not rewrite itself to (1 x). `#t`/`#f` end at a delimiter, so
    // R7RS's `#true` is a spelling error here, not `true`.
    let cap = run_program("( . 1) (1 . 2 3) (1 .x) #true #fX (quote (1 . 2)) #t #f 9");
    check(cap, "error: unexpected . at 2\nerror: unexpected . at 2\n1\nerror: unexpected ) at 5\nerror: expected ) after dotted tail at 10\nerror: unexpected ) at 15\nerror: unexpected . at 20\nerror: unbound symbol: x\nerror: unexpected ) at 22\nerror: bad boolean spelling at 24\nerror: unbound symbol: rue\nerror: bad boolean spelling at 30\nerror: unbound symbol: X\n(1 . 2)\n#t\n#f\n9\n");
}

#[test]
fn apply_and_eval() {
    let cap = run_program("(apply + '(1 2 3)) (apply + 1 2 '(3 4)) (apply list '()) (define (two-args a b) (+ a b)) (apply two-args '(40 2)) (eval '(+ 1 2) (interaction-environment)) (eval '(* 7 6))");
    check(cap, "6\n10\n()\n42\n3\n42\n");
}

#[test]
fn call_cc_escapes_and_reenters() {
    let cap = run_program("(+ 1 (call/cc (lambda (k) (k 10)))) (+ 1 (call/cc (lambda (k) 20))) (define r 0) (+ 1 (call/cc (lambda (k) (set! r k) 3))) (r 100)");
    check(cap, "11\n21\n4\n101\n");
}

#[test]
fn call_cc_values_are_procedures() {
    let cap = run_program("(procedure? call/cc) (procedure? (call/cc (lambda (k) k))) (define k (call/cc (lambda (x) x))) (procedure? k) (call/cc (lambda (k) 5))");
    check(cap, "#t\n#t\n#t\n5\n");
}

#[test]
fn vectors_round_trip_through_lists() {
    let cap = run_program("(vector 1 2 3) (vector->list (vector 1 2 3)) (list->vector '(a b)) (vector-map square (vector 2 3)) (vector-length #(1 2)) (vector-ref #(a b c) 2) #(1 \"two\" #(3))");
    check(cap, "#(1 2 3)\n(1 2 3)\n#(a b)\n#(4 9)\n2\nc\n#(1 \"two\" #(3))\n");
}

#[test]
fn the_gc_counts_honestly() {
    // gc-stats answers (pairs strings vectors conts): live cells after a
    // full collection. The numbers are deterministic — the allocator's are
    // — so the whole ledger pins. The second collect, after a thousand
    // fresh cells are abandoned and rebound to (), must return to the
    // floor: this is the no-leak law the module headers promise.
    let cap = run_program("(gc) (gc-stats) (define junk (map1 (lambda (x) (+ x 1)) (iota 1000))) (length junk) (gc-stats) (set! junk (quote ())) (gc-stats) junk (number->trits 6)");
    check(cap, "(1196 2 0 0)\n1000\n(2198 2 0 0)\n(1198 2 0 0)\n()\n(1 -1 0)\n");
}
